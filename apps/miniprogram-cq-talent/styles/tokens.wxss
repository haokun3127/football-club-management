/**
 * 重庆天才设计 Token 层
 * 来源：Figma《重庆天才小程序 UIUX Design System》"CQ Talent Contract Tokens" 变量集
 * 校准：2026-07-30 通过 .fig 全量解析（kiwi 解码）提取精确色值，
 *       并与 P/C 页面实际用色直方图交叉验证（Contract 集与页面一致）。
 * 消费方式：app.wxss 顶部 @import，页面/组件一律使用 var(--token)，禁止新增硬编码色值。
 */

page {
  /* 品牌 */
  --color-brand: #a80f1b;
  --color-brand-pressed: #7f0b14;
  --color-brand-soft: #fceeef;
  --color-brand-rgb: 168, 15, 27; /* 供 rgba(var(--color-brand-rgb), .xx) 使用 */

  /* 表面 */
  --color-page: #f6f7f9;
  --color-card: #ffffff;
  --color-line: #e7eaf0;
  /* Approved bright club V2; opt in per verified screen during rollout. */
  --club-page: var(--color-page);
  --club-nav: var(--color-card);
  --club-line: var(--color-line);
  --club-text: var(--color-text);
  --club-muted: var(--color-text-secondary);
  --club-warning-line: #ebcf91;
  --club-warning-soft: #fff7e5;
  --club-shadow: 0 6rpx 24rpx rgba(46, 20, 15, 0.06);

  /* 文本 */
  --color-text: #202124;
  --color-text-secondary: #667085;

  /* 语义状态（色值已从 .fig 精确校准） */
  --color-success: #188754; /* Figma color/state/success/fg，替代旧 #237804 */
  --color-success-soft: #ecfdf3;
  --color-warning: #b56a00;
  --color-warning-soft: #fff7e8;
  --color-error: #b42318;
  --color-error-soft: #fff1f1;
  --color-info: #2268d8;
  --color-info-soft: #eef4ff;
  --color-pending: #7a5af8;
  --color-pending-soft: #f4f3ff;

  /* 字号（rpx） */
  --font-size-display: 20px;
  --font-size-section: 18px;
  --font-size-body: 16px;
  --font-size-aux: 14px;
  --font-size-caption: 12px;

  /* 间距（rpx） */
  --spacing-page: 24rpx;
  --space-page: 24rpx; /* 新版画板 Body p-16px；venues/coaches/content-select 等页引用 */
  --spacing-card: 24rpx;
  --spacing-card-gap: 20rpx;
  --spacing-stack: 16rpx;

  /* 圆角（rpx） */
  --radius-card: 24rpx;
  --radius-button: 16rpx;
  --radius-hero: 28rpx;

  /* v1.1 通用交互与腾讯组件主题；逻辑px保持窄屏可读。 */
  --control-height: 44px;
  --control-padding: 10px 16px;
  --td-textarea-padding: 12px;
  --control-height-primary: 48px;
  --motion-fast: 180ms;
  --td-brand-color: var(--color-brand);
  --td-brand-color-active: var(--color-brand-pressed);
  --td-brand-color-light: var(--color-brand-soft);
  --td-brand-color-disabled: #e4e7ec;
  --td-button-primary-disabled-bg: #e4e7ec;
  --td-button-primary-disabled-border-color: #e4e7ec;
  --td-button-primary-disabled-color: var(--color-text-secondary);
  --td-text-color-primary: var(--color-text);
  --td-text-color-secondary: var(--color-text-secondary);
  --td-text-color-placeholder: #667085;
  --td-bg-color-page: var(--color-page);
  --td-bg-color-container: var(--color-card);
  --td-font-size-base: 16px;
  --td-font-size-m: 16px;
  --td-font-body-large: 400 16px / 1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --td-font-body-medium: 400 16px / 1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --td-font-body-small: 400 14px / 1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --td-button-border-radius: var(--radius-button);
  --td-button-font-size: 16px;
  --td-button-medium-height: 44px;
  --td-button-large-height: 48px;
  --td-input-placeholder-text-color: #667085;
  --td-input-vertical-padding: 10px;
  --td-textarea-placeholder-color: #667085;
  --td-tab-bar-height: 56px;
  --td-tab-bar-active-color: var(--color-brand);
  --td-tab-bar-color: var(--color-text-secondary);
  --td-tab-bar-bg-color: var(--color-card);

  /* 阴影 */
  --shadow-card: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
  --shadow-hero: 0 18rpx 36rpx rgba(var(--color-brand-rgb), 0.16);
}
