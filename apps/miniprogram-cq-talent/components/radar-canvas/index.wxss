.radar {position:relative;width:100%;height:300px;}.ec-chart {display:block;width:100%;height:100%;}.radar--dark {background:#101c2c;border-radius:12px;}.radar-empty {position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--color-text-secondary);font-size:14px;pointer-events:none;}.radar--dark .radar-empty {color:#e8edf5;}
