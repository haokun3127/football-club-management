.role-tabs { --td-tab-bar-height: 56px; --td-tab-bar-active-color: var(--color-brand); --td-tab-bar-color: var(--color-text-secondary); --td-tab-bar-bg-color: var(--color-card); }
.role-tabs--dark { --td-tab-bar-color: #d6d9df; --td-tab-bar-active-color: #fff; --td-tab-bar-bg-color: #171b24; }
.tabbar-icon { width: 22px; height: 22px; }
