.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  height: 116rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eceef2;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #60646f;
  font-size: 22rpx;
}

.tabbar-dot {
  width: 12rpx;
  height: 12rpx;
  margin-bottom: 8rpx;
  border-radius: 999rpx;
  background: transparent;
}

.tabbar-item.active {
  color: #e60012;
  font-weight: 700;
}

.tabbar-item.active .tabbar-dot {
  background: #e60012;
}
