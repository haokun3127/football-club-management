.tabbar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 9999; display: flex; box-sizing: border-box; height: 140rpx; padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #e7eaf0; background: #ffffff; box-shadow: 0 -6rpx 20rpx rgba(16,24,40,.04); }
.tabbar-item { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-width: 0; color: #667085; font-size: 21rpx; }
.tabbar-icon-wrap { position: relative; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 52rpx; border-radius: 18rpx; transition: background-color 180ms ease; }
.tabbar-icon { width: 44rpx; height: 44rpx; }
.tabbar-dot { position: absolute; bottom: -3rpx; width: 8rpx; height: 8rpx; border-radius: 999rpx; background: transparent; }
.tabbar-label { margin-top: 4rpx; overflow: hidden; max-width: 100%; text-overflow: ellipsis; white-space: nowrap; }
.tabbar--parent .tabbar-item.active { color: #a80f1b; font-weight: 650; }
.tabbar--parent .tabbar-item.active .tabbar-dot { bottom: -3rpx; width: 4rpx; height: 4rpx; border-radius: 999rpx; background: #a80f1b; }
.tabbar--coach .tabbar-item.active { color: var(--color-brand); font-weight: 650; }
.tabbar--coach .tabbar-dot { display: none; }
