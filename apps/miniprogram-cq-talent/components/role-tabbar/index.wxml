<view class="role-tabs {{theme === 'dark' ? 'role-tabs--dark' : ''}}">
  <t-tab-bar value="{{active}}" fixed="{{!flow}}" safe-area-inset-bottom split="{{false}}" z-index="30" bindchange="handleChange">
    <t-tab-bar-item wx:for="{{items}}" wx:key="key" value="{{item.key}}" aria-label="{{item.label}}">
      <image slot="icon" class="tabbar-icon" src="{{item.icon}}" mode="aspectFit" />
      {{item.label}}
    </t-tab-bar-item>
  </t-tab-bar>
</view>
