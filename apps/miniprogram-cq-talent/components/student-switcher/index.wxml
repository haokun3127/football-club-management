<scroll-view class="switcher" scroll-x enable-flex show-scrollbar="{{false}}">
  <view class="switcher__inner">
    <t-check-tag wx:if="{{showAll}}" checked="{{selectedId === 'all'}}" shape="round" variant="light" content="{{allLabel}}" data-id="all" bindchange="select" custom-style="min-height:var(--control-height);padding:10px 14px;font-size:var(--font-size-body);" />
    <t-check-tag wx:for="{{students}}" wx:key="id" checked="{{selectedId === item.id}}" shape="round" variant="light" content="{{item.name}}" data-id="{{item.id}}" bindchange="select" custom-style="min-height:var(--control-height);padding:10px 14px;font-size:var(--font-size-body);" />
  </view>
</scroll-view>
