<view class="activity-card activity-card--{{type}}" bindtap="handleTap">
  <view class="activity-card__rail"></view>
  <view class="activity-card__body">
    <view class="activity-card__top">
      <view class="activity-card__title">{{title}}</view>
      <status-chip wx:if="{{statusLabel}}" label="{{statusLabel}}" tone="{{statusTone}}" compact="{{true}}" />
    </view>
    <view wx:if="{{time}}" class="activity-card__primary">{{time}}</view>
    <view wx:if="{{venue}}" class="activity-card__secondary">{{venue}}</view>
    <view wx:if="{{description}}" class="activity-card__description">{{description}}</view>
    <view wx:if="{{meta.length}}" class="activity-card__meta">
      <view wx:for="{{meta}}" wx:key="label" class="activity-card__meta-item">{{item.label}} {{item.value}}</view>
    </view>
    <view wx:if="{{actionLabel}}" class="activity-card__footer">
      <button class="activity-card__action" catchtap="handleAction">{{actionLabel}}</button>
    </view>
  </view>
</view>
