.activity-card { position: relative; display: flex; overflow: hidden; margin-bottom: 20rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(16,24,40,.04); }
.activity-card:active { transform: scale(.995); }
.activity-card__rail { width: 8rpx; background: var(--color-brand); }
.activity-card--match .activity-card__rail { background: #175cd3; }
.activity-card--other .activity-card__rail { background: #7a5af8; }
.activity-card__body { flex: 1; min-width: 0; padding: 24rpx; }
.activity-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.activity-card__title { flex: 1; color: #202124; font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.activity-card__primary { margin-top: 14rpx; color: #202124; font-size: 26rpx; font-weight: 600; }
.activity-card__secondary,.activity-card__description { margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.activity-card__meta { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; margin-top: 16rpx; }
.activity-card__meta-item { color: #667085; font-size: 22rpx; }
.activity-card__footer { display: flex; justify-content: flex-end; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #f2f4f7; }
.activity-card__action { min-width: 180rpx; min-height: 64rpx; margin: 0; padding: 0 24rpx; border-radius: 14rpx; background: var(--color-brand); color: #ffffff; font-size: 25rpx; font-weight: 600; line-height: 64rpx; }
