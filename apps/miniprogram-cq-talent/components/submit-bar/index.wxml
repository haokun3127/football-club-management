<view class="submit-bar">
  <view wx:if="{{hint}}" class="submit-bar__hint">{{hint}}</view>
  <view class="submit-bar__actions">
    <t-button wx:if="{{secondaryText}}" class="submit-bar__secondary" bindtap="handleSecondary" custom-style="min-height:var(--control-height-primary);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="submit-bar__secondary" theme="default" variant="outline">{{secondaryText}}</t-button>
    <t-button class="submit-bar__primary {{loading || disabled ? 'submit-bar__primary--disabled' : ''}}" loading="{{loading}}" disabled="{{loading || disabled}}" bindtap="handlePrimary" custom-style="min-height:var(--control-height-primary);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="submit-bar__primary {{loading || disabled ? 'submit-bar__primary--disabled' : ''}}" theme="primary" variant="base">{{primaryText}}</t-button>
  </view>
</view>
