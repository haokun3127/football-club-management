.submit-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 25; box-sizing: border-box; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7eaf0; background: rgba(255,255,255,.97); box-shadow: 0 -8rpx 24rpx rgba(16,24,40,.06); }
.submit-bar__hint { margin-bottom: 10rpx; color: #667085; font-size: 22rpx; text-align: center; }
.submit-bar__actions { display: flex; gap: 16rpx; }
.submit-bar__primary,.submit-bar__secondary { min-height: 84rpx; margin: 0; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; line-height: 84rpx; }
.submit-bar__primary { flex: 1; background: var(--color-brand); color: #ffffff; }
.submit-bar__primary--disabled { background: #d0d5dd; color: #ffffff; }
.submit-bar__secondary { width: 196rpx; border: 1rpx solid #e7eaf0; background: #ffffff; color: #202124; }
