.app-header { position: relative; z-index: 30; background: #ffffff; color: #202124; }
.app-header--brand { background: var(--color-brand); color: #ffffff; }
.app-header--soft { background: #fdf0f1; }
.app-header__content { position: relative; display: flex; align-items: center; box-sizing: border-box; padding-left: 24rpx; }
.app-header__heading { position: absolute; left: 128rpx; right: 128rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
.app-header__heading--left { position: static; min-width: 0; flex: 1; align-items: flex-start; text-align: left; }
.app-header__title { overflow: hidden; max-width: 100%; font-size: 32rpx; font-weight: 650; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.app-header__subtitle { margin-top: 2rpx; overflow: hidden; max-width: 100%; color: #667085; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.app-header--brand .app-header__subtitle { color: rgba(255,255,255,.76); }
.app-header__side { display: flex; align-items: center; min-width: 88rpx; }
.app-header__side--right { margin-left: auto; justify-content: flex-end; }
.app-header__back { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin-left: -12rpx; font-size: 58rpx; font-weight: 300; line-height: 1; }
.app-header__action { min-height: 64rpx; padding: 0 12rpx; color: var(--color-brand); font-size: 26rpx; font-weight: 600; line-height: 64rpx; }
.app-header--brand .app-header__action { color: #ffffff; }

/* 图标动作（Figma P1: 32x32 铃铛 + 8px 红点 #ff3b30 白描边） */
.app-header__icon-action { position: relative; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }
.app-header__icon-glyph { font-size: 40rpx; line-height: 1; }
.app-header__icon-dot { position: absolute; top: 6rpx; right: 6rpx; width: 16rpx; height: 16rpx; background: #ff3b30; border: 2rpx solid #ffffff; border-radius: 50%; }

/* 胶囊动作（Figma P3: bg #fceeef, text #a80f1b, r=16px, pad 6/12px） */
.app-header__action--pill { min-height: 54rpx; margin-right: 8rpx; padding: 0 24rpx; background: var(--color-brand-soft); border-radius: 999rpx; font-size: 24rpx; line-height: 54rpx; }
