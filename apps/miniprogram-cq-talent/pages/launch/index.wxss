.launch { min-height: 100vh; box-sizing: border-box; background: #f6f7f9; }
.launch__body { padding: 88rpx 32rpx 48rpx; }
.brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 48rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 36rpx; background: var(--color-brand); box-shadow: 0 18rpx 40rpx rgba(168,15,27,.2); }
.brand-ball { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border: 3rpx solid rgba(255,255,255,.86); border-radius: 50%; color: #ffffff; font-size: 30rpx; font-weight: 800; letter-spacing: 2rpx; }
.brand-name { margin-top: 28rpx; color: #202124; font-size: 40rpx; font-weight: 800; }
.brand-subtitle,.notice,.dev-hint { margin-top: 12rpx; color: #667085; font-size: 24rpx; line-height: 1.55; text-align: center; }
.notice { margin: 32rpx auto 0; max-width: 580rpx; }
.dev-hint { color: #ad6800; }
