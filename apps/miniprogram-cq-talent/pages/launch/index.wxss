.launch { min-height: 100vh; box-sizing: border-box; background: var(--color-page); }
.launch__content { width: 662rpx; margin: 0 auto; }
.launch-brand { display: flex; flex-direction: column; align-items: center; height: 200rpx; }
.launch-brand__badge { display: flex; align-items: center; justify-content: center; width: 128rpx;     background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.launch-brand__icon { width: 64rpx; height: 64rpx; }
.launch-brand__name { margin-top: 24rpx; color: var(--color-brand); font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.launch-card { overflow: hidden; height: 424rpx; margin-top: 48rpx; border-radius: 24rpx; background: var(--color-card); box-shadow:none; }
.launch-row { display: flex; box-sizing: border-box; align-items: center; justify-content: space-between; height: 140rpx; padding: 0 32rpx; }
.launch-row--action { cursor: pointer; }
.launch-row__copy { min-width: 0; }
.launch-row__title { color: var(--color-text); font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.launch-row__desc { overflow: hidden; margin-top: 8rpx; color: var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.launch-divider { height: 2rpx; margin: 0; background: var(--color-line); }
.launch-chip { flex: 0 0 auto;   font-size: var(--font-size-aux); font-weight: 500; line-height: 1.5;  background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.launch-chip--loading {    background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.launch-chip--pending {    background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.launch-chip--error {    background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-error);}
.launch-chevron { flex: 0 0 auto; width: 32rpx; height: 32rpx; }
.launch-helper { box-sizing: border-box; height: 48rpx; margin-top: 48rpx; padding: 16rpx; color: var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; text-align: center; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.launch-row,
.launch-row--action { min-height:44px; min-width:44px; box-sizing:border-box; }
