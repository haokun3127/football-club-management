<view class="launch">
  <view class="launch__body">
    <view class="brand" bindlongpress="switchDevRole">
      <view class="brand-mark"><view class="brand-ball">CQ</view></view>
      <view class="brand-name">{{clientName}}</view>
      <view class="brand-subtitle">陪伴每一次训练与成长</view>
    </view>

    <status-view state="{{state}}" title="{{title}}" message="{{message}}" action-text="{{actionText}}" bindaction="retry" />

    <view class="notice">身份将根据俱乐部登记资料自动匹配。如资料有误，请联系俱乐部工作人员。</view>
    <view wx:if="{{devHint}}" class="dev-hint">{{devHint}}</view>
  </view>
</view>
