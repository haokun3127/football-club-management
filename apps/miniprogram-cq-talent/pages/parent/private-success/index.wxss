.success-page {
  min-height: 100vh;
  background: var(--color-page);
}

.success-page__body {
  padding: 96rpx var(--space-page) 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.check-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #22c55e;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 48rpx rgba(34, 197, 94, 0.25);
}

.check-circle__icon {
  font-size: 96rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.success-title {
  margin-top: 64rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.success-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.summary-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 64rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.summary-row--last {
  border-bottom: none;
}

.summary-row__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.summary-row__value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.actions {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.actions__primary {
  background: var(--color-brand);
  border-radius: 52rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.actions__outline {
  border: 1rpx solid var(--color-brand);
  border-radius: 52rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-brand);
}
