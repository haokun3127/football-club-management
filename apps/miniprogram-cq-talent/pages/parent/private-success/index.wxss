.private-success-page {
  min-height: 100vh;
  background: var(--color-page);
}

.page-nav { position: sticky; top: 0; z-index: 100; }

.private-success-page__body {
  min-height: calc(100vh - 140rpx);
  box-sizing: border-box;
  padding: 44rpx 44rpx 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-nav {
  height:44px;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 44rpx;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-line);
}

.page-nav__back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-nav__back image { width: 48rpx; height: 48rpx; }

.page-nav__title {
  margin-left: 0;
  font-size: var(--font-size-display);
  font-weight: 700;
  color: var(--color-text);
}

.request-marker {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.request-marker--confirmed {
  background: #22c55e;
  box-shadow:none;
}

.request-marker--neutral { background: #e7eaf0; }

.request-marker__check {
  width: 96rpx;
  height: 96rpx;
}

.request-marker__status {
  font-size: var(--font-size-body);
  font-weight: 600;

      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.request-title {
  margin-top: 64rpx;
  font-size: var(--font-size-section);
  font-weight: 700;
  color: var(--color-text);
}

.request-subtitle {
  margin-top: 16rpx;
  font-size: var(--font-size-aux);
  color: var(--color-text-secondary);
}

.summary-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 64rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow:none;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 32rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.summary-row--last { border-bottom: none; }

.summary-row__label {
  flex: 0 0 auto;
  font-size: var(--font-size-aux);
  color: var(--color-text-secondary);
}

.summary-row__value {
  font-size: var(--font-size-aux);
  font-weight: 600;
  color: var(--color-text);
  text-align: right;
}

.summary-row__value--wrap { white-space: normal; }

.actions {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.actions__primary,
.actions__outline {
  padding: 26rpx 0;
  border-radius: 52rpx;
  text-align: center;
  font-size: var(--font-size-body);
  font-weight: 600;
}

.actions__primary {
  background: var(--color-brand);
  color: #ffffff;
}

.actions__outline {
  border: 1rpx solid var(--color-brand);
  color: var(--color-brand);
}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.actions__outline,
.actions__primary,
.page-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
