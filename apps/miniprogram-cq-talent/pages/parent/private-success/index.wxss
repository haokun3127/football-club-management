.private-success-page {
  min-height: 100vh;
  background: var(--color-page);
}

.page-nav { position: sticky; top: 0; z-index: 100; }

.private-success-page__body {
  min-height: calc(100vh - 140rpx);
  box-sizing: border-box;
  padding: 56rpx 44rpx 176rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-nav {
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 44rpx;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-line);
}

.page-nav__back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-nav__back image { width: 48rpx; height: 48rpx; }

.page-nav__title {
  margin-left: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
}

.request-marker {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.request-marker--confirmed {
  background: #22c55e;
  box-shadow: 0 24rpx 48rpx rgba(34, 197, 94, 0.25);
}

.request-marker--neutral { background: #e7eaf0; }

.request-marker__check {
  font-size: 96rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.request-marker__status {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.request-title {
  margin-top: 64rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.request-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.summary-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 64rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 32rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.summary-row--last { border-bottom: none; }

.summary-row__label {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.summary-row__value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  text-align: right;
}

.summary-row__value--wrap { white-space: normal; }

.actions {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.actions__primary,
.actions__outline {
  padding: 26rpx 0;
  border-radius: 52rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.actions__primary {
  background: var(--color-brand);
  color: #ffffff;
}

.actions__outline {
  border: 1rpx solid var(--color-brand);
  color: var(--color-brand);
}
