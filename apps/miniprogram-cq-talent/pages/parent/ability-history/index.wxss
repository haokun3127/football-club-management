.ability-history-page { min-height: 100vh; background: #f5f6f8; }
.page-nav { position: sticky; top: 0; z-index: 100; box-sizing: content-box; display: flex; align-items: center; height: 88rpx; padding-left: 32rpx; background: #ffffff; }
.page-nav__back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.page-nav__back image { width: 48rpx; height: 48rpx; }
.page-nav__title { flex: 1; margin-left: 24rpx; overflow: hidden; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.page-nav__spacer { flex: 0 0 auto; width: 48rpx; height: 48rpx; }
.ability-history-page__body { padding: 16rpx 32rpx 64rpx; }
.ability-history-page__intro { margin: 0 0 24rpx; color: #667085; font-size: 26rpx; line-height: 40rpx; }
.history-summary { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; min-height: 164rpx; margin-bottom: 36rpx; padding: 30rpx 32rpx; border-radius: 32rpx; background: #ffffff; }
.history-summary__copy { min-width: 0; }
.history-summary__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 44rpx; }
.history-summary__meta { margin-top: 8rpx; overflow: hidden; color: #667085; font-size: 24rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-summary__score { flex: 0 0 auto; margin-left: 24rpx; text-align: right; }
.history-summary__score-value { color: #a80f1b; font-size: 48rpx; font-weight: 700; line-height: 52rpx; }
.history-summary__score-label { margin-top: 4rpx; color: #667085; font-size: 22rpx; line-height: 30rpx; }
.ability-update-card { box-sizing: border-box; min-height: 224rpx; margin-bottom: 24rpx; padding: 30rpx 32rpx; border-radius: 32rpx; background: #ffffff; }
.ability-update-card__top, .ability-update-card__bottom { display: flex; align-items: flex-start; }
.ability-update-card__badge { flex: 0 0 auto; margin-top: 2rpx; padding: 5rpx 16rpx; border-radius: 22rpx; font-size: 22rpx; font-weight: 700; line-height: 32rpx; }
.ability-update-card__badge--training { color: #2e7d32; background: #ebfaed; }
.ability-update-card__badge--assessment { color: #2954ab; background: #e8f2ff; }
.ability-update-card__heading { flex: 1; min-width: 0; margin-left: 20rpx; }
.ability-update-card__title { overflow: hidden; color: #202124; font-size: 30rpx; font-weight: 700; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.ability-update-card__time { margin-top: 4rpx; color: #667085; font-size: 24rpx; line-height: 32rpx; }
.ability-update-card__source { flex: 0 0 auto; margin-left: 12rpx; padding: 2rpx 0 18rpx 12rpx; color: #a80f1b; font-size: 24rpx; font-weight: 700; line-height: 32rpx; }
.ability-update-card__bottom { align-items: center; justify-content: space-between; margin-top: 26rpx; }
.ability-update-card__metric { min-width: 0; overflow: hidden; color: #202124; font-size: 28rpx; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.ability-update-card__delta { flex: 0 0 auto; margin-left: 24rpx; font-size: 32rpx; font-weight: 700; line-height: 40rpx; }
.ability-update-card__delta--positive { color: #2e7d32; }
.ability-update-card__delta--negative { color: #a80f1b; }
.ability-update-card__delta--neutral { color: #667085; }
