<view class="ability-history-page">
  <app-header title="能力模型更新" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />

  <view class="ability-history-page__body">
    <view class="ability-history-page__intro">查看每一次能力变化与来源</view>
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载能力模型更新' : state === 'empty' ? '暂无能力模型更新' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="history-summary">
        <view class="history-summary__copy">
          <view class="history-summary__title">能力更新记录</view>
          <view class="history-summary__meta">{{updateCountLabel}} · {{latestUpdateLabel}}</view>
        </view>
        <view class="history-summary__meta">课堂表现与测评模型各自记录，不合成为综合分；历史未提供版本与单位，暂不比较趋势。</view>
      </view>

      <view wx:for="{{rows}}" wx:key="id" class="ability-update-card">
        <view class="ability-update-card__top">
          <view class="ability-update-card__badge ability-update-card__badge--{{item.sourceTone}}">{{item.sourceLabel}}</view>
          <view class="ability-update-card__heading"><view class="ability-update-card__title">{{item.title}}</view><view class="ability-update-card__time">{{item.occurredAtLabel}}</view></view>
          <view wx:if="{{item.hasSourceUrl}}" class="ability-update-card__source" data-url="{{item.sourceUrl}}" bindtap="openSource">查看来源 ›</view>
        </view>
        <view class="ability-update-card__bottom"><view class="ability-update-card__metric">{{item.metricLabel}}</view><view class="ability-update-card__delta ability-update-card__delta--{{item.deltaTone}}">{{item.deltaLabel}}</view></view>
      </view>
    </block>
  </view>
</view>
