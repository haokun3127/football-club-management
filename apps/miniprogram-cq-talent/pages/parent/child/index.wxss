.child-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.child-tab {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: #60646f;
  font-size: 24rpx;
}

.child-tab.active {
  background: #fceeef;
  color: #a80f1b;
  font-weight: 700;
}

button {
  margin-top: 20rpx;
}
