.p7 { min-height: 100vh; background: #f6f7f9; }
.p7-nav { position: relative; display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding: 0 200rpx 0 32rpx; background: #ffffff; }
.p7-nav__title { color: #202124; font-size: 40rpx; font-weight: 700; line-height: 48rpx; }.p7-nav__signout { position: absolute; min-width: 56rpx; height: 56rpx; padding: 0 16rpx; color: #a80f1b; font-size: 26rpx; font-weight: 600; line-height: 56rpx; text-align: center; }
.p7-body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)); }
.p7-content { display: flex; flex-direction: column; gap: 32rpx; }
.p7-player { display: flex; box-sizing: border-box; align-items: center; gap: 32rpx; min-height: 208rpx; padding: 40rpx; border-radius: 32rpx; background: #07111f; }
.p7-player__avatar { display: flex; flex: 0 0 128rpx; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 64rpx; background: #a80f1b; color: #ffffff; font-size: 48rpx; font-weight: 700; }
.p7-player__name { color: #ffffff; font-size: 40rpx; font-weight: 700; }.p7-player__team { overflow: hidden; max-width: 400rpx; margin-top: 8rpx; color: rgba(255,255,255,.5); font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.p7-stats { display: flex; box-sizing: border-box; height: 160rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05); }
.p7-stat { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-width: 0; gap: 8rpx; }.p7-stat + .p7-stat { border-left: 1rpx solid #e7eaf0; }
.p7-stat__value { overflow: hidden; max-width: 100%; color: #202124; font-size: 48rpx; font-weight: 700; line-height: 58rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.p7-stat__value--brand { color: #a80f1b; }.p7-stat__label { color: #667085; font-size: 24rpx; text-align: center; white-space: nowrap; }
.p7-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }.p7-action { display: flex; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; height: 202rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; color: #202124; font-size: 28rpx; font-weight: 600; }
.p7-action__icon { position: relative; display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 40rpx; background: #fceeef; color: #a80f1b; }.p7-action__icon > view { box-sizing: border-box; width: 36rpx; height: 36rpx; border: 4rpx solid currentColor; }
.p7-action__icon--calendar > view { border-radius: 6rpx; }.p7-action__icon--calendar::after { position: absolute; top: 30rpx; width: 32rpx; height: 4rpx; background: currentColor; content: ""; }
.p7-action__icon--chart > view { border: 0; border-right: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor; }.p7-action__icon--chart::after { position: absolute; width: 30rpx; height: 20rpx; border-bottom: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: skewY(-30deg); content: ""; }
.p7-action__icon--bolt > view { width: 22rpx; height: 38rpx; border: 0; background: currentColor; clip-path: polygon(55% 0,100% 0,68% 40%,100% 40%,30% 100%,43% 55%,0 55%); }
.p7-action__icon--message > view { border-radius: 50%; }.p7-action__icon--message::after { position: absolute; right: 23rpx; bottom: 20rpx; width: 12rpx; height: 12rpx; border-left: 4rpx solid currentColor; transform: rotate(-35deg); content: ""; }
.p7-card { display: flex; box-sizing: border-box; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05); }.p7-card--recent { min-height: 220rpx; }.p7-card--pending { min-height: 160rpx; justify-content: center; }.p7-card__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 38rpx; }.p7-pending { color: #667085; font-size: 26rpx; line-height: 34rpx; }.p7-activity { display: flex; align-items: center; gap: 24rpx; min-height: 68rpx; }.p7-activity__dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #a80f1b; }.p7-activity__dot--green { background: #059669; }.p7-activity__dot--blue { background: #2563eb; }.p7-activity__title { color: #202124; font-size: 28rpx; font-weight: 600; line-height: 34rpx; }.p7-activity__date { margin-top: 4rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; }
