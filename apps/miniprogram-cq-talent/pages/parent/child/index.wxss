.child-page { min-height: 100vh; background: #f6f7f9; }
.child-page__body { padding: 24rpx 24rpx calc(148rpx + env(safe-area-inset-bottom)); }
.switcher-block { margin-bottom: 20rpx; }
.switcher-block__label { margin-bottom: 12rpx; color: #667085; font-size: 22rpx; font-weight: 600; }
.profile-hero { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; padding: 28rpx 24rpx; border-radius: 28rpx; background: linear-gradient(145deg,var(--color-brand) 0%,var(--color-brand-pressed) 100%); color: #fff; box-shadow: 0 18rpx 36rpx rgba(127,11,20,.16); }
.profile-hero__avatar { display: flex; flex: 0 0 88rpx; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border: 3rpx solid rgba(255,255,255,.35); border-radius: 50%; background: rgba(255,255,255,.16); font-size: 36rpx; font-weight: 700; }
.profile-hero__content { flex: 1; min-width: 0; }
.profile-hero__name { margin-bottom: 8rpx; font-size: 36rpx; font-weight: 700; }
.profile-hero__meta { margin-top: 4rpx; color: rgba(255,255,255,.72); font-size: 22rpx; }
.info-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; }
.info-card__head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10rpx; }
.info-card__icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #fceeef; color: var(--color-brand); font-size: 22rpx; font-weight: 700; }
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 20rpx; }
.summary-card { min-width: 0; padding: 22rpx; border: 1rpx solid #e7eaf0; border-radius: 22rpx; background: #fff; }
.summary-card--lesson { border-color: #f7cdd1; background: #fffafa; }
.summary-card--insurance { border-color: #b2ddff; background: #f5fbff; }
.summary-card__label { margin-bottom: 14rpx; color: #667085; font-size: 21rpx; font-weight: 650; }
.summary-card__row { margin-top: 10rpx; color: #667085; font-size: 20rpx; }
.summary-card__value { overflow: hidden; margin-top: 4rpx; color: #202124; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.read-only-note { margin-top: 18rpx; padding: 16rpx; border-radius: 14rpx; background: #f8f9fb; color: #667085; font-size: 22rpx; line-height: 1.5; }

.summary-card__more { margin-top: 16rpx; color: var(--color-brand); font-size: 24rpx; font-weight: 600; }
.field-value--link { color: var(--color-brand); font-weight: 600; }
