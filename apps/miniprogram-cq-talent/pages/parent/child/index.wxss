.p7 { min-height: 100vh; background: #f6f7f9; }
.p7-nav { display: flex; align-items: center; justify-content: center; box-sizing: content-box; height: 120rpx; padding: 28rpx 44rpx; background: #ffffff; }
.p7-nav__title { color: #202124; font-size: 40rpx; font-weight: 700; }
.p7-body { padding: 32rpx 32rpx calc(148rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; }
.p7-content { display: flex; flex-direction: column; gap: 32rpx; }

/* Figma P7 Parent Profile Hub */
.p7-player { display: flex; align-items: center; gap: 32rpx; padding: 40rpx; border-radius: 32rpx; background: #07111f; }
.p7-player__avatar { display: flex; flex: 0 0 128rpx; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 64rpx; background: #a80f1b; color: #ffffff; font-size: 48rpx; font-weight: 700; }
.p7-player__name { color: #ffffff; font-size: 40rpx; font-weight: 700; }.p7-player__team { margin-top: 8rpx; color: rgba(255,255,255,.5); font-size: 26rpx; }
.p7-stats { display: flex; padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05); }
.p7-stat { display: flex; flex: 1; flex-direction: column; align-items: center; min-width: 0; gap: 8rpx; }.p7-stat + .p7-stat { border-left: 1rpx solid #e7eaf0; }
.p7-stat__value { overflow: hidden; max-width: 100%; min-height: 58rpx; color: #202124; font-size: 48rpx; font-weight: 700; line-height: 58rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.p7-stat__value--brand { color: #a80f1b; }.p7-stat__label { overflow: hidden; max-width: 100%; color: #667085; font-size: 24rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.p7-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }.p7-action { display: flex; flex-direction: column; align-items: center; gap: 24rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; color: #202124; font-size: 28rpx; font-weight: 600; }.p7-action__icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 40rpx; background: #fceeef; color: #a80f1b; font-size: 28rpx; font-weight: 700; }
.p7-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05); }.p7-card__title { color: #202124; font-size: 32rpx; font-weight: 700; }.p7-activity { display: flex; align-items: center; gap: 24rpx; min-height: 68rpx; }.p7-activity__dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #a80f1b; }.p7-activity__dot--green { background: #059669; }.p7-activity__dot--blue { background: #2563eb; }.p7-activity__title { color: #202124; font-size: 28rpx; font-weight: 600; }.p7-activity__date { margin-top: 4rpx; color: #667085; font-size: 24rpx; }.p7-reminder { display: flex; align-items: center; justify-content: space-between; }.p7-reminder__icon { color: #a80f1b; font-size: 32rpx; }
/* custom navigation: keep Figma 88px total height inclusive of safe area */
.p7-nav { box-sizing: border-box; }
/* Figma Top Nav is 375x88 (176rpx): safe area is inside this envelope. */
.p7-nav { height: 176rpx; }
