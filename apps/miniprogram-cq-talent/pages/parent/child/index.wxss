.p7 { min-height: 100vh; background: #f6f7f9; }

/* P7 Top Nav */
.p7-nav { display: flex; align-items: center; justify-content: center; height: 176rpx; background: #ffffff; }
.p7-nav__title { color: #202124; font-size: 40rpx; font-weight: 700; }

.p7-body { padding: 32rpx 32rpx calc(148rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; }
.p7-content { display: flex; flex-direction: column; gap: 32rpx; }

/* P7 Player Card */
.pcard {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
}
.pcard__avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pcard__info { display: flex; flex-direction: column; gap: 8rpx; }
.pcard__name { color: #ffffff; font-size: 40rpx; font-weight: 700; }
.pcard__team { color: rgba(255, 255, 255, 0.5); font-size: 26rpx; }

/* P7 Stats Row */
.pstats {
  display: flex;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}
.pstats__item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.pstats__item + .pstats__item { border-left: 1rpx solid #e7eaf0; }
.pstats__value { color: #202124; font-size: 48rpx; font-weight: 700; }
.pstats__value--brand { color: #a80f1b; }
.pstats__label { color: #667085; font-size: 24rpx; }

/* P7 Quick Actions */
.pactions { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.pactions__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}
.pactions__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #fceeef;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pactions__label { color: #202124; font-size: 28rpx; font-weight: 600; }
