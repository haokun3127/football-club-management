<view class="page">
  <view class="card nav">
    <text bindtap="goSchedule">日程</text>
    <text bindtap="goGrowth">成长</text>
    <text class="tag">我的孩子</text>
  </view>
  <view class="card">
    <view class="title">{{student.name}}</view>
    <view class="subtitle">{{student.ageGroup}}｜{{student.teamsText}}</view>
    <view class="subtitle">主教练：{{student.coachesText}}</view>
  </view>
  <view class="card">
    <view class="section-title">课时与保险</view>
    <view class="row"><text>剩余课时</text><text class="tag">24</text></view>
    <view class="row"><text>保险状态</text><text class="tag">有效</text></view>
    <view class="subtitle">数据来自俱乐部线下确认记录。</view>
  </view>
  <view class="card">
    <view class="section-title">俱乐部服务</view>
    <view class="subtitle">俱乐部信息｜球场分布｜青训帮助｜教练团队｜私教意向</view>
  </view>
</view>
