<view class="p7">
  <view class="p7-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><view class="p7-nav__title">我的孩子</view></view>
  <view class="p7-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载孩子档案' : state === 'empty' ? '未绑定孩子' : '档案读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <view wx:if="{{studentHome}}" class="p7-content">
      <!-- Figma P7 Parent Profile Hub: Player Card -->
      <view class="p7-player" bindtap="openBinding"><view class="p7-player__avatar">{{avatarLetter}}</view><view><view class="p7-player__name">{{activeChild.name}}</view><view class="p7-player__team">{{teamLabel}}</view></view></view>
      <!-- Figma P7 Parent Profile Hub: Stats Row -->
      <view class="p7-stats" bindtap="openStatus"><view wx:for="{{heroStats}}" wx:key="label" class="p7-stat"><view class="p7-stat__value {{index === 1 ? 'p7-stat__value--brand' : ''}}">{{item.value}}</view><view class="p7-stat__label">{{item.label}}</view></view></view>
      <!-- Figma P7 Parent Profile Hub: Quick Actions -->
      <view class="p7-actions">
        <view class="p7-action" bindtap="openSchedule"><view class="p7-action__icon p7-action__icon--calendar"><view></view></view><view>训练日程</view></view>
        <view class="p7-action" bindtap="openGrowth"><view class="p7-action__icon p7-action__icon--chart"><view></view></view><view>成长报告</view></view>
        <view class="p7-action" bindtap="openRadar"><view class="p7-action__icon p7-action__icon--bolt"><view></view></view><view>体能数据</view></view>
        <view class="p7-action" bindtap="openCoach"><view class="p7-action__icon p7-action__icon--message"><view></view></view><view>联系教练</view></view>
      </view>
      <!-- Figma P7 Parent Profile Hub: Recent Activity -->
      <view class="p7-card p7-card--recent"><view class="p7-card__title">最近动态</view>
        <view wx:for="{{recentActivities}}" wx:key="title" class="p7-activity"><view class="p7-activity__dot {{index === 1 ? 'p7-activity__dot--green' : index === 2 ? 'p7-activity__dot--blue' : ''}}"></view><view><view class="p7-activity__title">{{item.title}}</view><view class="p7-activity__date">{{item.date}}</view></view></view>
      </view>
      <view class="p7-card p7-card--reminder"><view class="p7-card__title">本周提醒</view><view class="p7-reminder"><view><view class="p7-activity__title">{{reminderTitle}}</view><view class="p7-activity__date">{{reminderSub}}</view></view><image class="p7-reminder__icon" src="/assets/icons/bell-brand.svg" mode="aspectFit" /></view></view>
    </view>
  </view>
  <role-tabbar role="parent" active="child" />
</view>
