.article-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.article-page__body {
  padding: 32rpx 32rpx 64rpx;
}

.article-hero {
  background: var(--color-card);
  border-radius: 24rpx;
  border-top: 6rpx solid var(--color-brand);
  padding: 40rpx 32rpx;
}

.article-hero__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
}

.article-hero__subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.article-body {
  margin-top: 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.article-body__paragraph {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.article-body__paragraph:last-child {
  margin-bottom: 0;
}
