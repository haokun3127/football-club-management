.article-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.article-page__body {
  padding: 32rpx 32rpx 64rpx;
}

.page-nav { position: sticky; top: 0; z-index: 100; height: 88rpx; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav__back, .page-nav__more { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.page-nav__back image, .page-nav__more image { width: 48rpx; height: 48rpx; }
.page-nav__title { margin-left: 24rpx; flex: 1; font-size: 36rpx; font-weight: 700; color: var(--color-text); }
.page-nav__more { font-size: 28rpx; letter-spacing: 4rpx; }

.article-hero {
  background: var(--color-card);
  border-radius: 24rpx;
  border-top: 6rpx solid var(--color-brand);
  padding: 40rpx 32rpx;
}

.article-hero__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.4;
}

.article-hero__subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.article-body {
  margin-top: 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.article-body__paragraph {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.article-body__paragraph:last-child {
  margin-bottom: 0;
}
