<view class="milestones-page">
  <app-header title="成长足迹" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />

  <view class="milestones-page__body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载成长足迹' : state === 'empty' ? '暂无成长足迹' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view wx:for="{{milestones}}" wx:key="id" class="milestone-card milestone-card--{{item.tone}}">
        <view class="milestone-card__icon milestone-card__icon--{{item.tone}}">{{item.icon}}</view>
        <view class="milestone-card__content"><view class="milestone-card__title">{{item.title}}</view><view class="milestone-card__detail">{{item.detail}}</view><view class="milestone-card__meta">{{item.meta}}</view></view>
        <view wx:if="{{item.isAbilityUpdate}}" class="milestone-card__action" bindtap="openAbilityHistory">查看更新 ›</view>
        <view wx:elif="{{item.isEvaluation}}" class="milestone-card__action" data-team="{{item.teamId}}" bindtap="openEvaluation">查看变化 ›</view>
        <view wx:else class="milestone-card__state milestone-card__state--{{item.tone}}">{{item.state}}</view>
      </view>
    </block>
  </view>
</view>
