.milestones-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.milestones-page__body {
  padding: 32rpx 32rpx 64rpx;
}

.page-nav { position: sticky; top: 0; z-index: 100; height:44px; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav__back { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.page-nav__back image { width: 48rpx; height: 48rpx; }
.page-nav__title { flex: 1; margin-left: 8rpx; color: #202124; font-size: var(--font-size-display); font-weight: 700; }
.page-nav__spacer { width: 48rpx; height: 48rpx; }

.milestone-card { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; padding: 28rpx 32rpx; border-radius: 24rpx; background: #ffffff; }
.milestone-card__icon { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 50%; font-size: var(--font-size-body); }
.milestone-card__icon--green { background: #e8f8f0; color: #10b981; }
.milestone-card__icon--red { background: #fceeef; color: #a80f1b; }
.milestone-card__icon--blue { background: #e8f1fd; color: #1976d2; }
.milestone-card__content { flex: 1; min-width: 0; }
.milestone-card__title { overflow: hidden; font-size: var(--font-size-section); font-weight: 600; color: #202124; text-overflow: ellipsis; white-space: nowrap; }
.milestone-card__detail { margin-top: 6rpx; overflow: hidden; color: #475569; font-size: var(--font-size-aux); text-overflow: ellipsis; white-space: nowrap; }
.milestone-card__meta { margin-top: 6rpx; overflow: hidden; color:var(--color-text-secondary); font-size: var(--font-size-aux); text-overflow: ellipsis; white-space: nowrap; }
.milestone-card__state { flex: 0 0 auto; font-size: var(--font-size-aux); }
.milestone-card__state--green { color: #10b981; }
.milestone-card__state--red { color: #a80f1b; }
.milestone-card__state--blue { color: #1976d2; }
.milestone-card__action { flex: 0 0 auto; padding: 10rpx 0 10rpx 16rpx; color: #a80f1b; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.milestone-card__action,
.page-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
