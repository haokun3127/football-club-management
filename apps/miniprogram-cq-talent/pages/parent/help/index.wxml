<view class="help-page">
  <app-header title="帮助中心" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />
  <view class="help-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载帮助问题' : state === 'empty' ? '暂无帮助问题' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="loadFaqs"
    />
    <block wx:if="{{state === 'ready'}}">
      <view class="help-search"><image class="help-search__icon" src="/assets/icons/search.svg" mode="aspectFit" /><t-input class="help-search__input" placeholder="搜索常见问题" value="{{searchKeyword}}" bindchange="onSearchInput"  borderless t-class="help-search__input" /></view>

      <view class="section-title">帮助分类</view>
      <view class="category-grid">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="category-card {{activeCategory === item.value ? 'category-card--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectCategory"
        >
          <view class="category-card__icon" style="background: {{item.color}}"><image src="{{item.icon}}" mode="aspectFit" /></view>
          <view class="category-card__label">{{item.label}}</view>
        </view>
      </view>

      <view class="card">
        <view class="card__title">热门问题</view>
        <view wx:if="{{hasVisibleQuestions}}">
          <view wx:for="{{visibleQuestions}}" wx:key="id" class="question-row {{item.showDivider ? 'question-row--border' : ''}}">
            <view class="question-row__head" data-id="{{item.id}}" bindtap="toggleQuestion">
              <image class="question-row__icon" src="/assets/icons/p82-help-circle.svg" mode="aspectFit" />
              <view class="question-row__q">{{item.q}}</view>
              <image class="question-row__chevron {{item.open ? 'question-row__chevron--open' : ''}}" src="/assets/icons/p82-chevron-right.svg" mode="aspectFit" />
            </view>
            <view wx:if="{{item.open}}" class="question-row__a">{{item.a}}</view>
          </view>
        </view>
        <view wx:else class="question-empty">{{emptyMessage}}</view>
      </view>
    </block>
  </view>
  <role-tabbar role="parent" active="discover" />
</view>
