.help-page {
  min-height: 100vh;
  background: var(--color-page);
}

.help-page__body {
  padding: 32rpx 32rpx 180rpx;
}

.page-nav { height: 88rpx; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav__back, .page-nav__more { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.page-nav__back image, .page-nav__more image { width: 48rpx; height: 48rpx; }
.page-nav__title { margin-left: 24rpx; flex: 1; font-size: 36rpx; font-weight: 700; color: var(--color-text); }
.page-nav__more { font-size: 28rpx; letter-spacing: 4rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 48rpx 0 24rpx;
}

/* 搜索框 */
.help-search { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; padding: 0 28rpx; height: 88rpx; background: var(--color-card); border: 1rpx solid var(--color-line); border-radius: 44rpx; }
.help-search__icon { width: 36rpx; height: 36rpx; opacity: 0.5; }
.help-search__input { flex: 1; font-size: 28rpx; color: var(--color-text); }

/* 分类网格 */
.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  text-align: center;
}

.category-card__icon { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 20rpx; }
.category-card__icon image { width: 40rpx; height: 40rpx; }
.category-card__label { flex-shrink: 0; }

.category-card--active {
  border-color: var(--color-brand);
}

/* 卡片 */
.card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

/* 热门问题行 */
.question-row {
  padding: 16rpx 0;
}

.question-row--border {
  border-bottom: 1rpx solid var(--color-line);
}

.question-row__head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0;
}

.question-row__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--color-brand-soft, #fceeef);
  flex-shrink: 0;
}

.question-row__icon image { width: 28rpx; height: 28rpx; }

.question-row__q {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.question-row__chevron {
  font-size: 36rpx;
  color: var(--color-text-secondary);
  transition: transform 0.18s ease;
}

.question-row__chevron--open {
  transform: rotate(90deg);
}

.question-row__a {
  padding: 8rpx 0 16rpx 56rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.question-empty {
  padding: 32rpx 0 8rpx;
  font-size: 26rpx;
  text-align: center;
  color: var(--color-text-secondary);
}
