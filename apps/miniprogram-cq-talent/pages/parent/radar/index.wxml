<view class="radar-page"><app-header title="能力雷达" show-back /><view class="radar-page__body"><student-switcher students="{{children}}" selected-id="{{activeStudentId}}" show-all="{{false}}" bindchange="switchChild" /><status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="能力雷达" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" /><block wx:if="{{state === 'ready'}}"><view wx:if="{{compositeScore !== ''}}" class="score-line"><view><view class="score-label">综合评估</view><view class="score-date">{{updatedAtLabel}}</view></view><view class="score-value">{{compositeScore}}</view></view><radar-comparison class="radar-comparison-widget" role="parent" student-id="{{activeStudentId}}" fallback-metrics="{{radar}}" bindmetrictap="openMetric" /></block></view><role-tabbar role="parent" active="growth" /></view>
