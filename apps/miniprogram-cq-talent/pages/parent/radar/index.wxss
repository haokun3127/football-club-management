.radar-page {min-height:100vh;background:var(--color-page);padding-bottom:calc(80px + env(safe-area-inset-bottom));}.radar-page__body {padding:16px;background:var(--color-card);}.score-line {display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 0;border-bottom:1px solid var(--color-line);margin-bottom:20px;}.score-label {font-size:16px;line-height:1.5;}.score-date {font-size:14px;color:var(--color-text-secondary);line-height:1.5;margin-top:4px;}.score-value {font-size:28px;font-weight:600;color:var(--color-text);}
