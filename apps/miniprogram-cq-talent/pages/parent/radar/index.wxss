.p5 { min-height: 100vh; background: #f6f7f9; }

/* P5 Header */
.p5-nav { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; gap: 0; box-sizing: content-box; height: 88rpx; padding: 0 200rpx 0 32rpx; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }
.p5-nav__back { display: flex; width: 48rpx; height: 80rpx; align-items: center; justify-content: center; border-radius: 40rpx; background: #ffffff; }
.p5-nav__back image { width: 40rpx; height: 40rpx; }
.p5-nav__title { flex: 1; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; }
/* P5 Player Selector */
.p5-players { width: 100%; white-space: nowrap; background: #f6f7f9; }
.p5-players__inner { display: inline-flex; gap: 24rpx; padding: 24rpx 32rpx; }
.p5-chip { padding: 12rpx 24rpx; border-radius: 40rpx; background: #e7eaf0; color: #667085; font-size: 26rpx; font-weight: 500; line-height: 16px; }
.p5-chip--active { background: #a80f1b; color: #ffffff; font-weight: 600; }

.p5-body { padding: 32rpx 32rpx calc(200rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; }
.p5-content { display: flex; flex-direction: column; gap: 32rpx; }

/* P5 Radar Hero */
.rhero { display: flex; flex-direction: column; gap: 40rpx; padding: 40rpx 40rpx 64rpx; border-radius: 32rpx; background: #07111f; }
.rhero__head { display: flex; align-items: center; justify-content: space-between; }
.rhero__title { color: #ffffff; font-size: 32rpx; font-weight: 700; }
.rhero__date { color: rgba(255, 255, 255, 0.6); font-size: 24rpx; }
.rhero__canvas { border-radius: 32rpx; background: #1f1f24; height: 560rpx; overflow: hidden; }
.rhero__placeholder { width: 100%; height: 560rpx; }
.rhero__score { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.rhero__score-label { color: rgba(255,255,255,.6); font-size: 28rpx; font-weight: 600; line-height: 32rpx; }
.rhero__score-value { color: #ffffff; font-size: 96rpx; font-weight: 800; line-height: 96rpx; }

/* P5 Dimension Breakdown */
.dim-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; }
.dim-card__title { color: #202124; font-size: 28rpx; font-weight: 700; }
.dim-row { display: flex; align-items: center; gap: 24rpx; }
.dim-row__label { width: 120rpx; color: #667085; font-size: 28rpx; flex-shrink: 0; white-space: nowrap; }
.dim-row__bar { position: relative; flex: 1; height: 8rpx; border-radius: 4rpx; background: #e7eaf0; }
.dim-row__fill { height: 100%; border-radius: 4rpx; background: #a80f1b; }
.dim-row__value { width: 48rpx; text-align: right; color: #a80f1b; font-size: 28rpx; font-weight: 700; }
.dim-card__hint { color: #a80f1b; font-size: 24rpx; text-align: center; }
