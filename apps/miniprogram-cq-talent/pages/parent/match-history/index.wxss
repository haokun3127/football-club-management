.match-history-page { min-height: 100vh; background: var(--color-bg); }
.match-history-page__body { padding: 32rpx 32rpx 64rpx; }
.match-history-card { box-sizing: border-box; display: flex; align-items: center; gap: 24rpx; width: 686rpx; min-height: 128rpx; margin-bottom: 24rpx; padding: 20rpx 24rpx 20rpx 32rpx; border-radius: 24rpx; background: #ffffff; }
.match-history-card__bar { flex: 0 0 auto; width: 8rpx; min-height: 72rpx; border-radius: 4rpx; background: #d1d5dd; }
.match-history-card__bar--done { background: #a80f1b; }
.match-history-card__main { min-width: 0; flex: 1; }
.match-history-card__title { overflow: hidden; color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.match-history-card__meta { margin-top: 6rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.match-history-card__context { overflow: hidden; margin-top: 4rpx; color:var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.match-history-card__result { flex: 0 0 156rpx; align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; }
.match-history-card__score { color: #202124; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; white-space: nowrap; }
.match-history-card__status { margin-top: 6rpx;  font-size: var(--font-size-aux); line-height: 1.5;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.match-history-card__status--done {  font-weight: 600;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.match-history-card,
.page-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
