.match-history-page { min-height: 100vh; background: var(--color-bg); }
.match-history-page__body { padding: 32rpx 32rpx 64rpx; }
.page-nav { height: 88rpx; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav__back { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.page-nav__back image { width: 48rpx; height: 48rpx; }
.page-nav__title { flex: 1; margin-left: 24rpx; color: #202124; font-size: 36rpx; font-weight: 700; }
.page-nav__spacer { width: 48rpx; height: 48rpx; }
.match-history-card { box-sizing: border-box; display: flex; align-items: center; gap: 24rpx; width: 686rpx; min-height: 128rpx; margin-bottom: 24rpx; padding: 20rpx 24rpx 20rpx 32rpx; border-radius: 24rpx; background: #ffffff; }
.match-history-card__bar { flex: 0 0 auto; width: 8rpx; min-height: 72rpx; border-radius: 4rpx; background: #d1d5dd; }
.match-history-card__bar--done { background: #a80f1b; }
.match-history-card__main { min-width: 0; flex: 1; }
.match-history-card__title { overflow: hidden; color: #202124; font-size: 30rpx; font-weight: 700; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.match-history-card__meta { margin-top: 6rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; }
.match-history-card__context { overflow: hidden; margin-top: 4rpx; color: #98a2b3; font-size: 22rpx; line-height: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.match-history-card__result { flex: 0 0 156rpx; align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; }
.match-history-card__score { color: #202124; font-size: 26rpx; font-weight: 700; line-height: 32rpx; white-space: nowrap; }
.match-history-card__status { margin-top: 6rpx; color: #98a2b3; font-size: 22rpx; line-height: 28rpx; }
.match-history-card__status--done { color: #10b981; font-weight: 600; }
