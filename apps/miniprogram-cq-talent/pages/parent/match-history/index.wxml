<view class="match-history-page">
  <view class="page-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="page-nav__back" bindtap="goBack" aria-label="返回"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
    <view class="page-nav__title">比赛记录</view>
    <view class="page-nav__spacer"></view>
  </view>

  <view class="match-history-page__body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载比赛记录' : state === 'empty' ? '暂无比赛记录' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view wx:for="{{rows}}" wx:key="id" class="match-history-card" data-id="{{item.id}}" bindtap="openMatch">
        <view class="match-history-card__bar {{item.done ? 'match-history-card__bar--done' : ''}}"></view>
        <view class="match-history-card__main">
          <view class="match-history-card__title">{{item.title}}</view>
          <view class="match-history-card__meta">{{item.dateLabel}} · {{item.timeLabel}}</view>
          <view wx:if="{{item.contextLabel || item.opponentLabel}}" class="match-history-card__context">{{item.contextLabel}}<text wx:if="{{item.contextLabel && item.opponentLabel}}"> · </text>{{item.opponentLabel}}</view>
        </view>
        <view class="match-history-card__result">
          <view class="match-history-card__score">{{item.scoreLabel}}</view>
          <view class="match-history-card__status {{item.done ? 'match-history-card__status--done' : ''}}">{{item.statusLabel}}</view>
        </view>
      </view>
    </block>
  </view>
</view>
