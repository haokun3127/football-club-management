.p11 { min-height: 100vh; background: #f6f7f9; }.p11-body { padding: 32rpx 32rpx calc(148rpx + env(safe-area-inset-bottom)); }.p11-list { display: flex; flex-direction: column; gap: 24rpx; }.p11-card { display: flex; overflow: hidden; min-height: 176rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05); }.p11-card__bar { width: 8rpx; flex-shrink: 0; }.p11-card__main { flex: 1; padding: 28rpx; }.p11-card__head { display: flex; gap: 16rpx; align-items: center; justify-content: space-between; }.p11-card__title { color: #202124; font-size: 30rpx; font-weight: 700; }.p11-card__status { padding: 6rpx 14rpx; border-radius: 8rpx; font-size: 20rpx; font-weight: 600; }.p11-card__meta,.p11-card__coach { margin-top: 10rpx; color: #667085; font-size: 24rpx; }.p11-card__arrow { display: flex; align-items: center; padding: 0 24rpx 0 0; color: #667085; font-size: 40rpx; }