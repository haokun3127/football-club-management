<view class="day-page">
  <app-header title="{{dateLabel}}" subtitle="当日活动" show-back />
  <view class="day-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载当日活动' : state === 'empty' ? '暂无活动' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <view wx:if="{{state === 'ready'}}" class="activity-list">
      <view
        wx:for="{{events}}"
        wx:key="id"
        class="activity-card"
        data-id="{{item.id}}"
        bindtap="openEvent"
      >
        <view class="activity-card__bar" style="background: {{item.barColor}}"></view>
        <view class="activity-card__content">
          <view class="activity-card__head">
            <view class="activity-card__title">{{item.title}}</view>
            <view class="activity-card__status" style="background: {{item.statusBg}}; color: {{item.statusColor}}">{{item.statusLabel}}</view>
          </view>
          <view class="activity-card__time">{{item.timeLabel}}</view>
          <view wx:if="{{item.placeLabel}}" class="activity-card__place">📍 {{item.placeLabel}}</view>
        </view>
      </view>
    </view>
  </view>
  <role-tabbar role="parent" active="schedule" />
</view>
