<view class="p11">
  <app-header title="{{dateLabel}}" subtitle="当日活动" show-back action-text="筛选" bindaction="openFilter" />
  <view class="p11-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载当日活动' : state === 'empty' ? '暂无活动' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <view wx:if="{{state === 'ready'}}" class="p11-list">
      <view wx:for="{{events}}" wx:key="id" class="p11-card" data-id="{{item.id}}" bindtap="openEvent">
        <view class="p11-card__bar" style="background: {{item.barColor}}"></view>
        <view class="p11-card__main"><view class="p11-card__head"><view class="p11-card__title">{{item.title}}</view><view class="p11-card__status" style="background: {{item.statusBg}}; color: {{item.statusColor}}">{{item.statusLabel}}</view></view><view class="p11-card__meta">{{item.timeLabel}}</view><view class="p11-card__meta">{{item.placeLabel}}</view><view class="p11-card__coach">教练：{{item.coachLabel}}</view></view>
        <view class="p11-card__arrow">›</view>
      </view>
    </view>
  </view>
  <role-tabbar role="parent" active="schedule" />
</view>
