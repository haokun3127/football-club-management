<view class="p4">
  <view class="p4-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="p4-nav__title">成长</view>
    <view class="p4-nav__settings" bindtap="openSettings"><image class="p4-nav__settings-icon" src="/assets/icons/settings-gear.svg" mode="aspectFit" /></view>
  </view>

  <view class="p4-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载成长数据' : state === 'empty' ? '成长数据不足' : '成长数据读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <view wx:if="{{growth && state === 'ready'}}" class="p4-content">
      <!-- Figma P4 Player Hero: 335 x 212 -->
      <view class="p4-hero">
        <view class="p4-hero__header">
          <view class="p4-hero__avatar">{{heroSurname}}</view>
          <view class="p4-hero__identity"><view class="p4-hero__name">{{heroName}}</view><view class="p4-hero__team">{{heroTeam}}</view></view>
        </view>
        <view wx:if="{{heroTags.length}}" class="p4-hero__tags"><view wx:for="{{heroTags}}" wx:key="*this" class="p4-hero__tag {{index === 1 ? 'p4-hero__tag--accent' : ''}}">{{item}}</view></view>
        <view wx:if="{{heroStats.length}}" class="p4-hero__stats"><view wx:for="{{heroStats}}" wx:key="label" class="p4-hero__stat"><view class="p4-hero__stat-value {{item.accent ? 'p4-hero__stat-value--accent' : ''}}">{{item.value}}</view><view class="p4-hero__stat-label">{{item.label}}</view></view></view>
        <view wx:if="{{!heroStats.length}}" class="p4-hero__pending">{{heroSummaryMessage}}</view>
      </view>

      <!-- Figma P4 Milestones Card -->
      <view class="p4-card p4-milestones">
        <view class="p4-card__head"><view class="p4-card__title">成长足迹 🏆</view><view class="p4-card__link">更多›</view></view>
        <view class="p4-milestones__list">
          <view wx:for="{{milestones}}" wx:key="id" class="p4-milestone">
            <view class="p4-milestone__dot p4-milestone__dot--{{item.tone}}">{{item.icon}}</view>
            <view class="p4-milestone__title">{{item.title}}</view>
            <view class="p4-milestone__state p4-milestone__state--{{item.tone}}">{{item.state}}</view>
          </view>
        </view>
      </view>

      <!-- Figma P4 Training Chart Card -->
      <view class="p4-card p4-chart-card">
        <view class="p4-card__head"><view class="p4-card__title">训练历程 📊</view><view class="p4-card__link" bindtap="openTrainingHistory">查看›</view></view>
        <view class="p4-bars">
          <view wx:for="{{trainingBars}}" wx:key="id" class="p4-bar" style="height: {{item.height}}rpx"></view>
        </view>
        <view class="p4-months"><view wx:for="{{trainingBars}}" wx:key="id">{{item.label}}</view></view>
      </view>

      <!-- Figma P4 Ability Radar Card: dark surface -->
      <view class="p4-radar" bindtap="openRadar">
        <view class="p4-card__head"><view><view class="p4-radar__title">能力雷达</view><view class="p4-radar__sub">{{radar.length}}维度综合评估</view></view><view class="p4-radar__action">进入详情 ›</view></view>
        <view class="p4-radar-preview" wx:if="{{canDrawRadar && radarPreview}}">
          <view wx:for="{{radarPreview.gridLayers}}" wx:key="index" class="p4-radar-preview__grid p4-radar-preview__grid--{{item.kind}}" style="width: {{item.size}}rpx; height: {{item.size}}rpx; clip-path: {{radarPreview.ringPath}}"></view>
          <view wx:for="{{radarPreview.spokes}}" wx:key="*this" class="p4-radar-preview__spoke" style="transform: translate(-50%,-50%) rotate({{item}}deg)"></view>
          <block wx:if="{{radarPreview.peerPath}}">
            <view class="p4-radar-preview__peerline" style="clip-path: {{radarPreview.peerPath}}"></view>
            <view class="p4-radar-preview__peerfill" style="clip-path: {{radarPreview.peerPathInner}}"></view>
          </block>
          <view class="p4-radar-preview__shapeline" style="clip-path: {{radarPreview.valuePath}}"></view>
          <view class="p4-radar-preview__shapefill" style="clip-path: {{radarPreview.valuePathInner}}"></view>
          <view wx:for="{{radarPreview.labels}}" wx:key="text" class="p4-radar-preview__label" style="left: {{item.x}}%; top: {{item.y}}%">{{item.text}}</view>
          <view class="p4-radar-preview__dot"></view>
        </view>
        <view wx:else class="p4-radar__empty">指标正在积累</view>
      </view>
    </view>
  </view>
  <role-tabbar role="parent" active="growth" />
</view>
