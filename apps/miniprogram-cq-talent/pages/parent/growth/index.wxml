<view class="p4">
  <view class="p4-nav" style="padding-top:{{navInset}}px">
    <view class="p4-nav__title">成长</view>
    <view class="p4-nav__settings" bindtap="openSettings"><view class="p4-nav__settings-core"></view></view>
  </view>

  <view class="p4-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载成长数据' : state === 'empty' ? '成长数据不足' : '成长数据读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <view wx:if="{{growth}}" class="p4-content">
      <!-- Figma P4 Player Hero: 335 x 212 -->
      <view class="p4-hero">
        <view class="p4-hero__header">
          <view class="p4-hero__avatar">{{heroSurname}}</view>
          <view class="p4-hero__identity"><view class="p4-hero__name">{{heroName}}</view><view class="p4-hero__team">{{heroTeam}}</view></view>
        </view>
        <view class="p4-hero__chips">
          <view wx:for="{{heroChips}}" wx:key="label" class="p4-hero__chip {{index === 1 ? 'p4-hero__chip--brand' : ''}}">{{item.label}} {{item.value}}</view>
        </view>
        <view class="p4-hero__stats">
          <view wx:for="{{heroStats}}" wx:key="label" class="p4-stat">
            <view class="p4-stat__value {{index === 1 ? 'p4-stat__value--green' : ''}}">{{item.value}}</view>
            <view class="p4-stat__label">{{item.label}}</view>
          </view>
        </view>
      </view>

      <!-- Figma P4 Milestones Card -->
      <view class="p4-card p4-milestones">
        <view class="p4-card__head"><view class="p4-card__title">成长足迹 🏆</view><view class="p4-card__link" bindtap="openMilestones">更多›</view></view>
        <view wx:for="{{growth.milestones}}" wx:key="title" class="p4-milestone">
          <view class="p4-milestone__dot {{index === 1 ? 'p4-milestone__dot--red' : index === 2 ? 'p4-milestone__dot--blue' : ''}}">{{index === 0 ? '✓' : '○'}}</view>
          <view class="p4-milestone__title">{{item.title}}</view>
          <view class="p4-milestone__state {{index === 0 ? 'p4-milestone__state--done' : ''}}">{{index === 0 ? '已达成' : '待达成'}}</view>
        </view>
      </view>

      <!-- Figma P4 Training Chart Card -->
      <view class="p4-card p4-chart-card">
        <view class="p4-card__head"><view class="p4-card__title">训练历程 📊</view><view class="p4-card__link">查看›</view></view>
        <view class="p4-bars"><view class="p4-bar p4-bar--1"></view><view class="p4-bar p4-bar--2"></view><view class="p4-bar p4-bar--1"></view><view class="p4-bar p4-bar--3"></view><view class="p4-bar p4-bar--2"></view><view class="p4-bar p4-bar--4"></view><view class="p4-bar p4-bar--3"></view><view class="p4-bar p4-bar--4"></view></view>
        <view class="p4-months"><view>1月</view><view>2月</view><view>3月</view><view>4月</view><view>5月</view><view>6月</view><view>7月</view><view>8月</view></view>
      </view>

      <!-- Figma P4 Ability Radar Card: dark surface -->
      <view class="p4-radar" bindtap="openRadar">
        <view class="p4-card__head"><view><view class="p4-radar__title">能力雷达</view><view class="p4-radar__sub">6维度综合评估</view></view><view class="p4-radar__action">进入详情 ›</view></view>
        <view class="p4-radar-preview" wx:if="{{canDrawRadar}}">
          <view class="p4-radar-preview__grid"></view>
          <view class="p4-radar-preview__shape"></view>
          <view class="p4-radar-preview__dot"></view>
        </view>
        <view wx:else class="p4-radar__empty">指标正在积累</view>
      </view>
    </view>
  </view>
  <role-tabbar role="parent" active="growth" />
</view>
