<view class="p4">
  <app-header title="成长" title-align="left" action-text="孩子" bindaction="openSettings" />

  <view class="p4-body">
    <student-switcher wx:if="{{state === 'ready' && children.length > 1}}" students="{{children}}" selected-id="{{activeStudentId}}" show-all="{{false}}" bindchange="switchChild" />
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载成长数据' : state === 'empty' ? '成长数据不足' : '成长数据读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <view wx:if="{{refreshing}}" class="p4-card__summary">正在更新成长记录…</view>
    <view wx:if="{{refreshMessage}}" class="p4-card"><view class="p4-card__summary">{{refreshMessage}}</view><t-button bindtap="retry" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">重试成长记录</t-button></view>
    <!-- V-02 P08 213:526：白底概览（训练累计）→ 能力组合区 → 当前评价 -->
    <view wx:if="{{activeStudentId && state === 'ready'}}" class="p4-content">
      <view class="p4-overview">
        <view class="p4-overview__head">
          <view class="p4-overview__name">{{heroName}}的成长</view>
          <view class="p4-overview__avatar">{{heroSurname}}</view>
        </view>
        <view class="p4-overview__team">{{heroTeam}}</view>
        <view wx:if="{{heroStats.length}}" class="p4-overview__stats">
          <view wx:for="{{heroStats}}" wx:key="label" class="p4-overview__stat"><view class="p4-overview__stat-value">{{item.value}}</view><view class="p4-overview__stat-label">{{item.label}}</view></view>
        </view>
        <view class="p4-overview__summary">{{heroSummaryMessage}}</view><view class="p4-card__summary">{{updatedAtLabel ? '汇总更新时间：' + updatedAtLabel : '成长汇总待读取'}}。已确认原始成绩、队伍评价与课堂表现分别记录；训练计次不代表实际到场。</view>
      </view>


    </view>

    <view wx:if="{{activeStudentId && (state === 'ready' || state === 'empty')}}" class="p4-evaluations"><view class="p4-evaluation-card" bindtap="openConfirmedResults"><view class="p4-evaluation-title">已确认测评结果</view><view class="p4-evaluation-author">查看原始成绩、分值、等级与历史 ›</view></view>
      <view wx:if="{{resultsState === 'loading'}}" class="p4-card__summary">{{resultsLoaded ? '正在更新已确认成绩…' : '正在读取已确认成绩…'}}</view>
      <view wx:if="{{resultsMessage}}" class="p4-evaluation-card"><view class="p4-card__summary">{{resultsMessage}}</view><t-button bindtap="retryResults" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">重试成绩</t-button></view>
      <view wx:for="{{confirmedRows}}" wx:key="id" class="p4-evaluation-card"><view class="p4-evaluation-title">{{item.name}} · 原始成绩 {{item.value}}</view><view class="p4-evaluation-text">{{item.mapping}}</view><view class="p4-evaluation-author">{{item.source}} · {{item.date}}</view><view class="p4-evaluation-author">{{item.version}}</view><view wx:if="{{item.eventId}}" class="p4-card__link" data-id="{{item.id}}" bindtap="openResultSource">查看来源活动 ›</view></view>
      <view wx:if="{{resultsLoaded && !confirmedRows.length}}" class="p4-card__summary">暂无已确认原始成绩。未确认结果不会显示为零分。</view>
      <view class="p4-card__summary">仅比较同一项目、项目版本及单位的历史。课堂表现与队伍评价不作为标准测评分数。</view>
      <view wx:for="{{evaluationCards}}" wx:key="teamId" class="p4-evaluation-card" data-team="{{item.teamId}}" bindtap="openEvaluation"><view class="p4-evaluation-title">当前教练评价 · {{item.teamName}}</view><view class="p4-evaluation-text">{{item.text}}</view><view class="p4-evaluation-author">{{item.author}} · 查看变化 ›</view></view>
      <view wx:if="{{evaluationMessage}}" class="p4-evaluation-card" bindtap="openEvaluation"><view class="p4-evaluation-title">当前教练评价</view><view class="p4-evaluation-text">{{evaluationMessage}}</view><view class="p4-evaluation-author">查看当前评价与变化 ›</view></view>
    </view>

    <view wx:if="{{growth && state === 'ready'}}" class="p4-content">
      <view class="p4-card p4-ability">
        <view class="p4-card__head"><view class="p4-card__title">能力组合概览</view><view class="p4-card__link" bindtap="openRadar">进入详情 ›</view></view>
        <view class="p4-card__summary">模型数值用于辅助概览，不等同于原始成绩或队伍评价；缺失项不补零，未提供标准时不判断达标。</view>
        <radar-canvas wx:if="{{radar.length >= 3 && radar.length <= 8}}" metrics="{{radar}}" height="300px" />
        <view wx:else class="p4-card__empty">{{radar.length > 8 ? '当前组指标较多，请进入详情选择雷达指标' : '少于3项指标，请进入详情查看数值'}} </view>
        <view class="p4-metric-list"><view wx:for="{{radarRows}}" wx:key="id" class="p4-metric-row" data-id="{{item.id}}" bindtap="openMetricRow"><view>{{item.label}} · {{item.value}}</view><view class="p4-card__summary">{{item.date}} ›</view></view></view>
        <view class="p4-ability__foot">点击能力查看明细 · 更新于 {{updatedAtLabel}}</view>
      </view>
      <!-- Figma P4 Milestones Card -->
      <view class="p4-card p4-milestones">
        <view class="p4-card__head"><view class="p4-card__title">成长足迹 🏆</view><view class="p4-card__link" bindtap="openMilestones">查看全部 ›</view></view>
        <view class="p4-milestones__list">
          <view wx:for="{{milestones}}" wx:key="id" class="p4-milestone">
            <view class="p4-milestone__dot p4-milestone__dot--{{item.tone}}">{{item.icon}}</view>
            <view class="p4-milestone__title">{{item.title}}</view>
            <view class="p4-milestone__state p4-milestone__state--{{item.tone}}">{{item.state}}</view>
          </view>
        </view>
      </view>

      <view class="p4-card p4-match-history">
        <view class="p4-card__head"><view class="p4-card__title">比赛记录 ⚽</view><view class="p4-card__link" bindtap="openMatchHistory">查看›</view></view>
        <view class="p4-card__summary">{{matchHistoryMessage}}</view>
      </view>

      <!-- Figma P4 Training Chart Card -->
      <view class="p4-card p4-chart-card">
        <view class="p4-card__head"><view class="p4-card__title">训练历程 📊</view><view class="p4-card__link" bindtap="openTrainingHistory">查看›</view></view>
        <view wx:if="{{trainingBars.length}}" class="p4-bars">
          <view wx:for="{{trainingBars}}" wx:key="id" class="p4-bar" style="height: {{item.height}}rpx"></view>
        </view>
        <view class="p4-months"><view wx:for="{{trainingBars}}" wx:key="id">{{item.label}}<view>{{item.count}} 次</view></view></view><view wx:if="{{!trainingBars.length}}" class="p4-card__summary">尚无按月统计，可进入训练记录查看计次事实。</view>
      </view>
    </view>
  </view>
  <role-tabbar role="parent" active="growth" />
</view>
