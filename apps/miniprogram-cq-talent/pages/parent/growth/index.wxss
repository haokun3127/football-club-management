.p4 { min-height: 100vh; background: #f5f6f8; }

/* P4 Top Nav */
.p4-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 176rpx;
  padding: 28rpx 40rpx;
  background: #ffffff;
}
.p4-nav__title { color: #202124; font-size: 44rpx; font-weight: 700; }
.p4-nav__settings {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #667085;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.p4-body { padding: 32rpx 40rpx calc(148rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; }
.p4-content { display: flex; flex-direction: column; gap: 32rpx; }

/* P4 Player Hero */
.phero {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
}
.phero__header { display: flex; align-items: center; gap: 24rpx; }
.phero__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.phero__info { display: flex; flex-direction: column; gap: 8rpx; }
.phero__name { color: #ffffff; font-size: 36rpx; font-weight: 700; }
.phero__team { color: #ffffff; font-size: 26rpx; }
.phero__chips { display: flex; gap: 16rpx; flex-wrap: wrap; }
.phero__chip { padding: 8rpx 16rpx; border-radius: 8rpx; background: #334155; color: #ffffff; font-size: 20rpx; font-weight: 600; }
.phero__chip--brand { background: #a80f1b; }
.phero__stats { display: flex; border-top: 1rpx solid #334155; padding-top: 32rpx; }
.phero__stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.phero__stat + .phero__stat { border-left: 1rpx solid #334155; }
.phero__stat-value { color: #ffffff; font-size: 64rpx; font-weight: 800; line-height: 1; }
.phero__stat-value--green { color: #22c55e; }
.phero__stat-label { color: #ffffff; font-size: 22rpx; }

/* P4 成长足迹 */
.mcard {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.mcard__head { display: flex; align-items: center; justify-content: space-between; }
.mcard__title { color: #202124; font-size: 28rpx; font-weight: 700; }
.mcard__more { color: #a80f1b; font-size: 26rpx; font-weight: 600; }
.mcard__row { display: flex; gap: 24rpx; align-items: flex-start; }
.mcard__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #ecfdf5;
  color: #059669;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mcard__row-title { color: #202124; font-size: 26rpx; font-weight: 600; }
.mcard__row-desc { color: #667085; font-size: 24rpx; margin-top: 4rpx; }

/* 保留：雷达/指标区域沿用 app.wxss 共享类 */
.radar-card { padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); }
.radar-card__updated { color: #8a8f99; font-size: 22rpx; margin-top: 6rpx; }
.radar-card__hint { margin-top: 12rpx; color: #8a8f99; font-size: 22rpx; text-align: center; }
.view-picker { padding: 10rpx 18rpx; border-radius: 999rpx; background: #fceeef; color: var(--color-brand); font-size: 23rpx; font-weight: 600; }
.metric-scroll { width: 100%; white-space: nowrap; }
.metric-chips { display: inline-flex; gap: 12rpx; }
.metric-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e7eaf0;
  color: #60646f;
  font-size: 24rpx;
}
.metric-chip.active { border-color: var(--color-brand); background: #fceeef; color: var(--color-brand); font-weight: 700; }
.metric-chip__dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }
.metric-summary { padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); display: flex; flex-direction: column; gap: 16rpx; }
.metric-summary__eyebrow { color: #8a8f99; font-size: 20rpx; letter-spacing: 2rpx; }
.metric-value { color: var(--color-brand); font-size: 56rpx; font-weight: 800; }
.info-card { padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); display: flex; flex-direction: column; gap: 16rpx; }
.radar-placeholder { padding: 48rpx 24rpx; text-align: center; }
.radar-placeholder__title { color: #202124; font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }

/* 恢复自重写前样式（pre-b13） */
.trend-text { color: var(--color-success); font-weight: 600; }
.inline-error { margin-top: 16rpx; padding: 16rpx; border-radius: 14rpx; background: #fff1f0; color: #b42318; font-size: 22rpx; }

/* 修复：统计值/芯片防溢出（截图重叠问题） */
.pstats__cell { min-width: 0; }
.pstats__value { max-width: 100%; overflow: hidden; font-size: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.pstats__label { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.p4-hero__chip { max-width: 320rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
