<view class="page">
  <view class="card hero-card">
    <view class="row">
      <view>
        <view class="title">家庭日程</view>
        <view class="subtitle">训练、比赛和俱乐部活动</view>
      </view>
      <view class="tag">提醒待接入</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">查看范围</view>
    <picker mode="selector" range="{{childOptions}}" range-key="name" value="{{childIndex}}" bindchange="onChildChange">
      <view class="child-picker">{{activeStudentName}} <text class="picker-hint">点击切换</text></view>
    </picker>
  </view>

  <view class="card">
    <view class="row">
      <view>
        <view class="section-title">{{selectedDate}}</view>
        <view class="subtitle">{{activeStudentName}}｜当天 {{visibleEvents.length}} 项安排</view>
      </view>
      <view class="tag muted">只读</view>
    </view>
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="date-picker">切换日期：{{selectedDate}}</view>
    </picker>
    <scroll-view scroll-x class="date-strip" enhanced show-scrollbar="{{false}}">
      <view class="date-strip-inner">
        <view wx:for="{{dateOptions}}" wx:key="date" class="date-chip {{selectedDate === item.date ? 'active' : ''}}" data-date="{{item.date}}" bindtap="selectDate">
          <view>{{item.day}}</view>
          <view class="date-count">{{item.count ? item.count + '项' : '无安排'}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="type-tabs">
      <view
        wx:for="{{typeTabs}}"
        wx:key="value"
        class="type-tab {{selectedType === item.value ? 'active' : ''}}"
        data-type="{{item.value}}"
        bindtap="switchType"
      >{{item.label}}</view>
    </view>
  </view>

  <status-view
    state="{{state}}"
    title="{{state === 'loading' ? '加载日程' : state === 'empty' ? '暂无活动' : '日程读取失败'}}"
    message="{{message}}"
    action-text="{{state === 'error' ? '重试' : ''}}"
    bindaction="retry"
  />

  <view wx:if="{{state === 'ready'}}">
    <view wx:for="{{visibleEvents}}" wx:key="id" class="card event-card" bindtap="openEvent" data-id="{{item.id}}">
      <view class="row">
        <view class="section-title">{{item.title}}</view>
        <view class="tag">{{item.status}}</view>
      </view>
      <view class="subtitle">
        <block wx:if="{{item.children && item.children.length}}">
          <block wx:for="{{item.children}}" wx:key="id" wx:for-item="child">{{child.name}} </block>
        </block>
        <block wx:else>{{item.studentName || '家庭活动'}}</block>
        ｜{{item.teamName || '队伍待同步'}}
      </view>
      <view class="subtitle">{{item.startsAt}} <text wx:if="{{item.endsAt}}">- {{item.endsAt}}</text></view>
      <view class="subtitle">{{item.venue}}</view>
    </view>
  </view>

  <role-tabbar role="parent" active="schedule" />
</view>
