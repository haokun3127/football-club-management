<view class="p1">
  <view class="p1-nav" style="padding-top:{{navInset}}px">
    <view class="p1-nav__title">日程</view>
    <view class="p1-nav__bell" style="margin-right:{{menuInset}}px" bindtap="openReminders">
      <image class="p1-nav__bell-icon" src="/assets/icons/bell.svg" mode="aspectFit" />
      <view wx:if="{{hasUnreadReminders}}" class="p1-nav__bell-dot"></view>
    </view>
  </view>

  <view class="p1-body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载日程' : state === 'empty' ? '暂无活动' : '日程读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <view wx:if="{{state === 'ready' && hero.mode === 'upcoming'}}" class="hero" data-id="{{hero.id}}" bindtap="openEvent">
      <view class="hero__glow"></view>
      <view class="hero__top"><text>{{hero.todayLabel}}</text><text>重庆天才</text></view>
      <view class="hero__time-row"><text class="hero__time">{{hero.timeText}}</text><text class="hero__title">{{hero.title}}</text></view>
      <view class="hero__meta">{{hero.teamName || '队伍待同步'}} · {{hero.venue || '场地待同步'}}</view>
      <view class="hero__stats">
        <view class="hero__pill hero__pill--brand"><text class="hero__pill-value">—</text><text class="hero__pill-label">出席率</text></view>
        <view class="hero__pill"><text class="hero__pill-value">{{hero.weekHours}}h</text><text class="hero__pill-label">本周训练</text></view>
        <view class="hero__pill"><text class="hero__pill-value">{{hero.weekCount}}节</text><text class="hero__pill-label">本周课次</text></view>
      </view>
    </view>

    <view wx:elif="{{state === 'ready' && hero.mode === 'empty'}}" class="hero hero--empty">
      <view class="hero__glow"></view>
      <view class="hero__top"><text>{{hero.todayLabel}}</text></view>
      <view class="hero__empty-content">
        <view class="hero__empty-title">{{hero.title}}</view>
        <view class="hero__empty-copy">{{hero.description}}</view>
      </view>
      <view class="hero__stats hero__stats--empty">
        <view class="hero__pill"><text class="hero__pill-value">{{hero.weekHours}}h</text><text class="hero__pill-label">本周训练</text></view>
        <view class="hero__pill"><text class="hero__pill-value">{{hero.weekCount}}节</text><text class="hero__pill-label">本周课次</text></view>
      </view>
    </view>

    <view class="month-calendar">
      <view class="month-calendar__header">
        <view class="month-calendar__title">{{monthLabel}}</view>
        <view class="month-calendar__actions">
          <view class="month-calendar__arrow" data-offset="1" bindtap="changeMonth">›</view>
        </view>
      </view>
      <view class="month-calendar__weekdays">
        <view wx:for="{{monthWeekdays}}" wx:key="*this" class="month-calendar__weekday">{{item}}</view>
      </view>
      <view class="month-calendar__grid">
        <view wx:for="{{monthDays}}" wx:key="key" class="month-day {{item.isCurrentMonth ? '' : 'month-day--outside'}} {{item.isToday ? 'month-day--today' : ''}} {{item.isSelected ? 'month-day--selected' : ''}}" data-date="{{item.key}}" bindtap="selectDate">
          <view class="month-day__number">{{item.dayNumber}}</view>
          <view class="month-day__markers">
            <view wx:if="{{item.hasTraining}}" class="month-day__marker month-day__marker--training"></view>
            <view wx:if="{{item.hasMatch}}" class="month-day__marker month-day__marker--match"></view>
            <view wx:if="{{item.hasMultiple}}" class="month-day__marker month-day__marker--multiple"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="chips">
      <view class="chip chip--red" bindtap="openDay">{{selectedCountLabel}}</view>
      <view class="chip chip--green">出席待同步</view>
      <view class="chip chip--yellow">待处理{{unreadCount}}</view>
    </view>

    <view wx:if="{{state === 'ready'}}" class="event-list">
      <view wx:for="{{visibleEvents}}" wx:key="id" class="acard" data-id="{{item.id}}" bindtap="openEvent">
        <view class="acard__bar" style="background:{{item.typeColor}}"></view>
        <view class="acard__main">
          <view class="acard__row"><text class="acard__title">{{item.title}}</text><view class="acard__pill pill--{{item.statusTone}}">{{item.statusLabel}}</view></view>
          <view class="acard__line">{{item.timeLabel}} · {{item.teamName || '队伍待同步'}} · {{item.venue || '场地待同步'}}</view>
          <view class="acard__dur"><view class="acard__clock"></view>{{item.durationText}}</view>
        </view>
        <view class="acard__chevron">›</view>
      </view>
      <view wx:if="{{!visibleEvents.length}}" class="p1-empty-list">
        <view class="p1-empty-list__icon"><view class="p1-empty-list__calendar"><view class="p1-empty-list__calendar-x"></view></view></view>
        <view class="p1-empty-list__title">暂无活动</view>
        <view class="p1-empty-list__copy">该日期暂未安排训练、比赛或其他活动</view>
      </view>
    </view>
  </view>
  <role-tabbar role="parent" active="schedule" />
</view>
