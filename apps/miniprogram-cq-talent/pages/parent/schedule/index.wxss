.p1 { min-height: 100vh; background: #f5f6f8; }
.p1-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 100; display: flex; box-sizing: content-box; align-items: center; justify-content: space-between; height:44px; padding-right: 32rpx; padding-left: 32rpx; background: #ffffff; box-shadow:none; }
.p1-top-spacer { width: 100%; }
.p1-nav__title { display: flex; align-items: center; color: #0d0d0d; font-size: var(--font-size-display); font-weight: 700; line-height: 1.5; }
.p1-nav__bell { position: relative; display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }
.p1-nav__bell-icon { display: block; width: 64rpx; height: 64rpx; }
.p1-nav__bell-dot { position: absolute; top: 0; right: 4rpx; box-sizing: border-box; width: 16rpx; height: 16rpx; border: 2rpx solid #ffffff; border-radius: 50%; background: #ff3b30; }
.p1-body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.notice-banner { position: relative; display: flex; align-items: stretch; overflow: hidden; box-sizing: border-box; width: 686rpx; min-height: 132rpx; border-radius: 24rpx; background: #ffffff; box-shadow:none; }
.notice-banner__accent { flex: 0 0 10rpx; background: #a80f1b; }
.notice-banner__body { min-width: 0; flex: 1; padding: 22rpx 20rpx 22rpx 24rpx; }
.notice-banner__meta { color: #a80f1b; font-size: var(--font-size-aux); line-height: 1.5; }
.notice-banner__title { overflow: hidden; margin-top: 4rpx; color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.notice-banner__summary { overflow: hidden; margin-top: 4rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.notice-banner__arrow { flex: 0 0 56rpx; align-self: center; color: #c0c8d2; font-size: var(--font-size-body); line-height: 1.5; text-align: center; }
.event-list { display: flex; flex-direction: column; gap: 24rpx; }.p1-empty-list { display: flex; box-sizing: border-box; flex-direction: column; align-items: center; gap: 20rpx; width: 686rpx; height: 360rpx; min-height: 360rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.p1-empty-list__icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 50%; background: #f3f4f6; }.p1-empty-list__calendar { position: relative; box-sizing: border-box; width: 42rpx; height: 42rpx; border: 4rpx solid #98a2b3; border-radius: 8rpx; }.p1-empty-list__calendar::before { position: absolute; top: 8rpx; right: 0; left: 0; height: 4rpx; background: #98a2b3; content: ""; }.p1-empty-list__calendar::after { position: absolute; top: -10rpx; left: 8rpx; width: 4rpx; height: 14rpx; border-radius: 4rpx; background: #98a2b3; box-shadow:none; content: ""; }.p1-empty-list__calendar-x { position: absolute; top: 22rpx; left: 11rpx; width: 14rpx; height: 4rpx; border-radius: 4rpx; background: #98a2b3; transform: rotate(45deg); }.p1-empty-list__calendar-x::after { position: absolute; top: 0; left: 0; width: 14rpx; height: 4rpx; border-radius: 4rpx; background: #98a2b3; content: ""; transform: rotate(90deg); }.p1-empty-list__title { color: #344054; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.p1-empty-list__copy { color:var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; }
.acard { display: flex; box-sizing: border-box; align-items: flex-start; gap: 24rpx; width: 686rpx; height: 192rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.acard__bar { flex: 0 0 8rpx; width: 8rpx; height: 128rpx; border-radius: 40rpx; }.acard__main { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; }.acard__row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; height: 42rpx; }.acard__title { overflow: hidden; flex: 1; color: #0d1117; font-size: var(--font-size-section); font-weight: 600; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.acard__pill { flex-shrink: 0; box-sizing: border-box;    font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.pill--info {   background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.pill--brand {   background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.pill--success {   background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.pill--warning,.pill--pending {   background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.pill--error {   background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.acard__line { overflow: hidden; color: #6b7280; font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.acard__dur { display: flex; align-items: center; gap: 12rpx; height: 30rpx; color: #6b7280; font-size: var(--font-size-aux); line-height: 1.5; }.acard__clock { width: 20rpx; height: 20rpx; border: 3rpx solid #6b7280; border-radius: 50%; }.acard__chevron { color: #c0c8d2; font-size: var(--font-size-body); font-weight: 700; }

.agenda-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:20px 0 12px; }
.agenda-heading__date { font-size:18px; font-weight:600; line-height:1.5; }
.agenda-summary { margin-top:4px; color:var(--color-text-secondary); font-size:14px; line-height:1.5; }
.acard { width:100%; height:auto; min-height:96px; padding:16px; border-radius:var(--radius-card); }
.acard__row { height:auto; min-height:24px; align-items:flex-start; flex-wrap:wrap; }
.acard__title,.acard__line { white-space:normal; overflow-wrap:break-word; }
.acard__pill {   font-weight:400; background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.acard__bar { height:auto; min-height:64px; width:4px; flex:0 0 4px; border-radius:2px; }

.p1-nav__bell {min-height:44px;min-width:44px;}.p1-nav__bell-icon {width:24px;height:24px;}
