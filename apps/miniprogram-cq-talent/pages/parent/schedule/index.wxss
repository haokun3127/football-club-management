.schedule-page { min-height: 100vh; background: #f6f7f9; }
.schedule-page__body { padding: 24rpx 24rpx calc(148rpx + env(safe-area-inset-bottom)); }
.scope-block { margin-bottom: 24rpx; }
.scope-block__label { margin-bottom: 12rpx; color: #667085; font-size: 22rpx; font-weight: 600; }
.calendar-panel { margin-bottom: 24rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; }
.calendar-panel__date { margin-bottom: 6rpx; color: #202124; font-size: 32rpx; font-weight: 700; }
.calendar-button { padding: 12rpx 18rpx; border-radius: 999rpx; background: #fceeef; color: var(--color-brand); font-size: 23rpx; font-weight: 600; }

.date-strip {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.date-strip-inner {
  display: inline-flex;
  gap: 12rpx;
}

.date-chip {
  min-width: 108rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
}

.date-chip.active {
  border-color: var(--color-brand);
  background: #fceeef;
  color: var(--color-brand);
  font-weight: 700;
}
.date-weekday { margin-bottom: 4rpx; color: #667085; font-size: 20rpx; }
.date-chip.active .date-weekday { color: var(--color-brand); }

.date-count {
  margin-top: 4rpx;
  color: #8a8f99;
  font-size: 20rpx;
}

.type-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.type-tab {
  min-height: 56rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  color: #60646f;
  font-size: 24rpx;
  text-align: center;
  line-height: 56rpx;
}

.type-tab.active {
  background: #fceeef;
  color: var(--color-brand);
  font-weight: 700;
}

.event-list { margin-top: 4rpx; }
.calendar-button--link { background: transparent; border: 1rpx solid var(--color-line); color: var(--color-text-secondary); }
