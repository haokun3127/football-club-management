.child-picker {
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  font-weight: 700;
}

.picker-hint {
  float: right;
  color: #8a8f99;
  font-size: 22rpx;
  font-weight: 400;
}

.date-strip {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.date-strip-inner {
  display: inline-flex;
  gap: 12rpx;
}

.date-chip {
  min-width: 108rpx;
  padding: 14rpx 12rpx;
  border-radius: 10rpx;
  background: #f2f3f5;
  text-align: center;
}

.date-chip.active {
  background: #fff1f0;
  color: #e60012;
  font-weight: 700;
}

.date-count {
  margin-top: 4rpx;
  color: #8a8f99;
  font-size: 20rpx;
}

.date-picker {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  color: #1f2329;
  font-size: 26rpx;
}

.type-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.type-tab {
  min-height: 56rpx;
  border-radius: 10rpx;
  background: #f2f3f5;
  color: #60646f;
  font-size: 24rpx;
  text-align: center;
  line-height: 56rpx;
}

.type-tab.active {
  background: #fff1f0;
  color: #e60012;
  font-weight: 700;
}

.event-card:active {
  background: #fff8f7;
}
