.p1 { min-height: 100vh; background: #f5f6f8; }
.p1-nav { position: relative; display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding-right: 32rpx; padding-bottom: 48rpx; padding-left: 32rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03); }
.p1-nav__title { position: absolute; left: 32rpx; display: flex; align-items: center; height: 64rpx; color: #0d0d0d; font-size: 44rpx; font-weight: 700; line-height: 54rpx; }
.p1-nav__bell { position: absolute; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }
.p1-nav__bell-shape { position: relative; box-sizing: border-box; width: 36rpx; height: 40rpx; }
.p1-nav__bell-shape::before { position: absolute; top: 0; left: 0; box-sizing: border-box; width: 36rpx; height: 32rpx; border: 4rpx solid #0d0d0d; border-top-left-radius: 18rpx; border-top-right-radius: 18rpx; border-bottom: 0; content: ""; }
.p1-nav__bell-shape::after { position: absolute; top: 32rpx; left: 0; box-sizing: border-box; width: 36rpx; height: 4rpx; border-radius: 4rpx; background: #0d0d0d; content: ""; }
.p1-nav__bell-clapper { position: absolute; top: 36rpx; left: 13rpx; box-sizing: border-box; width: 10rpx; height: 4rpx; border-radius: 0 0 10rpx 10rpx; background: #0d0d0d; }
.p1-nav__bell-dot { position: absolute; top: 0; right: 4rpx; box-sizing: border-box; width: 16rpx; height: 16rpx; border: 2rpx solid #ffffff; border-radius: 50%; background: #ff3b30; }
.p1-body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; overflow: hidden; box-sizing: border-box; width: 686rpx; height: 360rpx; border-radius: 32rpx; background: #07111f; box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.08), 0 4rpx 16rpx rgba(0, 0, 0, 0.04); }
.hero__glow { position: absolute; top: -160rpx; left: -208rpx; width: 520rpx; height: 520rpx; border-radius: 50%; background: #a80f1b; opacity: 0.35; }
.hero__top { position: absolute; top: 32rpx; right: 32rpx; left: 32rpx; display: flex; justify-content: space-between; color: rgba(255, 255, 255, 0.7); font-size: 24rpx; font-weight: 500; line-height: 30rpx; }
.hero__time-row { position: absolute; top: 86rpx; right: 32rpx; left: 32rpx; display: flex; align-items: flex-end; gap: 24rpx; height: 130rpx; }
.hero__time { color: #ffffff; font-size: 108rpx; font-weight: 800; line-height: 130rpx; text-shadow: 0 12rpx 36rpx rgba(168, 15, 27, 0.4); }
.hero__title { overflow: hidden; flex: 1; padding-bottom: 14rpx; color: #ffffff; font-size: 30rpx; font-weight: 600; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.hero__meta { position: absolute; top: 240rpx; right: 32rpx; left: 32rpx; overflow: hidden; color: rgba(255, 255, 255, 0.8); font-size: 24rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.hero__stats { position: absolute; top: 274rpx; left: 32rpx; display: flex; gap: 20rpx; height: 62rpx; }
.hero__empty-content { position: absolute; top: 112rpx; right: 32rpx; left: 32rpx; }
.hero__empty-title { color: #ffffff; font-size: 40rpx; font-weight: 700; line-height: 48rpx; }
.hero__empty-copy { margin-top: 16rpx; color: rgba(255, 255, 255, 0.72); font-size: 26rpx; line-height: 34rpx; }
.hero__stats--empty { top: 274rpx; }
.hero__pill { display: flex; box-sizing: border-box; align-items: center; gap: 12rpx; width: 190rpx; height: 62rpx; padding: 0 20rpx; border: 1rpx solid rgba(255, 255, 255, 0.1); border-radius: 999rpx; background: rgba(255, 255, 255, 0.06); }
.hero__pill:first-child { width: 172rpx; border-color: rgba(168, 15, 27, 0.2); background: rgba(168, 15, 27, 0.1); }.hero__pill:last-child { width: 196rpx; }.hero__pill--brand .hero__pill-value { color: #a80f1b; }
.hero__pill-value { flex: 0 0 auto; color: #ffffff; font-size: 24rpx; font-weight: 800; line-height: 30rpx; white-space: nowrap; }.hero__pill-label { color: rgba(255, 255, 255, 0.7); font-size: 22rpx; font-weight: 600; line-height: 26rpx; white-space: nowrap; }
.week-switcher { display: flex; align-items: center; gap: 8rpx; width: 686rpx; }.week-switcher__arrow { display: flex; flex: 0 0 44rpx; align-items: center; justify-content: center; width: 44rpx; height: 56rpx; color: #667085; font-size: 36rpx; font-weight: 400; line-height: 44rpx; }.week-nav { display: grid; grid-template-columns: repeat(7, 1fr); flex: 1; min-width: 0; box-sizing: border-box; height: 112rpx; padding: 0 12rpx; border: 1rpx solid #e5e7eb; border-radius: 28rpx; background: #ffffff; }
.week-day { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; color: #6b7280; }.week-day__name { font-size: 20rpx; line-height: 26rpx; }.week-day__number { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 28rpx; font-size: 28rpx; font-weight: 700; line-height: 34rpx; }.week-day--active .week-day__name { color: #101828; }.week-day--active .week-day__number { background: #101828; color: #ffffff; }.week-day--today .week-day__name { color: #a80f1b; }.week-day--today .week-day__number { background: #a80f1b; color: #ffffff; }
.chips { display: flex; flex-wrap: nowrap; align-items: center; gap: 16rpx; min-height: 54rpx; height: 54rpx; }.chip { display: flex; flex: 0 0 auto; flex-shrink: 0; box-sizing: border-box; align-items: center; justify-content: center; min-height: 54rpx; height: 54rpx; padding: 0 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; line-height: 30rpx; text-align: center; white-space: nowrap; overflow: visible; text-overflow: clip; }.chip--red { width: auto; min-width: 0; max-width: 100%; background: #fee2e2; color: #a80f1b; }.chip--green { width: 182rpx; background: #d1fae5; color: #065f46; }.chip--yellow { width: 124rpx; background: #fef3c7; color: #92400e; }
.event-list { display: flex; flex-direction: column; gap: 24rpx; }.p1-empty-list { display: flex; box-sizing: border-box; flex-direction: column; align-items: center; gap: 20rpx; width: 686rpx; height: 360rpx; min-height: 360rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05); }.p1-empty-list__icon { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 50%; background: #f3f4f6; }.p1-empty-list__calendar { position: relative; box-sizing: border-box; width: 42rpx; height: 42rpx; border: 4rpx solid #98a2b3; border-radius: 8rpx; }.p1-empty-list__calendar::before { position: absolute; top: 8rpx; right: 0; left: 0; height: 4rpx; background: #98a2b3; content: ""; }.p1-empty-list__calendar::after { position: absolute; top: -10rpx; left: 8rpx; width: 4rpx; height: 14rpx; border-radius: 4rpx; background: #98a2b3; box-shadow: 18rpx 0 #98a2b3; content: ""; }.p1-empty-list__calendar-x { position: absolute; top: 22rpx; left: 11rpx; width: 14rpx; height: 4rpx; border-radius: 4rpx; background: #98a2b3; transform: rotate(45deg); }.p1-empty-list__calendar-x::after { position: absolute; top: 0; left: 0; width: 14rpx; height: 4rpx; border-radius: 4rpx; background: #98a2b3; content: ""; transform: rotate(90deg); }.p1-empty-list__title { color: #344054; font-size: 28rpx; font-weight: 700; line-height: 34rpx; }.p1-empty-list__copy { color: #98a2b3; font-size: 24rpx; line-height: 30rpx; }
.acard { display: flex; box-sizing: border-box; align-items: flex-start; gap: 24rpx; width: 686rpx; height: 192rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05); }.acard__bar { flex: 0 0 8rpx; width: 8rpx; height: 128rpx; border-radius: 40rpx; }.acard__main { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; }.acard__row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; height: 42rpx; }.acard__title { overflow: hidden; flex: 1; color: #0d1117; font-size: 32rpx; font-weight: 600; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }.acard__pill { flex-shrink: 0; box-sizing: border-box; height: 42rpx; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; line-height: 26rpx; }.pill--info { background: #d1fae5; color: #065f46; }.pill--brand { background: #dbeafe; color: #1a3a6b; }.pill--success { background: #f3f4f6; color: #6b7280; }.pill--warning,.pill--pending { background: #fef3c7; color: #92400e; }.pill--error { background: #fee2e2; color: #a80f1b; }.acard__line { overflow: hidden; color: #6b7280; font-size: 26rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }.acard__dur { display: flex; align-items: center; gap: 12rpx; height: 30rpx; color: #6b7280; font-size: 24rpx; line-height: 30rpx; }.acard__clock { width: 20rpx; height: 20rpx; border: 3rpx solid #6b7280; border-radius: 50%; }.acard__chevron { color: #c0c8d2; font-size: 32rpx; font-weight: 700; }
