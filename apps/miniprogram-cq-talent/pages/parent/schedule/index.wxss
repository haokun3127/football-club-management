.p1 { min-height: 100vh; background: #f5f6f8; }
.p1-nav { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; height: 176rpx; padding: 24rpx 32rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.03); }
.p1-nav__title { color: #0d0d0d; font-size: 44rpx; font-weight: 700; }
.p1-nav__bell { position: relative; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }
.p1-nav__bell-shape { position: relative; width: 30rpx; height: 32rpx; border: 4rpx solid #0d0d0d; border-top-left-radius: 18rpx; border-top-right-radius: 18rpx; border-bottom: 0; }
.p1-nav__bell-shape::after { position: absolute; right: -8rpx; bottom: -4rpx; left: -8rpx; height: 4rpx; border-radius: 4rpx; background: #0d0d0d; content: ""; }
.p1-nav__bell-clapper { position: absolute; bottom: -12rpx; left: 9rpx; width: 10rpx; height: 6rpx; border-radius: 0 0 10rpx 10rpx; background: #0d0d0d; }
.p1-nav__bell-dot { position: absolute; top: 0; right: 2rpx; width: 16rpx; height: 16rpx; border: 2rpx solid #ffffff; border-radius: 50%; background: #ff3b30; }
.p1-body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; overflow: hidden; display: flex; box-sizing: border-box; flex-direction: column; gap: 24rpx; min-height: 360rpx; padding: 32rpx; border-radius: 32rpx; background: #07111f; box-shadow: 0 20rpx 48rpx rgba(0,0,0,.08),0 4rpx 16rpx rgba(0,0,0,.04); }
.hero__glow { position: absolute; top: -160rpx; left: -240rpx; width: 520rpx; height: 520rpx; border-radius: 50%; background: rgba(168,15,27,.35); }
.hero__top { position: relative; display: flex; justify-content: space-between; color: rgba(255,255,255,.7); font-size: 24rpx; font-weight: 500; }
.hero__time-row { position: relative; display: flex; align-items: flex-end; gap: 24rpx; }
.hero__time { color: #ffffff; font-size: 108rpx; font-weight: 800; line-height: 1; text-shadow: 0 12rpx 36rpx rgba(168,15,27,.4); }
.hero__title { overflow: hidden; flex: 1; padding-bottom: 12rpx; color: #ffffff; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.hero__meta { position: relative; overflow: hidden; color: rgba(255,255,255,.8); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.hero__stats { position: relative; display: flex; gap: 20rpx; }
.hero__pill { display: flex; align-items: center; gap: 12rpx; min-width: 0; padding: 16rpx 20rpx; border: 1rpx solid rgba(255,255,255,.1); border-radius: 999rpx; background: rgba(255,255,255,.06); }
.hero__pill--brand { border-color: rgba(168,15,27,.2); background: rgba(168,15,27,.1); }.hero__pill--brand .hero__pill-value { color: #a80f1b; }
.hero__pill-value { color: #ffffff; font-size: 24rpx; font-weight: 800; }.hero__pill-label { color: rgba(255,255,255,.7); font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.week-nav { display: grid; grid-template-columns: repeat(7,1fr); box-sizing: border-box; height: 112rpx; padding: 0 24rpx; border: 1rpx solid #e5e7eb; border-radius: 28rpx; background: #ffffff; }
.week-day { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #6b7280; }.week-day__name { font-size: 20rpx; }.week-day__number { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 28rpx; font-size: 28rpx; font-weight: 700; }.week-day--active .week-day__name { color: #a80f1b; }.week-day--active .week-day__number { background: #a80f1b; color: #ffffff; }
.chips { display: flex; gap: 16rpx; }.chip { padding: 12rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }.chip--red { background: #fee2e2; color: #a80f1b; }.chip--green { background: #d1fae5; color: #065f46; }.chip--yellow { background: #fef3c7; color: #92400e; }
.event-list { display: flex; flex-direction: column; gap: 24rpx; }.acard { display: flex; box-sizing: border-box; align-items: flex-start; gap: 24rpx; min-height: 192rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 32rpx rgba(0,0,0,.05); }.acard__bar { flex: 0 0 8rpx; width: 8rpx; height: 128rpx; border-radius: 40rpx; }.acard__main { display: flex; flex: 1; flex-direction: column; gap: 14rpx; min-width: 0; }.acard__row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.acard__title { overflow: hidden; flex: 1; color: #0d1117; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.acard__pill { flex-shrink: 0; padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; }.pill--info { background: #d1fae5; color: #065f46; }.pill--brand { background: #dbeafe; color: #1a3a6b; }.pill--success { background: #f3f4f6; color: #6b7280; }.pill--warning,.pill--pending { background: #fef3c7; color: #92400e; }.pill--error { background: #fee2e2; color: #a80f1b; }.acard__line { overflow: hidden; color: #6b7280; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }.acard__dur { display: flex; align-items: center; gap: 12rpx; color: #6b7280; font-size: 24rpx; }.acard__clock { width: 20rpx; height: 20rpx; border: 3rpx solid #6b7280; border-radius: 50%; }.acard__chevron { color: #c0c8d2; font-size: 32rpx; font-weight: 700; }
