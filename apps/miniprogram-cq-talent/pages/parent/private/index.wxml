<view class="private-page">
  <view class="page-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><view class="page-nav__back" bindtap="goBack"><image src="/assets/icons/p9-chevron-left.svg" mode="aspectFit" /></view><view class="page-nav__title">私教预约</view><view class="page-nav__spacer"></view></view>
  <view class="private-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载预约信息' : state === 'empty' ? '未绑定孩子' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="form-card">
        <view class="form-card__title">预约信息</view>

        <view class="field">
          <view class="field__label">选择教练</view>
          <picker wx:if="{{hasCoaches}}" range="{{coachOptions}}" value="{{coachIndex}}" bindchange="selectCoach">
            <view class="field__picker">
              <text>{{coachDisplayName}}</text>
              <image class="field__chevron" src="/assets/icons/p9-chevron-right.svg" mode="aspectFit" />
            </view>
          </picker>
          <view wx:else class="field__picker field__picker--disabled">暂无可用教练</view>
        </view>

        <view class="field">
          <view class="field__label">预约日期</view>
          <picker mode="date" value="{{date}}" bindchange="selectDate">
            <view class="field__picker">
              <text class="{{date ? '' : 'field__picker--placeholder'}}">{{dateLabel}}</text>
              <image class="field__icon" src="/assets/icons/p9-calendar.svg" mode="aspectFit" />
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="field__label">时段选择</view>
          <view class="chip-grid chip-grid--slots">
            <view
              wx:for="{{timeSlots}}"
              wx:key="value"
              class="chip {{item.selected ? 'chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="selectSlot"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="field">
          <view class="field__label">训练目标</view>
          <view class="chip-grid chip-grid--goals">
            <view
              wx:for="{{goalOptions}}"
              wx:key="value"
              class="chip {{item.selected ? 'chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="toggleGoal"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="field field--last">
          <view class="field__label">备注</view>
          <textarea
            class="field__textarea"
            placeholder="请输入特殊要求或说明"
            maxlength="500"
            value="{{note}}"
            bindinput="inputNote"
          />
        </view>
      </view>
      <view wx:if="{{hasFormMessage}}" class="form-message">{{formMessage}}</view>
    </block>
  </view>

  <view wx:if="{{state === 'ready'}}" class="submit-area">
    <view class="submit-button {{canSubmit && !submitting ? '' : 'submit-button--disabled'}}" bindtap="submit">{{submitLabel}}</view>
    <view class="submit-hint">提交后等待教练确认，无需在线支付</view>
  </view>
  <role-tabbar role="parent" active="discover" />
</view>
