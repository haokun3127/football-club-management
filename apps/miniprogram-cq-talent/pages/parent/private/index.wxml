<view class="private-page">
  <view class="page-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><view class="page-nav__back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view><view class="page-nav__title">私教预约</view><view class="page-nav__spacer"></view></view>
  <view class="private-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载预约信息' : state === 'empty' ? '未绑定孩子' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="form-card">
        <view class="form-card__title">预约信息</view>

        <view class="field">
          <view class="field__label">预约学员</view>
          <view class="field__picker field__picker--readonly">{{studentName}}</view>
        </view>

        <view class="field">
          <view class="field__label">选择教练</view>
          <picker wx:if="{{hasCoaches}}" range="{{coachOptions}}" value="{{coachIndex}}" bindchange="selectCoach">
            <view class="field__picker">
              <text>{{coachDisplayName}}</text>
              <text class="field__chevron">›</text>
            </view>
          </picker>
          <view wx:else class="field__picker field__picker--disabled">暂无可用教练</view>
        </view>

        <view class="field">
          <view class="field__label">预约日期</view>
          <picker mode="date" value="{{date}}" bindchange="selectDate">
            <view class="field__picker">
              <text class="{{date ? '' : 'field__picker--placeholder'}}">{{dateLabel}}</text>
              <text class="field__chevron">日期</text>
            </view>
          </picker>
        </view>

        <view class="field">
          <view class="field__label">预约时间</view>
          <view class="time-grid">
            <picker mode="time" value="{{startTime}}" bindchange="selectStartTime">
              <view class="field__picker">
                <text class="{{startTime ? '' : 'field__picker--placeholder'}}">{{startTimeLabel}}</text>
              </view>
            </picker>
            <picker mode="time" value="{{endTime}}" bindchange="selectEndTime">
              <view class="field__picker">
                <text class="{{endTime ? '' : 'field__picker--placeholder'}}">{{endTimeLabel}}</text>
              </view>
            </picker>
          </view>
        </view>

        <view class="field">
          <view class="field__label">训练目标</view>
          <textarea
            class="field__textarea"
            placeholder="请输入训练目标，多个目标用换行或逗号分隔"
            maxlength="500"
            value="{{goalsInput}}"
            bindinput="inputGoals"
          />
        </view>

        <view class="field field--last">
          <view class="field__label">备注</view>
          <textarea
            class="field__textarea"
            placeholder="请输入特殊要求或说明"
            maxlength="500"
            value="{{note}}"
            bindinput="inputNote"
          />
        </view>
      </view>
      <view wx:if="{{hasFormMessage}}" class="form-message">{{formMessage}}</view>
    </block>
  </view>

  <view wx:if="{{state === 'ready'}}" class="submit-area">
    <view wx:if="{{canSubmit && !submitting}}" class="submit-button" bindtap="submit">{{submitLabel}}</view>
    <view wx:else class="submit-button submit-button--disabled">{{submitLabel}}</view>
  </view>
  <role-tabbar wx:if="{{state !== 'ready'}}" role="parent" active="child" />
</view>
