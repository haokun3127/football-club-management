.private-page {
  min-height: 100vh;
  background: var(--color-page);
}

.private-page__body {
  padding: 32rpx 44rpx 260rpx;
}

.page-nav { position: sticky; top: 0; z-index: 100; height: 88rpx; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav__back { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.page-nav__back image { width: 48rpx; height: 48rpx; }
.page-nav__title { margin-left: 24rpx; flex: 1; font-size: 44rpx; font-weight: 700; color: var(--color-text); text-align: center; }
.page-nav__spacer { width: 48rpx; height: 48rpx; }

/* 表单卡 */
.form-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.form-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.field__picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.field__picker--placeholder {
  color: var(--color-text-secondary);
}

.field__picker--readonly {
  color: var(--color-text-secondary);
}

.field__picker--disabled {
  color: var(--color-text-secondary);
  opacity: 0.7;
}

.field__chevron {
  color: var(--color-text-secondary);
  font-size: 32rpx;
}

.field__textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 160rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.field--last {
  margin-bottom: 0;
}

.time-grid {
  display: flex;
  gap: 16rpx;
}

.time-grid picker {
  flex: 1;
  min-width: 0;
}

/* 时段/目标 chips（Figma P9: 白底灰边，选中红底白字） */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text);
  font-size: 26rpx;
}

.chip--active {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: #ffffff;
}

.field__icon { width: 36rpx; height: 36rpx; opacity: 0.55; }

.form-message {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: var(--color-brand);
}

/* 提交区（Figma: 底部固定，上阴影；位于 tabbar 之上） */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  padding: 24rpx 44rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.submit-button {
  background: var(--color-brand);
  border-radius: 52rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.submit-button--disabled {
  opacity: 0.6;
}

.submit-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
