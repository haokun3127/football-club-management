.private-page {
  min-height: 100vh;
  background: var(--color-page);
}

.private-page__body {
  padding: 24rpx var(--space-page) 260rpx;
}

/* 表单卡 */
.form-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.form-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.field__picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.field__picker--placeholder {
  color: var(--color-text-secondary);
}

.field__chevron {
  color: var(--color-text-secondary);
  font-size: 32rpx;
}

.field__textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 160rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

/* 选择 chips */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 16rpx 24rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

.chip--wide {
  min-width: 180rpx;
  text-align: center;
  color: var(--color-text-secondary);
}

.chip--active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #ffffff;
  font-weight: 600;
}

/* 费用卡 */
.price-card {
  margin-top: 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.price-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-card__label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.price-card__value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.price-card__chip {
  display: inline-block;
  margin-top: 24rpx;
  padding: 8rpx 16rpx;
  background: #ecfdf5;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #10b981;
}

/* 提交区（Figma: 底部固定，上阴影） */
.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-card);
  padding: 32rpx var(--space-page) calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.submit-button {
  background: var(--color-brand);
  border-radius: 52rpx;
  padding: 26rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.submit-button--disabled {
  opacity: 0.6;
}

.submit-hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
