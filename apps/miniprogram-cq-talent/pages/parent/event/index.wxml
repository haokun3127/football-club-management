<view class="p2">
  <app-header title="{{detail ? detail.navTitle : '活动详情'}}" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />

  <view class="p2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '正在读取活动' : '暂时无法查看'}}" message="{{message}}" action-text="{{state === 'error' ? '重新加载' : ''}}" bindaction="retry" />

    <student-switcher wx:if="{{state === 'ready' && children.length > 1}}" students="{{children}}" selected-id="{{selectedStudentId}}" show-all="{{false}}" bindchange="selectChild" />
    <view wx:if="{{state === 'ready' && children.length > 1 && !selectedStudentId}}" class="leave-card__hint">请选择本次要查看的孩子，再进行请假或查看个人记录。</view>

    <block wx:if="{{detail && detail.type === 'training'}}">
      <view class="training-hero">
        <view class="training-hero__head"><view class="training-hero__type">训练</view><view class="training-hero__coach"><image src="/assets/icons/user-white.svg" mode="aspectFit" />{{detail.coachName}}</view></view>
        <view class="training-hero__title">{{detail.title}}</view>
        <view class="training-hero__meta"><view><image src="/assets/icons/calendar-white.svg" mode="aspectFit" />{{detail.trainingDateText}}</view><view><image src="/assets/icons/map-pin-white.svg" mode="aspectFit" />{{detail.venueText}}</view></view>
      </view>
      <view wx:if="{{leave && leave.visible}}" class="leave-card">
        <view class="leave-card__head"><view class="leave-card__title">请假与训练记录</view><view class="leave-card__status">{{leave.statusLabel}}</view></view>
        <view class="leave-card__rows">
          <view class="leave-card__row"><view class="leave-card__label">孩子</view><view class="leave-card__value">{{leave.studentName}}</view></view>
          <view class="leave-card__row"><view class="leave-card__label">计次结果</view><view class="leave-card__value">{{leave.resultLabel}}</view></view>
        </view>
        <view wx:if="{{leave.historyLabels.length}}" class="leave-card__history">
          <view class="leave-card__history-title">变更历史</view>
          <view wx:for="{{leave.historyLabels}}" wx:key="*this" class="leave-card__history-item">{{item}}</view>
        </view>
        <view wx:if="{{leave.cancelled}}" class="leave-card__hint">课程已取消，本课不计次，无需请假。</view>
        <view wx:elif="{{leave.onLeave}}" class="leave-card__hint">请假已生效，本课不计次。撤销后按实际记录显示待生成、已计次或不计次。</view>
        <view wx:else class="leave-card__hint">提交请假后立即生效、无需审批，本课不计次。</view>
        <view wx:if="{{leave.available && !leave.cancelled && !leave.onLeave}}" class="leave-card__action {{leave.submitting ? 'leave-card__action--disabled' : ''}}" bindtap="submitLeave">{{leave.submitting ? '提交中…' : '提交请假'}}</view>
        <view wx:if="{{leave.available && !leave.cancelled && leave.onLeave}}" class="leave-card__action leave-card__action--revoke {{leave.submitting ? 'leave-card__action--disabled' : ''}}" bindtap="revokeLeave">{{leave.submitting ? '提交中…' : '撤销请假'}}</view>
        <view class="leave-card__hint">训练计次不代表实际到场，也不扣减费用或课包余额。</view>
        <view wx:if="{{leave.message}}" class="leave-card__message">{{leave.message}}</view>
        <view wx:if="{{!leave.available}}" class="leave-card__action" bindtap="retry">重新加载计次记录</view>
      </view>
      <view class="detail-card detail-card--training"><view class="detail-card__head"><view class="detail-card__title">训练内容</view></view><view class="detail-card__copy">{{detail.trainingSummary}}</view></view>
      <view wx:if="{{selectedStudentId}}" class="detail-card detail-card--games"><view class="detail-card__title">训练内友谊赛</view><view wx:if="{{gamesLoading}}" class="detail-card__copy">正在读取记录…</view><view wx:if="{{gamesMessage}}" class="detail-card__copy">{{gamesMessage}}</view><view wx:for="{{friendlyGames}}" wx:key="id" class="parent-friendly-game"><view>{{item.title}} · {{item.score}}</view><view class="detail-card__copy">{{item.events}}</view></view></view>
      <view class="detail-card detail-card--ability"><view class="detail-card__title">关联能力</view><view class="ability-tags"><view wx:for="{{detail.abilityChips}}" wx:key="*this" class="ability-tag">{{item}}</view></view></view>

    </block>

    <block wx:elif="{{detail && detail.type === 'match'}}">
      <view class="match-detail__date">{{detail.dateText}}</view>
      <view class="match-summary">
        <view class="match-summary__venue-label">比赛场地</view>
        <view class="match-summary__venue">{{detail.venueText}}</view>
        <view class="match-summary__scoreline"><view class="match-summary__team match-summary__team--home">{{detail.homeTeam}}</view><view class="match-summary__score">{{detail.scoreText}}</view><view class="match-summary__team match-summary__team--away">{{detail.awayTeam}}</view></view>
        <view class="match-summary__result">{{detail.matchResultLabel}}</view>
      </view>
      <view class="match-events-title">{{detail.childName}}的比赛数据</view>
      <view class="match-events-card">
        <view wx:if="{{detail.hasMatchEvents}}" class="match-events-list">
          <view wx:for="{{detail.matchEvents}}" wx:key="id" class="match-event-row">
            <view class="match-event-row__icon match-event-row__icon--{{item.tone}}">{{item.icon}}</view>
            <view class="match-event-row__main">
              <view class="match-event-row__name">{{item.label}}</view>
              <view class="match-event-row__minute">{{item.minuteLabel}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="match-events-empty">暂无已记录的比赛事件</view>
      </view>
      <view wx:if="{{detail.hasMatchNote}}" class="match-note"><view class="match-note__title">教练点评</view><view class="match-note__copy">{{detail.matchNote}}</view></view>
    </block>

    <block wx:elif="{{detail}}">
      <view class="other-hero"><view class="other-hero__head"><view class="other-hero__type">{{detail.typeLabel}}</view><view class="other-hero__status">{{detail.statusLabel}}</view></view><view class="other-hero__title">{{detail.title}}</view><view class="other-hero__meta"><view>{{detail.dateText}}</view><view><image src="/assets/icons/map-pin.svg" mode="aspectFit" />{{detail.venueText}}</view></view></view>
      <view class="other-info"><view class="other-info__row"><view>活动描述</view><view>{{detail.otherDescription}}</view></view><view class="other-info__line"></view><view class="other-info__row"><view>注意事项</view><view>{{detail.otherNotice}}</view></view></view>
      <view class="person-card"><view class="person-card__title">参与孩子</view><view class="person-row"><view class="person-row__avatar person-row__avatar--child">{{detail.childInitial}}</view><view class="person-row__main"><view>{{detail.childName}}</view><view class="person-row__badge">{{detail.childStatusLabel}}</view></view></view></view>
      <view class="coach-card"><view class="person-row"><view class="person-row__avatar">{{detail.coachInitial}}</view><view class="person-row__main"><view>{{detail.coachName}}</view><view class="person-row__sub">{{detail.coachRole}}</view></view></view></view>
      <view class="other-footer"><image src="/assets/icons/info.svg" mode="aspectFit" />{{detail.otherNotice}}</view>
    </block>
  </view>
</view>
