<view class="p2">
  <view class="p2-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="p2-nav__back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
    <view class="p2-nav__title">{{detail ? detail.navTitle : '活动详情'}}</view>
    <button wx:if="{{detail && detail.type === 'match'}}" class="p2-nav__action" open-type="share">邀请好友</button>
    <view wx:elif="{{detail}}" class="p2-nav__status p2-nav__status--{{detail.statusTone}}">{{detail.statusLabel}}</view>
    <view wx:else class="p2-nav__spacer"></view>
  </view>

  <view class="p2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '正在读取活动' : '暂时无法查看'}}" message="{{message}}" action-text="{{state === 'error' ? '重新加载' : ''}}" bindaction="retry" />

    <block wx:if="{{detail && detail.type === 'training'}}">
      <view class="training-hero">
        <view class="training-hero__head"><view class="training-hero__type">训练</view><view class="training-hero__coach"><image src="/assets/icons/user-white.svg" mode="aspectFit" />{{detail.coachName}}</view></view>
        <view class="training-hero__title">{{detail.title}}</view>
        <view class="training-hero__meta"><view><image src="/assets/icons/calendar-white.svg" mode="aspectFit" />{{detail.trainingDateText}}</view><view><image src="/assets/icons/map-pin-white.svg" mode="aspectFit" />{{detail.venueText}}</view></view>
      </view>
      <view class="detail-card detail-card--training"><view class="detail-card__head"><view class="detail-card__title">训练内容</view><image src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view><view class="detail-card__copy">{{detail.trainingSummary}}</view></view>
      <view class="detail-card detail-card--ability"><view class="detail-card__title">关联能力</view><view class="ability-tags"><view wx:for="{{detail.abilityChips}}" wx:key="*this" class="ability-tag">{{item}}</view></view></view>
      <view class="detail-card detail-card--confirm"><view class="detail-card__head"><image src="/assets/icons/alert.svg" mode="aspectFit" /><view class="detail-card__title">线下确认</view></view><view class="detail-card__copy">{{detail.offlineConfirmText}}</view></view>
      <view class="attendance-button {{detail.attendanceConfirmed ? 'attendance-button--confirmed' : ''}}">{{detail.attendanceConfirmed ? '已确认出席' : '待现场确认'}}</view>
    </block>

    <block wx:elif="{{detail && detail.type === 'match'}}">
      <view class="match-hero">
        <view class="match-hero__meta"><view><view class="match-hero__type">比赛</view><view class="match-hero__title">{{detail.title}}</view></view><view class="match-hero__date"><view>{{detail.dateText}}</view><view>{{detail.venueText}}</view></view></view>
        <view class="match-score"><view class="match-team"><view class="match-team__avatar">A</view><view>{{detail.homeTeam}}</view></view><view class="match-score__center"><view>{{detail.scoreText}}</view><view class="match-score__status">{{detail.statusLabel}}</view></view><view class="match-team"><view class="match-team__avatar">B</view><view>{{detail.awayTeam}}</view></view></view>
      </view>
      <view class="roster-card"><view class="roster-card__head"><view>出席名单</view><view>{{detail.roster.length}}人</view></view><view wx:for="{{detail.roster}}" wx:key="id" class="roster-row"><view class="roster-row__avatar roster-row__avatar--{{item.tone}}">{{item.initial}}</view><view class="roster-row__name">{{item.name}}</view><view class="roster-row__state roster-row__state--{{item.statusTone}}">{{item.statusLabel}}</view></view><view wx:if="{{!detail.roster.length}}" class="roster-empty">出席名单待同步</view></view>
    </block>

    <block wx:elif="{{detail}}">
      <view class="other-hero"><view class="other-hero__head"><view class="other-hero__type">{{detail.typeLabel}}</view><view class="other-hero__status">{{detail.statusLabel}}</view></view><view class="other-hero__title">{{detail.title}}</view><view class="other-hero__meta">{{detail.timeText}}<image src="/assets/icons/map-pin.svg" mode="aspectFit" />{{detail.venueText}}</view></view>
      <view class="other-info"><view class="other-info__row"><view>活动描述</view><view>{{detail.otherDescription}}</view></view><view class="other-info__line"></view><view class="other-info__row"><view>注意事项</view><view>{{detail.otherNotice}}</view></view></view>
      <view class="person-card"><view class="person-card__title">参与孩子</view><view class="person-row"><view class="person-row__avatar person-row__avatar--child">{{detail.childInitial}}</view><view class="person-row__main"><view>{{detail.childName}}</view><view class="person-row__badge">{{detail.childStatusLabel}}</view></view></view></view>
      <view class="coach-card"><view class="person-row"><view class="person-row__avatar">{{detail.coachInitial}}</view><view class="person-row__main"><view>{{detail.coachName}}</view><view class="person-row__sub">{{detail.coachRole}}</view></view></view></view>
      <view class="other-footer"><image src="/assets/icons/info.svg" mode="aspectFit" />{{detail.otherNotice}}</view>
    </block>
  </view>
  <role-tabbar role="parent" active="schedule" />
</view>
