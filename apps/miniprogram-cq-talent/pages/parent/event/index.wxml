<view class="p2">
  <!-- P2/P2.1/P2.2 Nav：返回 + 标题 + 右侧动作 -->
  <view class="p2-nav">
    <view class="p2-nav__back" bindtap="goBack">‹</view>
    <view class="p2-nav__title">{{detail ? detail.navTitle : '活动详情'}}</view>
    <view wx:if="{{detail && detail.type === 'match'}}" class="p2-nav__action" bindtap="inviteFriend">邀请好友</view>
    <view wx:elif="{{detail}}" class="p2-nav__status">{{detail.statusLabel}}</view>
    <view wx:else class="p2-nav__placeholder"></view>
  </view>

  <view class="p2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '正在读取活动' : '暂时无法查看'}}" message="{{message}}" action-text="{{state === 'error' ? '重新加载' : ''}}" bindaction="retry" />

    <!-- P2 Hero（训练/其他） -->
    <view wx:if="{{detail && detail.type !== 'match'}}" class="hero">
      <view class="hero__header">
        <view class="hero__type-chip">{{detail.typeLabel}}</view>
        <view wx:if="{{detail.coachName}}" class="hero__coach">👤 {{detail.coachName}}</view>
      </view>
      <view class="hero__title">{{detail.title}}</view>
      <view class="hero__meta">
        <view class="hero__meta-row">📅 {{detail.dateTimeText}}</view>
        <view class="hero__meta-row">📍 {{detail.venueText}}</view>
      </view>
    </view>

    <!-- P2.1 Hero Scoreboard（比赛） -->
    <view wx:if="{{detail && detail.type === 'match'}}" class="scoreboard">
      <view class="scoreboard__meta">
        <view class="scoreboard__left">
          <view class="hero__type-chip">比赛</view>
          <view class="scoreboard__name">{{detail.title}}</view>
        </view>
        <view class="scoreboard__right">
          <view class="scoreboard__date">{{detail.dateTimeText}}</view>
          <view class="scoreboard__venue">{{detail.venueText}}</view>
        </view>
      </view>
      <view class="scoreboard__row">
        <view class="scoreboard__team">
          <view class="scoreboard__avatar">A</view>
          <view class="scoreboard__team-name">{{detail.homeTeam}}</view>
        </view>
        <view class="scoreboard__center">
          <view class="scoreboard__score">{{detail.scoreText}}</view>
          <view class="scoreboard__state">{{detail.statusLabel}}</view>
        </view>
        <view class="scoreboard__team">
          <view class="scoreboard__avatar">B</view>
          <view class="scoreboard__team-name">{{detail.awayTeam}}</view>
        </view>
      </view>
    </view>

    <!-- 基本信息卡 -->
    <view wx:if="{{detail}}" class="dcard">
      <view class="dcard__head">
        <view class="dcard__title">基本信息</view>
        <view class="dcard__chevron">›</view>
      </view>
      <view wx:for="{{detail.fields}}" wx:key="label" class="dcard__row">
        <view class="dcard__label">{{item.label}}</view>
        <view class="dcard__value">{{item.value}}</view>
      </view>
    </view>

    <!-- 内容/能力卡 -->
    <view wx:if="{{detail}}" wx:for="{{detail.sections}}" wx:key="title" class="dcard">
      <view class="dcard__head">
        <view class="dcard__title">{{item.title}}</view>
      </view>
      <view wx:for="{{item.items}}" wx:key="label" wx:for-item="sub" class="dcard__row">
        <view class="dcard__label">{{sub.label}}</view>
        <view class="dcard__value">{{sub.value}}</view>
      </view>
    </view>

    <!-- 待确认提示卡 -->
    <view wx:if="{{detail}}" wx:for="{{detail.pending}}" wx:key="title" class="dcard dcard--pending">
      <view class="dcard__head">
        <view class="dcard__title">⚠ {{item.title}}</view>
      </view>
      <view class="dcard__text">{{item.message}}</view>
    </view>

    <!-- P2 底部状态按钮 -->
    <view wx:if="{{detail && detail.type === 'training'}}" class="status-btn {{detail.attendanceConfirmed ? 'status-btn--done' : ''}}">
      {{detail.attendanceConfirmed ? '已确认出席' : '到场后由教练确认出席'}}
    </view>
  </view>
</view>
