.p2 { min-height: 100vh; background: #f6f7f9; }

/* P2 Nav Bar */
.p2-nav {
  display: flex;
  align-items: center;
  height: 176rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e7eaf0;
}
.p2-nav__back { width: 80rpx; color: #202124; font-size: 56rpx; font-weight: 300; line-height: 1; }
.p2-nav__title { flex: 1; text-align: center; color: #202124; font-size: 36rpx; font-weight: 700; }
.p2-nav__action { width: 160rpx; text-align: right; color: #a80f1b; font-size: 28rpx; font-weight: 700; }
.p2-nav__status { width: 160rpx; text-align: right; color: #ff9800; font-size: 24rpx; font-weight: 700; }
.p2-nav__placeholder { width: 80rpx; }

.p2-body { padding: 32rpx 32rpx 64rpx; display: flex; flex-direction: column; gap: 32rpx; }

/* P2 Hero（训练/其他） */
.hero {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 40rpx;
  border-radius: 40rpx;
  background: #07111f;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
}
.hero__header { display: flex; align-items: center; justify-content: space-between; }
.hero__type-chip { padding: 8rpx 20rpx; border-radius: 999rpx; background: #a80f1b; color: #ffffff; font-size: 24rpx; font-weight: 700; }
.hero__coach { color: #ffffff; font-size: 24rpx; }
.hero__title { color: #ffffff; font-size: 40rpx; font-weight: 700; }
.hero__meta { display: flex; flex-direction: column; gap: 16rpx; }
.hero__meta-row { color: #ffffff; font-size: 28rpx; }

/* P2.1 Scoreboard（比赛） */
.scoreboard {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
}
.scoreboard__meta { display: flex; justify-content: space-between; }
.scoreboard__left { display: flex; flex-direction: column; gap: 16rpx; }
.scoreboard__name { color: #ffffff; font-size: 36rpx; font-weight: 700; }
.scoreboard__right { display: flex; flex-direction: column; gap: 8rpx; align-items: flex-end; justify-content: center; }
.scoreboard__date, .scoreboard__venue { color: #ffffff; font-size: 26rpx; }
.scoreboard__row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.scoreboard__team { display: flex; flex-direction: column; align-items: center; gap: 16rpx; width: 160rpx; }
.scoreboard__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #07111f;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.scoreboard__team-name { color: #ffffff; font-size: 24rpx; }
.scoreboard__center { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.scoreboard__score { color: #ffffff; font-size: 96rpx; font-weight: 900; line-height: 1; }
.scoreboard__state { padding: 8rpx 20rpx; border-radius: 999rpx; background: #f1f5f9; color: #475569; font-size: 22rpx; font-weight: 700; }

/* Detail Cards */
.dcard {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.dcard__head { display: flex; align-items: center; justify-content: space-between; }
.dcard__title { color: #202124; font-size: 32rpx; font-weight: 700; }
.dcard__chevron { color: #667085; font-size: 32rpx; }
.dcard__row { display: flex; justify-content: space-between; gap: 24rpx; }
.dcard__label { color: #667085; font-size: 26rpx; flex-shrink: 0; }
.dcard__value { color: #202124; font-size: 26rpx; text-align: right; flex: 1; }
.dcard__text { color: #667085; font-size: 28rpx; line-height: 1.6; }
.dcard--pending { border: 1rpx solid #fde68a; background: #fffbeb; }

/* P2 底部状态按钮 */
.status-btn {
  height: 96rpx;
  border-radius: 24rpx;
  background: #e5e7eb;
  color: #6b7280;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-btn--done { background: #2e7d32; color: #ffffff; }
