.p2 { min-height: 100vh; background: #f6f7f9; }
.p2-nav { position: relative; display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding: 0 200rpx 0 32rpx; border-bottom: 1rpx solid #e7eaf0; background: #ffffff; }.p2-nav__back { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; }.p2-nav__back image { width: 48rpx; height: 48rpx; }.p2-nav__title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #202124; font-size: 44rpx; font-weight: 700; line-height: 52rpx; text-align: center; }
.p2-nav__spacer { width: 80rpx; height: 44rpx; }.p2-nav__action { flex: 0 0 auto; color: #a80f1b; font-size: 28rpx; font-weight: 700; line-height: 34rpx; }.p2-nav__status { flex: 0 0 auto; box-sizing: border-box; height: 44rpx; padding: 8rpx 20rpx; border-radius: 24rpx; font-size: 24rpx; font-weight: 700; line-height: 28rpx; }.p2-nav__status--warning { background: #fff3e0; color: #ff9800; }.p2-nav__status--success { background: #22c55e; color: #ffffff; }.p2-nav__status--muted { background: #f3f4f6; color: #667085; }
.p2-body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.training-hero { box-sizing: border-box; width: 686rpx; height: 320rpx; padding: 40rpx; border-radius: 40rpx; background: #07111f; box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1); }.training-hero__head { display: flex; align-items: center; justify-content: space-between; }.training-hero__type,.match-hero__type { box-sizing: border-box; height: 44rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: #a80f1b; color: #ffffff; font-size: 24rpx; font-weight: 700; line-height: 28rpx; }.training-hero__coach { display: flex; align-items: center; gap: 12rpx; color: #ffffff; font-size: 24rpx; line-height: 28rpx; }.training-hero__coach image { width: 28rpx; height: 28rpx; }.training-hero__title { overflow: hidden; margin-top: 32rpx; color: #ffffff; font-size: 40rpx; font-weight: 700; line-height: 48rpx; text-overflow: ellipsis; white-space: nowrap; }.training-hero__meta { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }.training-hero__meta view { display: flex; align-items: center; gap: 16rpx; overflow: hidden; color: #ffffff; font-size: 28rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }.training-hero__meta image { flex: 0 0 auto; width: 32rpx; height: 32rpx; }
.detail-card { box-sizing: border-box; width: 686rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04); }.detail-card--training { height: 208rpx; padding: 32rpx; }.detail-card--ability { height: 182rpx; padding: 32rpx; }.detail-card--confirm { height: 208rpx; padding: 32rpx; }.detail-card__head { display: flex; align-items: center; justify-content: space-between; min-height: 40rpx; }.detail-card__head image { flex: 0 0 auto; width: 40rpx; height: 40rpx; }.detail-card__head > image + .detail-card__title { margin-right: auto; margin-left: 8rpx; }.detail-card__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 38rpx; }.detail-card__copy { display: -webkit-box; overflow: hidden; margin-top: 24rpx; color: #667085; font-size: 28rpx; line-height: 40rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.ability-tags { display: flex; gap: 16rpx; overflow: hidden; margin-top: 24rpx; }.ability-tag { flex: 0 0 auto; box-sizing: border-box; height: 56rpx; padding: 12rpx 24rpx; border-radius: 999rpx; background: #fceeef; color: #a80f1b; font-size: 26rpx; font-weight: 700; line-height: 32rpx; }.attendance-button { display: flex; box-sizing: border-box; align-items: center; justify-content: center; width: 686rpx; height: 96rpx; border-radius: 24rpx; background: #e5e7eb; color: #6b7280; font-size: 32rpx; font-weight: 700; line-height: 38rpx; }.attendance-button--confirmed { background: #2e7d32; color: #ffffff; }
.match-hero { box-sizing: border-box; width: 686rpx; height: 440rpx; padding: 40rpx; border-radius: 32rpx; background: #07111f; }.match-hero__meta { display: flex; justify-content: space-between; }.match-hero__title { display: -webkit-box; overflow: hidden; max-width: 340rpx; margin-top: 16rpx; color: #ffffff; font-size: 36rpx; font-weight: 700; line-height: 44rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.match-hero__date { display: flex; flex-direction: column; gap: 8rpx; max-width: 240rpx; color: #ffffff; font-size: 26rpx; line-height: 32rpx; text-align: right; }.match-score { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; }.match-team { display: flex; flex: 0 0 180rpx; flex-direction: column; align-items: center; gap: 16rpx; overflow: hidden; color: #ffffff; font-size: 24rpx; line-height: 28rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.match-team__avatar { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; background: #ffffff; color: #07111f; font-size: 36rpx; font-weight: 900; }.match-score__center { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }.match-score__center > view:first-child { color: #ffffff; font-size: 96rpx; font-weight: 900; line-height: 116rpx; }.match-score__status { box-sizing: border-box; height: 42rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: #f1f5f9; color: #475569; font-size: 22rpx; font-weight: 700; line-height: 26rpx; }.roster-card { box-sizing: border-box; width: 686rpx; min-height: 402rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); }.roster-card__head { display: flex; justify-content: space-between; color: #202124; font-size: 28rpx; font-weight: 700; line-height: 34rpx; }.roster-card__head > view:last-child { color: #667085; font-size: 26rpx; font-weight: 400; }.roster-row { display: flex; align-items: center; height: 80rpx; margin-top: 20rpx; }.roster-row__avatar { display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; color: #ffffff; font-size: 28rpx; font-weight: 700; }.roster-row__avatar--blue { background: #3b82f6; }.roster-row__avatar--amber { background: #f59e0b; }.roster-row__avatar--brand { background: #a80f1b; }.roster-row__name { flex: 1; margin-left: 24rpx; color: #202124; font-size: 28rpx; font-weight: 700; line-height: 34rpx; }.roster-row__state { box-sizing: border-box; height: 42rpx; padding: 8rpx 20rpx; border-radius: 999rpx; color: #ffffff; font-size: 22rpx; font-weight: 700; line-height: 26rpx; }.roster-row__state--present { background: #22c55e; }.roster-row__state--pending { background: #f59e0b; }.roster-empty { margin-top: 32rpx; color: #667085; font-size: 26rpx; line-height: 32rpx; text-align: center; }
.other-hero { box-sizing: border-box; width: 686rpx; height: 254rpx; padding: 40rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); }.other-hero__head { display: flex; justify-content: space-between; }.other-hero__type,.other-hero__status { box-sizing: border-box; height: 44rpx; padding: 8rpx 20rpx; border-radius: 999rpx; color: #ffffff; font-size: 24rpx; font-weight: 700; line-height: 28rpx; }.other-hero__type { background: #ff9a3b; }.other-hero__status { background: #22c55e; }.other-hero__title { overflow: hidden; margin-top: 24rpx; color: #202124; font-size: 40rpx; font-weight: 700; line-height: 48rpx; text-overflow: ellipsis; white-space: nowrap; }.other-hero__meta { display: flex; align-items: center; gap: 24rpx; overflow: hidden; margin-top: 24rpx; color: #667085; font-size: 28rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }.other-hero__meta image { flex: 0 0 auto; width: 28rpx; height: 28rpx; }.other-info,.person-card,.coach-card,.other-footer { box-sizing: border-box; width: 686rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); }.other-info { height: 180rpx; padding: 32rpx; }.other-info__row { display: flex; justify-content: space-between; gap: 24rpx; color: #667085; font-size: 28rpx; line-height: 34rpx; }.other-info__row > view:last-child { overflow: hidden; max-width: 390rpx; color: #202124; font-weight: 500; text-align: right; text-overflow: ellipsis; white-space: nowrap; }.other-info__line { height: 1rpx; margin: 24rpx 0; background: #e7eaf0; }.person-card { height: 206rpx; padding: 32rpx; }.person-card__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 38rpx; }.person-row { display: flex; align-items: center; margin-top: 24rpx; }.person-row__avatar { display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; background: #f3f4f6; color: #202124; font-size: 28rpx; font-weight: 700; }.person-row__avatar--child { background: #e8f5e9; color: #2e7d32; }.person-row__main { flex: 1; min-width: 0; margin-left: 24rpx; color: #202124; font-size: 30rpx; font-weight: 700; line-height: 36rpx; }.person-row__badge { display: inline-block; box-sizing: border-box; height: 34rpx; margin-top: 4rpx; padding: 4rpx 16rpx; border-radius: 8rpx; background: #22c55e; color: #ffffff; font-size: 22rpx; line-height: 26rpx; }.person-row__sub { margin-top: 4rpx; color: #667085; font-size: 24rpx; font-weight: 400; line-height: 30rpx; }.coach-card { height: 144rpx; padding: 32rpx; }.coach-card .person-row { margin-top: 0; }.other-footer { display: flex; align-items: center; height: 96rpx; padding: 0 32rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; }.other-footer image { flex: 0 0 auto; width: 32rpx; height: 32rpx; margin-right: 16rpx; }
