.p2 { min-height: 100vh; background: #f6f7f9; }
.p2-body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.training-hero { box-sizing: border-box; width: 686rpx; height: 320rpx; padding: 40rpx; border-radius: 40rpx; background:var(--color-card); box-shadow:none; }.training-hero__head { display: flex; align-items: center; justify-content: space-between; }.training-hero__type,.match-hero__type { box-sizing: border-box; height: 44rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: #a80f1b; color:var(--color-text); font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; }.training-hero__coach { display: flex; align-items: center; gap: 12rpx; color:var(--color-text); font-size: var(--font-size-aux); line-height: 1.5; }.training-hero__coach image { width: 28rpx; height: 28rpx; }.training-hero__title { overflow: hidden; margin-top: 32rpx; color:var(--color-text); font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.training-hero__meta { display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }.training-hero__meta view { display: flex; align-items: center; gap: 16rpx; overflow: hidden; color:var(--color-text); font-size: var(--font-size-body); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.training-hero__meta image { flex: 0 0 auto; width: 32rpx; height: 32rpx; }
.detail-card { box-sizing: border-box; width: 686rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.detail-card--training { min-height:208rpx; height:auto; padding:32rpx; }.detail-card--ability { min-height:182rpx; height:auto; padding:32rpx; }.leave-card { box-sizing: border-box; width: 686rpx; margin-top: 24rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.leave-card__head { display: flex; align-items: center; justify-content: space-between; }.leave-card__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.leave-card__status { box-sizing: border-box;      font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.leave-card__rows { margin-top: 24rpx; }.leave-card__row { display: flex; justify-content: space-between; gap: 24rpx; min-height: 44rpx; align-items: center; }.leave-card__row + .leave-card__row { margin-top: 12rpx; }.leave-card__label { flex: 0 0 auto; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.leave-card__value { color: #202124; font-size: var(--font-size-aux); font-weight: 500; line-height: 1.5; text-align: right; }.leave-card__history { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #e7eaf0; }.leave-card__history-title { color: #667085; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.leave-card__history-item { margin-top: 12rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.leave-card__hint { margin-top: 20rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.leave-card__action { display: flex; box-sizing: border-box; align-items: center; justify-content: center; width: 622rpx; height: 88rpx; margin-top: 24rpx; border-radius: 24rpx; background: #a80f1b; color: #ffffff; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }.leave-card__action--revoke { background: #fceeef; color: #a80f1b; }.leave-card__action--disabled { opacity: 0.6; }.leave-card__message { margin-top: 16rpx; color: #b56a00; font-size: var(--font-size-aux); line-height: 1.5; }.detail-card__head { display: flex; align-items: center; justify-content: space-between; min-height: 40rpx; }.detail-card__head image { flex: 0 0 auto; width: 40rpx; height: 40rpx; }.detail-card__head > image + .detail-card__title { margin-right: auto; margin-left: 8rpx; }.detail-card__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.detail-card__copy { display: -webkit-box; overflow: hidden; margin-top: 24rpx; color: #667085; font-size: var(--font-size-body); line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.ability-tags { display: flex; gap: 16rpx; overflow: hidden; margin-top: 24rpx; }.ability-tag { flex: 0 0 auto; box-sizing: border-box;      font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5;  background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.match-hero { box-sizing: border-box; width: 686rpx; height: 440rpx; padding: 40rpx; border-radius: 32rpx; background:var(--color-card); }.match-hero__meta { display: flex; justify-content: space-between; }.match-hero__title { display: -webkit-box; overflow: hidden; max-width: 340rpx; margin-top: 16rpx; color: #ffffff; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.match-hero__date { display: flex; flex-direction: column; gap: 8rpx; max-width: 240rpx; color: #ffffff; font-size: var(--font-size-aux); line-height: 1.5; text-align: right; }.match-score { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; }.match-team { display: flex; flex: 0 0 180rpx; flex-direction: column; align-items: center; gap: 16rpx; overflow: hidden; color: #ffffff; font-size: var(--font-size-aux); line-height: 1.5; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.match-team__avatar { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; background: #ffffff; color: #07111f; font-size: var(--font-size-body); font-weight: 900; }.match-score__center { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }.match-score__center > view:first-child { color: #ffffff; font-size: 96rpx; font-weight: 900; line-height: 116rpx; }.match-score__status { box-sizing: border-box;      font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.roster-card { box-sizing: border-box; width: 686rpx; min-height: 402rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.roster-card__head { display: flex; justify-content: space-between; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }.roster-card__head > view:last-child { color: #667085; font-size: var(--font-size-aux); font-weight: 400; }.roster-row { display: flex; align-items: center; height: 80rpx; margin-top: 20rpx; }.roster-row__avatar { display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; color: #ffffff; font-size: var(--font-size-body); font-weight: 700; }.roster-row__avatar--blue { background: #3b82f6; }.roster-row__avatar--amber { background: #f59e0b; }.roster-row__avatar--brand { background: #a80f1b; }.roster-row__name { flex: 1; margin-left: 24rpx; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }.roster-row__state { box-sizing: border-box; height: 42rpx; padding: 8rpx 20rpx; border-radius: 999rpx; color: #ffffff; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; }.roster-row__state--present { background: #22c55e; }.roster-row__state--pending { background: #f59e0b; }.roster-empty { margin-top: 32rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-align: center; }
.match-events-title { margin-top: 40rpx; color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.match-events-card { box-sizing: border-box; width: 686rpx; min-height: 220rpx; margin-top: 20rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; }.match-events-list { display: flex; flex-direction: column; gap: 32rpx; }.match-event-row { display: flex; align-items: flex-start; gap: 24rpx; }.match-event-row__icon { display: flex; flex: 0 0 48rpx; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 24rpx; background: #fef0f0; color: #a80f1b; font-size: var(--font-size-aux); font-weight: 700; line-height: 1; }.match-event-row__icon--assist { background: #eef4ff; color: #2268d8; }.match-event-row__icon--defense { background: #f4f3ff; color: #7a5af8; }.match-event-row__icon--discipline { background: #fff7e8; color: #b56a00; }.match-event-row__icon--neutral { background: #f2f4f7; color: #667085; }.match-event-row__main { min-width: 0; flex: 1; }.match-event-row__name { color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }.match-event-row__minute { margin-top: 4rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.match-events-empty { padding: 36rpx 0 8rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-align: center; }
.other-hero { box-sizing: border-box; width: 686rpx; height: 254rpx; padding: 40rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.other-hero__head { display: flex; justify-content: space-between; }.other-hero__type,.other-hero__status { box-sizing: border-box;     font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5;  background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}.other-hero__type { background: #ff9a3b; }.other-hero__status {        background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.other-hero__title { overflow: hidden; margin-top: 24rpx; color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.other-hero__meta { display: flex; align-items: center; gap: 24rpx; overflow: hidden; margin-top: 24rpx; color: #667085; font-size: var(--font-size-body); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.other-hero__meta image { flex: 0 0 auto; width: 28rpx; height: 28rpx; }.other-info,.person-card,.coach-card,.other-footer { box-sizing: border-box; width: 686rpx; border-radius: 24rpx; background: #ffffff; box-shadow:none; }.other-info { height: 180rpx; padding: 32rpx; }.other-info__row { display: flex; justify-content: space-between; gap: 24rpx; color: #667085; font-size: var(--font-size-body); line-height: 1.5; }.other-info__row > view:last-child { overflow: hidden; max-width: 390rpx; color: #202124; font-weight: 500; text-align: right; text-overflow: ellipsis; white-space: nowrap; }.other-info__line { height: 1rpx; margin: 24rpx 0; background: #e7eaf0; }.person-card { height: 206rpx; padding: 32rpx; }.person-card__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.person-row { display: flex; align-items: center; margin-top: 24rpx; }.person-row__avatar { display: flex; flex: 0 0 80rpx; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; background: #f3f4f6; color: #202124; font-size: var(--font-size-body); font-weight: 700; }.person-row__avatar--child { background: #e8f5e9; color: #2e7d32; }.person-row__main { flex: 1; min-width: 0; margin-left: 24rpx; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }.person-row__badge { display: inline-block; box-sizing: border-box;  margin-top: 4rpx;     font-size: var(--font-size-aux); line-height: 1.5;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.person-row__sub { margin-top: 4rpx; color: #667085; font-size: var(--font-size-aux); font-weight: 400; line-height: 1.5; }.coach-card { height: 144rpx; padding: 32rpx; }.coach-card .person-row { margin-top: 0; }.other-footer { display: flex; align-items: center; height: 96rpx; padding: 0 32rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.other-footer image { flex: 0 0 auto; width: 32rpx; height: 32rpx; margin-right: 16rpx; }

button.p2-nav__action { width: auto; min-width: 0; margin: 0; padding: 0; border: none; background: transparent; line-height: 34rpx; }
button.p2-nav__action::after { border: none; }

.match-detail__date { color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.match-summary { box-sizing: border-box; width: 686rpx; min-height: 328rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; }
.match-summary__venue-label { color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.match-summary__venue { margin-top: 4rpx; overflow: hidden; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.match-summary__scoreline { display: flex; align-items: center; justify-content: space-between; margin-top: 30rpx; }
.match-summary__team { width: 176rpx; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.match-summary__team--home { text-align: left; }
.match-summary__team--away { text-align: right; }
.match-summary__score { flex: 0 0 auto; margin: 0 18rpx; color: #a80f1b; font-size: 56rpx; font-weight: 700; line-height: 68rpx; white-space: pre; }
.match-summary__result { margin: 10rpx auto 0; color: #2e7d32; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; text-align: center; }
.match-events-card { min-height: 360rpx; }
.match-events-card__head > view:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.match-event-row__minute { flex-basis: 108rpx; }
.match-note { box-sizing: border-box; width: 686rpx; min-height: 172rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; }
.match-note__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.match-note__copy { margin-top: 16rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.leave-card__action,
.leave-card__action--revoke,
.p2-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }

.parent-friendly-game { padding:16rpx 0; border-bottom:1rpx solid var(--color-line); font-size:var(--font-size-body); line-height:1.6; }

.detail-card--games { padding:32rpx; height:auto; }
.detail-card--games .detail-card__copy { display:block; overflow:visible; -webkit-line-clamp:unset; }

.detail-card--training .detail-card__copy { display:block; overflow:visible; -webkit-line-clamp:unset; }
.ability-tags { flex-wrap:wrap; overflow:visible; }
