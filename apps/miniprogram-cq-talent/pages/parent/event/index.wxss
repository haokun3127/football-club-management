.event-page { min-height: 100vh; background: #f6f7f9; }
.event-page__body { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }
.event-hero { display: flex; gap: 20rpx; margin-bottom: 20rpx; padding: 28rpx 24rpx; border-radius: 28rpx; background: var(--color-brand); color: #fff; }
.event-page--match .event-hero { background: #175cd3; }
.event-page--other .event-hero { background: #6941c6; }
.event-hero__symbol { display: flex; flex: 0 0 72rpx; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 20rpx; background: rgba(255,255,255,.16); font-size: 30rpx; font-weight: 700; }
.event-hero__content { min-width: 0; flex: 1; }
.event-hero__eyebrow { margin-bottom: 8rpx; color: rgba(255,255,255,.72); font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }
.event-hero__row { align-items: flex-start; }
.event-hero__title { color: #fff; font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.event-hero__subtitle { margin-top: 8rpx; color: rgba(255,255,255,.76); font-size: 23rpx; line-height: 1.45; }
.detail-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(16,24,40,.04); }
.detail-card--section { border-top: 6rpx solid var(--color-brand); }
.event-page--match .detail-card--section { border-top-color: #175cd3; }
.event-page--other .detail-card--section { border-top-color: #6941c6; }
.detail-card--pending { border-color: #fecdca; background: #fff1f0; }
.detail-card__head { display: flex; align-items: center; gap: 14rpx; margin-bottom: 10rpx; }
.detail-card__head .section-title { margin-bottom: 0; }
.detail-card__icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 12rpx; background: #fceeef; color: var(--color-brand); font-size: 21rpx; font-weight: 700; }
.event-page--match .detail-card__icon { background: #eff8ff; color: #175cd3; }
.event-page--other .detail-card__icon { background: #f4f3ff; color: #6941c6; }
.detail-card__hint { color: #667085; font-size: 21rpx; }
.field-value { max-width: 430rpx; line-height: 1.55; }
