<view class="status-page">
  <view class="status-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="status-nav__back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
    <view class="status-nav__title">课时与保障</view>
  </view>

  <view class="status-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载课时与保障' : state === 'empty' ? '未绑定孩子' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="lesson-card">
        <view class="lesson-card__title">训练课时</view>
        <view class="lesson-card__count">{{totalCount}}</view>
        <view class="lesson-card__caption">累计课时</view>
        <view class="lesson-card__chips"><view class="stat-chip">本月 {{monthCount}}课</view><view class="stat-chip">本季 {{seasonCount}}课</view></view>
      </view>

      <view class="card history-card">
        <view class="card__title">近期课时记录</view>
        <view wx:if="{{history.length}}"><view wx:for="{{history}}" wx:key="id" class="history-row {{index < history.length - 1 ? 'history-row--border' : ''}}">
          <view class="history-row__date">{{item.dateLabel}}</view><view class="history-row__title">{{item.title}}</view><view class="history-row__hours">{{item.hoursLabel}}</view>
        </view></view>
        <view wx:else class="card__empty">暂无可展示的训练日程</view>
      </view>

      <view class="card safety-card">
        <view class="safety-card__head"><view><view class="card__title">运动保障</view><view wx:if="{{insuranceSubtitle}}" class="safety-card__sub">{{insuranceSubtitle}}</view></view><image class="safety-card__info" src="/assets/icons/info.svg" mode="aspectFit" /></view>
        <view class="insurance-badge insurance-badge--{{insuranceBadgeTone}}">{{insuranceBadge}}</view>
        <view class="safety-card__divider"></view>
        <view wx:if="{{insuranceRows.length}}"><view wx:for="{{insuranceRows}}" wx:key="label" class="kv-row"><view class="kv-row__label">{{item.label}}</view><view class="kv-row__value">{{item.value}}</view></view></view>
        <view wx:else class="card__empty">保障资料待同步</view>
        <view class="safety-card__action" bindtap="openCoach">续费/加保 · 联系教练 ›</view>
      </view>
      <view class="contact-note">如有疑问请联系俱乐部管理员</view>
    </block>
  </view>
  <role-tabbar role="parent" active="child" />
</view>
