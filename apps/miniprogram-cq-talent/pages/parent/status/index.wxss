.status-page { min-height: 100vh; background: #f6f7f9; }
.status-nav { position: sticky; top: 0; z-index: 100; display: flex; box-sizing: content-box; align-items: center; height:44px; padding: 0 200rpx 0 32rpx; background: #ffffff; }
.status-nav__title { color: #202124; font-size: var(--font-size-display); font-weight: 700; line-height: 1.5; }
.status-nav__back { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; }.status-nav__back image { width: 48rpx; height: 48rpx; }
.status-page__body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.lesson-card { box-sizing: border-box; width: 686rpx; height: 422rpx; padding: 48rpx; border-radius: 32rpx; background: #ffffff; box-shadow:none; }
.lesson-card__title { color: #202124; font-size: var(--font-size-section); font-weight: 600; line-height: 1.5; }.lesson-card__count { margin-top: 40rpx; color: #07111f; font-size: 96rpx; font-weight: 700; line-height: 116rpx; }.lesson-card__caption { margin-top: 8rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.lesson-card__chips { display: flex; gap: 16rpx; margin-top: 32rpx; }.stat-chip { flex: 1; box-sizing: border-box;      font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; text-align: center;  background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.card { box-sizing: border-box; width: 686rpx; border-radius: 24rpx; background: #ffffff; box-shadow:none; }.history-card { min-height: 260rpx; padding: 32rpx; }.safety-card { min-height: 260rpx; padding: 32rpx; }.card__title { color: #202124; font-size: var(--font-size-section); font-weight: 600; line-height: 1.5; }.card__empty { padding: 32rpx 0 16rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.history-row { display: flex; box-sizing: border-box; align-items: center; gap: 24rpx; height: 80rpx; padding: 24rpx 0; }.history-row--border { border-bottom: 1rpx solid #e7eaf0; }.history-row__date { flex: 0 0 160rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.history-row__title { overflow: hidden; flex: 1; color: #202124; font-size: var(--font-size-section); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.history-row__hours { flex: 0 0 72rpx; color: #202124; font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; text-align: right; }
.safety-card__head { display: flex; align-items: center; justify-content: space-between; }.safety-card__info { width: 32rpx; height: 32rpx; }.insurance-badge { display: inline-block; box-sizing: border-box;  margin-top: 32rpx;   font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.insurance-badge--success {         background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.insurance-badge--warning {         background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.insurance-badge--error {         background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.insurance-badge--neutral {         background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}.safety-card__divider { height: 1rpx; margin: 32rpx 0 8rpx; background: #e7eaf0; }
.safety-card__sub { margin-top: 6rpx; color: #667085; font-size: var(--font-size-aux); }
.safety-card__action { margin-top: 24rpx; padding: 20rpx 0 4rpx; border-top: 1rpx solid #f2f4f7; color: #a80f1b; font-size: var(--font-size-aux); font-weight: 600; }
.kv-row { display: flex; align-items: center; justify-content: space-between; min-height: 56rpx; padding: 12rpx 0; }.kv-row__label { color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.kv-row__value { overflow: hidden; max-width: 430rpx; color: #202124; font-size: var(--font-size-aux); font-weight: 500; line-height: 1.5; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.contact-note { box-sizing: border-box; height: 46rpx; padding-top: 16rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-align: center; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.safety-card__action,
.status-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
