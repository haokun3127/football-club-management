.status-page { min-height: 100vh; background: #f6f7f9; }
.status-nav { position: relative; display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding: 0 200rpx 0 32rpx; background: #ffffff; }
.status-nav__title { color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; }
.status-nav__back { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; }.status-nav__back image { width: 48rpx; height: 48rpx; }
.status-page__body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
.lesson-card { box-sizing: border-box; width: 686rpx; height: 422rpx; padding: 48rpx; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); }
.lesson-card__title { color: #202124; font-size: 30rpx; font-weight: 600; line-height: 36rpx; }.lesson-card__count { margin-top: 40rpx; color: #07111f; font-size: 96rpx; font-weight: 700; line-height: 116rpx; }.lesson-card__caption { margin-top: 8rpx; color: #667085; font-size: 26rpx; line-height: 32rpx; }
.lesson-card__chips { display: flex; gap: 16rpx; margin-top: 32rpx; }.stat-chip { flex: 1; box-sizing: border-box; height: 54rpx; padding: 12rpx 20rpx; border-radius: 12rpx; background: #e7eaf0; color: #202124; font-size: 24rpx; font-weight: 600; line-height: 30rpx; text-align: center; }
.card { box-sizing: border-box; width: 686rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); }.history-card { min-height: 260rpx; padding: 32rpx; }.safety-card { min-height: 260rpx; padding: 32rpx; }.card__title { color: #202124; font-size: 30rpx; font-weight: 600; line-height: 36rpx; }.card__empty { padding: 32rpx 0 16rpx; color: #667085; font-size: 26rpx; line-height: 34rpx; }
.history-row { display: flex; box-sizing: border-box; align-items: center; gap: 24rpx; height: 80rpx; padding: 24rpx 0; }.history-row--border { border-bottom: 1rpx solid #e7eaf0; }.history-row__date { flex: 0 0 160rpx; color: #667085; font-size: 26rpx; line-height: 32rpx; }.history-row__title { overflow: hidden; flex: 1; color: #202124; font-size: 26rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }.history-row__hours { flex: 0 0 72rpx; color: #202124; font-size: 26rpx; font-weight: 600; line-height: 32rpx; text-align: right; }
.safety-card__head { display: flex; align-items: center; justify-content: space-between; }.safety-card__info { width: 32rpx; height: 32rpx; }.insurance-badge { display: inline-block; box-sizing: border-box; height: 42rpx; margin-top: 32rpx; padding: 8rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; line-height: 26rpx; }.insurance-badge--success { background: #d1fae5; color: #059669; }.insurance-badge--warning { background: #fef3c7; color: #92400e; }.insurance-badge--error { background: #fee2e2; color: #a80f1b; }.insurance-badge--neutral { background: #f2f4f7; color: #667085; }.safety-card__divider { height: 1rpx; margin: 32rpx 0 8rpx; background: #e7eaf0; }
.kv-row { display: flex; align-items: center; justify-content: space-between; min-height: 56rpx; padding: 12rpx 0; }.kv-row__label { color: #667085; font-size: 26rpx; line-height: 32rpx; }.kv-row__value { overflow: hidden; max-width: 430rpx; color: #202124; font-size: 26rpx; font-weight: 500; line-height: 32rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.contact-note { box-sizing: border-box; height: 46rpx; padding-top: 16rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; text-align: center; }
