<view class="semester-report-page">
  <view class="page-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="page-nav__back" bindtap="goBack" aria-label="返回"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
    <view class="page-nav__title">成长报告</view>
    <view class="page-nav__spacer"></view>
  </view>

  <scroll-view class="semester-report-page__scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载成长报告' : state === 'empty' ? '暂无成长记录' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state !== 'loading' && state !== 'error' && activeStudentId}}">
      <view class="report-card report-card--period">
        <view class="report-period__label">{{report.periodLabel}}</view>
        <view class="report-period__description">{{report.periodDescription}}</view>
        <view class="report-period__freshness">{{report.freshnessLabel}}</view>
      </view>

      <view class="report-card report-card--student" bindtap="openStudentPicker">
        <view class="report-student__avatar">{{report.studentInitial}}</view>
        <view class="report-student__identity"><view class="report-student__name">{{report.studentName}}</view><view class="report-student__team">{{report.teamLabel}}</view></view>
        <view class="report-student__current">{{report.currentStudentLabel}}</view>
      </view>

      <view class="report-section-title">能力表现</view>

      <view class="report-card report-card--ability">
        <view class="report-ability__copy"><view class="report-ability__title">{{report.abilityTitle}}</view><view class="report-ability__subtitle">{{report.abilitySubtitle}}</view></view>
        <view class="report-ability__score"><view class="report-ability__score-value">{{report.overallScore}}</view><view class="report-ability__score-label">{{report.overallScoreLabel}}</view></view>
        <view wx:if="{{report.dimensions.length}}" class="report-dimensions">
          <view wx:for="{{report.dimensions}}" wx:key="label" class="report-dimension">
            <view class="report-dimension__head"><view class="report-dimension__label">{{item.label}}</view><view class="report-dimension__value">{{item.valueLabel}}</view></view>
            <view class="report-dimension__track"><view class="report-dimension__fill" style="width:{{item.percent}}%"></view></view>
          </view>
        </view>
        <view wx:else class="report-empty">{{report.metricsEmptyLabel}}</view>
      </view>

      <view class="report-card report-card--summary">
        <view class="report-stats">
          <view class="report-stat"><view class="report-stat__value">{{report.trainingSummary.value}}</view><view class="report-stat__label">已完成训练</view></view>
          <view class="report-stat report-stat--accent"><view class="report-stat__value">{{report.matchSummary.value}}</view><view class="report-stat__label">已完成比赛</view></view>
          <view class="report-stat"><view class="report-stat__value">{{report.attendanceSummary.value}}</view><view class="report-stat__label">出勤率</view></view>
        </view>
      </view>

      <view class="report-card report-card--note">
        <view class="report-note__title">教练评语</view><view class="report-note">{{report.coachNoteLabel}}</view>
      </view>
    </block>
  </scroll-view>
  <role-tabbar role="parent" active="growth" />
</view>
