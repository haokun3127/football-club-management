.coaches-page {
  min-height: 100vh;
  background: var(--color-page);
}
.coaches-nav { display: flex; align-items: center; box-sizing: content-box; height: 88rpx; padding: 0 200rpx 0 32rpx; background: #ffffff; box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.05); }
.coaches-nav__back { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.coaches-nav__back image { width: 48rpx; height: 48rpx; }
.coaches-nav__title { flex: 1; margin-left: 24rpx; color: #202124; font-size: 44rpx; font-weight: 700; text-align: center; }
.coaches-nav__spacer { width: 48rpx; height: 48rpx; }

.coaches-page__body {
  padding: 24rpx var(--space-page) 180rpx;
}

/* 球队介绍卡 */
.team-card {
  background: #07111f;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.1);
}

.team-card__name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.team-card__chips {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.team-chip {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.team-card__divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 32rpx 0;
}

.team-card__goal {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
}

/* 教练卡片 */
.coach-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.coach-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.coach-card__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.coach-card__info {
  flex: 1;
  min-width: 0;
}

.coach-card__name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coach-card__name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.coach-card__role {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.coach-card__bio {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.coach-card__contact {
  flex-shrink: 0;
  border: 1rpx solid var(--color-line);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
