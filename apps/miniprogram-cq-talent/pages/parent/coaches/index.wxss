.coaches-page {
  min-height: 100vh;
  background: var(--color-page);
}
.coaches-nav { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; box-sizing: content-box; height:44px; padding: 0 200rpx 0 32rpx; background: #ffffff; box-shadow:none; }
.coaches-nav__back { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.coaches-nav__back image { width: 48rpx; height: 48rpx; }
.coaches-nav__title { flex: 1; margin-left: 24rpx; color: #202124; font-size: var(--font-size-display); font-weight: 700; }
.coaches-nav__spacer { width: 48rpx; height: 48rpx; }

.coaches-page__body {
  padding: 24rpx var(--space-page) 180rpx;
}

/* 球队介绍卡 */
.team-card {
  background:var(--color-card);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow:none;
}

.team-card__name {
  font-size: var(--font-size-body);
  font-weight: 700;
  color:var(--color-text);
}

.team-card__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.team-chip {



  font-size: var(--font-size-aux);
  font-weight: 600;

 background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}

.team-card__divider {
  height: 1rpx;
  background:transparent;
  margin: 32rpx 0;
}

.team-card__goal {
  font-size: var(--font-size-aux);
  line-height: 1.6;
  color:var(--color-text-secondary);
}

/* 教练卡片 */
.coach-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.coach-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow:none;
}

.coach-card__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-brand);
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-brand);
  flex-shrink: 0;
}

.coach-card__info {
  flex: 1;
  min-width: 0;
}

.coach-card__name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coach-card__name {
  font-size: var(--font-size-body);
  font-weight: 700;
  color: var(--color-text);
}

.coach-card__role {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-size-aux);
  font-weight: 700;
  color: #ffffff;
}

.coach-card__bio {
  margin-top: 12rpx;
  font-size: var(--font-size-aux);
  line-height: 1.5;
  color: var(--color-text-secondary);
}

.coach-card__contact {
  flex-shrink: 0;
  border: 1rpx solid var(--color-line);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  font-size: var(--font-size-aux);
  color: var(--color-text-secondary);
}

.coach-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-size-aux);
  color: var(--color-text-secondary);
}

.coach-card__wechat { flex: 0 0 auto; display: flex; align-items: center; gap: 8rpx; align-self: center; padding: 12rpx 20rpx; border: 1rpx solid #e7eaf0; border-radius: 999rpx; background: #f6f7f9; }
.coach-card__wechat-icon { width: 28rpx; height: 28rpx; }
.coach-card__wechat-text { font-size: var(--font-size-aux); color: #202124; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.coach-card__wechat,
.coaches-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }

.coach-card__role { background:transparent;padding:0;border-radius:0;color:var(--color-text-secondary);font-weight:400; }
