.guide-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.guide-page__body {
  padding: 32rpx 32rpx 64rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  padding: 24rpx;
}

.guide-card__accent {
  width: 8rpx;
  height: 72rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.guide-card__content {
  flex: 1;
  min-width: 0;
}

.guide-card__title {
  font-size: var(--font-size-section);
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-card__subtitle {
  margin-top: 8rpx;
  font-size: var(--font-size-aux);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guide-card__chevron {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.guide-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: var(--font-size-aux);
  color: var(--color-text-secondary);
}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.guide-card,
.page-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
