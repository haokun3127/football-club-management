.home { min-height: 100vh; background: var(--color-page); }
.home-body { padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom)); }
.player-slides { height: 596rpx; margin-bottom: 12rpx; }
.player-card { height: 548rpx; box-sizing: border-box; padding: 40rpx; border-radius: 28rpx; background: var(--color-brand); color: var(--color-card); }
.eyebrow { font-size: 20rpx; letter-spacing: 2rpx; line-height: 30rpx; }
.player-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; }
.player-name { min-width: 0; overflow: hidden; font-size: 68rpx; font-weight: 700; line-height: 92rpx; text-overflow: ellipsis; white-space: nowrap; }
.child-button { flex-shrink: 0; margin: 0; padding: 0 24rpx; min-height: 72rpx; line-height: 72rpx; border-radius: 36rpx; background: var(--color-brand-soft); color: var(--color-brand); font-size: 24rpx; }
.player-team { margin-top: 8rpx; font-size: 26rpx; line-height: 40rpx; }
.player-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.metric-label { opacity: .76; font-size: 22rpx; line-height: 36rpx; }
.metric-value { font-size: 72rpx; font-weight: 700; line-height: 88rpx; font-variant-numeric: tabular-nums; }
.metric-unit { margin-left: 10rpx; font-size: 22rpx; font-weight: 400; }
.player-latest { margin-top: 24rpx; font-size: 24rpx; line-height: 40rpx; }
.milestone-card { display: flex; flex-direction: column; }
.milestone-title { margin-top: 48rpx; font-size: 44rpx; line-height: 60rpx; font-weight: 700; }
.milestone-description { margin-top: 20rpx; font-size: 28rpx; line-height: 44rpx; opacity: .85; }
.milestone-link { margin-top: auto; font-size: 24rpx; line-height: 40rpx; }
.club-banner { position: relative; height: 296rpx; overflow: hidden; border-radius: 24rpx; color: var(--color-card); }
.club-banner-image { position: absolute; width: 100%; height: 100%; }
.club-banner-copy { position: relative; padding: 36rpx; width: 55%; box-sizing: border-box; }
.club-banner-title { margin-top: 14rpx; white-space: pre-line; font-size: 46rpx; line-height: 62rpx; font-weight: 700; }
.club-banner-subtitle { margin-top: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; line-height: 30rpx; }
.shortcuts { display: flex; gap: 20rpx; padding: 36rpx 0; }
.shortcut { flex: 1; width: 0; min-width: 0; padding: 0; margin: 0; background: transparent; color: var(--color-text); font-size: 24rpx; line-height: 40rpx; text-align: left; }
.shortcut-icon { display: flex; align-items: center; justify-content: center; height: 88rpx; margin-bottom: 14rpx; border-radius: 20rpx; background: var(--color-brand-soft); }
.shortcut-icon image { width: 44rpx; height: 44rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0 20rpx; font-size: 36rpx; font-weight: 700; }
.text-button { margin: 0; padding: 12rpx 0 12rpx 20rpx; background: transparent; color: var(--color-brand); font-size: 24rpx; font-weight: 400; line-height: 44rpx; }
.next-event { padding: 28rpx 32rpx; border-radius: 20rpx; border: 1rpx solid var(--color-line); background: var(--color-card); }
.next-event-title { font-size: 30rpx; line-height: 44rpx; font-weight: 600; }
.next-event-time { margin-top: 12rpx; color: var(--color-brand); font-size: 28rpx; line-height: 40rpx; }
.next-event-meta { margin-top: 12rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 40rpx; }

.shortcut-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; font-size: 28rpx; font-weight: 600; }
.shortcut-editor { padding: 28rpx; margin-bottom: 24rpx; border: 1rpx solid var(--color-line); border-radius: 20rpx; background: var(--color-card); }
.editor-title { font-size: 30rpx; font-weight: 600; line-height: 44rpx; }
.slot-picker { padding: 24rpx 0; color: var(--color-brand); font-size: 24rpx; line-height: 40rpx; }
.shortcut-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.shortcut-choices button, .editor-actions button { width: 100%; margin: 0; padding: 12rpx; font-size: 24rpx; line-height: 44rpx; background: var(--color-brand-soft); color: var(--color-brand); }
.editor-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.editor-actions .editor-save { background: var(--color-brand); color: var(--color-card); }
.configuration-message { margin: 16rpx 0; color: var(--color-brand); font-size: 24rpx; line-height: 36rpx; }
