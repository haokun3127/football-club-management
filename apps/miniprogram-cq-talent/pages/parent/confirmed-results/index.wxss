@import "../../coach/student-results/index.wxss";

/* 移动端触控下限，业务内容与原事件保持一致。 */
.results-alternative,
.results-back,
.results-card { min-height:44px; min-width:44px; box-sizing:border-box; }

.results-source-details { display:flex; flex-direction:column; gap:16rpx; color:var(--club-muted); font-size:var(--font-size-aux); line-height:1.5; word-break:break-all; }
