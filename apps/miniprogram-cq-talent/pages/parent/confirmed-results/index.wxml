<view class="results-page">
  <app-header title="{{pageTitle}}" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />
  <view class="results-body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载成绩' : state === 'empty' ? '暂无已确认成绩' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready' && selected}}">
      <view class="results-card"><view class="results-heading">{{selected.name}} · 已确认</view><view class="results-value">{{selected.valueLabel}}</view><view wx:if="{{selected.mapping}}" class="results-text">分值 {{selected.mapping.integerScore}} · 等级 {{selected.mapping.grade}}</view><view wx:else class="results-caption">该确认结果暂无完整分值/等级映射</view><view class="results-caption">{{studentName}} · {{teamName}} · {{selected.historyDate}}</view></view>
      <view class="results-card results-source-card">
        <t-button bindtap="toggleSource" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">来源与规则信息 · {{sourceExpanded ? '收起' : '展开'}}</t-button>
        <view wx:if="{{sourceExpanded}}" class="results-source-details">
          <view>原始单位：{{sourceRawUnit}}</view>
          <view>项目版本：<text selectable>{{selected.templateVersionId || '未提供，不合并比较'}}</text></view>
          <view wx:if="{{selected.mapping}}">分值规则：<text selectable>{{selected.mapping.rawScoreVersionId}}</text></view>
          <view wx:if="{{selected.mapping}}">等级规则：<text selectable>{{selected.mapping.gradeVersionId}}</text></view>
          <view>发生时间：{{selected.occurredAt}}</view><view>记录时间：{{selected.recordedAt || '未提供'}}</view>
          <view>来源：{{selected.eventId ? '关联活动' : selected.taskId ? '测评任务' : '已确认测评记录'}}</view>
          <t-button wx:if="{{selected.eventId}}" bindtap="openSourceEvent" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">查看来源活动</t-button>
          <view>仅比较同一项目、项目版本与单位的结果；课堂表现和队伍评价分别记录。</view>
        </view>
      </view>
      <view class="results-card"><view class="results-history-title">{{scaleLabel}}</view>
        <view wx:if="{{bars.length}}" class="results-chart"><view wx:for="{{bars}}" wx:key="id" class="results-column"><view class="results-bar {{item.latest ? 'results-bar--latest' : ''}}" style="height:{{item.height}}"></view><view>{{item.valueLabel}}</view><view class="results-caption">{{item.dateLabel}}</view></view></view>
        <view wx:if="{{bars.length}}" class="results-caption">图表显示最近三次，完整记录如下</view>
        <view wx:for="{{history}}" wx:key="id" class="results-history-row"><text>{{item.historyDate}}</text><text>{{item.valueLabel}}<text wx:if="{{item.mapping}}"> · {{item.mapping.integerScore}} / {{item.mapping.grade}}</text></text></view>
        <view class="results-caption">仅比较同一项目、版本及单位；修订保留为同一次测评。</view>
      </view>
      <view wx:for="{{alternatives}}" wx:key="id" class="results-card results-alternative" data-id="{{item.id}}" bindtap="select"><view class="results-title">{{item.name}}</view><view class="results-text">原始成绩 {{item.valueLabel}} · {{item.historyDate}}</view><view class="results-link">查看已确认成绩与个人历史 ›</view></view>
    </block>
  </view>
  <view wx:if="{{teamId}}" class="results-footer"><t-button class="results-primary" loading="{{switching}}" disabled="{{switching}}" bindtap="switchStudent" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="results-primary" theme="primary" variant="base">切换同队学员</t-button></view>
</view>
