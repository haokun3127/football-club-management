.binding-page { min-height: 100vh; background: #f6f7f9; }
.binding-nav { position: relative; display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding: 0 44rpx; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }
.binding-nav__back { position: absolute; left: 44rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }.binding-nav__back image { width: 48rpx; height: 48rpx; }.binding-nav__title { margin-left: 72rpx; color: #202124; font-size: 44rpx; font-weight: 700; line-height: 54rpx; }
.binding-page__body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 44rpx calc(160rpx + env(safe-area-inset-bottom)); }
.binding-card { box-sizing: border-box; width: 662rpx; padding: 32rpx; border: 1rpx solid #e7eaf0; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05); }.binding-card--child { height: 282rpx; }.binding-card--wechat { height: 160rpx; }.binding-card--family { min-height: 160rpx; }.binding-card__title { color: #202124; font-size: 28rpx; font-weight: 700; line-height: 34rpx; }.binding-card__hint { margin-top: 32rpx; color: #667085; font-size: 26rpx; line-height: 32rpx; }
.binding-child { display: flex; align-items: center; height: 88rpx; margin-top: 24rpx; }.binding-child__avatar { display: flex; flex: 0 0 88rpx; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; background: #f3f4f6; color: #202124; font-size: 28rpx; font-weight: 700; }.binding-child__info { flex: 1; min-width: 0; margin-left: 24rpx; }.binding-child__name { color: #202124; font-size: 30rpx; font-weight: 700; line-height: 36rpx; }.binding-child__team { overflow: hidden; margin-top: 4rpx; color: #667085; font-size: 26rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }.binding-child__chip,.family-row__chip { flex: 0 0 auto; box-sizing: border-box; height: 42rpx; padding: 8rpx 16rpx; border-radius: 8rpx; background: #ecfdf5; color: #10b981; font-size: 22rpx; font-weight: 700; line-height: 26rpx; }
.wechat-head { display: flex; align-items: center; gap: 16rpx; }.wechat-head image { width: 40rpx; height: 40rpx; }.wechat-detail { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; }.wechat-detail image { width: 32rpx; height: 32rpx; }
.family-unavailable { margin-top: 24rpx; color: #667085; font-size: 26rpx; line-height: 32rpx; }
