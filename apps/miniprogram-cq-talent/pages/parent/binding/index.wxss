.binding-page { min-height: 100vh; background: #f6f7f9; }
.binding-nav { position: sticky; top: 0; z-index: 100; display: flex; box-sizing: content-box; align-items: center; height:44px; padding: 0 44rpx; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }
.binding-nav__back { position: absolute; left: 44rpx; display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; }.binding-nav__back image { width: 48rpx; height: 48rpx; }.binding-nav__title { margin-left: 48rpx; color: #202124; font-size: var(--font-size-display); font-weight: 700; line-height: 1.5; }
.binding-page__body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx 44rpx calc(160rpx + env(safe-area-inset-bottom)); }
.binding-card { box-sizing: border-box; width: 662rpx; padding: 32rpx; border: 1rpx solid #e7eaf0; border-radius: 32rpx; background: #ffffff; box-shadow:none; }.binding-card--child { height: 282rpx; }.binding-card--wechat { height: 160rpx; }.binding-card--family { min-height: 160rpx; }.binding-card__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }.binding-card__hint { margin-top: 32rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.binding-child { display: flex; align-items: center; height: 88rpx; margin-top: 24rpx; }.binding-child__avatar { display: flex; flex: 0 0 88rpx; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; background: #f3f4f6; color: #202124; font-size: var(--font-size-body); font-weight: 700; }.binding-child__info { flex: 1; min-width: 0; margin-left: 24rpx; }.binding-child__name { color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }.binding-child__team { overflow: hidden; margin-top: 4rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.binding-child__chip,.family-row__chip { flex: 0 0 auto; box-sizing: border-box;      font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5;  background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}
.wechat-head { display: flex; align-items: center; gap: 16rpx; }.wechat-head image { width: 40rpx; height: 40rpx; }.wechat-detail { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.wechat-detail image { width: 32rpx; height: 32rpx; }
.family-unavailable { margin-top: 24rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.family-row { display: flex; align-items: center; padding: 20rpx 0; }
.family-row--border { border-bottom: 1rpx solid #e7eaf0; }
.family-row__avatar { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; flex-shrink: 0; }
.family-row__avatar image { width: 48rpx; height: 48rpx; }
.family-row__info { flex: 1; min-width: 0; margin-left: 20rpx; }
.family-row__name { color: #202124; font-size: var(--font-size-body); font-weight: 600; line-height: 1.5; }
.family-row__self { color: #667085; font-size: var(--font-size-aux); font-weight: 400; }
.family-row__phone { margin-top: 2rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.family-add { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 20rpx; padding: 22rpx 0; border: 1rpx solid #e7eaf0; border-radius: 16rpx; color: #a80f1b; font-size: var(--font-size-body); font-weight: 600; text-align: center; }.family-add image { width: 48rpx; height: 48rpx; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.binding-card,
.binding-card--wechat,
.binding-card__hint,
.binding-child,
.binding-nav__back,
.family-add { min-height:44px; min-width:44px; box-sizing:border-box; }
