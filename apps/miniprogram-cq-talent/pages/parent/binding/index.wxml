<view class="binding-page">
  <view class="binding-nav" style="padding-top:{{navInset}}px">
    <view class="binding-nav__back" style="top:{{navActionTop}}px" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
    <view class="binding-nav__title">账号绑定</view>
  </view>

  <view class="binding-page__body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载绑定信息' : state === 'empty' ? '暂无绑定学员' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view class="binding-card binding-card--child">
        <view class="binding-card__title">绑定学员</view>
        <view wx:if="{{activeChild}}" class="binding-child" data-id="{{activeChild.id}}" bindtap="switchChild">
          <view class="binding-child__avatar">{{activeChild.avatarLetter}}</view>
          <view class="binding-child__info"><view class="binding-child__name">{{activeChild.name}}</view><view class="binding-child__team">{{activeChild.teams[0] || '重庆天才足球俱乐部'}}</view></view>
          <view class="binding-child__chip">已绑定</view>
        </view>
        <view class="binding-card__hint" bindtap="chooseChild">切换学员</view>
      </view>

      <view class="binding-card binding-card--wechat" bindtap="openAccount">
        <view class="wechat-head"><image src="/assets/icons/smartphone.svg" mode="aspectFit" /><view class="binding-card__title">微信登录绑定</view></view>
        <view class="wechat-detail"><image src="/assets/icons/check-circle.svg" mode="aspectFit" /><view>微信: {{wechatLabel}}</view></view>
      </view>

      <view class="binding-card binding-card--family">
        <view class="binding-card__title">家庭成员</view>
        <view class="family-row"><image src="/assets/icons/user.svg" mode="aspectFit" /><view class="family-row__main"><view class="family-row__name">主监护人</view><view class="family-row__phone">已通过微信授权</view></view><view class="family-row__chip">已加入</view></view>
        <view class="family-divider"></view>
        <view class="family-add" bindtap="addFamilyMember"><image src="/assets/icons/plus.svg" mode="aspectFit" /><view>添加家庭成员</view></view>
      </view>
    </block>
  </view>
  <role-tabbar role="parent" active="child" />
</view>
