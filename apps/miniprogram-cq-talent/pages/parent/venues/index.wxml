<view class="venues-page">
  <view class="venues-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><view class="venues-nav__back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view><view class="venues-nav__title">场地信息</view><view class="venues-nav__action venues-nav__action--disabled" aria-disabled="true"><image src="/assets/icons/search.svg" mode="aspectFit" /></view></view>
  <view class="venues-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载场地信息' : state === 'empty' ? '暂无场地' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="loadVenues"
    />
    <block wx:if="{{state === 'ready'}}">
      <scroll-view scroll-x class="filters" enhanced show-scrollbar="{{false}}">
        <view class="filters__inner">
          <view
            wx:for="{{filters}}"
            wx:key="value"
            class="filter-chip {{activeFilter === item.value ? 'filter-chip--active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectFilter"
          >{{item.label}}</view>
        </view>
      </scroll-view>

      <view class="venue-list">
        <view wx:if="{{hasVisibleVenues}}">
          <view wx:for="{{visibleVenues}}" wx:key="id" class="venue-card">
            <view class="venue-card__hero">
              <view class="venue-card__type">{{item.type}}</view>
            </view>
            <view class="venue-card__body">
              <view class="venue-card__name">{{item.name}}</view>
              <view class="venue-card__address">📍 {{item.address}}</view>
              <view wx:if="{{item.hasTags}}" class="venue-card__tags">
                <view wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag-chip">{{tag}}</view>
              </view>
              <view wx:if="{{item.hasFacilities}}" class="venue-card__facilities">
                <view wx:for="{{item.facilities}}" wx:key="*this" wx:for-item="facility" class="facility-chip">{{facility}}</view>
              </view>
              <view class="venue-card__footer">
                <view class="venue-card__count">{{item.usageLabel}}</view>
                <view wx:if="{{item.canNavigate}}" class="venue-card__nav" data-id="{{item.id}}" bindtap="navigate">导航</view>
                <view wx:else class="venue-card__nav venue-card__nav--disabled">定位待同步</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:else class="venue-empty">{{emptyMessage}}</view>
      </view>
    </block>
  </view>
  <role-tabbar role="parent" active="child" />
</view>
