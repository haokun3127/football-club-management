.account-page { min-height: 100vh; background: var(--color-page); }
.account-page__body { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx var(--space-page) 64rpx; }
.profile-card { display: flex; gap: 24rpx; padding: 28rpx; border-radius: 20rpx; background: var(--color-card); box-shadow:none; }
.profile-card__avatar { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border: 4rpx solid var(--color-brand); border-radius: 50%; background: #fceeef; color: var(--color-brand); font-size: var(--font-size-body); font-weight: 700; }
.profile-card__info { display: flex; flex: 1; flex-direction: column; gap: 8rpx; min-width: 0; }.profile-card__name { overflow: hidden; color: var(--color-text); font-size: var(--font-size-body); font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.profile-card__team { overflow: hidden; color: var(--color-text-secondary); font-size: var(--font-size-aux); text-overflow: ellipsis; white-space: nowrap; }.profile-card__badge { align-self: flex-start;     font-size: var(--font-size-aux); font-weight: 600;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.settings-list { overflow: hidden; border-radius: 20rpx; background: var(--color-card); box-shadow:none; }.settings-row { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 28rpx; border-bottom: 1rpx solid var(--color-line); }.settings-row:last-child { border-bottom: none; }.settings-row__label { display: flex; align-items: center; gap: 12rpx; color: var(--color-text); font-size: var(--font-size-aux); font-weight: 500; }.settings-row__label--danger { color: var(--color-brand); }.settings-row__icon { font-size: var(--font-size-body); }.settings-row__right { display: flex; align-items: center; gap: 24rpx; }.settings-row__value { color: var(--color-text-secondary); font-size: var(--font-size-aux); }.settings-row__action { color: var(--color-brand); font-size: var(--font-size-aux); font-weight: 600; }.settings-row__chevron { color: var(--color-text-secondary); font-size: var(--font-size-body); }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.settings-row { min-height:44px; min-width:44px; box-sizing:border-box; }
