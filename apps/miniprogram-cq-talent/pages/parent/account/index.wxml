<view class="account-page">
  <app-header title="账号设置" show-back />
  <view class="account-page__body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载账号信息' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="profile-card">
        <view class="profile-card__avatar">{{initial}}</view>
        <view class="profile-card__info">
          <view class="profile-card__name">{{displayName}}</view>
          <view class="profile-card__team">{{profileLabel}}</view>
          <view class="profile-card__badge">已认证</view>
        </view>
      </view>
      <view class="settings-list">
        <view class="settings-row" bindtap="editPhone">
          <view class="settings-row__label">手机号</view>
          <view class="settings-row__right"><text class="settings-row__value">{{phoneLabel}}</text><text class="settings-row__action">修改</text></view>
        </view>
        <view wx:if="{{canSwitchToCoach}}" class="settings-row" bindtap="switchToCoach">
          <view class="settings-row__label">切换到教练身份</view>
          <view class="settings-row__chevron">›</view>
        </view>
        <view class="settings-row" bindtap="logout">
          <view class="settings-row__label settings-row__label--danger"><text class="settings-row__icon">⊘</text>退出登录</view>
          <view class="settings-row__chevron">›</view>
        </view>
      </view>
    </block>
  </view>
</view>
