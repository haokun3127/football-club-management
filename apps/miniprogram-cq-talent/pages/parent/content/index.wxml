<view class="content-page">
  <view class="page-nav page-nav--plain" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="page-nav__title">内容中心</view>
    <view class="page-nav__action" bindtap="toggleSearch" aria-label="搜索文章"><image class="page-nav__action-icon" src="/assets/icons/search.svg" mode="aspectFit" /></view>
  </view>
  <view class="content-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载内容中心' : state === 'empty' ? '暂无内容' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="loadArticles"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="featured-card">
        <image class="featured-card__photo" src="/assets/content/featured-venue.jpg" mode="aspectFill" />
        <view class="featured-card__scrim"></view>
        <view class="featured-card__content">
          <view class="featured-card__chip">场地</view>
          <view class="featured-card__title">球场预订指南</view>
          <view class="featured-card__subtitle">了解各场地设施与预订流程</view>
        </view>
      </view>

      <view class="section-title">快速入口</view>
      <view class="quick-grid">
        <view
          wx:for="{{quickLinks}}"
          wx:key="label"
          class="quick-card"
          data-category="{{item.category}}"
          bindtap="openQuickLink"
        >
          <view class="quick-card__icon" style="background: {{item.color}}1a"><image src="{{item.icon}}" mode="aspectFit" /></view>
          <view class="quick-card__label">{{item.label}}</view>
        </view>
      </view>


      <view class="section-title">最近文章</view>
      <view class="article-list">
        <view wx:if="{{searchOpen}}" class="search-bar">
          <input class="search-bar__input" value="{{searchQuery}}" placeholder="搜索文章标题或内容" bindinput="onSearchInput" focus="{{true}}" />
        </view>
        <view wx:if="{{hasVisibleArticles}}">
          <view wx:for="{{visibleArticles}}" wx:key="id" class="article-card" data-id="{{item.id}}" bindtap="openArticle">
            <view class="article-card__accent" style="background: {{item.accent}}"></view>
            <view class="article-card__content">
              <view class="article-card__title">{{item.title}}</view>
              <view class="article-card__subtitle">{{item.subtitle}}</view>
            </view>
            <image class="article-card__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>
        <view wx:else class="article-empty">{{emptyMessage}}</view>
      </view>
    </block>
  </view>
  <role-tabbar role="parent" active="discover" />
</view>
