.content-page {
  min-height: 100vh;
  background: var(--color-page);
}

.content-page__body {
  padding: 32rpx 32rpx 180rpx;
}

.page-nav { height: 88rpx; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav--plain { justify-content: space-between; }
.page-nav__title { font-size: 40rpx; font-weight: 700; color: var(--color-text); }
.page-nav__action { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; background: #f6f7f9; }
.page-nav__action--disabled { opacity: 0.45; }
.page-nav__action-icon { width: 36rpx; height: 36rpx; }
.icon-search { width: 26rpx; height: 26rpx; border: 4rpx solid var(--color-text); border-radius: 50%; box-sizing: border-box; position: relative; }
.icon-search::after { content: ""; position: absolute; width: 12rpx; height: 4rpx; background: var(--color-text); right: -9rpx; bottom: -4rpx; transform: rotate(45deg); border-radius: 4rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 32rpx 0 24rpx;
}

/* 分类 pills（Figma: 32px 高, r20, active #a80f1b） */
.pills {
  white-space: nowrap;
}

.pills__inner {
  display: inline-flex;
  gap: 16rpx;
}

.pill {
  padding: 16rpx 32rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.pill--active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #ffffff;
  font-weight: 700;
}


/* 快速入口网格 */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.quick-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  padding: 32rpx;
}

.quick-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.quick-card__label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 文章卡片 */
.article-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.article-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  padding: 24rpx;
}

.article-card__accent {
  width: 8rpx;
  height: 72rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.article-card__content {
  flex: 1;
  min-width: 0;
}

.article-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-card__subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
