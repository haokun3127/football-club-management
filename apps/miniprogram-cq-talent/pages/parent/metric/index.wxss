.page { padding-bottom: 24rpx; }
.latest-value { margin-top: 24rpx; color: #e60012; font-size: 54rpx; font-weight: 700; }
.unit { font-size: 24rpx; font-weight: 400; }
.trend-row,
.source-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.trend-row:last-child,
.source-row:last-child { border-bottom: 0; }
.strong { color: #1f2329; font-weight: 700; }
.source-link { color: #e60012; font-size: 24rpx; }
