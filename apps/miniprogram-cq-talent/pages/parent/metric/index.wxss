.metric-page { min-height: 100vh; background: #f6f7f9; }
.metric-page__body { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }
.metric-hero { margin-bottom: 20rpx; padding: 28rpx; border-radius: 28rpx; background: linear-gradient(145deg,var(--color-brand) 0%,var(--color-brand-pressed) 100%); color: #fff; box-shadow: 0 18rpx 36rpx rgba(127,11,20,.18); }
.metric-hero__eyebrow { color: rgba(255,255,255,.68); font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.metric-hero__title { margin-top: 8rpx; font-size: 38rpx; font-weight: 700; }
.metric-hero__description { margin-top: 10rpx; color: rgba(255,255,255,.76); font-size: 23rpx; line-height: 1.5; }
.metric-hero__value { margin-top: 28rpx; font-size: 64rpx; font-weight: 750; }
.metric-hero__foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; color: rgba(255,255,255,.7); font-size: 21rpx; }
.metric-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.record-count { padding: 8rpx 14rpx; border-radius: 999rpx; background: #f2f4f7; color: #667085; font-size: 21rpx; }
.trend-list { margin-top: 12rpx; }
.trend-row { display: flex; gap: 18rpx; }
.trend-row__axis { display: flex; flex-direction: column; align-items: center; width: 20rpx; }
.trend-row__dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; margin-top: 23rpx; border: 5rpx solid #fceeef; border-radius: 50%; background: var(--color-brand); }
.trend-row__line { flex: 1; width: 2rpx; min-height: 80rpx; background: #e7eaf0; }
.trend-row:last-child .trend-row__line { background: transparent; }
.trend-row__content { flex: 1; min-width: 0; padding: 14rpx 0 24rpx; }
.trend-row__value { color: #202124; font-size: 30rpx; font-weight: 700; }
.trend-row__meta { margin-top: 8rpx; color: #667085; font-size: 22rpx; }
.trend-row__note { margin-top: 10rpx; padding: 14rpx; border-radius: 12rpx; background: #f8f9fb; color: #667085; font-size: 22rpx; line-height: 1.5; }
.source-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f7; }
.source-row:last-child { border-bottom: 0; }
.source-row__mark { display: flex; flex: 0 0 56rpx; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 16rpx; background: #fceeef; color: var(--color-brand); font-size: 23rpx; font-weight: 700; }
.source-row__content { flex: 1; min-width: 0; }
.source-row__title { overflow: hidden; color: #202124; font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.source-link { color: var(--color-brand); font-size: 23rpx; font-weight: 600; }
.privacy-note { display: flex; gap: 16rpx; padding: 22rpx; border-radius: 20rpx; background: #f0fff4; }
.privacy-note__icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--color-success); color: #fff; font-size: 22rpx; }
.privacy-note__title { margin-bottom: 4rpx; color: #202124; font-size: 25rpx; font-weight: 650; }
