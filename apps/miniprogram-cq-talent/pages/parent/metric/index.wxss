.p6 { min-height: 100vh; background: #f6f7f9; }

/* P6 NavHeader */
.p6-nav { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; box-sizing: content-box; height:44px; padding: 0 32rpx; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }

.p6-body { padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 24rpx; }

/* P6 HeroCard */
.mhero { display: flex; flex-direction: column; gap: 28rpx; padding: 40rpx; border-radius: 40rpx; background:var(--color-card); }
.mhero__top { display: flex; align-items: center; justify-content: space-between; }
.mhero__label { color:var(--color-text); font-size: var(--font-size-body); font-weight: 700; }
.mhero__score-row { display: flex; align-items: flex-end; gap: 12rpx; }
.mhero__score { color:var(--color-text); font-size:32px; font-weight: 900; line-height: 1; }
.mhero__score-unit { color:var(--color-text-secondary); font-size: var(--font-size-body); padding-bottom: 16rpx; }
.mhero__divider { height: 1rpx; background:transparent; }
.mhero__foot { display: flex; align-items: center; gap: 16rpx; }
.mhero__badge {     font-size: var(--font-size-aux); font-weight: 700;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.mhero__foot-text { color:var(--color-text-secondary); font-size: var(--font-size-aux); }

/* P6 TrendChart */







.comment-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.comment-row__content { flex: 1; min-width: 0; }
.comment-row__name { color: #202124; font-size: var(--font-size-aux); font-weight: 700; }
.comment-row__date { margin-left: 12rpx; color:var(--color-text-secondary); font-size: var(--font-size-aux); font-weight: 400; }
.comment-row__text { margin-top: 10rpx; color: #475467; font-size: var(--font-size-aux); line-height: 1.6; }
.metric-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.record-count { padding: 8rpx 14rpx; border-radius: 999rpx; background: #f2f4f7; color: #667085; font-size: var(--font-size-aux); }
.trend-list { margin-top: 12rpx; }
.trend-row { display: flex; gap: 18rpx; }
.trend-row__axis { display: flex; flex-direction: column; align-items: center; width: 20rpx; }
.trend-row__dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; margin-top: 23rpx; border: 5rpx solid #fceeef; border-radius: 50%; background: var(--color-brand); }
.trend-row__line { flex: 1; width: 2rpx; min-height: 80rpx; background: #e7eaf0; }
.trend-row:last-child .trend-row__line { background: transparent; }
.trend-row__content { flex: 1; min-width: 0; padding: 14rpx 0 24rpx; }
.trend-row__value { color: #202124; font-size: var(--font-size-body); font-weight: 700; }
.trend-row__meta { margin-top: 8rpx; color: #667085; font-size: var(--font-size-aux); }
.trend-row__note { margin-top: 10rpx; padding: 14rpx; border-radius: 12rpx; background: #f8f9fb; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.source-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f7; }
.source-row:last-child { border-bottom: 0; }
.source-row__mark { display: flex; flex: 0 0 56rpx; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 16rpx; background: #fceeef; color: var(--color-brand); font-size: var(--font-size-aux); font-weight: 700; }
.source-row__content { flex: 1; min-width: 0; }
.source-row__title { overflow: hidden; color: #202124; font-size: var(--font-size-section); font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.source-link { color: var(--color-brand); font-size: var(--font-size-aux); font-weight: 600; }
.privacy-note { display: flex; gap: 16rpx; padding: 22rpx; border-radius: 20rpx; background: #f0fff4; }
.privacy-note__icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--color-success); color: #fff; font-size: var(--font-size-aux); }
.privacy-note__title { margin-bottom: 4rpx; color: #202124; font-size: var(--font-size-section); font-weight: 650; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.p6-nav__back,
.source-row { min-height:44px; min-width:44px; box-sizing:border-box; }
