.p6 { min-height: 100vh; background: #f6f7f9; }

/* P6 NavHeader */
.p6-nav { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; box-sizing: content-box; height: 88rpx; padding: 0 32rpx; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }
.p6-nav__back { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #f6f7f9; display: flex; align-items: center; justify-content: center; }
.p6-nav__back image { width: 36rpx; height: 36rpx; }
.p6-nav__title { flex: 1; text-align: center; color: #202124; font-size: 34rpx; font-weight: 700; }
.p6-nav__range { padding: 10rpx 20rpx; border: 1rpx solid #e7eaf0; border-radius: 999rpx; color: #202124; font-size: 24rpx; }

.p6-body { padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 24rpx; }

/* P6 HeroCard */
.mhero { display: flex; flex-direction: column; gap: 28rpx; padding: 40rpx; border-radius: 40rpx; background: #07111f; }
.mhero__top { display: flex; align-items: center; justify-content: space-between; }
.mhero__label { color: #ffffff; font-size: 36rpx; font-weight: 700; }
.mhero__trend { padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(22, 163, 74, 0.1); color: #22c55e; font-size: 24rpx; font-weight: 700; }
.mhero__score-row { display: flex; align-items: flex-end; gap: 12rpx; }
.mhero__score { color: #ffffff; font-size: 128rpx; font-weight: 900; line-height: 1; }
.mhero__score-unit { color: rgba(255, 255, 255, 0.5); font-size: 40rpx; padding-bottom: 16rpx; }
.mhero__divider { height: 1rpx; background: rgba(255, 255, 255, 0.1); }
.mhero__foot { display: flex; align-items: center; gap: 16rpx; }
.mhero__badge { padding: 6rpx 16rpx; border-radius: 8rpx; background: #a80f1b; color: #ffffff; font-size: 22rpx; font-weight: 700; }
.mhero__badge--success { background: #16a34a; }
.mhero__badge--warning { background: #d97706; }
.mhero__badge--info { background: #475569; }
.mhero__foot-text { color: rgba(255, 255, 255, 0.6); font-size: 26rpx; }

/* P6 TrendChart */
.chart-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border-radius: 32rpx; background: #ffffff; }
.chart-card__head { display: flex; align-items: center; justify-content: space-between; }
.chart-card__title { color: #202124; font-size: 30rpx; font-weight: 700; }
.chart-card__range { color: #667085; font-size: 24rpx; }
.chart-card__body { display: flex; gap: 16rpx; }
.chart-card__y { display: flex; flex: 0 0 48rpx; flex-direction: column; justify-content: space-between; height: 320rpx; }
.chart-card__y-label { color: #98a2b3; font-size: 20rpx; text-align: right; }
.chart-card__plot { position: relative; flex: 1; height: 320rpx; }
.chart-grid { height: 1rpx; margin-top: 64rpx; background: rgba(0, 0, 0, 0.06); }
.chart-area { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(168, 15, 27, 0.28), rgba(168, 15, 27, 0.02)); }
.chart-segment { position: absolute; height: 4rpx; margin-top: -2rpx; border-radius: 2rpx; background: #a80f1b; transform-origin: left center; }
.chart-dot { position: absolute; width: 16rpx; height: 16rpx; margin-left: -8rpx; margin-bottom: -8rpx; border-radius: 50%; background: #a80f1b; }
.chart-dot--current { width: 24rpx; height: 24rpx; margin-left: -12rpx; margin-bottom: -12rpx; box-shadow: 0 0 0 12rpx rgba(168, 15, 27, 0.2); }
.chart-dot__label { position: absolute; bottom: 28rpx; left: 50%; transform: translateX(-50%); padding: 4rpx 12rpx; border-radius: 8rpx; background: #a80f1b; color: #ffffff; font-size: 20rpx; font-weight: 700; white-space: nowrap; }
.chart-card__x { display: flex; justify-content: space-between; padding-left: 64rpx; }
.chart-card__x-label { color: #667085; font-size: 20rpx; }
.peer-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.peer-row__label { flex: 0 0 120rpx; color: #667085; font-size: 24rpx; }
.peer-row__bar { flex: 1; height: 16rpx; border-radius: 8rpx; background: #f2f4f7; overflow: hidden; }
.peer-row__fill { height: 100%; border-radius: 8rpx; }
.peer-row__fill--mine { background: #a80f1b; }
.peer-row__fill--peer { background: #cbd5e1; }
.peer-row__value { flex: 0 0 80rpx; color: #202124; font-size: 26rpx; font-weight: 700; text-align: right; }
.comment-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.comment-row__avatar { display: flex; flex: 0 0 72rpx; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: #a80f1b; color: #ffffff; font-size: 28rpx; font-weight: 700; }
.comment-row__content { flex: 1; min-width: 0; }
.comment-row__name { color: #202124; font-size: 26rpx; font-weight: 700; }
.comment-row__date { margin-left: 12rpx; color: #98a2b3; font-size: 22rpx; font-weight: 400; }
.comment-row__text { margin-top: 10rpx; color: #475467; font-size: 26rpx; line-height: 1.6; }
.metric-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.record-count { padding: 8rpx 14rpx; border-radius: 999rpx; background: #f2f4f7; color: #667085; font-size: 21rpx; }
.trend-list { margin-top: 12rpx; }
.trend-row { display: flex; gap: 18rpx; }
.trend-row__axis { display: flex; flex-direction: column; align-items: center; width: 20rpx; }
.trend-row__dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; margin-top: 23rpx; border: 5rpx solid #fceeef; border-radius: 50%; background: var(--color-brand); }
.trend-row__line { flex: 1; width: 2rpx; min-height: 80rpx; background: #e7eaf0; }
.trend-row:last-child .trend-row__line { background: transparent; }
.trend-row__content { flex: 1; min-width: 0; padding: 14rpx 0 24rpx; }
.trend-row__value { color: #202124; font-size: 30rpx; font-weight: 700; }
.trend-row__meta { margin-top: 8rpx; color: #667085; font-size: 22rpx; }
.trend-row__note { margin-top: 10rpx; padding: 14rpx; border-radius: 12rpx; background: #f8f9fb; color: #667085; font-size: 22rpx; line-height: 1.5; }
.source-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f7; }
.source-row:last-child { border-bottom: 0; }
.source-row__mark { display: flex; flex: 0 0 56rpx; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 16rpx; background: #fceeef; color: var(--color-brand); font-size: 23rpx; font-weight: 700; }
.source-row__content { flex: 1; min-width: 0; }
.source-row__title { overflow: hidden; color: #202124; font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.source-link { color: var(--color-brand); font-size: 23rpx; font-weight: 600; }
.privacy-note { display: flex; gap: 16rpx; padding: 22rpx; border-radius: 20rpx; background: #f0fff4; }
.privacy-note__icon { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--color-success); color: #fff; font-size: 22rpx; }
.privacy-note__title { margin-bottom: 4rpx; color: #202124; font-size: 25rpx; font-weight: 650; }
