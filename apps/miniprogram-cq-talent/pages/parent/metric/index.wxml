<view class="page">
  <view class="card hero-card">
    <view class="title">指标详情</view>
    <view class="subtitle">当前指标：{{metricId || '未选择'}}</view>
  </view>

  <status-view
    state="pending"
    title="指标详情准备中"
    message="趋势、来源记录和相关训练内容将在数据同步完成后显示。"
  />

  <view class="card">
    <view class="section-title">权限边界</view>
    <view class="subtitle">仅展示当前家长绑定孩子的 parent-visible 指标；前端不计算评测公式。</view>
  </view>
</view>
