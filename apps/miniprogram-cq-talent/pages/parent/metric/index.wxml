<view class="p6">
  <!-- P6 NavHeader -->
  <app-header title="{{detail ? detail.label : ''}} 指标详情" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />

  <view class="p6-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载指标详情' : '暂时无法查看'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <!-- P6 HeroCard -->
    <view wx:if="{{detail}}" class="mhero">
      <view class="mhero__top">
        <view class="mhero__label">{{detail.label}}</view>
      </view>
      <view class="mhero__score-row">
        <text class="mhero__score">{{heroValue}}</text>
        <text class="mhero__score-unit">{{heroMaxLabel}}</text>
      </view>
      <view class="mhero__divider"></view>
      <view class="mhero__foot">
        <view class="mhero__badge">{{records.length}} 项记录</view>
        <view class="mhero__foot-text">{{latestDateLabel}} · 持续追踪中</view>
      </view>
    </view>

    <view wx:if="{{refreshing}}" class="subtitle">正在更新指标记录…</view>
    <view wx:if="{{refreshMessage}}" class="metric-card"><view class="subtitle">{{refreshMessage}}</view><t-button bindtap="retry" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">重试</t-button></view>
    <view wx:if="{{detail}}" class="metric-card"><view class="section-title">历史可比性</view><view class="subtitle">{{comparabilityMessage}}</view><t-button bindtap="openConfirmedResults" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">查看已确认原始成绩</t-button></view>

    <!-- P6 个人历史（无经核定标准时以个人历史为主体，REQ-PAR-004） -->
    <view wx:if="{{detail}}" class="metric-card">
      <view class="section-heading"><view><view class="section-title">变化记录</view><view class="subtitle">按时间查看每次记录、单位与来源</view></view><view class="record-count">{{records.length}} 次</view></view>
      <view wx:if="{{records.length}}" class="trend-list">
        <view wx:for="{{records}}" wx:key="id" class="trend-row">
          <view class="trend-row__axis"><view class="trend-row__dot"></view><view class="trend-row__line"></view></view>
          <view class="trend-row__content">
            <view class="row"><view class="trend-row__value">{{item.valueLabel}}</view><status-chip label="{{item.changeLabel}}" tone="{{item.changeTone}}" compact="{{true}}" /></view>
            <view class="trend-row__meta">{{item.dateLabel}} · {{item.source}}</view>
            <view wx:if="{{item.note}}" class="trend-row__note">{{item.note}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="subtitle">暂无可展示的历史记录。</view>
    </view>

    <!-- P6 CoachComment（最新记录带评语时展示） -->
    <view wx:if="{{detail && coachCommentText}}" class="metric-card">
      <view class="section-title">记录备注</view>
      <view class="comment-row">

        <view class="comment-row__content">
          <view class="comment-row__name">来源记录 <text class="comment-row__date">{{coachCommentDate}}</text></view>
          <view class="comment-row__text">{{coachCommentText}}</view>
        </view>
      </view>
    </view>

    <!-- 数据来源 -->
    <view wx:if="{{detail}}" class="metric-card">
      <view class="section-title">数据来源</view>
      <view wx:if="{{sourceEvents.length}}">
        <view wx:for="{{sourceEvents}}" wx:key="recordId" class="source-row" data-id="{{item.eventId}}" bindtap="openSourceEvent">
          <view class="source-row__mark">{{item.typeSymbol}}</view><view class="source-row__content"><view class="source-row__title">{{item.title}}</view><view class="subtitle">{{item.typeLabel}} · {{item.startsAtLabel}}</view></view><view class="source-link">查看 ›</view>
        </view>
      </view>
      <view wx:else class="subtitle">当前记录暂无可跳转的活动来源。</view>
    </view>

    <view wx:if="{{detail}}" class="privacy-note"><view class="privacy-note__icon">✓</view><view><view class="privacy-note__title">孩子数据已保护</view><view class="subtitle">这里只展示当前孩子可见的能力结果与来源。</view></view></view>
  </view>
</view>
