.reminders-page {
  min-height: 100vh;
  background: var(--color-page);
}

.reminders-page__body {
  padding: 24rpx var(--space-page) 180rpx;
}

/* 分组标题（Figma: 12px Bold #667085） */
.reminder-section {
  margin-bottom: 48rpx;
}

.reminder-section__title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
}

/* 提醒卡片（Figma: 白底 r12，pad 16px，H gap 12px，shadow 0,2,8,rgba(0,0,0,.05)） */
.reminder-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.reminder-item__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.reminder-item__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.reminder-item__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.reminder-item__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-item__ago {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.reminder-item__time {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text);
  flex-shrink: 0;
}

/* 已读态（Figma Earlier: 标题/时间 #667085，圆点 #e7eaf0） */
.reminder-item--read .reminder-item__title,
.reminder-item--read .reminder-item__time {
  color: var(--color-text-secondary);
}
