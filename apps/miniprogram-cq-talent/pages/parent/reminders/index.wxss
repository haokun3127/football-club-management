.reminders-page { min-height: 100vh; background: #f6f7f9; }
.reminders-nav { position: relative; display: flex; box-sizing: content-box; align-items: center; justify-content: space-between; height: 88rpx; padding: 0 200rpx 0 32rpx; background: #ffffff; }.reminders-nav__back { display: flex; align-items: center; gap: 12rpx; height: 40rpx; color: #202124; font-size: 28rpx; font-weight: 500; line-height: 34rpx; }.reminders-nav__back image { width: 40rpx; height: 40rpx; }.reminders-nav__title { flex: 1; color: #202124; font-size: 34rpx; font-weight: 700; line-height: 42rpx; text-align: center; }.reminders-nav__read { box-sizing: border-box; height: 54rpx; padding: 12rpx 24rpx; border-radius: 32rpx; background: #fceeef; color: #a80f1b; font-size: 24rpx; font-weight: 600; line-height: 30rpx; }
.reminders-page__body { display: flex; flex-direction: column; gap: 48rpx; padding: 48rpx 44rpx calc(160rpx + env(safe-area-inset-bottom)); }.reminder-section { display: flex; flex-direction: column; gap: 24rpx; }.reminder-section--earlier { margin-top: 0; }.reminder-section__title { color: #667085; font-size: 24rpx; font-weight: 700; line-height: 30rpx; }
.reminder-item { display: flex; box-sizing: border-box; align-items: center; width: 662rpx; height: 132rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); }.reminder-item__dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; margin-right: 24rpx; border-radius: 50%; }.reminder-item__icon { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; }.reminder-item__icon image { width: 32rpx; height: 32rpx; }.reminder-item__main { flex: 1; min-width: 0; margin-left: 24rpx; }.reminder-item__title { overflow: hidden; color: #202124; font-size: 28rpx; font-weight: 600; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }.reminder-item__ago { margin-top: 4rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; }.reminder-item__time { flex: 0 0 auto; margin-left: 16rpx; color: #202124; font-size: 24rpx; font-weight: 500; line-height: 30rpx; }.reminder-item--read .reminder-item__title,.reminder-item--read .reminder-item__time { color: #667085; }
.reminders-empty { display: flex; flex-direction: column; align-items: center; gap: 24rpx; margin-top: 64rpx; color: #667085; font-size: 28rpx; line-height: 34rpx; text-align: center; }.reminders-empty__icon { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 50%; background: #f3f4f6; }.reminders-empty__icon image { width: 64rpx; height: 64rpx; }
.reminders-empty--footer { margin-top: 0; gap: 16rpx; font-size: 24rpx; }.reminders-empty__icon--sm { width: 96rpx; height: 96rpx; }.reminders-empty__icon--sm image { width: 48rpx; height: 48rpx; }
