.reminders-page { min-height: 100vh; background: #f6f7f9; }
.reminders-page__body { display: flex; flex-direction: column; gap: 48rpx; padding: 48rpx 44rpx calc(160rpx + env(safe-area-inset-bottom)); }.reminder-section { display: flex; flex-direction: column; gap: 24rpx; }.reminder-section--earlier { margin-top: 0; }.reminder-section__title { color: #667085; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.reminder-item { display: flex; box-sizing: border-box; align-items: center; width: 662rpx; height: 132rpx; padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow:none; }.reminder-item__dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; margin-right: 24rpx; border-radius: 50%; }.reminder-item__icon { display: flex; flex: 0 0 64rpx; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; }.reminder-item__icon image { width: 32rpx; height: 32rpx; }.reminder-item__main { flex: 1; min-width: 0; margin-left: 24rpx; }.reminder-item__title { overflow: hidden; color: #202124; font-size: var(--font-size-section); font-weight: 600; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }.reminder-item__ago { margin-top: 4rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }.reminder-item__time { flex: 0 0 auto; margin-left: 16rpx; color: #202124; font-size: var(--font-size-aux); font-weight: 500; line-height: 1.5; }.reminder-item--read .reminder-item__title,.reminder-item--read .reminder-item__time { color: #667085; }
.reminders-empty { display: flex; flex-direction: column; align-items: center; gap: 24rpx; margin-top: 64rpx; color: #667085; font-size: var(--font-size-body); line-height: 1.5; text-align: center; }.reminders-empty__icon { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 50%; background: #f3f4f6; }.reminders-empty__icon image { width: 64rpx; height: 64rpx; }
.reminders-empty--footer { margin-top: 0; gap: 16rpx; font-size: var(--font-size-aux); }.reminders-empty__icon--sm { width: 96rpx; height: 96rpx; }.reminders-empty__icon--sm image { width: 48rpx; height: 48rpx; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.reminders-nav__back,
.reminders-nav__read { min-height:44px; min-width:44px; box-sizing:border-box; }
