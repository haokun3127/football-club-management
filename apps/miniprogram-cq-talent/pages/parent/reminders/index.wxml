<view class="reminders-page">
  <view class="reminders-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="reminders-nav__back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /><view>返回</view></view>
    <view class="reminders-nav__title">提醒中心</view>
    <view wx:if="{{unreadCount}}" class="reminders-nav__read" bindtap="markAllRead">全部已读</view>
  </view>

  <view class="reminders-page__body">
    <status-view state="{{state === 'empty' ? 'idle' : state}}" title="{{state === 'loading' ? '加载提醒' : '提醒读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view wx:if="{{today.length}}" class="reminder-section">
        <view class="reminder-section__title">今天</view>
        <view wx:for="{{today}}" wx:key="id" class="reminder-item {{item.read ? 'reminder-item--read' : ''}}">
          <view class="reminder-item__dot" style="background: {{item.read ? '#e7eaf0' : item.dotColor}}"></view>
          <view class="reminder-item__icon" style="background: {{item.iconBg}}"><image src="{{item.iconSrc}}" mode="aspectFit" /></view>
          <view class="reminder-item__main"><view class="reminder-item__title">{{item.title}}</view><view class="reminder-item__ago">{{item.timeAgo}}</view></view>
          <view class="reminder-item__time">{{item.timeLabel}}</view>
        </view>
      </view>
      <view wx:if="{{earlier.length}}" class="reminder-section reminder-section--earlier">
        <view class="reminder-section__title">更早</view>
        <view wx:for="{{earlier}}" wx:key="id" class="reminder-item {{item.read ? 'reminder-item--read' : ''}}">
          <view class="reminder-item__dot" style="background: {{item.read ? '#e7eaf0' : item.dotColor}}"></view>
          <view class="reminder-item__icon" style="background: {{item.iconBg}}"><image src="{{item.iconSrc}}" mode="aspectFit" /></view>
          <view class="reminder-item__main"><view class="reminder-item__title">{{item.title}}</view><view class="reminder-item__ago">{{item.timeAgo}}</view></view>
          <view class="reminder-item__time">{{item.timeLabel}}</view>
        </view>
      </view>
    </block>
    <view wx:if="{{state === 'empty'}}" class="reminders-empty"><view class="reminders-empty__icon"><image src="/assets/icons/empty-reminders.svg" mode="aspectFit" /></view><view>暂无新提醒</view></view>
  </view>
  <role-tabbar role="parent" active="schedule" />
</view>
