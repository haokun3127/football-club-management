.c151-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 140rpx;
  background: var(--color-page);
}

.c151-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  box-sizing: content-box;
  align-items: center;
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  background: var(--color-brand-soft);
}

.c151-nav__back,
.c151-nav__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c151-nav__back-icon {
  width: 48rpx;
  height: 48rpx;
}

.c151-nav__title {
  flex: 1;
  margin-left: 0;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.c151-page__body {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  padding: 80rpx 44rpx 64rpx;
}

.c151-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.c151-success__circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.05);
}

.c151-success__check {
  width: 80rpx;
  height: 80rpx;
}

.c151-success__title {
  margin-top: 32rpx;
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.c151-success__subtitle {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 34rpx;
}

.c151-summary {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.05);
}

.c151-summary__details {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.c151-summary__head,
.c151-summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c151-summary__title,
.c151-summary__value {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.c151-summary__chip {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #fce7e7;
  color: var(--color-brand);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.c151-summary__label {
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 34rpx;
}

.c151-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.c151-actions__primary,
.c151-actions__secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  font-weight: 600;
}

.c151-actions__primary {
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 32rpx;
  line-height: 40rpx;
}

.c151-actions__secondary {
  height: 96rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 48rpx;
  background: #ffffff;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 36rpx;
}
