.c151-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 140rpx;
  background: var(--color-page);
}

.c151-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  box-sizing: content-box;
  align-items: center;
  width: 100%;
  height:44px;
  padding: 0 32rpx;
  background: var(--color-brand-soft);
}

.c151-nav__back,
.c151-nav__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c151-nav__back-icon {
  width: 48rpx;
  height: 48rpx;
}

.c151-nav__title {
  flex: 1;
  margin-left: 0;
  color: var(--color-text);
  font-size: var(--font-size-display);
  font-weight: 700;
  line-height: 1.5;
}

.c151-page__body {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  padding: 80rpx 44rpx 64rpx;
}

.c151-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.c151-success__circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #ffffff;
  box-shadow:none;
}

.c151-success__check {
  width: 80rpx;
  height: 80rpx;
}

.c151-success__title {
  margin-top: 32rpx;
  color: var(--color-text);
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 1.5;
}

.c151-success__subtitle {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.c151-summary {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:none;
}

.c151-summary__details {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.c151-summary__head,
.c151-summary__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c151-summary__title,
.c151-summary__value {
  color: var(--color-text);
  font-size: var(--font-size-section);
  font-weight: 600;
  line-height: 1.5;
}

.c151-summary__chip {




  font-size: var(--font-size-aux);
  font-weight: 600;
  line-height: 1.5;
 background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}

.c151-summary__label {
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
  line-height: 1.5;
}

.c151-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.c151-actions__primary,
.c151-actions__secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  font-weight: 600;
}

.c151-actions__primary {
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: var(--font-size-body);
  line-height: 1.5;
}

.c151-actions__secondary {
  height: 96rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 48rpx;
  background: #ffffff;
  color: var(--color-text-secondary);
  font-size: var(--font-size-body);
  line-height: 1.5;
}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.c151-actions__primary,
.c151-actions__secondary,
.c151-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
