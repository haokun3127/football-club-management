.submit-page {
  min-height: 100vh;
  background: var(--color-page);
}

.submit-page__body {
  padding: 80rpx var(--space-page) 180rpx;
  display: flex;
  flex-direction: column;
  gap: 64rpx;
}

.success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.success__circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-card);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #188754;
}

.success__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.success__subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.summary-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.summary-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.summary-card__chip {
  padding: 8rpx 16rpx;
  background: #fce7e7;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.summary-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-card__label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.summary-card__value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.actions__primary {
  background: var(--color-brand);
  border-radius: 52rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.actions__secondary {
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 48rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}
