<view class="c151-page">
  <view class="c151-nav" style="padding-top:{{navInset}}px">
    <view class="c151-nav__back" bindtap="backToList" aria-label="返回列表">
      <image class="c151-nav__back-icon" src="/assets/icons/c12-arrow-left.svg" mode="aspectFit" />
    </view>
    <view class="c151-nav__title">评估提交</view>
  </view>

  <view class="c151-page__body">
    <status-view
      wx:if="{{state === 'empty'}}"
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
    />

    <block wx:elif="{{state === 'ready'}}">
      <view class="c151-success">
        <view class="c151-success__circle">
          <image class="c151-success__check" src="/assets/icons/c151-check.svg" mode="aspectFit" />
        </view>
        <view class="c151-success__title">{{taskTitle}}已提交</view>
        <view class="c151-success__subtitle">已记录本次评估提交</view>
      </view>

      <view class="c151-summary">
        <view class="c151-summary__head">
          <view class="c151-summary__title">{{taskTitle}}</view>
          <view class="c151-summary__chip">已提交</view>
        </view>
        <view class="c151-summary__details">
          <view class="c151-summary__row">
            <text class="c151-summary__label">学员数</text>
            <text class="c151-summary__value">{{countLabel}}</text>
          </view>
          <view class="c151-summary__row">
            <text class="c151-summary__label">评估日期</text>
            <text class="c151-summary__value">{{dateLabel}}</text>
          </view>
        </view>
      </view>

      <view class="c151-actions">
        <view class="c151-actions__primary" bindtap="viewResults">查看结果</view>
        <view class="c151-actions__secondary" bindtap="backToList">返回列表</view>
      </view>
    </block>
  </view>
  <role-tabbar role="coach" active="training" />
</view>
