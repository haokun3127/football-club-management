.team-selector-page { min-height: 100vh; background: #f5f6f8; }.team-selector-nav { display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding-left: 32rpx; background: #ffffff; }.team-selector-nav__back { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #f5f6f8; }.team-selector-nav__back image { display: block; width: 32rpx; height: 32rpx; }.team-selector-nav__title { margin-left: 24rpx; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; }.team-selector-page__body { padding: 48rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); }.team-selector__title { color: #202124; font-size: 28rpx; font-weight: 700; line-height: 36rpx; }.team-selector__copy { margin-top: 12rpx; color: #667085; font-size: 24rpx; line-height: 32rpx; }.team-selector__list { margin-top: 32rpx; }.team-option { display: flex; box-sizing: border-box; align-items: center; justify-content: space-between; min-height: 164rpx; padding: 28rpx 32rpx; border: 1rpx solid #e7eaf0; border-radius: 28rpx; background: #ffffff; }.team-option + .team-option { margin-top: 24rpx; }.team-option--selected { border: 2rpx solid #a80f1b; background: #fff1f2; }.team-option__text { min-width: 0; flex: 1; }.team-option__name { overflow: hidden; color: #202124; font-size: 34rpx; font-weight: 600; line-height: 42rpx; text-overflow: ellipsis; white-space: nowrap; }.team-option__meta { margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; }.team-option--selected .team-option__meta { color: #a80f1b; }.team-option__check { display: flex; flex: 0 0 60rpx; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 50%; background: #a80f1b; }.team-option__check-image { display: block; width: 36rpx; height: 36rpx; }.team-option__chevron { display: block; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; }.team-selector__footer { margin-top: 24rpx; color: #98a2b3; font-size: 24rpx; line-height: 34rpx; }.team-selector__footer + .team-selector__footer { margin-top: 8rpx; }
