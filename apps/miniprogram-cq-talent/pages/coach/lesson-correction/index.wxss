.correction-page {
  min-height: 100vh;
  background: var(--color-page);
}

.correction-page__body {
  padding: 44rpx var(--space-page) calc(268rpx + env(safe-area-inset-bottom));
}

.correction-intro,
.student-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--color-card);
}

.correction-intro__title,
.student-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.correction-intro__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.correction-intro {
  position: relative;
  padding-left: 36rpx;
}

.correction-intro::before {
  position: absolute;
  top: 30rpx;
  bottom: 30rpx;
  left: 16rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #f59e0b;
  content: "";
}

.student-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.student-row:last-child {
  border-bottom: 0;
}

.student-row__avatar {
  display: flex;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 600;
}

.student-row__info {
  min-width: 0;
  flex: 1;
}

.student-row__name {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-row__balance {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.student-row__tag {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: #fff7ed;
  color: #d97706;
  font-size: 22rpx;
  font-weight: 600;
}

.student-row__stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.student-row__button {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-line);
  border-radius: 10rpx;
  color: var(--color-text);
  font-size: 32rpx;
}

.student-row__delta {
  min-width: 72rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.student-row__delta--changed {
  color: var(--color-brand);
}

.submit-error {
  margin: 0 0 16rpx;
  color: #b42318;
  font-size: 24rpx;
}

.lesson-correction-submit {
  position: fixed;
  right: 0;
  bottom: 140rpx;
  left: 0;
  z-index: 50;
  box-sizing: border-box;
  padding: 22rpx var(--space-page);
  border-top: 1rpx solid var(--color-line);
  background: rgba(246, 247, 249, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(16, 24, 40, 0.06);
}

.lesson-correction-submit__button {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 104rpx;
}
