.correction-page {
  min-height: 100vh;
  background: var(--color-page);
}

.correction-page__body {
  padding: 24rpx var(--space-page) 200rpx;
}

.alert-header {
  display: flex;
  gap: 20rpx;
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.alert-header__bar {
  width: 8rpx;
  border-radius: 4rpx;
  background: #f59e0b;
}

.alert-header__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.alert-header__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.student-card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.student-card__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.student-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.student-row:last-child {
  border-bottom: none;
}

.student-row__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
}

.student-row__info {
  flex: 1;
}

.student-row__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.student-row__base {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.student-row__stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.student-row__btn {
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-text);
}

.student-row__delta {
  min-width: 88rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

.student-row__delta--changed {
  color: var(--color-brand);
}

.reason-card {
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.reason-card__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.reason-card__input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.submit-button {
  background: var(--color-brand);
  border-radius: 999rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.submit-button--disabled {
  opacity: 0.5;
}
