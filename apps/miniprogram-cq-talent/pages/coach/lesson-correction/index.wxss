.correction-page {
  min-height: 100vh;
  background: var(--color-page);
}

.correction-page__body {
  padding: 24rpx var(--space-page) 220rpx;
}

.correction-intro,
.student-card,
.reason-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--color-card);
}

.correction-intro__title,
.student-card__title,
.reason-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.correction-intro__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.student-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.student-row:last-child {
  border-bottom: 0;
}

.student-row__info {
  min-width: 0;
  flex: 1;
}

.student-row__name {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-row__balance {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.student-row__stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.student-row__button {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-line);
  border-radius: 10rpx;
  color: var(--color-text);
  font-size: 32rpx;
}

.student-row__delta {
  min-width: 72rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.student-row__delta--changed {
  color: var(--color-brand);
}

.reason-card__title {
  margin-bottom: 16rpx;
}

.reason-card__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 10rpx;
  color: var(--color-text);
  font-size: 26rpx;
}

.submit-error {
  margin: 0 0 16rpx;
  color: #b42318;
  font-size: 24rpx;
}

.submit-button {
  padding: 28rpx;
  border-radius: 999rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.submit-button--disabled {
  opacity: 0.5;
}
