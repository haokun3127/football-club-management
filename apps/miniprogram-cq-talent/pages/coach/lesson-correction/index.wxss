.correction-page {
  min-height: 100vh;
  background: var(--color-page);
}

.correction-page__body {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding: 44rpx var(--space-page) calc(320rpx + env(safe-area-inset-bottom));
}

.correction-intro,
.student-card {
  box-sizing: border-box;
  margin: 0;
  border-radius: 24rpx;
  background: var(--color-card);
}

.correction-intro__title,
.student-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.correction-intro__text {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
}

.correction-intro {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 32rpx 32rpx 32rpx 56rpx;
}

.correction-intro::before {
  position: absolute;
  top: 32rpx;
  bottom: 32rpx;
  left: 32rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: #f59e0b;
  content: "";
}

.student-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
}

.student-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 80rpx;
}

.student-row__avatar {
  display: flex;
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 600;
}

.student-row__info {
  min-width: 0;
  flex: 1;
}

.student-row__name {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-row__balance {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.student-row__tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #fff7ed;
  color: #d97706;
  font-size: 22rpx;
  font-weight: 600;
}

.student-row__adjustment {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 160rpx;
  height: 80rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: var(--color-text);
}

.student-row__delta {
  min-width: 44rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.student-row__delta--changed {
  color: var(--color-brand);
}

.student-row__adjustment-arrows {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
}

.student-row__adjustment-arrow {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.student-row__adjustment-arrow::after {
  position: absolute;
  left: 7rpx;
  width: 10rpx;
  height: 10rpx;
  border-color: var(--color-text);
  border-style: solid;
  border-width: 0 2rpx 2rpx 0;
  content: "";
}

.student-row__adjustment-arrow--up::after {
  top: 8rpx;
  transform: rotate(225deg);
}

.student-row__adjustment-arrow--down::after {
  top: 2rpx;
  transform: rotate(45deg);
}

.submit-error {
  margin: 0 0 16rpx;
  color: #b42318;
  font-size: 24rpx;
}

.lesson-correction-submit {
  position: fixed;
  right: 0;
  bottom: 140rpx;
  left: 0;
  z-index: 50;
  box-sizing: border-box;
  padding: 0 var(--space-page) 40rpx;
  background: transparent;
}

.lesson-correction-submit__button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  border-radius: 52rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.lesson-correction-submit__button--disabled {
  opacity: 0.72;
}
