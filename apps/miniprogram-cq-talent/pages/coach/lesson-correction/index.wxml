<view class="correction-page">
  <app-header theme="soft" title="课时更正" title-align="left" show-back />
  <view class="correction-page__body">
    <status-view wx:if="{{state !== 'ready' && state !== 'idle'}}"
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
      action-text="{{statusAction}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready' && hasRows}}">
      <view class="correction-intro">
        <view class="correction-intro__title">
          <view class="correction-intro__warning">
            <view class="correction-intro__warning-bar"></view>
            <view class="correction-intro__warning-dot"></view>
          </view>
          <text>课时记录异常</text>
        </view>
        <view class="correction-intro__text">请检查并更正以下学员的课时记录</view>
      </view>

      <view class="student-card">
        <view class="student-card__title">需更正学员</view>
        <view wx:for="{{rows}}" wx:key="studentId" class="student-row">
          <view class="student-row__avatar" style="background: {{item.avatarColor}}">{{item.avatarLetter}}</view>
          <view class="student-row__info">
            <view class="student-row__name">{{item.name}}</view>
            <view class="student-row__balance">{{item.balanceText}}</view>
          </view>
          <view class="student-row__tag">课时调整</view>
          <view class="student-row__adjustment">
            <view class="student-row__delta {{item.delta !== 0 ? 'student-row__delta--changed' : ''}}">{{item.deltaLabel}}</view>
            <view class="student-row__adjustment-arrows">
              <view class="student-row__adjustment-arrow student-row__adjustment-arrow--up" data-student-id="{{item.studentId}}" data-direction="{{1}}" bindtap="adjustDelta"></view>
              <view class="student-row__adjustment-arrow student-row__adjustment-arrow--down" data-student-id="{{item.studentId}}" data-direction="{{-1}}" bindtap="adjustDelta"></view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{hasRows}}" class="lesson-correction-submit">
        <view wx:if="{{submitting}}" class="lesson-correction-submit__button lesson-correction-submit__button--disabled">保存中...</view>
        <view wx:else class="lesson-correction-submit__button" bindtap="submit">保存更正</view>
      </view>

      <view wx:if="{{hasSubmitError}}" class="submit-error">{{submitError}}</view>
    </block>
  </view>
  <role-tabbar role="coach" active="schedule" />
</view>
