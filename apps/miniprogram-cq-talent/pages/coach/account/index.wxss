.c163-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.c163-page__body {
  padding: 32rpx 44rpx 180rpx;
}

.c163-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.c163-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow:none;
}

.c163-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: 32rpx;
}

.c163-profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid #a80f1b;
  border-radius: 48rpx;
  background: #fceeef;
  color: #a80f1b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-body);
  font-weight: 700;
}

.c163-profile__info {
  min-width: 0;
  flex: 1;
}

.c163-profile__name {
  color: #202124;
  font-size: var(--font-size-body);
  font-weight: 700;
  line-height: 1.5;
}

.c163-profile__team {
  margin-top: 8rpx;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.c163-profile__badge {
  display: inline-flex;
  box-sizing: border-box;
  margin-top: 4rpx;


  font-size: var(--font-size-aux);
  font-weight: 600;
  line-height: 1.5;
      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.c163-profile__badge--pending {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.c163-profile__badge--bound {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.c163-list {
  overflow: hidden;
}

.c163-row {
  min-height: 90rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.c163-row--line {
  border-top: 1rpx solid #e7eaf0;
}

.c163-row__label {
  color: #202124;
  font-size: var(--font-size-body);
  font-weight: 500;
}

.c163-row__value {
  flex: 1;
  color: #667085;
  font-size: var(--font-size-aux);
  text-align: right;
}

.c163-row__binding-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-width: 0;
}

.c163-row__action {
  flex: 0 0 auto;
  color: #a80f1b;
  font-size: var(--font-size-body);
  font-weight: 600;
  line-height: 1.5;
}

.c163-row__label-with-icon {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.c163-row__binding-icon {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}

.c163-row__value--pending {
  color: #667085;
}

.c163-row__value--bound {
  color: #34c759;
  font-weight: 600;
}

.c163-row__arrow {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.c163-nav__back,
.c163-row,
.c163-row__action { min-height:44px; min-width:44px; box-sizing:border-box; }
