.c163-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.c163-nav {
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-right: 200rpx;
  padding-left: 32rpx;
  background: #fceeef;
}

.c163-nav__back {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c163-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.c163-nav__back-icon {
  width: 40rpx;
  height: 40rpx;
}

.c163-nav__title {
  flex: 1;
  color: #202124;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
}

.c163-nav__placeholder {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c163-page__body {
  padding: 32rpx 44rpx 180rpx;
}

.c163-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.c163-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.c163-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}

.c163-profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid #a80f1b;
  border-radius: 48rpx;
  background: #fceeef;
  color: #a80f1b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.c163-profile__info {
  min-width: 0;
  flex: 1;
}

.c163-profile__name {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
}

.c163-profile__team {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
}

.c163-list {
  overflow: hidden;
}

.c163-row {
  min-height: 84rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.c163-row--line {
  border-top: 1rpx solid #e7eaf0;
}

.c163-row__label {
  color: #202124;
  font-size: 28rpx;
  font-weight: 500;
}

.c163-row__value {
  flex: 1;
  color: #667085;
  font-size: 24rpx;
  text-align: right;
}
