.c163-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.c163-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-right: 200rpx;
  padding-left: 32rpx;
  background: #fceeef;
}

.c163-nav__back {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c163-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.c163-nav__back-icon {
  width: 40rpx;
  height: 40rpx;
}

.c163-nav__title {
  flex: 1;
  color: #202124;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: left;
}

.c163-nav__placeholder {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c163-page__body {
  padding: 32rpx 44rpx 180rpx;
}

.c163-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.c163-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.c163-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: 32rpx;
}

.c163-profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid #a80f1b;
  border-radius: 48rpx;
  background: #fceeef;
  color: #a80f1b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.c163-profile__info {
  min-width: 0;
  flex: 1;
}

.c163-profile__name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.c163-profile__name {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.c163-profile__edit {
  box-sizing: border-box;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fceeef;
  color: #a80f1b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 26rpx;
}

.c163-profile__team {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 32rpx;
}

.c163-profile__badge {
  display: inline-flex;
  box-sizing: border-box;
  margin-top: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 26rpx;
}

.c163-profile__badge--pending {
  background: #f2f4f7;
  color: #667085;
}

.c163-list {
  overflow: hidden;
}

.c163-row {
  min-height: 90rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.c163-row--line {
  border-top: 1rpx solid #e7eaf0;
}

.c163-row__label {
  color: #202124;
  font-size: 28rpx;
  font-weight: 500;
}

.c163-row__value {
  flex: 1;
  color: #667085;
  font-size: 24rpx;
  text-align: right;
}

.c163-row__right {
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-width: 0;
}

.c163-row__action {
  flex: 0 0 auto;
  color: #a80f1b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.c163-row__label-with-icon {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.c163-row__binding-icon {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid #34c759;
  border-radius: 50%;
  color: #34c759;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.c163-row__value--pending {
  color: #667085;
}

.c163-row__arrow {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}
