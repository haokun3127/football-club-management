.account-page {
  min-height: 100vh;
  background: var(--color-page);
}

.account-page__body {
  padding: 24rpx var(--space-page) 180rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-card {
  display: flex;
  gap: 24rpx;
  background: var(--color-card);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.profile-card__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fceeef;
  border: 4rpx solid var(--color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.profile-card__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-card__name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.profile-card__edit {
  padding: 2rpx 12rpx;
  background: #fceeef;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.profile-card__team {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.profile-card__badge {
  align-self: flex-start;
  padding: 2rpx 12rpx;
  background: #e8f5e9;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2e7d32;
}

.settings-list {
  background: var(--color-card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.settings-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-row__label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.settings-row__label--danger {
  color: var(--color-brand);
}

.settings-row__icon {
  font-size: 28rpx;
}

.settings-row__right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.settings-row__value {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.settings-row__action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.settings-row__chevron {
  font-size: 36rpx;
  color: var(--color-text-secondary);
}
