<view class="account-page">
  <app-header title="账号设置" show-back />
  <view class="account-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载账号信息' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <!-- 资料卡（Figma C16.3: 头像 + 姓名 + 编辑 + 队伍 + 已认证） -->
      <view class="profile-card">
        <view class="profile-card__avatar">{{coachInitial}}</view>
        <view class="profile-card__info">
          <view class="profile-card__name-row">
            <text class="profile-card__name">{{coachName}}</text>
            <text class="profile-card__edit" bindtap="editName">编辑</text>
          </view>
          <view class="profile-card__team">{{teamLabel}}</view>
          <view class="profile-card__badge">已认证</view>
        </view>
      </view>

      <!-- 设置列表 -->
      <view class="settings-list">
        <view class="settings-row" bindtap="editPhone">
          <view class="settings-row__label">手机号</view>
          <view class="settings-row__right">
            <text class="settings-row__value">{{phoneLabel}}</text>
            <text class="settings-row__action">修改</text>
          </view>
        </view>
        <view class="settings-row" bindtap="logout">
          <view class="settings-row__label settings-row__label--danger">
            <text class="settings-row__icon">⊘</text>退出登录
          </view>
          <view class="settings-row__chevron">›</view>
        </view>
      </view>
    </block>
  </view>
  <role-tabbar role="coach" active="me" />
</view>
