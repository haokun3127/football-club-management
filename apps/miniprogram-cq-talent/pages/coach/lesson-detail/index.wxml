<view class="lesson-detail-page">
  <app-header theme="soft" title="销课详情" title-align="left" show-back />

  <view class="lesson-detail-page__body">
    <status-view
      wx:if="{{state !== 'ready' && state !== 'idle' && state !== 'empty'}}"
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
      action-text="{{statusAction}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="detail-hero">
        <view class="detail-hero__title">{{eventTitle}}</view>
        <view class="detail-hero__meta detail-hero__meta--muted">{{eventPrimaryMeta}}</view>
        <view class="detail-hero__meta">{{eventSecondaryMeta}}</view>
      </view>

      <view class="detail-card">
        <view class="detail-card__header">
          <view class="detail-card__title">出勤与课时</view>
          <view class="detail-card__count">{{rosterStatusLabel}}</view>
        </view>
        <view wx:for="{{rows}}" wx:key="studentId" class="detail-row">
          <view class="detail-row__avatar">{{item.avatarLetter}}</view>
          <view class="detail-row__main">
            <view class="detail-row__name">{{item.name}}</view>
          </view>
          <view class="detail-row__lesson-chip">{{item.lessonLabel}}</view>
        </view>
      </view>

      <view class="detail-actions">
        <view class="detail-actions__primary" bindtap="openTrainingContent">查看训练内容</view>
        <view class="detail-actions__correction" bindtap="openCorrection">更正本次销课</view>
      </view>
    </block>

    <view wx:if="{{state === 'empty'}}" class="detail-empty">
      <view class="detail-empty__title">{{statusTitle}}</view>
      <view class="detail-empty__message">{{message}}</view>
    </view>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
