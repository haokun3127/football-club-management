.lesson-detail-page {
  min-height: 100vh;
  background: var(--color-page);
}

.lesson-detail-page__body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: calc(100vh - 176rpx);
  padding: 22rpx 44rpx 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero {
  padding: 36rpx;
  border-radius: 28rpx;
  background: #07111f;
}

.detail-hero__eyebrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.detail-hero__name {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.detail-hero__meta {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 34rpx;
}

.detail-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-card);
}

.detail-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.detail-card__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.detail-card__count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.detail-row,
.project-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.detail-row:last-child,
.project-row:last-child {
  border-bottom: 0;
}

.detail-row__avatar {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 700;
}

.detail-row__main {
  min-width: 0;
  flex: 1;
}

.detail-row__name {
  overflow: hidden;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row__meta,
.detail-card__empty {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.detail-row__lesson {
  flex: 0 0 auto;
  color: var(--color-brand);
  font-size: 24rpx;
  font-weight: 600;
}

.project-row__dot {
  flex: 0 0 16rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-brand);
}

.project-row__name {
  color: var(--color-text);
  font-size: 26rpx;
}

.detail-card__empty {
  margin: 0;
  padding: 28rpx 32rpx;
  line-height: 34rpx;
}

.detail-correction {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 48rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  text-align: center;
}

.detail-empty__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.detail-empty__message {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}
