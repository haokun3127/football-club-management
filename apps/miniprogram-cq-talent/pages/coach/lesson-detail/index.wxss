.lesson-detail-page {
  min-height: 100vh;
  background: var(--color-page);
}

.lesson-detail-page__body {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  min-height: calc(100vh - 176rpx);
  padding: 44rpx 44rpx 0;
  padding-bottom: calc(324rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero {
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
}

.detail-hero__title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.detail-hero__meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 34rpx;
}

.detail-hero__meta--muted { margin-top: 24rpx; color: rgba(255, 255, 255, .6); }

.detail-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-card);
}

.detail-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.detail-card__title {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.detail-card__count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-row__avatar {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 700;
}

.detail-row__main {
  min-width: 0;
  flex: 1;
}

.detail-row__name {
  overflow: hidden;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row__lesson-chip {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #dcfce7;
  color: #22c55e;
  font-size: 24rpx;
  font-weight: 600;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 8rpx;
}

.detail-actions__primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 24rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.detail-actions__correction {
  color: var(--color-brand);
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
  text-decoration: underline;
}

.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  text-align: center;
}

.detail-empty__title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 700;
}

.detail-empty__message {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}
