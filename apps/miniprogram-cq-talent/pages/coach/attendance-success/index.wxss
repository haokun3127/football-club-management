.success-page {
  min-height: 100vh;
  background: var(--color-page);
}

.success-page__body {
  display: flex;
  flex-direction: column;
  gap: 80rpx;
  min-height: 720rpx;
  padding: 160rpx var(--space-page) 200rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.hero__circle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 16rpx 24rpx rgba(34, 197, 94, 0.25);
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 700;
}

.hero__title {
  color: var(--color-text);
  font-size: 40rpx;
  font-weight: 700;
}

.hero__subtitle,
.page-state__message {
  color: var(--color-text-secondary);
  font-size: 28rpx;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: none;
}

.summary-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-card__label {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.summary-card__value {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.actions,
.page-state {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.page-state {
  align-items: stretch;
  justify-content: center;
  min-height: 360rpx;
  text-align: center;
}

.actions__primary,
.actions__secondary {
  width: 100%;
  min-height: 96rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.actions__primary {
  border: 0;
  background: var(--color-brand);
  color: #ffffff;
}

.actions__secondary {
  border: 1rpx solid var(--color-line);
  background: var(--color-card);
  color: var(--color-text-secondary);
}
