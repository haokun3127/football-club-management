.success-page {
  min-height: 100vh;
  background: var(--color-page);
}

.success-page__body {
  padding: 100rpx var(--space-page) 180rpx;
  display: flex;
  flex-direction: column;
  gap: 56rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.hero__circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 16rpx 48rpx rgba(34, 197, 94, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
}

.hero__subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.summary-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.summary-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-card__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.summary-card__value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.actions__primary {
  background: var(--color-brand);
  border-radius: 999rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.actions__secondary {
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}
