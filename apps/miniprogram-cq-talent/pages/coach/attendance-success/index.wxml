<view class="success-page">
  <app-header theme="soft" title="出勤管理" title-align="left" show-back />

  <view class="success-page__body" wx:if="{{state === 'loading'}}">
    <view class="page-state">正在读取出勤记录</view>
  </view>

  <view class="success-page__body" wx:elif="{{state === 'ready'}}">
    <view class="hero">
      <view class="hero__circle">✓</view>
      <view class="hero__title">出勤记录已提交</view>
      <view class="hero__subtitle">{{summary.present}}名已到场，{{summary.absent}}名未到场</view>
    </view>

    <view class="summary-card">
      <view class="summary-card__row">
        <text class="summary-card__label">课程</text>
        <text class="summary-card__value">{{eventTitle}}</text>
      </view>
      <view class="summary-card__row">
        <text class="summary-card__label">日期</text>
        <text class="summary-card__value">{{eventDate}}</text>
      </view>
      <view class="summary-card__row">
        <text class="summary-card__label">出席</text>
        <text class="summary-card__value">{{attendanceText}}</text>
      </view>
      <view class="summary-card__row">
        <text class="summary-card__label">时间</text>
        <text class="summary-card__value">{{eventTime}}</text>
      </view>
    </view>

    <view class="actions">
      <button class="actions__primary" bindtap="openWorkbench">查看训练详情</button>
    </view>
  </view>

  <view class="success-page__body" wx:else>
    <view class="page-state">
      <view class="page-state__message">{{message}}</view>
      <button class="actions__primary" wx:if="{{state === 'error'}}" bindtap="retry">重新读取</button>
      <button class="actions__secondary" bindtap="openSchedule">返回日程</button>
    </view>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
