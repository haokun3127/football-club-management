.match-edit-page { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); background: var(--color-page); }
.match-edit-page__body { display: flex; flex-direction: column; gap: 32rpx; padding: 32rpx var(--space-page) calc(200rpx + env(safe-area-inset-bottom)); }
.match-edit-hero { padding: 40rpx; border-radius: 32rpx; background: #07111f; color: #ffffff; }
.match-edit-hero__eyebrow { color: #fda4af; font-size: 24rpx; line-height: 30rpx; }
.match-edit-hero__title { margin-top: 20rpx; font-size: 40rpx; font-weight: 700; line-height: 48rpx; }
.match-edit-hero__team { margin-top: 16rpx; color: rgba(255,255,255,.76); font-size: 26rpx; line-height: 34rpx; }
.match-edit-card { padding: 16rpx 32rpx; border-radius: 28rpx; background: var(--color-card); box-shadow: 0 8rpx 24rpx rgba(0,0,0,.04); }
.match-edit-field { padding: 24rpx 0; border-bottom: 1rpx solid var(--color-line); }
.match-edit-field:last-child { border-bottom: 0; }
.match-edit-field__label { margin-bottom: 16rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 30rpx; }
.match-edit-field__input,.match-edit-picker { box-sizing: border-box; width: 100%; height: 80rpx; padding: 0 24rpx; border-radius: 14rpx; background: var(--color-page); color: var(--color-text); font-size: 30rpx; line-height: 80rpx; }
.match-edit-picker { display: flex; align-items: center; justify-content: space-between; }
.match-edit-picker text { color: var(--color-text-secondary); font-size: 38rpx; }
.match-edit-score { display: flex; align-items: center; justify-content: center; gap: 20rpx; }
.match-edit-score__input { box-sizing: border-box; width: 220rpx; height: 96rpx; border-radius: 16rpx; background: var(--color-page); color: var(--color-text); font-size: 44rpx; font-weight: 700; line-height: 96rpx; text-align: center; }
.match-edit-score__colon { color: var(--color-text); font-size: 42rpx; font-weight: 700; }
.match-edit-error { color: #b42318; font-size: 25rpx; line-height: 36rpx; }
.match-edit-save { display: flex; align-items: center; justify-content: center; height: 104rpx; border-radius: 52rpx; background: var(--color-brand); color: #ffffff; font-size: 32rpx; font-weight: 700; }
.match-edit-save--disabled { opacity: .65; }
