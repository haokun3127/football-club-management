<view class="projects-page">
  <view class="projects-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><view class="projects-nav__back" bindtap="goBack" aria-label="返回"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view><view class="projects-nav__title">{{taskTitle}}</view><view class="projects-nav__spacer"></view></view>
  <view class="projects-page__body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载测评项目' : state === 'empty' ? '暂无测评项目' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="projects-context">{{teamContextLabel}}</view>
      <view class="projects-progress"><view class="projects-progress__head"><view class="projects-progress__title">请选择测评项目</view><view class="projects-progress__status {{taskStatusClass}}">{{taskStatusLabel}}</view></view><view class="projects-progress__meta">{{projectProgressLabel}}</view><view class="projects-progress__instruction">请选择下方测评项目开始录入</view></view>
      <view class="project-list">
        <view wx:for="{{projects}}" wx:key="id" class="{{item.cardClass}}" data-id="{{item.id}}" bindtap="toggleProject">
          <view class="project-card__content">
            <view class="project-card__name">{{item.title}}</view>
            <view class="project-card__description">{{item.description}}</view>
            <view class="project-card__meta">
              <text>{{item.itemCountLabel}}</text>
              <text class="project-card__status {{item.completedStudents > 0 ? 'project-card__status--active' : ''}}">{{item.statusLabel}}</text>
            </view>
          </view>
          <view class="{{item.selectClass}}" aria-label="{{item.isSelected ? '已选择' : '未选择'}}">
            <image wx:if="{{item.isSelected}}" src="/assets/icons/c10-check-circle.svg" mode="aspectFit" />
          </view>
        </view>
        <view wx:if="{{!projects.length}}" class="inline-empty">当前没有可录入的测评项目。</view>
      </view>
    </block>
  </view>
  <view wx:if="{{state === 'ready'}}" class="projects-select-bar">
    <view class="projects-select-bar__summary"><view class="projects-select-bar__title">测评项目</view><view class="projects-select-bar__count">{{selectedCount ? '已选 ' + selectedCount + ' 项' : '请选择测评项目'}}</view></view>
    <view class="{{confirmClass}}" bindtap="confirmSelection" aria-disabled="{{isConfirmDisabled}}"><text>{{confirmLabel}}</text></view>
  </view>
</view>
