<view class="projects-page">
  <app-header title="测评项目" title-align="left" show-back="{{true}}" back-disabled="{{publishing}}" />
  <view class="projects-page__body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载测评项目' : state === 'empty' ? '暂无测评项目' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="projects-task-title">{{taskTitle}}</view><view class="projects-context">{{teamContextLabel}}</view>
      <view class="projects-progress"><view class="projects-progress__head"><view class="projects-progress__title">请选择测评项目</view><view class="projects-progress__status {{taskStatusClass}}">{{taskStatusLabel}}</view></view><view class="projects-progress__meta">{{projectProgressLabel}}</view><view class="projects-progress__meta">{{studentProgressLabel}}</view><view class="projects-progress__instruction">请选择本次需要测评的项目</view></view>
      <view wx:if="{{managed}}" class="projects-publication">
        <view>{{publicationLabel}}</view>
        <t-button disabled="{{publishing}}" loading="{{publishing}}" bindtap="openReviewList" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">核对成绩并确认发布</t-button>
        <view wx:if="{{publicationMessage}}">{{publicationMessage}}</view>
      </view>
      <scroll-view wx:if="{{hasContentTree}}" scroll-x class="content-primary-strip" enhanced show-scrollbar="{{false}}">
        <view class="content-primary-strip__inner">
          <view wx:for="{{primaryNodes}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="selectPrimary">
            <text class="content-primary__label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{hasContentTree}}" class="content-layout">
        <scroll-view scroll-y class="content-secondary-rail" enhanced show-scrollbar="{{false}}">
          <view wx:for="{{secondaryNodes}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="selectSecondary">
            <text class="content-secondary__label">{{item.label}}</text>
          </view>
          <view wx:if="{{!secondaryNodes.length}}" class="content-secondary__empty">暂无子项</view>
        </scroll-view>

        <view class="content-results">
          <block wx:for="{{tertiaryGroups}}" wx:key="id" wx:for-item="group">
            <view class="content-tertiary-group">
              <view class="content-tertiary-group__head">
                <text class="content-tertiary-group__title">{{group.label}}</text>
                <text class="content-tertiary-group__count">{{group.actionCount}} 项</text>
              </view>
              <view class="content-action-grid">
                <view wx:for="{{group.cards}}" wx:key="id" class="{{item.cardClass}}" data-id="{{item.id}}" bindtap="toggleProject">
                  <view class="content-action-card__body">
                    <view class="content-action-card__name">{{item.title}}</view>
                    <view class="content-action-card__meta">
                      <text class="content-action-card__quantity">{{item.itemCountLabel}}</text>
                      <text class="content-action-card__duration">{{item.statusLabel}}</text>
                    </view>
                    <view class="content-action-card__point">{{item.description}}</view>
                  </view>
                  <view class="{{item.selectClass}}" aria-label="{{item.isSelected ? '已选择' : '未选择'}}">
                    <image wx:if="{{item.isSelected}}" src="/assets/icons/c10-check-circle.svg" mode="aspectFit" />
                  </view>
                </view>
              </view>
            </view>
          </block>
          <view wx:if="{{!hasActionCards}}" class="inline-empty">当前分类暂无测评项目。</view>
        </view>
      </view>

      <view wx:if="{{!hasContentTree}}" class="project-list">
        <view wx:for="{{projects}}" wx:key="id" class="{{item.cardClass}}" data-id="{{item.id}}" bindtap="toggleProject">
          <view class="project-card__content">
            <view class="project-card__name">{{item.title}}</view>
            <view class="project-card__description">{{item.description}}</view>
            <view class="project-card__meta">
              <text>{{item.itemCountLabel}}</text>
              <text class="project-card__status {{item.completedStudents > 0 ? 'project-card__status--active' : ''}}">{{item.statusLabel}}</text>
            </view>
          </view>
          <view class="{{item.selectClass}}" aria-label="{{item.isSelected ? '已选择' : '未选择'}}">
            <image wx:if="{{item.isSelected}}" src="/assets/icons/c10-check-circle.svg" mode="aspectFit" />
          </view>
        </view>
        <view wx:if="{{!projects.length}}" class="inline-empty">当前没有可录入的测评项目。</view>
      </view>
    </block>
  </view>
  <submit-bar wx:if="{{state === 'ready' && !reviewVisible}}" primary-text="{{confirmLabel}}" disabled="{{isConfirmDisabled || publishing}}" bindsubmit="confirmSelection" hint="选择本次录入项目，保存后再核对确认" />
</view>

<view wx:if="{{reviewVisible}}" class="review-mask">
  <view class="review-panel">
    <view class="review-head"><text>逐人核对</text><t-button size="small" disabled="{{publishing || reviewLoading}}" bindtap="closeReview" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">关闭</t-button></view>
    <scroll-view scroll-x class="review-students"><view class="review-students__row"><t-button wx:for="{{reviewStudents}}" wx:key="studentId" size="small" class="{{reviewStudentId === item.studentId ? 'review-selected' : ''}}" data-id="{{item.studentId}}" bindtap="chooseReviewStudent" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="{{reviewStudentId === item.studentId ? 'review-selected' : ''}}" theme="primary" variant="text">{{item.name}} · {{item.completedFields}}/{{item.totalFields}}</t-button></view></scroll-view>
    <view class="review-name">{{reviewLoading ? '正在读取…' : reviewName}}</view>
    <scroll-view scroll-y class="review-results"><view wx:for="{{reviewRows}}" wx:key="id" class="review-result"><view>{{item.label}} <text>{{item.value}}</text></view><view class="review-result__source">{{item.course}}</view><view class="review-result__source">{{item.recorded}}</view></view></scroll-view>
    <view wx:if="{{reviewMessage}}" class="review-message">{{reviewMessage}}</view>
    <t-button class="review-confirm" disabled="{{!reviewCanPublish || publishing || reviewLoading}}" loading="{{publishing}}" bindtap="confirmReviewedStudent" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="review-confirm" theme="primary" variant="base">确认发布该学员</t-button>
  </view>
</view>
