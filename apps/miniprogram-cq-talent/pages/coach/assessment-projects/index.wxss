.projects-page { min-height: 100vh; background: #f6f7f9; }
.projects-nav { position: sticky; top: 0; z-index: 100; display: flex; box-sizing: content-box; align-items: center; height:44px; padding-left: 32rpx; background: #ffffff; }
.projects-nav__back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.projects-nav__back image { width: 48rpx; height: 48rpx; }
.projects-nav__title { min-width: 0; flex: 1; margin-left: 24rpx; overflow: hidden; color: #202124; font-size: var(--font-size-display); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.projects-nav__spacer { flex: 0 0 auto; width: 48rpx; height: 48rpx; }
.projects-page__body { padding: 16rpx 32rpx 180rpx; }
.projects-context { color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.projects-progress { box-sizing: border-box; margin-top: 24rpx; padding: 28rpx 32rpx; border-radius: 32rpx; background: #ffffff; }
.projects-progress__head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.projects-progress__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.projects-progress__meta { margin-top: 8rpx; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.projects-progress__instruction { margin-top: 12rpx; color: #a80f1b; font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; }
.projects-progress__status { flex: 0 0 auto;   font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5;       background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.projects-progress__status--in_progress {         background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.projects-progress__status--completed {         background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.project-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 20rpx; }
.project-card { display: flex; align-items: center; gap: 20rpx; min-height: 144rpx; box-sizing: border-box; padding: 24rpx; border: 2rpx solid transparent; border-radius: 24rpx; background: #ffffff; box-shadow:none; }
.project-card--selected { border-color: #a80f1b; background: #fff8f8; box-shadow:none; }
.project-card__icon { display: flex; width: 72rpx; height: 72rpx; flex: 0 0 72rpx; align-items: center; justify-content: center; border-radius: 20rpx; }
.project-card__icon image { width: 40rpx; height: 40rpx; }
.project-card__icon--tone-0 { background: #fee2e2; }
.project-card__icon--tone-1 { background: #fef3c7; }
.project-card__icon--tone-2 { background: #e0e7ff; }
.project-card__icon--tone-3 { background: #d1fae5; }
.project-card__info { min-width: 0; flex: 1; }
.project-card__name { overflow: hidden; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.project-card__meta { display: flex; gap: 16rpx; margin-top: 6rpx; color:var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; }
.project-card__description { margin-top: 4rpx; overflow: hidden; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.project-card__select { display: flex; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; margin-left: auto; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #d0d5dd; border-radius: 50%; background: #ffffff; }
.project-card__select image { width: 40rpx; height: 40rpx; }
.project-card__select--selected { border: 0; background: transparent; }
.projects-select-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 25; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; min-height: 140rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7eaf0; background: rgba(255,255,255,.98); box-shadow:none; }
.projects-select-bar__summary { display: flex; flex-direction: column; gap: 4rpx; }
.projects-select-bar__title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.projects-select-bar__count { color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.projects-select-bar__confirm { display: flex; min-width: 184rpx; height: 80rpx; align-items: center; justify-content: center; padding: 0 28rpx; border-radius: 16rpx; background: #a80f1b; color: #ffffff; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; text-align: center; }
.projects-select-bar__confirm--disabled { background: #d0d5dd; color: #ffffff; }

.content-primary-strip {
  margin: 24rpx -32rpx 20rpx;
  padding-left: 32rpx;
  white-space: nowrap;
}

.content-primary-strip__inner {
  display: flex;
  gap: 14rpx;
  padding-right: 32rpx;
}

.content-primary {
  display: inline-flex;
  min-width: 132rpx;
  height: 68rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 34rpx;
  background: #ffffff;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
  white-space: nowrap;
}

.content-primary--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 700;
}

.content-layout {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.content-secondary-rail {
  width: 142rpx;
  max-height: 760rpx;
  flex: 0 0 142rpx;
  box-sizing: border-box;
  padding: 8rpx 0 120rpx;
}

.content-secondary {
  display: flex;
  min-height: 76rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 18rpx;
  border-left: 4rpx solid transparent;
  border-radius: 4rpx 18rpx 18rpx 4rpx;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.content-secondary--active {
  border-left-color: #a80f1b;
  background: #fceeef;
  color: #a80f1b;
  font-weight: 700;
}

.content-secondary__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-secondary__empty {
  padding: 18rpx;
  color:var(--color-text-secondary);
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.content-results {
  min-width: 0;
  flex: 1;
}

.content-tertiary-group {
  margin-bottom: 28rpx;
}

.content-tertiary-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 4rpx 0 16rpx;
}

.content-tertiary-group__title {
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-tertiary-group__count {
  flex: 0 0 auto;
  color:var(--color-text-secondary);
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.content-action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.content-action-card {
  position: relative;
  min-width: 0;
  min-height: 152rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:none;
}

.content-action-card--selected {
  border-color: #a80f1b;
  box-shadow:none;
}

.content-action-card__body {
  min-width: 0;
  padding: 24rpx 72rpx 24rpx 24rpx;
}

.content-action-card__name {
  min-height: 40rpx;
  overflow: hidden;
  color: #202124;
  font-size: var(--font-size-body);
  font-weight: 700;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.content-action-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 30rpx;
  margin-top: 6rpx;
}

.content-action-card__quantity,
.content-action-card__duration {
  max-width: 100%;
  overflow: hidden;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__quantity {
  color: #a80f1b;
  font-weight: 700;
}

.content-action-card__point {
  margin-top: 4rpx;
  overflow: hidden;
  color:var(--color-text-secondary);
  font-size: var(--font-size-aux);
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__select {
  position: absolute;
  top: 50%;
  right: 24rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #d0d5dd;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  transform: translateY(-50%);
}

.content-action-card__select--selected {
  border: 0;
  background: transparent;
}

.content-action-card__select image {
  width: 40rpx;
  height: 40rpx;
}

.projects-publication { margin-bottom: 24rpx; padding: 24rpx; border: 1rpx solid #d9dde3; border-radius: 16rpx; background: #fff; font-size: var(--font-size-aux); line-height: 1.6; }
.projects-publication button { margin: 16rpx 0; font-size: var(--font-size-aux); }

.review-mask { position:fixed;inset:0;z-index:120;background:rgba(10,17,28,.48);display:flex;align-items:flex-end; }
.review-panel { width:100%;max-height:86vh;box-sizing:border-box;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff;display:flex;flex-direction:column; }
.review-head { display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size: var(--font-size-body); }
.review-head button { margin:0; }
.review-students { width:100%; margin:20rpx 0; }
.review-students__row { display:flex;gap:12rpx; }
.review-students button { flex-shrink:0;margin:0;font-size: var(--font-size-aux); }
.review-selected { color:#a80f1b!important;background:#fbecee!important; }
.review-name { font-weight:700;font-size: var(--font-size-body); margin-bottom:12rpx; }
.review-results { height:42vh; }
.review-result { padding:20rpx 0;border-bottom:1rpx solid #e8eaf0;font-size: var(--font-size-aux); }
.review-result text { float:right;font-weight:700; }
.review-result__source { color:#697386;font-size: var(--font-size-aux);line-height: 1.5; }
.review-message { font-size: var(--font-size-aux);color:#a80f1b;padding:16rpx 0; }
.review-confirm { width:100%;margin-top:20rpx;background:#a80f1b;color:#fff;font-size: var(--font-size-body); }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.projects-nav__back { min-height:44px; min-width:44px; box-sizing:border-box; }
