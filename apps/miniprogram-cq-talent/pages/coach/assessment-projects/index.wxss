.projects-page { min-height: 100vh; background: #f6f7f9; }
.projects-nav { position: sticky; top: 0; z-index: 100; display: flex; box-sizing: content-box; align-items: center; height: 88rpx; padding-left: 32rpx; background: #ffffff; }
.projects-nav__back { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.projects-nav__back image { width: 48rpx; height: 48rpx; }
.projects-nav__title { min-width: 0; flex: 1; margin-left: 24rpx; overflow: hidden; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.projects-nav__spacer { flex: 0 0 auto; width: 48rpx; height: 48rpx; }
.projects-page__body { padding: 16rpx 32rpx 180rpx; }
.projects-context { color: #667085; font-size: 26rpx; line-height: 40rpx; }
.projects-progress { box-sizing: border-box; margin-top: 24rpx; padding: 28rpx 32rpx; border-radius: 32rpx; background: #ffffff; }
.projects-progress__head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.projects-progress__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 44rpx; }
.projects-progress__meta { margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 36rpx; }
.projects-progress__instruction { margin-top: 12rpx; color: #a80f1b; font-size: 24rpx; font-weight: 600; line-height: 34rpx; }
.projects-progress__status { flex: 0 0 auto; padding: 6rpx 16rpx; border-radius: 24rpx; font-size: 22rpx; font-weight: 600; line-height: 30rpx; }
.projects-progress__status--in_progress { background: #ebfaed; color: #2e7d32; }
.projects-progress__status--completed { background: #ebfaed; color: #2e7d32; }
.project-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 20rpx; }
.project-card { display: flex; align-items: center; gap: 20rpx; min-height: 144rpx; box-sizing: border-box; padding: 24rpx; border: 2rpx solid transparent; border-radius: 24rpx; background: #ffffff; box-shadow: 0 6rpx 18rpx rgba(16,24,40,.05); }
.project-card--selected { border-color: #a80f1b; background: #fff8f8; box-shadow: 0 8rpx 20rpx rgba(168,15,27,.12); }
.project-card__icon { display: flex; width: 72rpx; height: 72rpx; flex: 0 0 72rpx; align-items: center; justify-content: center; border-radius: 20rpx; }
.project-card__icon image { width: 40rpx; height: 40rpx; }
.project-card__icon--tone-0 { background: #fee2e2; }
.project-card__icon--tone-1 { background: #fef3c7; }
.project-card__icon--tone-2 { background: #e0e7ff; }
.project-card__icon--tone-3 { background: #d1fae5; }
.project-card__info { min-width: 0; flex: 1; }
.project-card__name { overflow: hidden; color: #202124; font-size: 28rpx; font-weight: 700; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.project-card__meta { display: flex; gap: 16rpx; margin-top: 6rpx; color: #98a2b3; font-size: 21rpx; line-height: 30rpx; }
.project-card__description { margin-top: 4rpx; overflow: hidden; color: #667085; font-size: 22rpx; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.project-card__select { display: flex; flex: 0 0 40rpx; width: 40rpx; height: 40rpx; margin-left: auto; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #d0d5dd; border-radius: 50%; background: #ffffff; }
.project-card__select image { width: 40rpx; height: 40rpx; }
.project-card__select--selected { border: 0; background: transparent; }
.projects-select-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 25; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; min-height: 140rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e7eaf0; background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 24rpx rgba(16,24,40,.06); }
.projects-select-bar__summary { display: flex; flex-direction: column; gap: 4rpx; }
.projects-select-bar__title { color: #202124; font-size: 28rpx; font-weight: 700; line-height: 38rpx; }
.projects-select-bar__count { color: #667085; font-size: 24rpx; line-height: 34rpx; }
.projects-select-bar__confirm { display: flex; min-width: 184rpx; height: 80rpx; align-items: center; justify-content: center; padding: 0 28rpx; border-radius: 16rpx; background: #a80f1b; color: #ffffff; font-size: 28rpx; font-weight: 700; line-height: 80rpx; text-align: center; }
.projects-select-bar__confirm--disabled { background: #d0d5dd; color: #ffffff; }

.content-primary-strip {
  margin: 24rpx -32rpx 20rpx;
  padding-left: 32rpx;
  white-space: nowrap;
}

.content-primary-strip__inner {
  display: flex;
  gap: 14rpx;
  padding-right: 32rpx;
}

.content-primary {
  display: inline-flex;
  min-width: 132rpx;
  height: 68rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 34rpx;
  background: #ffffff;
  color: #667085;
  font-size: 25rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.content-primary--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 700;
}

.content-layout {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.content-secondary-rail {
  width: 142rpx;
  max-height: 760rpx;
  flex: 0 0 142rpx;
  box-sizing: border-box;
  padding: 8rpx 0 120rpx;
}

.content-secondary {
  display: flex;
  min-height: 76rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 18rpx;
  border-left: 4rpx solid transparent;
  border-radius: 4rpx 18rpx 18rpx 4rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.content-secondary--active {
  border-left-color: #a80f1b;
  background: #fceeef;
  color: #a80f1b;
  font-weight: 700;
}

.content-secondary__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-secondary__empty {
  padding: 18rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 32rpx;
}

.content-results {
  min-width: 0;
  flex: 1;
}

.content-tertiary-group {
  margin-bottom: 28rpx;
}

.content-tertiary-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 4rpx 0 16rpx;
}

.content-tertiary-group__title {
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-tertiary-group__count {
  flex: 0 0 auto;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 28rpx;
}

.content-action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.content-action-card {
  position: relative;
  min-width: 0;
  min-height: 152rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.06);
}

.content-action-card--selected {
  border-color: #a80f1b;
  box-shadow: 0 8rpx 20rpx rgba(168, 15, 27, 0.12);
}

.content-action-card__body {
  min-width: 0;
  padding: 24rpx 72rpx 24rpx 24rpx;
}

.content-action-card__name {
  min-height: 40rpx;
  overflow: hidden;
  color: #202124;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.content-action-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 30rpx;
  margin-top: 6rpx;
}

.content-action-card__quantity,
.content-action-card__duration {
  max-width: 100%;
  overflow: hidden;
  color: #667085;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__quantity {
  color: #a80f1b;
  font-weight: 700;
}

.content-action-card__point {
  margin-top: 4rpx;
  overflow: hidden;
  color: #98a2b3;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__select {
  position: absolute;
  top: 50%;
  right: 24rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #d0d5dd;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  transform: translateY(-50%);
}

.content-action-card__select--selected {
  border: 0;
  background: transparent;
}

.content-action-card__select image {
  width: 40rpx;
  height: 40rpx;
}
