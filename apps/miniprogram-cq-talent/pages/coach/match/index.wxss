.match-page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.match-page__content {
  padding: 32rpx 32rpx 40rpx;
}

.match-hero {
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: #0f1c2e;
  color: #ffffff;
}

.match-hero__eyebrow {
  color: #9fb4cf;
  font-size: 22rpx;
}

.match-hero__title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.match-hero__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.match-hero__team {
  flex: 1;
  min-width: 0;
  color: #dbe6f4;
  font-size: 24rpx;
  line-height: 1.4;
}

.match-hero__score {
  flex: 0 0 auto;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.match-hero__score--pending {
  display: block;
  margin-top: 28rpx;
  color: #dbe6f4;
  font-size: 26rpx;
  font-weight: 500;
}

.match-hero__status {
  display: inline-block;
  margin-top: 24rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid #5e7da5;
  border-radius: 8rpx;
  color: #dbe6f4;
  font-size: 22rpx;
}

.match-periods {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.match-periods__chip {
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(219, 230, 244, .32);
  border-radius: 999rpx;
  color: #dbe6f4;
  font-size: 22rpx;
  line-height: 1.2;
}

.match-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .05);
  background: #ffffff;
}

.match-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.match-card__title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.match-card__action {
  flex: 0 0 auto;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d92d20;
  border-radius: 12rpx;
  color: #d92d20;
  font-size: 26rpx;
  font-weight: 600;
}

.timeline {
  margin-top: 20rpx;
}

.timeline__item {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #e7ecf3;
}

.timeline__time {
  flex: 0 0 112rpx;
  color: #667085;
  font-size: 24rpx;
}

.timeline__body {
  min-width: 0;
  flex: 1;
}

.timeline__line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}

.timeline__pill {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.timeline__pill--score {
  color: #b42318;
  background: #fef3f2;
}

.timeline__pill--assist {
  color: #175cd3;
  background: #eff8ff;
}

.timeline__pill--defense {
  color: #027a48;
  background: #ecfdf3;
}

.timeline__pill--discipline {
  color: #b54708;
  background: #fffaeb;
}

.timeline__pill--neutral {
  color: #475467;
  background: #f2f4f7;
}

.timeline__name {
  color: #172033;
  font-size: 26rpx;
}

.timeline__note {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.match-card__empty {
  padding: 42rpx 0 12rpx;
  color: #667085;
  font-size: 26rpx;
  text-align: center;
}

.match-draft-mask {
  position: fixed;
  z-index: 10001;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 48rpx;
  background: rgba(23, 32, 51, 0.56);
}

.match-draft-modal {
  width: 630rpx;
  max-width: 100%;
  padding: 56rpx 44rpx 40rpx;
  border-radius: 40rpx;
  background: #ffffff;
  text-align: center;
}

.match-draft-modal__icon {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #d1fadf;
}

.match-draft-modal__check {
  width: 36rpx;
  height: 20rpx;
  border-bottom: 8rpx solid #027a48;
  border-left: 8rpx solid #027a48;
  transform: rotate(-45deg) translateY(-6rpx);
}

.match-draft-modal__title {
  margin-top: 32rpx;
  color: #172033;
  font-size: 36rpx;
  font-weight: 700;
}

.match-draft-modal__message {
  margin-top: 16rpx;
  color: #475467;
  font-size: 26rpx;
  line-height: 1.55;
}

.match-draft-modal__updated {
  margin-top: 14rpx;
  color: #667085;
  font-size: 22rpx;
}

.match-draft-modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 44rpx;
}

.match-draft-modal__continue,
.match-draft-modal__exit {
  flex: 1;
  padding: 24rpx 16rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.match-draft-modal__continue {
  color: #ffffff;
  background: #d92d20;
}

.match-draft-modal__exit {
  color: #344054;
  border: 1rpx solid #d0d5dd;
  background: #ffffff;
}
