.match-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.match-hero { margin-bottom: 20rpx; padding: 28rpx 24rpx; border-radius: 28rpx; background: linear-gradient(145deg,#0f4aa8,#2873e8); color: #fff; text-align: center; }
.match-hero .title { color: #fff; }
.match-hero__eyebrow { color: rgba(255,255,255,.65); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.match-hero__score { display: flex; justify-content: center; gap: 22rpx; margin-top: 20rpx; font-size: 62rpx; font-weight: 750; }
.match-hero__divider { color: rgba(255,255,255,.5); }
.match-hero__opponent { color: rgba(255,255,255,.76); font-size: 23rpx; }
.match-hero__board { width: 240rpx; min-height: 58rpx; margin: 18rpx auto 0; border: 1rpx solid rgba(255,255,255,.45); border-radius: 999rpx; background: rgba(255,255,255,.14); color: #fff; font-size: 22rpx; line-height: 58rpx; }
.match-form-card { border-top: 6rpx solid #175cd3; }
.match-form-card--events { margin-bottom: 30rpx; }
button { margin-top: 20rpx; }

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: 0;
}

.field-input {
  min-width: 220rpx;
  min-height: 64rpx;
  box-sizing: border-box;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  color: #111827;
  text-align: right;
}

.score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.score-grid .form-row {
  display: block;
}

.score-grid .field-input {
  width: 100%;
  margin-top: 12rpx;
  text-align: center;
}

.event-list {
  margin-top: 20rpx;
}

.match-event-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.match-event-row:last-child {
  border-bottom: 0;
}

.strong {
  color: #1f2329;
  font-weight: 700;
}

.remove-action {
  min-width: 80rpx;
  color: var(--color-brand);
  font-size: 24rpx;
  text-align: right;
}

/* C6 TopNav + MatchHero */
.c6 { min-height: 100vh; background: #f6f7f9; }
.c6-nav { display: flex; align-items: center; height: 176rpx; padding: 0 32rpx; background: #fceeef; }
.c6-nav__left { display: flex; align-items: center; gap: 24rpx; }
.c6-nav__back { color: #202124; font-size: 56rpx; font-weight: 300; line-height: 1; }
.c6-nav__title { color: #202124; font-size: 44rpx; font-weight: 700; }
.c6-body { padding: 32rpx; display: flex; flex-direction: column; gap: 32rpx; }
.c6-hero { display: flex; flex-direction: column; gap: 32rpx; padding: 40rpx; border-radius: 32rpx; background: #07111f; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1); }
.c6-hero__title { color: #ffffff; font-size: 32rpx; font-weight: 700; }
.c6-hero__teams { display: flex; align-items: center; justify-content: space-between; }
.c6-hero__team { color: #ffffff; font-size: 30rpx; font-weight: 700; max-width: 240rpx; }
.c6-hero__score { color: #ffffff; font-size: 48rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.c6-hero__periods { display: flex; gap: 16rpx; }
.c6-period { display: flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.1); color: #ffffff; font-size: 24rpx; }
.c6-period--link { font-weight: 600; }
