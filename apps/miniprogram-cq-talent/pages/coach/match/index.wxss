.match-page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.match-page__content {
  padding: 24rpx 24rpx 40rpx;
}

.match-hero {
  padding: 32rpx 28rpx;
  border-radius: 12rpx;
  background: #0f1c2e;
  color: #ffffff;
}

.match-hero__eyebrow {
  color: #9fb4cf;
  font-size: 22rpx;
}

.match-hero__title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.match-hero__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}

.match-hero__team {
  flex: 1;
  min-width: 0;
  color: #dbe6f4;
  font-size: 24rpx;
  line-height: 1.4;
}

.match-hero__score {
  flex: 0 0 auto;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.match-hero__score--pending {
  display: block;
  margin-top: 28rpx;
  color: #dbe6f4;
  font-size: 26rpx;
  font-weight: 500;
}

.match-hero__status {
  display: inline-block;
  margin-top: 24rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid #5e7da5;
  border-radius: 8rpx;
  color: #dbe6f4;
  font-size: 22rpx;
}

.match-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.match-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.match-card__title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}

.match-card__action {
  flex: 0 0 auto;
  color: #175cd3;
  font-size: 26rpx;
}

.timeline {
  margin-top: 20rpx;
}

.timeline__item {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #e7ecf3;
}

.timeline__time {
  flex: 0 0 112rpx;
  color: #667085;
  font-size: 24rpx;
}

.timeline__body {
  min-width: 0;
  flex: 1;
}

.timeline__line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}

.timeline__label {
  color: #175cd3;
  font-size: 24rpx;
  font-weight: 600;
}

.timeline__name {
  color: #172033;
  font-size: 26rpx;
}

.timeline__note {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.match-card__empty {
  padding: 42rpx 0 12rpx;
  color: #667085;
  font-size: 26rpx;
  text-align: center;
}
