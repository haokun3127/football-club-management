.match-page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #f6f7f9;
}

.match-page__content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx 32rpx 200rpx;
}

.match-hero {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
  color: #ffffff;
}

.match-hero__title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.match-hero__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.match-hero__team {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.match-hero__score {
  flex: 0 0 auto;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.match-hero__score--pending {
  display: block;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  font-weight: 500;
}

.match-periods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.match-periods__chip {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.2;
}

.match-card {
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .05);
  background: #ffffff;
}

.match-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.match-card__title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}

.match-card__action {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border: 1rpx solid #a80f1b;
  border-radius: 8rpx;
  color: #a80f1b;
  font-size: 28rpx;
  font-weight: 600;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline__item {
  display: flex;
  gap: 24rpx;
  padding: 0;
}

.timeline__time {
  flex: 0 0 auto;
  color: #202124;
  font-size: 26rpx;
  font-weight: 700;
}

.timeline__body {
  min-width: 0;
  flex: 1;
}

.timeline__line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timeline__pill {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.timeline__pill--score {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}

.timeline__pill--assist {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}

.timeline__pill--defense {
  color: #027a48;
  background: #ecfdf3;
}

.timeline__pill--discipline {
  color: #b54708;
  background: #fffaeb;
}

.timeline__pill--neutral {
  color: #475467;
  background: #f2f4f7;
}

.timeline__name {
  color: #202124;
  font-size: 26rpx;
}

.timeline__note {
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
}

.match-card__empty {
  padding: 42rpx 0 12rpx;
  color: #667085;
  font-size: 26rpx;
  text-align: center;
}

.match-draft-mask {
  position: fixed;
  z-index: 10001;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.5);
}

.match-draft-modal {
  width: 630rpx;
  max-width: 100%;
  padding: 48rpx;
  border-radius: 40rpx;
  background: #ffffff;
  text-align: left;
}

.match-draft-modal__icon {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #d1fadf;
}

.match-draft-modal__check {
  width: 36rpx;
  height: 20rpx;
  border-bottom: 8rpx solid #027a48;
  border-left: 8rpx solid #027a48;
  transform: rotate(-45deg) translateY(-6rpx);
}

.match-draft-modal__title {
  margin-top: 40rpx;
  color: #202124;
  font-size: 36rpx;
  font-weight: 700;
}

.match-draft-modal__message {
  margin-top: 16rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.match-draft-modal__updated {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.match-draft-modal__actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.match-draft-modal__continue,
.match-draft-modal__exit {
  flex: 1;
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.match-draft-modal__continue {
  color: #202124;
  border: 1rpx solid #e7eaf0;
  background: #ffffff;
}

.match-draft-modal__exit {
  color: #ffffff;
  border: 0;
  background: #a80f1b;
}
