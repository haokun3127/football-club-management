.match-page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #f6f7f9;
}

.match-page__content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx 32rpx 200rpx;
}

.match-hero {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background:var(--color-card);
  color:var(--color-text);
}

.match-hero__title {
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 1.35;
}

.match-hero__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.match-hero__edit {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  color:var(--color-text);
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.match-hero__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.match-hero__team {
  flex: 1;
  min-width: 0;
  color:var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 700;
  line-height: 1.5;
}

.match-hero__score {
  flex: 0 0 auto;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}

.match-hero__score--pending {
  display: block;
  color:var(--color-text-secondary);
  font-size: var(--font-size-aux);
  font-weight: 500;
}

.match-periods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.match-periods__chip {
  display: flex;
  gap: 8rpx;
  align-items: center;

  border: 0;



  font-size: var(--font-size-aux);
  line-height: 1.2;
 background:transparent; border-radius:0; height:auto; padding:0; min-height:0; color:var(--color-text-secondary);}

.match-periods__label {
  font-weight: 400;
}

.match-periods__score {
  font-weight: 700;
}

.match-card {
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow:none;
  background: #ffffff;
}

.match-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.match-card__title {
  color: #202124;
  font-size: var(--font-size-section);
  font-weight: 700;
}

.match-card__action {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border: 1rpx solid #a80f1b;
  border-radius: 8rpx;
  color: #a80f1b;
  font-size: var(--font-size-body);
  font-weight: 600;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.timeline__item {
  display: flex;
  gap: 24rpx;
  padding: 0;
}

.timeline__time {
  flex: 0 0 auto;
  color: #202124;
  font-size: var(--font-size-aux);
  font-weight: 700;
}

.timeline__body {
  min-width: 0;
  flex: 1;
}

.timeline__line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.timeline__pill {


  font-size: var(--font-size-aux);
  font-weight: 700;
      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.timeline__pill--score {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.timeline__pill--assist {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.timeline__pill--defense {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.timeline__pill--discipline {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.timeline__pill--neutral {


      background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}

.timeline__name {
  color: #202124;
  font-size: var(--font-size-aux);
}

.timeline__note {
  margin-top: 4rpx;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.match-card__empty {
  padding: 42rpx 0 12rpx;
  color: #667085;
  font-size: var(--font-size-aux);
  text-align: center;
}

.match-draft-notice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:none;
}

.match-draft-notice__icon {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
}

.match-draft-notice__content {
  min-width: 0;
  flex: 1;
}

.match-draft-notice__title {
  overflow: hidden;
  color: #202124;
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-draft-notice__meta {
  margin-top: 4rpx;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.match-draft-notice__action {
  flex: 0 0 auto;
  padding: 8rpx 0 8rpx 16rpx;
  color: #a80f1b;
  font-size: var(--font-size-aux);
  font-weight: 700;
  line-height: 1.5;
}

.match-meta { display: grid; grid-template-columns: 110rpx minmax(0,1fr); gap: 16rpx; font-size: var(--font-size-aux); line-height: 1.6; padding: 12rpx 0; color: #667085; }
.match-meta text { color: #202124; word-break: break-all; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.match-card__action,
.match-card__action--outlined,
.match-draft-notice__action,
.match-hero__edit { min-height:44px; min-width:44px; box-sizing:border-box; }
