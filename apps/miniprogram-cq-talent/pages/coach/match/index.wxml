<view class="match-page">
  <app-header theme="soft" title="比赛记录" title-align="left" show-back />

  <view class="match-page__content">
    <status-view wx:if="{{state !== 'ready' && state !== 'idle'}}" state="{{state}}" title="比赛记录" message="{{message}}" action-text="{{retryLabel}}" bindaction="retry" />

    <block wx:if="{{state === 'ready' && hasMatch}}">
      <view class="match-hero">
        <view class="match-hero__heading">
          <view class="match-hero__title">{{eventTitle}}</view>
          <view wx:if="{{canEditMatch}}" class="match-hero__edit" bindtap="openMatchEdit">编辑比赛</view>
        </view>
        <view wx:if="{{hasTeamName || hasOpponentName}}" class="match-hero__teams">
          <view wx:if="{{hasTeamName}}" class="match-hero__team">{{teamName}}</view>
          <view wx:if="{{hasScore}}" class="match-hero__score">{{scoreLabel}}</view>
          <view wx:if="{{hasOpponentName}}" class="match-hero__team">{{opponentName}}</view>
        </view>
        <view wx:else class="match-hero__score match-hero__score--pending">{{scoreLabel}}</view>
        <view class="match-periods">
          <view wx:for="{{periodChips}}" wx:key="id" class="match-periods__chip">
            <view class="match-periods__label">{{item.periodLabel}}</view>
            <view class="match-periods__score">{{item.scoreLabel}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{hasLocalDraftNotice}}" class="match-draft-notice">
        <image class="match-draft-notice__icon" src="/assets/icons/c6-2-cloud-check.svg" mode="aspectFit" />
        <view class="match-draft-notice__content">
          <view class="match-draft-notice__title">有未提交的比赛事件草稿</view>
          <view class="match-draft-notice__meta">{{localDraftUpdatedAtLabel}}</view>
        </view>
        <view class="match-draft-notice__action" bindtap="continueLocalDraft">继续编辑</view>
      </view>

      <view class="match-card">
        <view class="match-card__header">
          <view class="match-card__title">比赛事件</view>
          <view wx:if="{{canAddEvent}}" class="match-card__action match-card__action--outlined" bindtap="openMatchEventAdd">+ 添加事件</view>
        </view>
        <view wx:if="{{hasTimeline}}" class="timeline">
          <view wx:for="{{timeline}}" wx:key="id" class="timeline__item">
            <view class="timeline__time">{{item.minuteLabel}}</view>
            <view class="timeline__body">
              <view class="timeline__line">
                  <view class="timeline__pill timeline__pill--{{item.tone}}">{{item.typeLabel}}</view>
                <view class="timeline__name">{{item.studentName}}</view>
              </view>
              <view wx:if="{{item.hasNote}}" class="timeline__note">{{item.note}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="match-card__empty">暂无已记录的比赛事件</view>
      </view>
    </block>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
