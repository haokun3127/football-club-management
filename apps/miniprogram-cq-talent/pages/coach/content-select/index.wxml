<view class="select-page">
  <view class="select-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="select-nav__left">
      <view class="select-nav__back" bindtap="goBack" aria-label="返回"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
      <view class="select-nav__title">训练内容选择</view>
    </view>
  </view>

  <view class="select-page__body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{statusTitle}}" message="{{message}}" action-text="{{statusActionText}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view class="search-bar">
        <image class="search-bar__icon" src="/assets/icons/search.svg" mode="aspectFit" />
        <input class="search-bar__input" placeholder="搜索训练项目" value="{{searchText}}" bindinput="onSearchInput" />
      </view>

      <scroll-view scroll-x class="category-strip" enhanced show-scrollbar="{{false}}">
        <view class="category-strip__inner">
          <view wx:for="{{categories}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.label}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{hasVisibleProjects}}" class="project-list">
        <view wx:for="{{visibleProjects}}" wx:key="id" class="{{item.cardClass}}" data-id="{{item.id}}" bindtap="toggleProject">
          <view class="{{item.iconClass}}"><image src="{{item.iconSrc}}" mode="aspectFit" /></view>
          <view class="project-card__info">
            <view class="project-card__name">{{item.name}}</view>
            <view class="project-card__meta">
              <text wx:if="{{item.hasDifficulty}}" class="project-card__level">{{item.difficulty}}</text>
              <text wx:if="{{item.hasDuration}}" class="project-card__duration">{{item.durationLabel}}</text>
            </view>
          </view>
          <view class="{{item.selectClass}}"><image wx:if="{{item.isSelected}}" src="/assets/icons/c10-check-circle.svg" mode="aspectFit" /></view>
        </view>
      </view>
      <view wx:else class="inline-empty">当前分类暂无训练内容。</view>

      <view wx:if="{{hasSaveError}}" class="save-error" role="alert">{{saveError}}</view>
    </block>
  </view>

  <view wx:if="{{state === 'ready'}}" class="select-bar">
    <text class="select-bar__summary">{{summaryLabel}}</text>
    <view class="{{confirmClass}}" bindtap="confirmSelection" aria-disabled="{{isConfirmDisabled}}">{{confirmLabel}}</view>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
