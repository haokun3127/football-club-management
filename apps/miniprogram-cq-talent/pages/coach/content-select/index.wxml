<view class="select-page">
  <app-header title="训练内容选择" action-text="覆盖预览" bindaction="openCoverage" show-back />
  <view class="select-page__body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载训练项目' : state === 'empty' ? '暂无训练项目' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="search-bar"><text class="search-bar__icon">搜</text><input class="search-bar__input" placeholder="搜索训练项目" value="{{searchText}}" bindinput="onSearchInput" /></view>
      <scroll-view scroll-x class="category-strip" enhanced show-scrollbar="{{false}}"><view class="category-strip__inner"><view wx:for="{{categories}}" wx:key="*this" class="category-chip {{activeCategory === item ? 'category-chip--active' : ''}}" data-name="{{item}}" bindtap="selectCategory">{{item}}</view></view></scroll-view>
      <view class="project-list"><view wx:for="{{visibleProjects}}" wx:key="id" class="project-card {{selectedMap[item.id] ? 'project-card--selected' : ''}}" data-id="{{item.id}}" bindtap="toggleProject"><view class="project-card__icon {{selectedMap[item.id] ? 'project-card__icon--selected' : ''}}">{{selectedMap[item.id] ? '✓' : '项'}}</view><view class="project-card__info"><view class="project-card__name">{{item.name}}</view><view class="project-card__meta"><text wx:if="{{item.difficultyLabel}}" class="project-card__level">{{item.difficultyLabel}}</text><text wx:if="{{item.durationLabel}}" class="project-card__duration">{{item.durationLabel}}</text></view></view></view></view>
    </block>
  </view>
  <view wx:if="{{state === 'ready'}}" class="select-bar"><view class="select-bar__count">已选 {{selectedCount}} 项</view><view class="select-bar__confirm {{selectedCount ? '' : 'select-bar__confirm--disabled'}}" bindtap="confirmSelection">{{eventId ? '保存到活动' : '确定'}}</view></view>
  <role-tabbar role="coach" active="training" />
</view>
