.select-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.select-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 44rpx;
  background: #fceeef;
}

.select-nav__left {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  gap: 24rpx;
}

.select-nav__back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-nav__back image {
  width: 48rpx;
  height: 48rpx;
}

.select-nav__title {
  color: #202124;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.select-page__body {
  padding: 28rpx 32rpx 0;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.select-context {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.select-context__title {
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-context__meta {
  flex: 0 0 auto;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 28rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 1rpx solid #eaecf0;
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-bar__icon {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}

.search-bar__input {
  flex: 1;
  min-width: 0;
  color: #202124;
  font-size: 26rpx;
}

.content-primary-strip {
  margin: 24rpx -32rpx 20rpx;
  padding-left: 32rpx;
  white-space: nowrap;
}

.content-primary-strip__inner {
  display: flex;
  gap: 14rpx;
  padding-right: 32rpx;
}

.content-primary {
  display: inline-flex;
  min-width: 132rpx;
  height: 68rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 1rpx solid #e4e7ec;
  border-radius: 34rpx;
  background: #ffffff;
  color: #667085;
  font-size: 25rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.content-primary--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 700;
}

/* Legacy category geometry remains available for older API responses and tests. */
.category-chip {
  display: inline-flex;
  height: 64rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 32rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 32rpx;
  background: #ffffff;
  color: #667085;
  font-size: 26rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.category-chip--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 600;
}

.content-layout {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.content-secondary-rail {
  width: 142rpx;
  max-height: 760rpx;
  flex: 0 0 142rpx;
  box-sizing: border-box;
  padding: 8rpx 0 120rpx;
}

.content-secondary {
  display: flex;
  min-height: 76rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 18rpx;
  border-left: 4rpx solid transparent;
  border-radius: 4rpx 18rpx 18rpx 4rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.content-secondary--active {
  border-left-color: #a80f1b;
  background: #fceeef;
  color: #a80f1b;
  font-weight: 700;
}

.content-secondary__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-secondary__empty {
  padding: 18rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 32rpx;
}

.content-results {
  min-width: 0;
  flex: 1;
}

.content-tertiary-group {
  margin-bottom: 28rpx;
}

.content-tertiary-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 4rpx 0 16rpx;
}

.content-tertiary-group__title {
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-tertiary-group__count {
  flex: 0 0 auto;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 28rpx;
}

.content-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.content-action-card {
  position: relative;
  min-width: 0;
  min-height: 330rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.06);
}

.content-action-card--selected {
  border-color: #a80f1b;
  box-shadow: 0 8rpx 20rpx rgba(168, 15, 27, 0.12);
}

.content-action-card__visual {
  position: relative;
  display: flex;
  height: 124rpx;
  align-items: center;
  justify-content: center;
  background: #fef2f2;
}

.content-action-card__visual image {
  width: 72rpx;
  height: 72rpx;
}

.content-action-card__difficulty {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  max-width: 96rpx;
  overflow: hidden;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #a80f1b;
  font-size: 18rpx;
  line-height: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__body {
  min-width: 0;
  padding: 18rpx 16rpx 20rpx;
}

.content-action-card__name {
  min-height: 68rpx;
  overflow: hidden;
  color: #202124;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 34rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.content-action-card__meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 30rpx;
  margin-top: 8rpx;
}

.content-action-card__quantity,
.content-action-card__duration {
  max-width: 100%;
  overflow: hidden;
  color: #667085;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__quantity {
  color: #a80f1b;
  font-weight: 700;
}

.content-action-card__point {
  min-height: 30rpx;
  margin-top: 6rpx;
  overflow: hidden;
  color: #98a2b3;
  font-size: 19rpx;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-action-card__detail {
  margin-top: 10rpx;
  color: #a80f1b;
  font-size: 20rpx;
  line-height: 28rpx;
}

.content-action-card__select {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #d0d5dd;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
}

.content-action-card__select--selected {
  border: 0;
  background: transparent;
}

.content-action-card__select image {
  width: 40rpx;
  height: 40rpx;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.project-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 2rpx solid #e7eaf0;
  border-radius: 24rpx;
  background: #ffffff;
}

.project-card--selected {
  border-color: #a80f1b;
}

.project-card__icon {
  position: relative;
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.project-card__icon image {
  width: 40rpx;
  height: 40rpx;
}

.project-card__icon--tone-0 { background: #fee2e2; }
.project-card__icon--tone-1 { background: #fef3c7; }
.project-card__icon--tone-2 { background: #e0e7ff; }
.project-card__icon--tone-3 { background: #d1fae5; }

.project-card__info {
  min-width: 0;
  flex: 1;
}

.project-card__name {
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.project-card__level {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: #667085;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 24rpx;
}

.project-card__duration { color: #667085; font-size: 24rpx; line-height: 30rpx; }

.project-card__select {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #d0d5dd;
  border-radius: 50%;
}

.project-card__select--selected { border: 0; }
.project-card__select image { width: 40rpx; height: 40rpx; }

.inline-empty,
.save-error {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #667085;
  font-size: 25rpx;
  line-height: 38rpx;
}

.save-error {
  margin-top: 20rpx;
  border: 1rpx solid #f4b9c0;
  background: #fff1f2;
  color: #a80f1b;
}

.select-bar {
  position: fixed;
  right: 0;
  bottom: 140rpx;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 140rpx;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7eaf0;
  background: rgba(255, 255, 255, 0.98);
}

.select-bar__temporary {
  min-width: 0;
  flex: 1;
}

.select-bar__temporary-title {
  overflow: hidden;
  color: #202124;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-bar__temporary-count {
  margin-top: 4rpx;
  color: #98a2b3;
  font-size: 21rpx;
  line-height: 30rpx;
}

.select-bar__confirm {
  display: flex;
  min-width: 190rpx;
  min-height: 76rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.select-bar__confirm--disabled {
  background: #d0d5dd;
}

@media (max-width: 350px) {
  .select-page__body { padding-right: 24rpx; padding-left: 24rpx; }
  .content-primary-strip { margin-right: -24rpx; margin-left: -24rpx; padding-left: 24rpx; }
  .content-primary-strip__inner { padding-right: 24rpx; }
  .content-layout { gap: 12rpx; }
  .content-secondary-rail { width: 118rpx; flex-basis: 118rpx; }
  .content-secondary { padding-right: 12rpx; padding-left: 12rpx; font-size: 22rpx; }
  .content-action-grid { gap: 10rpx; }
  .content-action-card__body { padding-right: 12rpx; padding-left: 12rpx; }
  .select-bar { gap: 12rpx; padding-right: 24rpx; padding-left: 24rpx; }
  .select-bar__confirm { min-width: 150rpx; }
}
