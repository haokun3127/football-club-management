.select-page {
  min-height: 100vh;
  background: var(--color-page);
}

.select-page__body {
  padding: 24rpx var(--space-page) 240rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--color-card);
  border-radius: 44rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.search-bar__icon {
  font-size: 28rpx;
}

.search-bar__input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.category-strip {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.category-strip__inner {
  display: flex;
  gap: 16rpx;
}

.category-chip {
  padding: 12rpx 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-card);
}

.category-chip--active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #ffffff;
  font-weight: 600;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.project-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-line);
  border-radius: 24rpx;
  padding: 24rpx;
}

.project-card--selected {
  border-color: var(--color-brand);
}

.project-card__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #fee2e2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.project-card__icon--selected {
  background: var(--color-brand);
  color: #ffffff;
}

.project-card__info {
  flex: 1;
}

.project-card__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.project-card__meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-card__level {
  padding: 4rpx 16rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

.project-card__duration {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 底部已选栏 */
.select-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-line);
  padding: 24rpx var(--space-page) 160rpx;
  z-index: 20;
}

.select-bar__count {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.select-bar__confirm {
  padding: 20rpx 64rpx;
  background: var(--color-brand);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.select-bar__confirm--disabled {
  opacity: 0.4;
}
