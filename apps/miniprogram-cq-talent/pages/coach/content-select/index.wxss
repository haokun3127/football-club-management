.select-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.select-nav {
  height: 176rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  background: #fceeef;
}

.select-nav__left {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  gap: 24rpx;
}

.select-nav__back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-nav__back image {
  width: 48rpx;
  height: 48rpx;
}

.select-nav__title {
  color: #202124;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.select-page__body {
  padding: 32rpx 44rpx calc(280rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  background: #ffffff;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-bar__icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.search-bar__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text);
}

.category-strip {
  margin: 24rpx -44rpx 32rpx;
  padding-left: 44rpx;
  white-space: nowrap;
}

.category-strip__inner {
  display: flex;
  gap: 16rpx;
  padding-right: 44rpx;
}

.category-chip {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 32rpx;
  background: #ffffff;
  color: #667085;
  font-size: 24rpx;
}

.category-chip--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 600;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.project-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 128rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 2rpx solid #e7eaf0;
  border-radius: 24rpx;
  background: #ffffff;
}

.project-card--selected {
  border-color: #e7eaf0;
  background: #ffffff;
}

.project-card__icon {
  position: relative;
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.project-card__icon image:first-child {
  width: 40rpx;
  height: 40rpx;
}

.project-card__icon--tone-0 { background: #fee2e2; }
.project-card__icon--tone-1 { background: #fef3c7; }
.project-card__icon--tone-2 { background: #e0e7ff; }
.project-card__icon--tone-3 { background: #d1fae5; }

.project-card__info {
  min-width: 0;
  flex: 1;
}

.project-card__name {
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.project-card__level {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: #667085;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 24rpx;
}

.project-card__duration { color: #667085; font-size: 24rpx; line-height: 30rpx; }

.project-card__select {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #d0d5dd;
  border-radius: 50%;
}

.project-card__select--selected { border: 0; }
.project-card__select image { width: 40rpx; height: 40rpx; }

.inline-empty,
.save-error {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #667085;
  font-size: 26rpx;
  line-height: 38rpx;
}

.save-error {
  margin-top: 20rpx;
  border: 1rpx solid #f4b9c0;
  background: #fff1f2;
  color: #a80f1b;
}

.select-bar {
  position: fixed;
  right: 0;
  bottom: 140rpx;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 140rpx;
  box-sizing: border-box;
  padding: 0 44rpx;
  border-top: 1rpx solid #e7eaf0;
  background: #ffffff;
}

.select-bar__summary {
  flex: 1;
  overflow: hidden;
  color: #667085;
  font-size: 26rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.select-bar__confirm {
  min-width: 200rpx;
  padding: 20rpx 28rpx;
  border-radius: 12rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.select-bar__confirm--disabled {
  background: #d0d5dd;
}
