.team-page {
  min-height: 100vh;
  background: var(--color-page);
}

.team-page__body {
  padding: 24rpx var(--space-page) 180rpx;
}

/* Hero（Figma C9: #07111f） */
.hero {
  background: #07111f;
  border-radius: 32rpx;
  padding: 32rpx;
}

.hero__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero__season {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.hero__stats {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.hero-stat {
  flex: 1;
}

.hero-stat__label {
  font-size: 22rpx;
  color: #94a3b8;
}

.hero-stat__value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-stat__value--accent {
  color: #10b981;
}

.members-title {
  margin: 32rpx 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.members-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member {
  width: 156rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.member__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.member__name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}
