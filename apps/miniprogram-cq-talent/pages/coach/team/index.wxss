.team-page { min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); background: #f6f7f9; }
.team-nav { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; height:44px; padding-left: 32rpx; box-sizing: content-box; background: #fceeef; }
.team-nav__left { display: flex; align-items: center; gap: 0; min-height: 56rpx; }
.team-nav__back { width: 48rpx; height: 48rpx; }
.team-nav__title { color: #202124; font-size: var(--font-size-display); font-weight: 700; line-height: 1.5; }

.team-page__body { padding: 32rpx; }
.hero { display: flex; flex-direction: column; gap: 16rpx; padding: 32rpx; border-radius: 32rpx; background:var(--color-card); }
.hero__name { color:var(--color-text); font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.hero__season { align-self: flex-start; padding: 8rpx 20rpx; border-radius: 999rpx; background:transparent; color:var(--color-text); font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; }
.hero__stats { display: flex; gap: 24rpx; margin-top: 8rpx; }
.hero-stat { flex: 1; min-width: 0; }
.hero-stat__label { color:var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; white-space: nowrap; }
.hero-stat__value { margin-top: 8rpx; color:var(--color-text); font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.hero-stat__value--positive { color: #10b981; }

.members-title { margin: 32rpx 0 24rpx; color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.members-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24rpx; }
.member { display: flex; flex-direction: column; align-items: center; gap: 16rpx; min-width: 0; }
.member__avatar { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 44rpx; font-size: var(--font-size-body); font-weight: 700; }
.member__name { max-width: 100%; overflow: hidden; color: #202124; font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.members-empty { padding: 28rpx; border-radius: 16rpx; background: #ffffff; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }

.coaches-section { margin-top: 32rpx; }
.coaches-title { margin-bottom: 24rpx; color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.coaches-scroll { width: 100%; white-space: nowrap; }
.coaches-scroll__content { display: flex; gap: 24rpx; width: max-content; padding-bottom: 4rpx; }
.coach-card { width: 280rpx; height: 240rpx; overflow: hidden; box-sizing: border-box; display: flex; flex-direction: column; gap: 20rpx; padding: 24rpx; border: 2rpx solid #e7eaf0; border-radius: 24rpx; background: #ffffff; }
.coach-card__avatar { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 44rpx; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.coach-card__name { overflow: hidden; color: #202124; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.coach-card__role { align-self: flex-start; max-width: 100%; overflow: hidden; padding: 4rpx 16rpx; border-radius: 999rpx; background: #f3f4f6; color: #667085; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.coaches-empty { padding: 28rpx; border-radius: 16rpx; background: #ffffff; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }

.team-selector { white-space: nowrap; margin-bottom: 20rpx; }
.team-selector__item { display: inline-block; padding: 16rpx 24rpx; border-radius: 30rpx; background: #fff; margin-right: 12rpx; font-size: var(--font-size-aux); }
.team-selector__item.is-active { color: #fff; background: #a80f1b; }
.team-match { margin-top: 16rpx; padding: 24rpx; background: #fff; border-radius: 20rpx; border-left: 6rpx solid #a80f1b; }
.team-match__title { font-weight: 600; font-size: var(--font-size-section); }
.team-match__subtitle { color: #667085; font-size: var(--font-size-aux); line-height: 1.6; margin-top: 8rpx; }
.team-match__score { color: #a80f1b; font-weight: 700; margin-top: 12rpx; font-size: var(--font-size-body); }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.member,
.team-match,
.team-nav__left,
.team-selector__item { min-height:44px; min-width:44px; box-sizing:border-box; }
