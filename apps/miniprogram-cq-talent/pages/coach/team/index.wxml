<view class="team-page">
  <view class="team-nav" style="padding-top:{{navInset}}px">
    <view class="team-nav__left" bindtap="goBack">
      <image class="team-nav__back" src="/assets/icons/chevron-left.svg" mode="aspectFit" />
      <view class="team-nav__title">队伍详情</view>
    </view>
  </view>

  <view class="team-page__body">
    <status-view state="{{state}}" title="队伍详情" message="{{message}}" action-text="{{retryLabel}}" bindaction="retry" />

    <block wx:if="{{hasTeam}}">
      <view class="hero">
        <view class="hero__name">{{teamName}}</view>
        <view wx:if="{{season}}" class="hero__season">{{season}}</view>
        <view class="hero__stats">
          <view wx:for="{{heroStats}}" wx:key="label" class="hero-stat">
            <view class="hero-stat__label">{{item.label}}</view>
            <view class="hero-stat__value {{item.valueClass}}">{{item.value}}</view>
          </view>
        </view>
      </view>

      <view class="members-title">学员名单</view>
      <view wx:if="{{hasMembers}}" class="members-grid">
        <view wx:for="{{members}}" wx:key="id" class="member" data-id="{{item.id}}" bindtap="openRadar">
          <view class="member__avatar" style="background: {{item.avatarBg}}; color: {{item.avatarColor}}">{{item.initial}}</view>
          <view class="member__name">{{item.name}}</view>
        </view>
      </view>
      <view wx:else class="members-empty">{{memberEmptyMessage}}</view>

    </block>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
