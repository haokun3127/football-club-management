<view class="team-page">
  <app-header title="{{pageTitle}}" title-align="left" show-back="{{true}}" />
  <view class="team-page__body">
    <t-button wx:if="{{state === 'empty'}}" theme="primary" bindtap="chooseTeam">选择球队</t-button>
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{pageTitle}}" message="{{message}}" action-text="{{retryLabel}}" bindaction="retry" />

    <block wx:if="{{state === 'ready' && hasTeam}}">
      <context-bar title="{{teamName}}" subtitle="{{season}}" action-text="切换球队" bindaction="chooseTeam" />
      <view class="hero">
        <view class="hero__stats">
          <view wx:for="{{heroStats}}" wx:key="label" class="hero-stat">
            <view class="hero-stat__label">{{item.label}}</view>
            <view class="hero-stat__value {{item.valueClass}}">{{item.value}}</view>
          </view>
        </view>
        <view class="hero-stat-hint">{{heroStatsHint}}</view>
      </view>

      <view wx:if="{{section === 'all' || section === 'matches'}}" class="matches-section">
        <view class="members-title">比赛记录</view>
        <view class="match-filters"><view class="match-filter {{matchFilter === 'all' ? 'match-filter--active' : ''}}" data-kind="all" bindtap="selectMatchFilter">全部</view><view class="match-filter {{matchFilter === 'formal' ? 'match-filter--active' : ''}}" data-kind="formal" bindtap="selectMatchFilter">正式赛事</view><view class="match-filter {{matchFilter === 'training_friendly' ? 'match-filter--active' : ''}}" data-kind="training_friendly" bindtap="selectMatchFilter">训练内友谊赛</view></view>
        <view wx:if="{{gamesLoading}}" class="members-empty">正在读取训练内记录…</view><view wx:if="{{gamesMessage}}" class="members-empty">{{gamesMessage}}</view>
        <view wx:for="{{visibleMatches}}" wx:key="key" class="team-match" data-id="{{item.key}}" bindtap="openMatch"><view class="team-match__title">{{item.title}} ›</view><view class="team-match__subtitle">{{item.subtitle}}</view><view class="team-match__score">{{item.score}}</view></view>
        <view wx:if="{{!visibleMatches.length && !gamesLoading}}" class="members-empty">当前范围没有可展示的比赛记录</view>
      </view>
      <block wx:if="{{section === 'all' || section === 'roster'}}">
        <view class="members-title">队员名单 · {{members.length}} 人</view>
        <t-input value="{{search}}" bindchange="searchMembers" placeholder="搜索队员姓名" aria-label="搜索队员姓名" clearable />
        <view wx:if="{{hasMembers}}" class="member-list">
          <view wx:for="{{visibleMembers}}" wx:key="id" class="member-row" data-id="{{item.id}}" bindtap="openRadar" role="button"><view class="member-row__avatar">{{item.initial}}</view><text class="member-row__name">{{item.name}}</text><text class="member-row__action">查看档案 ›</text></view>
          <view wx:if="{{!visibleMembers.length}}" class="members-empty">未找到匹配队员，请调整姓名</view>
        </view>
        <view wx:else class="members-empty">{{memberEmptyMessage}}</view>
      </block><view class="coaches-section" wx:if="{{section === 'all' || section === 'coaches'}}">
        <view class="coaches-title">教练组</view>
        <scroll-view wx:if="{{hasCoaches}}" class="coaches-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
          <view class="coaches-scroll__content">
            <view wx:for="{{coaches}}" wx:key="id" class="coach-card">
              <view class="coach-card__avatar" style="background: {{item.avatarBg}}; color: {{item.avatarColor}}">{{item.initial}}</view>
              <view class="coach-card__name">{{item.name}}</view>
              <view class="coach-card__role">{{item.roleLabel}}</view>
            </view>
          </view>
        </scroll-view>
        <view wx:else class="coaches-empty">{{coachEmptyMessage}}</view>
      </view>
    </block>
  </view>


</view>
