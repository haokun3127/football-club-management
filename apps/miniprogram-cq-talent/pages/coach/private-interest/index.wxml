<view class="c34-page">
  <app-header title="私教接课" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />

  <view class="c34-body">
    <!-- 接课状态 -->
    <view class="c34-card">
      <view class="c34-card__title">接课状态</view>
      <view wx:if="{{loadFailed}}" class="c34-retry">
        <view class="c34-retry__text">私教偏好读取失败，为避免覆盖已有设置，暂不可编辑。</view>
        <view class="c34-retry__button" bindtap="retryLoad" aria-label="重试读取">重试</view>
      </view>
      <block wx:else>
        <view class="c34-status">
          <view class="c34-status__info">
            <view class="c34-status__label {{accepting ? 'c34-status__label--on' : ''}}">{{acceptingStatusLabel}}</view>
            <view class="c34-status__hint">{{featureMessage}}</view>
          </view>
          <view class="c34-toggle {{accepting ? 'c34-toggle--on' : 'c34-toggle--off'}} {{interactive ? '' : 'c34-toggle--disabled'}}" bindtap="toggleAccepting" aria-label="接受私教预约">
            <view class="c34-toggle__thumb"></view>
          </view>
        </view>
      </block>
      <view wx:if="{{saveFailed}}" class="c34-alert">上次保存未成功，当前展示的是已保存内容，请重试。</view>
    </view>

    <!-- 时段摘要 -->
    <block wx:if="{{featureState === 'enabled' && !loadFailed}}">
      <view class="c34-card">
        <view class="c34-card__title">可用时段</view>
        <view class="c34-summary">{{availabilitySummary}}</view>
        <view class="c34-grid">
          <view class="c34-grid__headers">
            <view wx:for="{{availabilityColumns}}" wx:key="day" class="c34-grid__header">{{item.day}}</view>
          </view>
          <view class="c34-grid__columns">
            <view wx:for="{{availabilityColumns}}" wx:key="day" class="c34-grid__column">
              <view wx:for="{{item.slots}}" wx:key="key" class="c34-slot {{item.selected ? 'c34-slot--selected' : 'c34-slot--unavailable'}}" data-key="{{item.key}}" bindtap="toggleSlot">
                <view class="c34-slot__text {{item.selected ? 'c34-slot__text--selected' : 'c34-slot__text--unavailable'}}">{{item.label}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 已分派咨询 -->
      <view class="c34-card">
        <view class="c34-card__title">已分派咨询</view>
        <view class="c34-card__empty">家长发起的私教预约，经俱乐部确认分派后将在此展示。</view>
      </view>

      <!-- 服务跟进 -->
      <view class="c34-card">
        <view class="c34-card__title">服务跟进</view>
        <view class="c34-card__note">{{feeMessage}}</view>
        <view class="c34-card__note">家长发起预约后由俱乐部统一跟进，教练确认可用时段后安排开课。</view>
      </view>
    </block>
  </view>

  <role-tabbar role="coach" active="me" />
</view>
