<view class="c162-page">
  <view class="c162-nav" style="padding-top:{{navInset}}px">
    <view class="c162-nav__back" bindtap="goBack" aria-label="返回">
      <image class="c162-nav__back-icon" src="/assets/icons/c162-chevron-left.svg" mode="aspectFit" />
    </view>
    <view class="c162-nav__title">私教兴趣</view>
    <view class="c162-nav__placeholder" aria-hidden="true"></view>
  </view>

  <view class="c162-page__body">
    <view class="c162-content">
      <view class="c162-info-card">
        <view class="c162-info-card__title">私教兴趣</view>
        <view class="c162-info-card__text">{{featureMessage}}</view>
      </view>

      <view wx:if="{{loadFailed}}" class="c162-load-error">
        <view class="c162-load-error__text">私教偏好读取失败，为避免覆盖已有设置，暂不可编辑。</view>
        <view class="c162-load-error__retry" bindtap="retryLoad" aria-label="重试读取">重试</view>
      </view>

      <block wx:if="{{!loadFailed}}">
      <view class="c162-toggle-row">
        <view class="c162-toggle-row__label">接受私教预约</view>
        <view class="c162-toggle {{accepting ? 'c162-toggle--on' : 'c162-toggle--off'}} {{interactive ? '' : 'c162-toggle--disabled'}}" bindtap="toggleAccepting" aria-label="接受私教预约">
          <view class="c162-toggle__thumb"></view>
        </view>
      </view>

      <view wx:if="{{saveFailed}}" class="c162-save-alert">上次保存未成功，当前展示的是已保存内容，请重试。</view>

      <view class="c162-schedule-card">
        <view class="c162-schedule-card__title">可用时段</view>
        <view class="c162-schedule-grid">
          <view class="c162-schedule-grid__headers">
            <view wx:for="{{availabilityColumns}}" wx:key="day" class="c162-schedule-grid__header">{{item.day}}</view>
          </view>
          <view class="c162-schedule-grid__columns">
            <view wx:for="{{availabilityColumns}}" wx:key="day" class="c162-schedule-grid__column">
              <view wx:for="{{item.slots}}" wx:key="key" class="c162-slot {{item.selected ? 'c162-slot--selected' : 'c162-slot--unavailable'}}" data-key="{{item.key}}" bindtap="toggleSlot">
                <view class="c162-slot__text {{item.selected ? 'c162-slot__text--selected' : 'c162-slot__text--unavailable'}}">{{item.label}}</view>
              </view>
            </view>
          </view>
        </view>
        <view class="c162-schedule-card__fee">{{feeMessage}}</view>
      </view>
      </block>
    </view>
  </view>

  <role-tabbar role="coach" active="me" />
</view>
