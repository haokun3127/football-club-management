.c162-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.c162-nav {
  height: 176rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 32rpx;
  padding-left: 32rpx;
  background: #fceeef;
}

.c162-nav__back,
.c162-nav__placeholder {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c162-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.c162-nav__back-icon {
  width: 40rpx;
  height: 40rpx;
}

.c162-nav__title {
  color: #202124;
  font-size: 44rpx;
  font-weight: 700;
}

.c162-page__body {
  padding: 32rpx 44rpx 180rpx;
}

.c162-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.c162-info-card,
.c162-status-card,
.c162-schedule-card {
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.c162-info-card__title,
.c162-status-card__title,
.c162-schedule-card__title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}

.c162-info-card__text,
.c162-status-card__message,
.c162-schedule-card__message,
.c162-schedule-card__feature {
  color: #667085;
  font-size: 24rpx;
  line-height: 36rpx;
}

.c162-info-card__text,
.c162-schedule-card__message {
  margin-top: 16rpx;
}

.c162-status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c162-status-card__message {
  margin-top: 8rpx;
}

.c162-pending-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 48rpx;
  background: #e7eaf0;
  border-radius: 24rpx;
}

.c162-pending-marker__dash {
  width: 24rpx;
  height: 4rpx;
  background: #8e97a6;
  border-radius: 2rpx;
}

.c162-schedule-card__feature {
  margin-top: 16rpx;
  color: #8e97a6;
}
