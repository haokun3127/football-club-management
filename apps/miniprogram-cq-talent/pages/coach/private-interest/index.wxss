/* C34 接课配置页：接课状态 / 时段摘要 / 已分派咨询 / 服务跟进 四块信息层次。
   配色一律使用 club tokens，禁止硬编码色值。 */
.c34-page {
  min-height: 100vh;
  background: var(--club-page);
}

.c34-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-right: 200rpx;
  padding-left: 32rpx;
  background: var(--club-nav);
  border-bottom: 1rpx solid var(--club-line);
}

.c34-nav__back {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
}

.c34-nav__back-icon {
  width: 40rpx;
  height: 40rpx;
}

.c34-nav__title {
  flex: 1;
  color: var(--club-text);
  font-size: var(--font-size-display);
  font-weight: 700;
  text-align: left;
}

.c34-nav__placeholder {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c34-body {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-card-gap);
  padding: var(--spacing-page) var(--space-page) 220rpx;
}

.c34-card {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-stack);
  box-sizing: border-box;
  padding: var(--spacing-card);
  border-radius: var(--radius-card);
  background: var(--color-card);
  box-shadow: var(--club-shadow);
}

.c34-card__title {
  color: var(--club-text);
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 42rpx;
}

.c34-card__note {
  color: var(--club-muted);
  font-size: var(--font-size-caption);
  line-height: 36rpx;
}

.c34-card__empty {
  padding: var(--spacing-stack) 0;
  border-radius: var(--radius-button);
  background: var(--club-page);
  color: var(--club-muted);
  font-size: var(--font-size-caption);
  line-height: 36rpx;
  text-align: center;
}

/* 接课状态 */
.c34-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-stack);
  min-height: 96rpx;
}

.c34-status__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.c34-status__label {
  color: var(--club-muted);
  font-size: var(--font-size-body);
  font-weight: 700;
  line-height: 40rpx;
}

.c34-status__label--on {
  color: var(--color-success);
}

.c34-status__hint {
  color: var(--club-muted);
  font-size: var(--font-size-caption);
  line-height: 32rpx;
}

.c34-toggle {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  width: 88rpx;
  height: 48rpx;
  box-sizing: border-box;
  padding: 4rpx;
  border-radius: 24rpx;
}

.c34-toggle--off {
  justify-content: flex-start;
  background: var(--club-line);
}

.c34-toggle--on {
  justify-content: flex-end;
  background: var(--color-brand);
}

.c34-toggle--disabled {
  opacity: 0.5;
}

.c34-toggle__thumb {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-card);
}

.c34-alert {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-button);
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: var(--font-size-caption);
  line-height: 32rpx;
}

/* 读取失败重试 */
.c34-retry {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-stack);
}

.c34-retry__text {
  color: var(--club-muted);
  font-size: var(--font-size-aux);
  line-height: 36rpx;
}

.c34-retry__button {
  align-self: flex-start;
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  background: var(--color-brand);
  color: var(--color-card);
  font-size: var(--font-size-aux);
  font-weight: 600;
  line-height: 34rpx;
}

/* 时段摘要 */
.c34-summary {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-button);
  background: var(--club-page);
  color: var(--club-muted);
  font-size: var(--font-size-caption);
  line-height: 32rpx;
}

.c34-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.c34-grid__headers,
.c34-grid__columns {
  display: flex;
  gap: 8rpx;
}

.c34-grid__header,
.c34-grid__column {
  flex: 1;
  min-width: 0;
}

.c34-grid__header {
  color: var(--club-muted);
  font-size: var(--font-size-aux);
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}

.c34-grid__column {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.c34-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 8rpx;
}

.c34-slot--unavailable {
  background: var(--club-line);
}

.c34-slot--selected {
  background: var(--color-brand);
}

.c34-slot__text {
  font-size: var(--font-size-aux);
  line-height: 1.5;
  white-space: nowrap;
}

.c34-slot__text--unavailable {
  color: var(--club-muted);
}

.c34-slot__text--selected {
  color: var(--color-card);
  font-weight: 600;
}
