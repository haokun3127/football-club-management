.ability-page {
  min-height: 100vh;
  background: var(--color-page);
}

.ability-nav {
  height: 176rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 32rpx;
  background: #fceeef;
}

.ability-nav__back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.ability-nav__back-icon {
  width: 36rpx;
  height: 36rpx;
}

.ability-nav__title {
  flex: 1;
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  color: #202124;
}

.ability-nav__export {
  margin: 0;
  padding: 12rpx 24rpx;
  flex: 0 0 auto;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  color: #a80f1b;
}

.ability-nav__export[disabled] {
  color: #8e97a6;
  opacity: 1;
}

.ability-page__body {
  padding: 32rpx var(--space-page) 180rpx;
}

.ability-context {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #667085;
}

.ability-hero {
  position: relative;
  height: 520rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: #07111f;
}

.ability-hero__head {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  left: 32rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ability-hero__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.ability-hero__period {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.ability-hero__plot {
  position: absolute;
  top: 80rpx;
  right: 0;
  left: 0;
  height: 360rpx;
  display: flex;
  justify-content: center;
}

.ability-hero__canvas {
  display: block;
  flex: 0 0 440rpx;
}

.ability-hero__overall {
  position: absolute;
  left: 0;
  right: 0;
  top: 160rpx;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  color: #ffffff;
}

.ability-hero__empty {
  display: flex;
  width: 440rpx;
  height: 360rpx;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.trend-chip {
  position: absolute;
  bottom: 24rpx;
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.trend-chip__icon {
  width: 24rpx;
  height: 24rpx;
}

.trend-chip--up {
  background: #dcfce7;
  color: #16a34a;
}

.trend-chip--down {
  background: #fee2e2;
  color: #a80f1b;
}

.dim-table,
.ranking-empty {
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.dim-table__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.dim-table__title,
.ranking-empty__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.dim-table__hint,
.ranking-empty__message {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.dim-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.dim-row:last-child {
  border-bottom: none;
}

.dim-row__label {
  font-size: 28rpx;
  color: var(--color-text);
}

.dim-row__values {
  display: flex;
  gap: 32rpx;
}

.dim-row__avg,
.dim-row__top,
.dim-row__bottom {
  min-width: 72rpx;
  font-size: 28rpx;
  text-align: right;
}

.dim-row__avg {
  font-weight: 700;
  color: #a80f1b;
}

.dim-row__top,
.dim-row__bottom {
  color: var(--color-text-secondary);
}

.ranking-empty__message {
  margin-top: 16rpx;
}
