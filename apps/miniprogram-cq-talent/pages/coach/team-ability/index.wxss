.ability-page { min-height: 100vh; padding-bottom: 48rpx; background: var(--color-page); }
.ability-nav { position: sticky; top: 0; z-index: 100; display: flex; height: 88rpx; box-sizing: content-box; align-items: center; padding: 0 32rpx; background: #fceeef; }
.ability-nav__back { display: flex; flex: 0 0 48rpx; width: 48rpx; height: 64rpx; align-items: center; justify-content: center; }
.ability-nav__back-icon { width: 36rpx; height: 36rpx; }
.ability-nav__title { min-width: 0; flex: 1; margin-left: 16rpx; overflow: hidden; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.ability-page__body { padding: 16rpx var(--space-page) 48rpx; }
.ability-context { min-height: 108rpx; box-sizing: border-box; padding: 18rpx 28rpx; border-radius: 28rpx; background: #ffffff; }
.ability-context__label { color: #667085; font-size: 22rpx; line-height: 30rpx; }
.ability-context__main { display: flex; align-items: center; justify-content: space-between; margin-top: 2rpx; }
.ability-context__team { min-width: 0; overflow: hidden; color: #202124; font-size: 30rpx; font-weight: 600; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.ability-context__hint { flex: 0 0 auto; margin-left: 16rpx; color: #a80f1b; font-size: 22rpx; line-height: 30rpx; }
.ability-summary { height: 284rpx; box-sizing: border-box; margin-top: 16rpx; padding: 32rpx; border-radius: 28rpx; background: #07111f; color: #ffffff; }
.ability-summary__title { font-size: 32rpx; font-weight: 700; line-height: 42rpx; }
.ability-summary__meta { margin-top: 8rpx; color: rgba(255,255,255,.68); font-size: 24rpx; line-height: 34rpx; }
.ability-summary__stats { display: flex; justify-content: space-between; margin-top: 36rpx; }
.ability-summary__stat { min-width: 0; flex: 1; }
.ability-summary__value { overflow: hidden; color: #ffffff; font-size: 56rpx; font-weight: 700; line-height: 64rpx; text-overflow: ellipsis; white-space: nowrap; }
.ability-summary__value--green { color: #2fd18a; font-size: 36rpx; }
.ability-summary__value--yellow { color: #ffc53d; font-size: 36rpx; }
.ability-summary__label { margin-top: 4rpx; color: rgba(255,255,255,.68); font-size: 22rpx; line-height: 30rpx; }
.ability-roster { margin-top: 32rpx; }
.ability-roster__head { display: flex; align-items: center; justify-content: space-between; }
.ability-roster__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 42rpx; }
.ability-roster__hint { color: #667085; font-size: 24rpx; line-height: 34rpx; }
.ability-roster__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 24rpx; }
.ability-player { display: flex; min-width: 0; height: 148rpx; box-sizing: border-box; align-items: center; padding: 24rpx; border-radius: 24rpx; background: #ffffff; }
.ability-player__avatar { display: flex; flex: 0 0 80rpx; width: 80rpx; height: 80rpx; align-items: center; justify-content: center; border-radius: 50%; background: #3971ba; color: #ffffff; font-size: 28rpx; font-weight: 700; }
.ability-player:first-child .ability-player__avatar { background: #a80f1b; }
.ability-player__copy { min-width: 0; margin-left: 16rpx; }
.ability-player__name { overflow: hidden; color: #202124; font-size: 30rpx; font-weight: 700; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.ability-player__score { margin-top: 4rpx; color: #667085; font-size: 22rpx; line-height: 30rpx; }
.ability-player__arrow { margin-left: auto; color: #a80f1b; font-size: 44rpx; line-height: 44rpx; }
