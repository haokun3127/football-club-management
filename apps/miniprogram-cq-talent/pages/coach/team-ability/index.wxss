.ability-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: var(--color-page);
}

.ability-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  height: 88rpx;
  box-sizing: content-box;
  align-items: center;
  padding-left: 32rpx;
  background: #fceeef;
}

.ability-nav__back {
  display: flex;
  width: 48rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
}

.ability-nav__back-icon {
  width: 36rpx;
  height: 36rpx;
}

.ability-nav__title {
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #202124;
}

.ability-page__body {
  padding: 32rpx var(--space-page) 0;
}

.ability-context {
  box-sizing: border-box;
  min-height: 108rpx;
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.ability-context__label,
.ability-context__hint,
.ability-hero__period,
.ability-hero__student-hint,
.ability-roster__hint {
  font-size: 22rpx;
  line-height: 30rpx;
}

.ability-context__label {
  color: #667085;
}

.ability-context__main,
.ability-hero__head,
.ability-hero__student,
.ability-roster__head,
.ability-dimension__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ability-context__main {
  margin-top: 2rpx;
}

.ability-context__team {
  min-width: 0;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #202124;
}

.ability-context__hint {
  margin-left: 16rpx;
  flex: 0 0 auto;
  color: #a80f1b;
}

.ability-hero {
  position: relative;
  height: 620rpx;
  box-sizing: border-box;
  margin-top: 32rpx;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #07111f;
}

.ability-hero__title,
.ability-roster__title,
.ability-dimensions__title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.ability-hero__title,
.ability-hero__student-name {
  color: #ffffff;
}

.ability-hero__period,
.ability-hero__student-hint {
  color: rgba(255, 255, 255, 0.68);
}

.ability-hero__student {
  margin-top: 12rpx;
}

.ability-hero__student-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.ability-hero__canvas {
  display: block;
  width: 352rpx;
  height: 352rpx;
  margin: 4rpx auto 0;
}

.ability-hero__overall {
  position: absolute;
  right: 0;
  bottom: 26rpx;
  left: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
  color: #ffffff;
}

.ability-roster,
.ability-dimensions {
  margin-top: 32rpx;
}

.ability-roster__hint {
  color: #667085;
}

.ability-roster__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 16rpx;
  row-gap: 20rpx;
  margin-top: 24rpx;
}

.ability-player {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.ability-player__avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e7eaf0;
  border-radius: 50%;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  color: #202124;
}

.ability-player__name {
  width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #667085;
}

.ability-player--active .ability-player__avatar {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
}

.ability-player--active .ability-player__name {
  font-weight: 600;
  color: #a80f1b;
}

.ability-dimensions {
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.ability-dimension {
  margin-top: 24rpx;
}

.ability-dimension__label {
  font-size: 26rpx;
  line-height: 34rpx;
  color: #667085;
}

.ability-dimension__value {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 34rpx;
  color: #a80f1b;
}

.ability-dimension__track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #e7eaf0;
}

.ability-dimension__fill {
  height: 100%;
  border-radius: inherit;
  background: #a80f1b;
}
