.ability-page {
  min-height: 100vh;
  background: var(--color-page);
}

.ability-nav {
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 32rpx;
  background: #fceeef;
}

.ability-nav__back {
  width: 48rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.ability-nav__back-icon {
  width: 36rpx;
  height: 36rpx;
}

.ability-nav__title {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #202124;
}

.ability-nav__export {
  display: flex;
  width: 104rpx;
  height: 58rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  flex: 0 0 auto;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  color: #a80f1b;
}

.ability-page__body {
  padding: 32rpx var(--space-page) 180rpx;
}

.ability-context {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #667085;
}

.ability-hero {
  display: flex;
  height: 1040rpx;
  box-sizing: border-box;
  flex-direction: column;
  overflow: hidden;
  padding: 48rpx;
  border-radius: 32rpx;
  background: #07111f;
}

.ability-hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ability-hero__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.ability-hero__period {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.ability-hero__plot {
  display: flex;
  height: 720rpx;
  min-height: 720rpx;
  margin-top: 40rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.ability-hero__canvas {
  display: block;
  width: 620rpx;
  height: 600rpx;
  flex: 0 0 600rpx;
}

.ability-hero__overall {
  margin-top: 8rpx;
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  color: #ffffff;
}

.ability-hero__empty {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.trend-chip {
  display: flex;
  align-self: flex-start;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.trend-chip__icon {
  width: 24rpx;
  height: 24rpx;
}

.trend-chip--up {
  background: #dcfce7;
  color: #16a34a;
}

.trend-chip--down {
  background: #fee2e2;
  color: #a80f1b;
}

.dim-table,
.ranking-empty {
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.dim-table__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.dim-table__title,
.ranking-empty__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.dim-table__hint,
.ranking-empty__message {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.dim-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dim-row + .dim-row {
  margin-top: 20rpx;
}

.dim-row__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.dim-row__label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.dim-row__avg {
  font-size: 26rpx;
  font-weight: 700;
  text-align: right;
  color: var(--color-brand);
}

.dim-row__track {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: var(--color-line);
}

.dim-row__fill {
  height: 100%;
  border-radius: inherit;
  background: #a80f1b;
}

.dim-row__summary {
  width: 100%;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 28rpx;
}

.ranking-empty__message {
  margin-top: 16rpx;
}
