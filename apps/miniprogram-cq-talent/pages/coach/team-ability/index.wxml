<view class="ability-page">
  <view class="ability-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="ability-nav__back" bindtap="goBack">
      <image class="ability-nav__back-icon" src="/assets/icons/c14-arrow-left.svg" mode="aspectFit" />
    </view>
    <view class="ability-nav__title">能力评估</view>
  </view>

  <view class="ability-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载能力评估' : state === 'empty' ? '暂无能力数据' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{hasTeam}}">
      <view class="ability-context">
        <view class="ability-context__label">当前训练球队</view>
        <view class="ability-context__main">
          <view class="ability-context__team">{{teamContext}}</view>
          <view class="ability-context__hint">{{teamHint}} ›</view>
        </view>
      </view>

      <view class="ability-summary">
        <view class="ability-summary__title">球队能力概览</view>
        <view class="ability-summary__meta">最近学期测评 · {{students.length}}名学员</view>
        <view class="ability-summary__stats">
          <view class="ability-summary__stat"><view class="ability-summary__value">{{summaryOverall}}</view><view class="ability-summary__label">平均综合分</view></view>
          <view class="ability-summary__stat"><view class="ability-summary__value ability-summary__value--green">{{summaryBestDimension}}</view><view class="ability-summary__label">优势维度</view></view>
          <view class="ability-summary__stat"><view class="ability-summary__value ability-summary__value--yellow">{{summaryNeedDimension}}</view><view class="ability-summary__label">待提升维度</view></view>
        </view>
      </view>

      <view wx:if="{{hasStudents}}" class="ability-roster">
        <view class="ability-roster__head">
          <view class="ability-roster__title">全部球员</view>
          <view class="ability-roster__hint">点击头像切换评估</view>
        </view>
        <view class="ability-roster__grid">
          <view
            wx:for="{{students}}"
            wx:key="id"
            class="ability-player"
            data-id="{{item.id}}"
            bindtap="selectStudent"
          >
            <view class="ability-player__avatar">{{item.initial}}</view>
            <view class="ability-player__copy"><view class="ability-player__name">{{item.name}}</view><view class="ability-player__score">综合 {{item.scoreLabel}}</view></view>
            <view class="ability-player__arrow">›</view>
          </view>
        </view>
      </view>

    </block>
  </view>

</view>
