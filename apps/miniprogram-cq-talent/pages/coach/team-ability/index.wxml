<view class="ability-page">
  <view class="ability-nav">
    <view class="ability-nav__back" bindtap="goBack">
      <image class="ability-nav__back-icon" src="/assets/icons/c14-arrow-left.svg" mode="aspectFit" />
    </view>
    <view class="ability-nav__title">团队能力总览</view>
    <button class="ability-nav__export" disabled="{{true}}">导出</button>
  </view>

  <view class="ability-page__body">
    <view class="ability-context">{{teamContext}}</view>
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '汇总团队能力' : state === 'empty' ? '暂无评测数据' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{hasOverview}}">
      <view class="ability-hero">
        <view class="ability-hero__head">
          <view class="ability-hero__title">团队平均能力雷达</view>
          <view class="ability-hero__period">{{assessmentPeriod}}</view>
        </view>
        <view class="ability-hero__plot">
          <radar-canvas wx:if="{{hasRadar}}" class="ability-hero__canvas" dark="{{true}}" metrics="{{radar}}" width="440rpx" height="360rpx"></radar-canvas>
          <view wx:else class="ability-hero__empty">暂无足够维度生成雷达图</view>
          <view class="ability-hero__overall">综合 {{overall}}</view>
        </view>
        <view wx:if="{{trendLabel}}" class="trend-chip {{trendPositive ? 'trend-chip--up' : 'trend-chip--down'}}">
          <image wx:if="{{trendPositive}}" class="trend-chip__icon" src="/assets/icons/c14-trending-up.svg" mode="aspectFit" />
          <text>{{trendLabel}}</text>
        </view>
      </view>

      <view class="dim-table">
        <view class="dim-table__head">
          <view class="dim-table__title">维度统计</view>
          <view class="dim-table__hint">队均 / TOP / 底</view>
        </view>
        <view wx:for="{{dimensions}}" wx:key="metricId" class="dim-row">
          <view class="dim-row__label">{{item.label}}</view>
          <view class="dim-row__values">
            <text class="dim-row__avg">{{item.average}}</text>
            <text class="dim-row__top">{{item.top}}</text>
            <text class="dim-row__bottom">{{item.bottom}}</text>
          </view>
        </view>
      </view>

      <view class="ranking-empty">
        <view class="ranking-empty__title">TOP 3 排名（每维度）</view>
        <view class="ranking-empty__message">{{rankingMessage}}</view>
      </view>
    </block>
  </view>
  <role-tabbar role="coach" active="training" />
</view>
