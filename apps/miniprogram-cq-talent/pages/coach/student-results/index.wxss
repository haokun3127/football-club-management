.results-page { min-height:100vh;background:var(--club-page);color:var(--club-text); }
.results-nav { position:sticky;top:0;z-index:100;height:44px;display:flex;align-items:center;padding-left:32rpx;background:var(--club-nav);font-size: var(--font-size-body); }
.results-back { width:40rpx;font-size: var(--font-size-body); }
.results-body { display:flex;flex-direction:column;gap:32rpx;padding:32rpx 32rpx calc(166rpx + env(safe-area-inset-bottom)); }
.results-card { display:flex;flex-direction:column;gap:24rpx;padding:32rpx;border:1rpx solid var(--club-line);border-radius:28rpx;background:#fff;box-shadow:none; }
.results-heading { font-size: var(--font-size-section);font-weight:700;line-height: 1.5; }
.results-value { font-size:64rpx;font-weight:700;line-height:88rpx;color:var(--color-brand);overflow-wrap:anywhere; }
.results-caption { font-size: var(--font-size-aux);line-height: 1.5;color:var(--color-text-secondary); }
.results-history-title { font-size: var(--font-size-section);font-weight:500;line-height: 1.5;color:var(--club-muted); }
.results-chart { display:flex;gap:24rpx;align-items:flex-end;min-height:300rpx; }
.results-column { flex:0 1 calc((100% - 48rpx) / 3);min-width:0;display:flex;flex-direction:column;gap:16rpx;font-size: var(--font-size-aux);line-height: 1.5;color:var(--club-muted); }
.results-bar { width:100%;background:var(--color-brand-soft);border-radius:12rpx; }
.results-bar--latest { background:var(--color-brand); }
.results-history-row { display:flex;justify-content:space-between;gap:20rpx;font-size: var(--font-size-body);line-height: 1.5; }
.results-title { font-size: var(--font-size-section);font-weight:500;line-height: 1.5; }
.results-text { font-size: var(--font-size-body);color:var(--color-text-secondary);line-height: 1.5; }
.results-link { font-size: var(--font-size-aux);color:var(--color-brand);line-height: 1.5; }
.results-footer { position:fixed;bottom:0;left:0;right:0;padding:16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));background:var(--club-nav); }
.results-footer .results-primary { width:100%;height:96rpx;padding:0;background:var(--color-brand);color:#fff;border-radius:16rpx;font-size: var(--font-size-body);line-height: 1.5; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.results-alternative,
.results-back,
.results-card { min-height:44px; min-width:44px; box-sizing:border-box; }
