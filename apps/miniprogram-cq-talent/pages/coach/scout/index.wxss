page{background:var(--club-page);color:var(--club-text)}.scout-page{min-height:100vh;background:var(--club-page)}.scout-nav{display:flex;align-items:center;min-height:88rpx;padding-left:32rpx;background:var(--club-nav);font-size:32rpx;box-sizing:content-box}.scout-back{width:48rpx;height:72rpx;display:flex;align-items:center}.scout-back image{width:32rpx;height:32rpx}.scout-body{display:flex;flex-direction:column;gap:40rpx;padding:32rpx 32rpx calc(192rpx + env(safe-area-inset-bottom))}.scout-card{display:flex;flex-direction:column;gap:24rpx;padding:32rpx;background:#fff;border:2rpx solid var(--club-line);border-radius:28rpx;box-shadow:var(--club-shadow);overflow-wrap:break-word}.scout-title{font-size:48rpx;line-height:68rpx;font-weight:700;color:var(--color-brand)}.scout-text{font-size:30rpx;line-height:48rpx;color:var(--color-text-secondary);white-space:pre-wrap}.scout-label{font-size:26rpx;line-height:40rpx;color:var(--color-text-secondary)}.scout-input{width:100%;min-height:48rpx;font-size:30rpx;line-height:48rpx;color:var(--club-text)}.scout-history+.scout-history{padding-top:24rpx;border-top:2rpx solid var(--club-line)}.scout-footer{position:fixed;bottom:0;left:0;right:0;padding:16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));background:var(--club-nav)}.scout-footer .scout-primary{width:100%;max-width:none;display:block;margin:0;background:var(--color-brand);color:#fff;border-radius:16rpx;height:96rpx;line-height:96rpx;font-size:32rpx;font-weight:500}.scout-primary::after,.scout-link::after{border:0}.scout-footer .scout-primary[disabled]{background:#dac7c8;color:var(--club-muted)}.scout-link{width:100%;max-width:none;background:transparent;color:var(--color-brand);font-size:28rpx}.scout-error{padding:24rpx;border-radius:16rpx;background:#fff0ef;color:var(--color-brand);font-size:26rpx;line-height:40rpx}
