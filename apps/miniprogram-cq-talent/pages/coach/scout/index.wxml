<view class="scout-page">
  <view class="scout-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><view class="scout-back" bindtap="goBack"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view><text>{{pageTitle}}</text></view>
  <view class="scout-body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{pageTitle}}" message="{{message}}" action-text="返回人员库" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="scout-card"><view class="scout-title">{{mode === 'detail' ? player.name : (eventRoster ? eventRoster.event.title : '天才足球 · 球探人员')}}</view><view class="scout-text" wx:if="{{mode === 'list'}}">{{eventId ? '选择球员加入本次活动。' : '查看人员档案与获准查看的参与历史。'}}</view><view class="scout-text" wx:elif="{{mode === 'create'}}">填写姓名与身份证，用于识别同一球员，避免重复建档。</view><view class="scout-text" wx:else>证件 {{player.maskedDocument}}
天才足球 · {{player.status === 'enrolled' ? '已转正式' : '球探档案'}}</view></view>
      <block wx:if="{{mode === 'list'}}">
        <view class="scout-card"><view class="scout-label">搜索姓名或证件尾号</view><t-input class="scout-input" value="{{search}}" placeholder="输入姓名或证件后四位" maxlength="60" confirm-type="search" bindchange="inputSearch" bindconfirm="searchPlayers" bindblur="searchPlayers"  borderless t-class="scout-input" /></view>
        <view wx:for="{{players}}" wx:key="id" class="scout-card" data-id="{{item.id}}" bindtap="openPlayer"><view class="scout-label">{{item.name}} · {{item.status === 'enrolled' ? '已转正式' : '已有档案'}}</view><view class="scout-text">证件 {{item.maskedDocument}} · 查看档案 ›</view></view>
        <view wx:if="{{!players.length}}" class="scout-text">{{loadedSearch ? '未找到匹配档案' : '暂无球探档案'}}</view>
        <t-button wx:if="{{nextOffset !== null}}" class="scout-link" loading="{{loadingMore}}" bindtap="loadMore" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="scout-link" theme="primary" variant="text">加载更多</t-button>
        <view wx:if="{{!canCreate}}" class="scout-label">人员身份登记暂不可用，请联系管理员。</view>
      </block>
      <block wx:elif="{{mode === 'create'}}">
        <view class="scout-card"><view class="scout-label">姓名 *</view><t-input class="scout-input" value="{{name}}" placeholder="请输入真实姓名" maxlength="60" disabled="{{saving}}" bindchange="inputName"  borderless t-class="scout-input" /></view>
        <view class="scout-card"><view class="scout-label">证件号码 *</view><t-input class="scout-input" type="idcard" value="{{identityNumber}}" placeholder="请输入18位身份证号码" maxlength="18" disabled="{{saving}}" bindchange="inputIdentity"  borderless t-class="scout-input" /></view>
      </block>
      <block wx:elif="{{mode === 'detail'}}">
        <view class="scout-card"><view class="scout-label">观察记录</view><view class="scout-text">暂无可展示的观察记录</view></view>
        <view class="scout-card"><view class="scout-label">参与历史</view><view wx:if="{{!participations.length}}" class="scout-text">暂无获准查看的活动名单记录</view><view wx:for="{{participations}}" wx:key="eventId" class="scout-history"><view class="scout-text">{{item.title}}</view><view class="scout-label">{{item.date}} · {{item.statusLabel}}</view></view></view>
      </block>
      <view wx:if="{{message}}" class="scout-error">{{message}}</view><t-button wx:if="{{mustReload}}" class="scout-link" bindtap="retry" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="scout-link" theme="primary" variant="text">刷新名单并核对</t-button>
    </block>
  </view>
  <view class="scout-footer" wx:if="{{state === 'ready' && (mode !== 'detail' || eventId)}}">
    <t-button wx:if="{{mode === 'list'}}" class="scout-primary" disabled="{{!canCreate || eventRoster.event.cancelled}}" bindtap="newPlayer" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="scout-primary" theme="primary" variant="base">{{eventId ? '找不到球员？新建档案' : '新建球探档案'}}</t-button>
    <t-button wx:elif="{{mode === 'create'}}" class="scout-primary" disabled="{{saving || !name || identityNumber.length !== 18}}" loading="{{saving}}" bindtap="save" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="scout-primary" theme="primary" variant="base">{{eventId ? '建档并加入本次活动' : '保存球探档案'}}</t-button>
    <t-button wx:elif="{{included}}" class="scout-primary" disabled="{{saving || mustReload}}" bindtap="manageRoster" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="scout-primary" theme="primary" variant="base">已在名单 · 查看操作</t-button>
    <t-button wx:else class="scout-primary" disabled="{{saving || mustReload || !eventRoster || eventRoster.event.cancelled}}" loading="{{saving}}" bindtap="addToEvent" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="scout-primary" theme="primary" variant="base">加入本次活动</t-button>
  </view>
</view>
