<view class="c12">
  <view class="c12-nav" style="padding-top: {{navInset}}px; padding-right: {{menuInset}}px">
    <view class="c12-nav__left" bindtap="goBack">
      <image class="c12-nav__back" src="/assets/icons/c12-arrow-left.svg" mode="aspectFit" />
      <text class="c12-nav__title">项目评分录入</text>
    </view>
    <text class="c12-nav__action" bindtap="submitAssessment">提交</text>
  </view>

  <view class="c12-body">
    <status-view
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{hasForm}}">
      <view class="c12-task-header">
        <text class="c12-task-header__title">{{form.templateName}}</text>
        <text class="c12-task-header__meta">{{eventTitle}}</text>
        <view class="c12-task-header__chips">
          <text class="c12-task-header__chip c12-task-header__chip--complete">{{progressLabel}}</text>
          <text class="c12-task-header__chip c12-task-header__chip--version">{{form.versionName}}</text>
        </view>
      </view>

      <view class="c12-progress"><view class="c12-progress__value" style="{{progressStyle}}"></view></view>

      <view wx:if="{{hasCurrentField}}" class="c12-field-window">
        <scroll-view scroll-x class="c12-groups" enhanced show-scrollbar="{{false}}">
          <view class="c12-groups__row">
            <view wx:for="{{groupOptions}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="switchGroup">{{item.label}}</view>
          </view>
        </scroll-view>
        <view class="c12-field-window__bar">
          <picker class="c12-field-window__picker" mode="selector" range="{{fieldsInGroup}}" range-key="label" value="{{fieldIndex}}" bindchange="onFieldChange">
            <view class="c12-field-window__selection">
              <text class="c12-field-window__label">{{currentField.label}}</text>
              <text class="c12-field-window__unit">{{currentFieldUnitLabel}}</text>
            </view>
          </picker>
          <view class="c12-field-window__steps">
            <text class="c12-field-window__position">{{fieldPositionLabel}}</text>
            <text class="c12-field-window__step" bindtap="previousField">上一项</text>
            <text class="c12-field-window__step" bindtap="nextField">下一项</text>
          </view>
        </view>
      </view>

      <view wx:if="{{hasCurrentField}}" class="c12-students">
        <text class="c12-students__title">待录入学员</text>
        <view wx:for="{{draftRows}}" wx:key="studentId" class="c12-student-card">
          <view class="c12-student-card__head">
            <view class="c12-student-card__avatar">{{item.initials}}</view>
            <text class="c12-student-card__name">{{item.name}}</text>
            <text class="{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <view class="c12-student-card__metrics">
            <view wx:for="{{item.metricCells}}" wx:for-item="cell" wx:key="testItemId" class="c12-metric-cell">
              <text class="c12-metric-cell__label">{{cell.label}}</text>
              <input wx:if="{{cell.showInput}}" class="c12-metric-cell__input" type="{{cell.inputType}}" placeholder="{{cell.placeholder}}" value="{{cell.rawValue}}" data-student-id="{{item.studentId}}" data-test-item-id="{{cell.testItemId}}" bindinput="onValueInput" />
              <text wx:else class="{{cell.statusClass}}">{{cell.statusLabel}}</text>
            </view>
          </view>
          <view class="c12-student-card__actions">
            <text wx:if="{{item.invalid}}" class="c12-student-card__invalid">{{item.invalidHint}}</text>
            <text class="c12-student-card__missing" data-student-id="{{item.studentId}}" data-test-item-id="{{currentField.testItemId}}" bindtap="toggleMissing">{{item.missingActionLabel}}</text>
          </view>
          <input wx:if="{{item.showMissingReason}}" class="c12-student-card__reason" placeholder="缺测原因（选填）" value="{{item.missingReason}}" data-student-id="{{item.studentId}}" data-test-item-id="{{currentField.testItemId}}" bindinput="onMissingReasonInput" />
        </view>
      </view>
    </block>
  </view>

  <view class="c12-submit-wrap">
    <text class="c12-submit__hint">{{progressLabel}}</text>
    <text wx:if="{{submitMessage}}" class="c12-submit__message">{{submitMessage}}</text>
    <view class="{{submitClass}}" bindtap="submitAssessment">{{submitLabel}}</view>
  </view>
  <role-tabbar role="coach" active="training" />

  <view wx:if="{{draftResumeVisible}}" class="c121-event-mask">
    <view class="c121-modal">
      <view class="c121-modal__content">
        <view class="c121-modal__check-wrap"><image class="c121-modal__check" src="/assets/icons/c121-check.svg" mode="aspectFit" /></view>
        <text class="c121-modal__title">评分已自动保存</text>
        <text class="c121-modal__message">下次打开可继续录入</text>
        <text class="c121-modal__updated-at">{{draftResumeUpdatedAtLabel}}</text>
      </view>
      <view class="c121-modal__actions">
        <view class="c121-modal__continue" bindtap="continueDraft">继续录入</view>
        <view class="c121-modal__exit" bindtap="exitDraft">退出</view>
      </view>
    </view>
  </view>
</view>
