<view class="task-resolver">
  <app-header title="本课测评" title-align="left" show-back="{{true}}" />
  <view class="task-resolver__body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '查找测评任务' : state === 'error' ? '暂时无法进入测评' : '暂无测评任务'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <block wx:if="{{state === 'ready'}}">
      <view class="task-resolver__title">{{courseTitle}}</view>
      <view class="task-resolver__hint">{{message}}</view>
      <view wx:for="{{tasks}}" wx:key="id" class="task-resolver__task">
        <view class="task-resolver__title">{{item.title}}</view>
        <view class="task-resolver__hint">{{item.completedStudents}}/{{item.totalStudents}} 人采集完成</view>
        <view wx:if="{{item.reason}}" class="task-resolver__hint">{{item.reason}}</view>
        <t-button disabled="{{!item.canOpen}}" data-id="{{item.id}}" bindtap="openTask" theme="primary" variant="outline">{{item.actionLabel}}</t-button>
      </view>
    </block>
    <t-button wx:if="{{eventId && state !== 'loading'}}" bindtap="openCourse" theme="primary" variant="text">查看课堂与训练记录</t-button>
  </view>
</view>
