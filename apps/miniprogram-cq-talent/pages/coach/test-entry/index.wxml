<view class="c12">
  <view class="c12-nav" style="padding-top: {{navInset}}px">
    <view class="c12-nav__left" bindtap="goBack">
      <image class="c12-nav__back" src="/assets/icons/c12-arrow-left.svg" mode="aspectFit" />
      <text class="c12-nav__title">项目评分录入</text>
    </view>
    <text class="c12-nav__action" bindtap="submitAssessment">提交</text>
  </view>

  <view class="c12-body">
    <status-view
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{hasForm}}">
      <view class="c12-task-header">
        <text class="c12-task-header__title">{{form.templateName}}</text>
        <text class="c12-task-header__meta">{{eventTitle}}</text>
        <view class="c12-task-header__chips">
          <text class="c12-task-header__chip c12-task-header__chip--complete">{{progressLabel}}</text>
          <text class="c12-task-header__chip c12-task-header__chip--version">{{form.versionName}}</text>
        </view>
      </view>

      <view class="c12-progress"><view class="c12-progress__value" style="{{progressStyle}}"></view></view>

      <scroll-view scroll-x class="c12-groups" enhanced show-scrollbar="{{false}}">
        <view class="c12-groups__row">
          <view wx:for="{{groupOptions}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="switchGroup">{{item.label}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{hasCurrentField}}" class="c12-field-card">
        <view class="c12-field-card__heading">
          <text class="c12-field-card__label">当前项目</text>
          <text class="c12-field-card__position">{{fieldPositionLabel}}</text>
        </view>
        <picker mode="selector" range="{{fieldsInGroup}}" range-key="label" value="{{fieldIndex}}" bindchange="onFieldChange">
          <view class="c12-field-card__picker">
            <text class="c12-field-card__name">{{currentField.label}}</text>
            <text class="c12-field-card__unit">{{currentFieldUnitLabel}}</text>
          </view>
        </picker>
        <text wx:if="{{hasCurrentFieldProtocol}}" class="c12-field-card__protocol">{{currentFieldProtocol}}</text>
        <view class="c12-field-card__navigation">
          <button class="c12-field-card__nav-button" disabled="{{previousDisabled}}" bindtap="previousField">上一项</button>
          <button class="c12-field-card__nav-button" disabled="{{nextDisabled}}" bindtap="nextField">下一项</button>
        </view>
      </view>

      <view wx:if="{{hasCurrentField}}" class="c12-roster">
        <text class="c12-roster__title">整队录入</text>
        <view wx:for="{{draftRows}}" wx:key="studentId" class="c12-row">
          <view class="c12-row__head">
            <text class="c12-row__name">{{item.name}}</text>
            <text class="{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <view class="c12-row__controls">
            <input wx:if="{{item.showInput}}" class="c12-row__input" type="{{currentFieldInputType}}" placeholder="{{currentFieldPlaceholder}}" value="{{item.rawValue}}" data-student-id="{{item.studentId}}" bindinput="onValueInput" />
            <button class="c12-row__missing" data-student-id="{{item.studentId}}" bindtap="toggleMissing">{{item.missingActionLabel}}</button>
          </view>
          <input wx:if="{{item.showMissingReason}}" class="c12-row__reason" placeholder="缺测原因（选填）" value="{{item.missingReason}}" data-student-id="{{item.studentId}}" bindinput="onMissingReasonInput" />
          <text wx:if="{{item.invalid}}" class="c12-row__invalid">{{item.invalidHint}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="c12-submit-wrap">
    <text class="c12-submit__hint">{{submitMessage}}</text>
    <view class="{{submitClass}}" bindtap="submitAssessment">{{submitLabel}}</view>
  </view>
  <role-tabbar role="coach" active="training" />

  <view wx:if="{{draftResumeVisible}}" class="c121-event-mask">
    <view class="c121-modal">
      <view class="c121-modal__content">
        <view class="c121-modal__check-wrap"><image class="c121-modal__check" src="/assets/icons/c121-check.svg" mode="aspectFit" /></view>
        <text class="c121-modal__title">评分已自动保存</text>
        <text class="c121-modal__message">下次打开可继续录入</text>
        <text class="c121-modal__updated-at">{{draftResumeUpdatedAtLabel}}</text>
      </view>
      <view class="c121-modal__actions">
        <view class="c121-modal__continue" bindtap="continueDraft">继续录入</view>
        <view class="c121-modal__exit" bindtap="exitDraft">退出</view>
      </view>
    </view>
  </view>
</view>
