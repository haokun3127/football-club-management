.task-resolver { min-height: 100vh; background: var(--color-page); color: var(--color-text); }
.task-resolver__body { padding: 16px; }
.task-resolver__title { font-size: var(--font-size-section); font-weight: 600; line-height: 1.5; }
.task-resolver__hint { margin: 12px 0; font-size: var(--font-size-body); line-height: 1.5; color: var(--color-text-secondary); }
.task-resolver__task { display: block; margin-bottom: 12px; --td-button-medium-height: auto; }
