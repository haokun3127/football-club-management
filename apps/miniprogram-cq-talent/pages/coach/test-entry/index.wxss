.c12 {
  min-height: 100vh;
  background: #f6f7f9;
  color: #202124;
}

.c12-nav {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding-right: 44rpx;
  padding-left: 32rpx;
  background: #fceeef;
}

.c12-nav__left {
  display: flex;
  align-items: center;
  gap: 0;
  min-width: 0;
}

.c12-nav__back {
  width: 48rpx;
  height: 48rpx;
}

.c12-nav__title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.c12-nav__action {
  color: #a80f1b;
  font-size: 30rpx;
  font-weight: 600;
}

.c12-body {
  box-sizing: border-box;
  padding: 32rpx 44rpx 320rpx;
}

.c12-task-header {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-sizing: border-box;
  height: 192rpx;
  overflow: hidden;
  padding: 30rpx 32rpx;
  border-radius: 16rpx;
  background: #07111f;
  color: #ffffff;
}

.c12-task-header__title {
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c12-task-header__meta {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.64);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c12-task-header__chips {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.c12-task-header__chip {
  padding: 8rpx 14rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.c12-task-header__chip--complete {
  background: #f8e231;
  color: #07111f;
}

.c12-task-header__chip--version {
  background: #fceeef;
  color: #a80f1b;
}

.c12-progress {
  height: 10rpx;
  margin: 0 0 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7eaf0;
}

.c12-progress__value {
  height: 100%;
  border-radius: inherit;
  background: #a80f1b;
}

.c12-groups {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.c12-groups__row {
  display: inline-flex;
  gap: 14rpx;
}

.c12-group {
  padding: 14rpx 22rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #667085;
  font-size: 24rpx;
}

.c12-group--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
}

.c12-field-card,
.c12-roster {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.c12-field-card__heading,
.c12-row__head,
.c12-row__controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c12-field-card__label,
.c12-roster__title {
  font-size: 28rpx;
  font-weight: 700;
}

.c12-field-card__position,
.c12-row__status {
  color: #667085;
  font-size: 22rpx;
}

.c12-field-card__picker {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #f6f7f9;
}

.c12-field-card__name {
  font-size: 28rpx;
  font-weight: 600;
}

.c12-field-card__unit,
.c12-field-card__protocol {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.c12-field-card__protocol {
  display: block;
  margin-top: 16rpx;
}

.c12-field-card__navigation {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.c12-field-card__nav-button {
  flex: 1;
  margin: 0;
  border: 1rpx solid #e7eaf0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #202124;
  font-size: 24rpx;
}

.c12-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}

.c12-row:last-child {
  border-bottom: 0;
}

.c12-row__name {
  font-size: 28rpx;
  font-weight: 600;
}

.c12-row__status--recorded {
  color: #0f7a42;
}

.c12-row__status--missing {
  color: #ad6800;
}

.c12-row__status--invalid {
  color: #a80f1b;
}

.c12-row__controls {
  gap: 16rpx;
  margin-top: 18rpx;
}

.c12-row__input,
.c12-row__reason {
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #f6f7f9;
  font-size: 26rpx;
}

.c12-row__input {
  flex: 1;
}

.c12-row__missing {
  width: 174rpx;
  margin: 0;
  border: 1rpx solid #e7eaf0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #667085;
  font-size: 22rpx;
}

.c12-row__reason {
  width: 100%;
  margin-top: 14rpx;
}

.c12-row__invalid {
  display: block;
  margin-top: 12rpx;
  color: #a80f1b;
  font-size: 22rpx;
}

.c12-submit-wrap {
  position: fixed;
  right: 0;
  bottom: 140rpx;
  left: 0;
  z-index: 4;
  box-sizing: border-box;
  min-height: 140rpx;
  padding: 14rpx 44rpx 18rpx;
  border-top: 1rpx solid #e7eaf0;
  background: #ffffff;
}

.c12-submit__hint {
  display: block;
  min-height: 28rpx;
  margin-bottom: 8rpx;
  color: #667085;
  font-size: 20rpx;
}

.c12-submit__message {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: #667085;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c12-submit {
  padding: 22rpx;
  border-radius: 10rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.c12-submit--disabled {
  background: #c9ccd3;
}

.c121-event-mask {
  position: fixed;
  z-index: 10000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 640rpx 44rpx 0;
  background: rgba(0, 0, 0, 0.4);
}

.c121-modal {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  gap: 40rpx;
  width: 662rpx;
  padding: 48rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 24rpx rgba(0, 0, 0, 0.1);
}

.c121-modal__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.c121-modal__check-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #e8f5e9;
}

.c121-modal__check {
  width: 64rpx;
  height: 64rpx;
}

.c121-modal__title {
  color: #202124;
  font-size: 36rpx;
  font-weight: 700;
}

.c121-modal__message {
  color: #667085;
  font-size: 28rpx;
}

.c121-modal__updated-at {
  color: #667085;
  font-size: 24rpx;
}

.c121-modal__actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.c121-modal__continue,
.c121-modal__exit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.c121-modal__continue {
  background: #a80f1b;
  color: #ffffff;
}

.c121-modal__exit {
  box-sizing: border-box;
  border: 1rpx solid #e7eaf0;
  color: #667085;
}

.c12-field-navigation {
  margin: 28rpx 32rpx 22rpx;
}

.c12-field-window__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.c12-field-window__picker {
  min-width: 0;
  flex: 1;
}

.c12-field-window__selection {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
}

.c12-field-window__label {
  overflow: hidden;
  color: #202124;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c12-field-window__unit,
.c12-field-window__position,
.c12-field-window__step {
  color: #667085;
  font-size: 20rpx;
}

.c12-field-window__steps {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 12rpx;
  margin-left: 12rpx;
}

.c12-field-window__step {
  color: #a80f1b;
}

.c12-students {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
  padding: 16rpx 32rpx 0;
}

.c12-students__title {
  padding: 0 2rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
}

.c12-student-card {
  position: relative;
  display: flex;
  box-sizing: border-box;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  min-height: 136rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(24, 32, 48, 0.04);
}

.c12-student-card__head {
  display: flex;
  flex: 0 0 140rpx;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.c12-student-card__avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f3f4f6;
  color: #667085;
  font-size: 24rpx;
  font-weight: 600;
}

.c12-student-card__name {
  overflow: hidden;
  min-width: 0;
  flex: 1;
  margin-left: 0;
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c12-student-card__metrics {
  display: grid;
  min-width: 0;
  flex: 1;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 0;
}

.c12-metric-cell {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.c12-metric-cell__label {
  overflow: hidden;
  color: #667085;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c12-metric-cell__input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 64rpx;
  padding: 0 8rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 12rpx;
  color: #202124;
  font-size: 24rpx;
  text-align: center;
}

.c12-metric-cell__status {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 64rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #ad6800;
  font-size: 20rpx;
}

.c12-metric-cell__status--recorded {
  background: #e8f5e9;
  color: #0f7a42;
}

.c12-student-card__actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  min-height: 0;
  margin-top: 0;
}

.c12-student-card__missing,
.c12-student-card__invalid {
  font-size: 20rpx;
}

.c12-student-card__missing {
  color: #a80f1b;
}

.c12-student-card__invalid {
  color: #a80f1b;
}

.c12-student-card__reason {
  box-sizing: border-box;
  flex-basis: 100%;
  width: 100%;
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
  color: #202124;
  font-size: 24rpx;
}
