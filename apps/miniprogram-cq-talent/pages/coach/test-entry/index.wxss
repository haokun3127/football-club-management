.progress-track {
  height: 12rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ffffff;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: var(--color-brand);
}

.group-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.group-row {
  display: inline-flex;
  gap: 12rpx;
}

.group-tab {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #60646f;
}

.group-tab.active {
  background: var(--color-brand);
  color: #ffffff;
}

.field-picker,
.protocol {
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
}

.protocol {
  margin-top: 14rpx;
  color: #60646f;
  font-size: 22rpx;
  line-height: 1.5;
}

.field-nav,
.draft-controls {
  display: flex;
  gap: 16rpx;
}

.field-nav {
  margin-top: 16rpx;
}

.field-nav button {
  margin: 0;
}

.draft-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.draft-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.strong {
  color: #1f2329;
  font-weight: 700;
}

.draft-status {
  font-size: 22rpx;
}

.status-recorded { color: var(--color-success); }
.status-missing { color: #ad6800; }
.status-empty { color: #8a8f99; }

.draft-controls {
  margin-top: 12rpx;
}

.score-input,
.reason-input {
  flex: 1;
  min-height: 68rpx;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
}

.missing-button {
  width: 180rpx;
  margin: 0;
  color: #60646f;
  background: #ffffff;
  font-size: 24rpx;
}

.missing-button.active {
  color: #ad6800;
  border-color: #ad6800;
}

.status-invalid,
.invalid-hint {
  color: var(--color-brand);
}

.invalid-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.reason-input {
  width: 100%;
  margin-top: 12rpx;
}

.assessment-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.assessment-hero { margin-bottom: 20rpx; padding: 28rpx 24rpx; border-radius: 28rpx; background: linear-gradient(145deg,#17191f,#30333b); color: #fff; }
.assessment-hero .title { color: #fff; }
.assessment-hero__eyebrow { margin-bottom: 8rpx; color: rgba(255,255,255,.62); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.assessment-hero__meta { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }
