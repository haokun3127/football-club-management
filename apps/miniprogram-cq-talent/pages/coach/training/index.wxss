.event-picker,
.search-input {
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
}

.selected-card {
  border-color: #ffd6d2;
}

.selected-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.selected-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fceeef;
  color: #a80f1b;
  font-size: 22rpx;
}

.search-input {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 12rpx;
}

.project-group {
  border-bottom: 1rpx solid #f0f0f0;
}

.group-header {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  color: #60646f;
}

.group-title,
.strong {
  color: #1f2329;
  font-weight: 700;
}

.project-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.project-row.selected {
  background: #fffafa;
}

.project-note {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  margin-top: 20rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
}

button {
  margin-top: 20rpx;
}
.training-page { padding-bottom: calc(250rpx + env(safe-area-inset-bottom)); }
.training-event-card { margin-bottom: 20rpx; padding: 26rpx 24rpx; border-radius: 28rpx; background: linear-gradient(145deg,#17191f,#30333b); color: #fff; }
.training-event-card .section-title { color: #fff; }
.training-event-card__eyebrow { margin-bottom: 8rpx; color: rgba(255,255,255,.62); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.training-event-card .event-picker { background: rgba(255,255,255,.1); color: #fff; }
.training-event-card .subtitle { color: rgba(255,255,255,.7); }
