button {
  margin-top: 20rpx;
}

.project-group {
  margin-top: 20rpx;
}

.group-title {
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.project-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.project-row:last-child {
  border-bottom: 0;
}

.project-row.selected {
  background: #fffafa;
}

.strong {
  color: #1f2329;
  font-weight: 700;
}

.project-note {
  width: 100%;
  min-height: 120rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
  font-size: 24rpx;
}
