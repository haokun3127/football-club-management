<view class="page">
  <view class="card hero-card">
    <view class="title">训练管理</view>
    <view class="subtitle">训练内容选择、能力覆盖预览、测试任务和学员雷达图</view>
  </view>

  <status-view
    state="{{state}}"
    title="{{state === 'loading' ? '加载训练管理' : '训练管理读取失败'}}"
    message="{{message}}"
    action-text="{{state === 'error' ? '重试' : ''}}"
    bindaction="retry"
  />

  <view wx:if="{{home}}" class="card">
    <view class="section-title">我的球队</view>
    <view class="subtitle">{{teamsText}}</view>
  </view>

  <view wx:if="{{workbench}}" class="card">
    <view class="section-title">当前活动训练内容</view>
    <view wx:for="{{workbench.training}}" wx:key="label" class="field-row">
      <view class="label">{{item.label}}</view>
      <view class="field-value">{{item.value}}</view>
    </view>
  </view>

  <view wx:if="{{projectTree}}" class="card">
    <view class="section-title">训练项目树</view>
    <view class="subtitle">来自后端训练项目库，可直接保存到当前训练活动</view>
    <view wx:for="{{projectTree.groups}}" wx:key="id" class="project-group">
      <view class="group-title">{{item.name}}</view>
      <view wx:for="{{item.projects}}" wx:key="id" wx:for-item="project" class="project-row {{selectedProjectMap[project.id] ? 'selected' : ''}}" data-id="{{project.id}}" bindtap="toggleProject">
        <view>
          <view class="label strong">{{project.name}}</view>
          <view class="subtitle">{{project.description || '训练说明待同步'}}</view>
        </view>
        <view class="tag {{selectedProjectMap[project.id] ? 'success' : 'muted'}}">{{selectedProjectMap[project.id] ? '已选' : '选择'}}</view>
      </view>
    </view>
    <textarea class="project-note" placeholder="训练内容备注，可选" value="{{projectNote}}" bindinput="onProjectNoteInput" />
    <button class="primary-button" loading="{{savingProjects}}" disabled="{{savingProjects}}" bindtap="saveProjects">保存训练内容</button>
  </view>

  <view class="card">
    <view class="section-title">测试任务</view>
    <view class="subtitle">按后端模板录入并手动完整提交；缺测、任务分配和单格自动保存待 assessment-task BFF。</view>
    <button class="primary-button" bindtap="openTestEntry">进入评测录入</button>
  </view>

  <view class="card">
    <view class="section-title">待完善项</view>
    <view class="field-row"><view class="label">能力覆盖预览</view><view class="field-value">P1 BFF 待接入</view></view>
    <view class="field-row"><view class="label">全队能力概览</view><view class="field-value">P1 BFF 待接入</view></view>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
