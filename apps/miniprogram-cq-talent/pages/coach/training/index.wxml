<view class="team-workspace">
  <app-header title="{{section === 'training' ? '训练安排' : '球队'}}" show-back="{{section === 'training'}}" />
  <view class="workspace-body">
    <view class="team-context" wx:if="{{teamId}}"><view><view class="team-context__name">{{teamName}}</view><view class="team-context__season">{{season}}</view></view><t-button theme="primary" variant="text" bindtap="chooseTeam" custom-style="min-height:44px;font-size:14px;">切换球队</t-button></view>
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'empty' ? '选择球队' : '球队'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <t-button wx:if="{{state === 'empty'}}" theme="primary" bindtap="chooseTeam" block custom-style="min-height:48px;">选择球队</t-button>
    <block wx:if="{{state === 'ready'}}">
      <block wx:if="{{section === 'workspace'}}">
        <t-cell-group theme="card"><t-cell wx:for="{{entries}}" wx:key="id" title="{{item.name}}" note="{{item.note}}" arrow data-id="{{item.id}}" bindtap="openEntry" hover /></t-cell-group>
        <view class="secondary-title">球队支持</view>
        <t-cell-group theme="card"><t-cell title="教练组" arrow data-id="coaches" bindtap="openEntry" hover /><t-cell title="俱乐部球探库" arrow bindtap="openScouts" hover /></t-cell-group>
      </block>
      <block wx:else>
        <view class="section-caption">本月已排课程 · {{trainingCards.length}}节</view>
        <t-cell-group theme="card" wx:if="{{trainingCards.length}}"><t-cell wx:for="{{trainingCards}}" wx:key="id" title="{{item.title}}" description="{{item.timeLabel}}" note="{{item.venue}}" arrow data-id="{{item.id}}" bindtap="openTrainingEvent" hover /></t-cell-group>
        <view wx:else class="workspace-empty">本队本月暂无训练安排</view>
      </block>
    </block>
  </view>
  <role-tabbar wx:if="{{section === 'workspace'}}" role="coach" active="training" />
</view>
