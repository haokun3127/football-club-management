<view class="c8">
  <view class="c8-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c8-nav__title">训练管理</view>
  </view>

  <view wx:if="{{hasSelectedTeam}}" class="c8-team-context" bindtap="openTrainingTeamSelector">
    <view class="c8-team-context__copy">
      <text class="c8-team-context__label">我的球队</text>
      <view class="c8-team-context__line"><text class="c8-team-context__name">{{selectedTeamName}}</text><text class="c8-team-context__meta">{{selectedTeamMetaLabel}}</text></view>
    </view>
    <image class="c8-team-context__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
  </view>

  <view class="c8-hero">
    <view class="c8-hero__grid">
      <view wx:for="{{heroMetrics}}" wx:key="label" class="c8-stat">
        <view class="c8-stat__label">{{item.label}}</view>
        <view class="c8-stat__value">{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="c8-tabs">
    <view class="c8-tab c8-tab--active">训练计划</view>
    <view class="c8-tab" bindtap="openTeamAbility">能力评估</view>
    <view class="c8-tab" bindtap="openTeam">学员管理</view>
    <view class="c8-tab" bindtap="openTestTasks">测评任务</view>
  </view>

  <view class="c8-body">
    <status-view state="{{state}}" title="训练管理" message="{{message}}" action-text="{{retryLabel}}" bindaction="retry" />

    <view wx:if="{{hasTrainingCards}}" class="c8-list">
      <view wx:for="{{trainingCards}}" wx:key="id" class="session-card" data-id="{{item.id}}" bindtap="openTrainingEvent">
        <view class="session-card__head">
          <view class="session-card__title">{{item.title}}</view>
          <view class="session-card__time">{{item.timeLabel}}</view>
        </view>
        <view wx:if="{{item.hasVenue}}" class="session-card__venue">{{item.venue}}</view>
        <view class="session-card__foot">
          <view wx:if="{{item.hasStatus}}" class="session-card__status session-card__status--{{item.statusTone}}">{{item.statusLabel}}</view>
          <view wx:if="{{item.hasParticipantCount}}" class="session-card__count">{{item.participantLabel}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{state === 'ready' && !hasTrainingCards}}" class="c8-empty">当前球队本月暂无训练</view>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
