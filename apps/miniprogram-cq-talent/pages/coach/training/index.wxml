<view class="c8">
  <view class="c8-nav" style="padding-top:{{navInset}}px">
    <view class="c8-nav__title">训练管理</view>
  </view>

  <view class="c8-hero">
    <view class="c8-hero__grid">
      <view class="c8-stat"><view class="c8-stat__label">训练活动</view><view class="c8-stat__value">{{eventOptions.length}}</view></view>
      <view class="c8-stat"><view class="c8-stat__label">已选项目</view><view class="c8-stat__value">{{selectedProjects.length}}</view></view>
      <view class="c8-stat"><view class="c8-stat__label">在队人数</view><view class="c8-stat__value">{{home ? home.teams.length : 0}}</view></view>
      <view class="c8-stat"><view class="c8-stat__label">项目分组</view><view class="c8-stat__value">{{filteredGroups.length}}</view></view>
    </view>
  </view>

  <view class="c8-tabs">
    <view class="c8-tab c8-tab--active">训练计划</view>
    <view class="c8-tab" bindtap="openTestEntry">能力评估</view>
    <view class="c8-tab" bindtap="openContentSelect">学员管理</view>
  </view>

  <view class="c8-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载训练活动' : state === 'empty' ? '暂无训练活动' : '训练内容读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <view wx:if="{{state === 'ready'}}" class="c8-list">
      <view wx:for="{{eventOptions}}" wx:key="id" class="session-card {{eventIndex === index ? 'session-card--selected' : ''}}" data-index="{{index}}" bindtap="selectSession">
        <view class="session-card__head">
          <view class="session-card__title">{{item.teamName || '球队'}} 训练</view>
          <view class="session-card__time">{{item.displayTime}}</view>
        </view>
        <view class="session-card__venue">{{item.venue || '地点待确认'}}</view>
        <view class="session-card__foot">
          <view class="session-card__status">{{item.status || '已排定'}}</view>
          <view class="session-card__count">{{item.participantCount || 0}} 人报到</view>
        </view>
      </view>
    </view>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
