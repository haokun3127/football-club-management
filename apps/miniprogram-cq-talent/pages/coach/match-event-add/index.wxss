.match-event-page {
  min-height: 100vh;
  background: var(--color-page);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.match-event-page__body {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  padding: 32rpx var(--space-page) calc(200rpx + env(safe-area-inset-bottom));
}

.match-event-types {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.match-event-form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow:none;
}

.section-title {
  margin: 0;
  font-size: var(--font-size-section);
  font-weight: 700;
  color: var(--color-text);
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  font-size: var(--font-size-aux);
  font-weight: 600;
  color: var(--color-text);
  background: var(--color-card);
}

.type-chip--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
}

.minute-control,
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text);
}

.minute-control__input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: var(--color-text);
  font-size: var(--font-size-body);
  font-weight: 600;
}

.minute-control__arrows {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  align-items: center;
}

.minute-control__arrow,
.picker-row__chevron {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.minute-control__arrow::after,
.picker-row__chevron::after {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-color: var(--color-text-secondary);
  border-style: solid;
  border-width: 0 2rpx 2rpx 0;
  content: "";
}

.minute-control__arrow--up::after {
  top: 8rpx;
  left: 7rpx;
  transform: rotate(225deg);
}

.minute-control__arrow--down::after {
  top: 2rpx;
  left: 7rpx;
  transform: rotate(45deg);
}

.picker-row__chevron::after {
  top: 6rpx;
  left: 3rpx;
  transform: rotate(-45deg);
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  height: 160rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: var(--font-size-body);
  line-height: 1.5;
  color: var(--color-text);
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  background: #a80f1b;
  border-radius: 52rpx;
  font-size: var(--font-size-body);
  font-weight: 600;
  color: #ffffff;
}

.save-button--disabled {
  opacity: 0.72;
}

.submit-error {
  margin: 0;
  color: #b42318;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.save-button,
.type-chip { min-height:44px; min-width:44px; box-sizing:border-box; }
