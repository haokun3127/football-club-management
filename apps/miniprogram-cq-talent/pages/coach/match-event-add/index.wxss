.match-event-page {
  min-height: 100vh;
  background: var(--color-page);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.match-event-page__body {
  padding: 32rpx var(--space-page) 200rpx;
}

.match-event-form {
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .05);
}

.match-event-form__field + .match-event-form__field {
  margin-top: 28rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 0 0 16rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  background: var(--color-card);
}

.type-chip--active {
  background: #fef3f2;
  border-color: #d92d20;
  color: #b42318;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.picker-row__chevron {
  color: var(--color-text-secondary);
}

.text-input {
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.save-button {
  margin-top: 40rpx;
  background: #d92d20;
  border-radius: 52rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.submit-error {
  margin-top: 24rpx;
  color: #b42318;
  font-size: 24rpx;
  line-height: 1.5;
}
