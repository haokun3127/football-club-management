<view class="match-event-page">
  <view class="match-event-nav">
    <view class="match-event-nav__back" bindtap="goBack">返回</view>
    <view class="match-event-nav__title">添加比赛事件</view>
  </view>

  <view class="match-event-page__body">
    <status-view state="{{state}}" title="比赛事件" message="{{message}}" action-text="{{retryLabel}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view class="section-title">事件类型</view>
      <view class="type-grid">
        <view wx:for="{{eventTypes}}" wx:key="value" class="type-chip {{activeType === item.value ? 'type-chip--active' : ''}}" data-value="{{item.value}}" bindtap="selectType">{{item.label}}</view>
      </view>

      <view class="section-title">球员</view>
      <picker mode="selector" range="{{playerNames}}" value="{{playerIndex}}" bindchange="onPlayerChange">
        <view class="picker-row">
          <text>{{selectedPlayerName}}</text>
          <text class="picker-row__chevron">›</text>
        </view>
      </picker>

      <view class="section-title">发生分钟</view>
      <input class="text-input" type="number" placeholder="0-300 分钟（可选）" value="{{minute}}" bindinput="onMinuteInput" />

      <view class="section-title">备注（可选）</view>
      <input class="text-input" placeholder="补充说明" value="{{note}}" bindinput="onNoteInput" />

      <view wx:if="{{hasSubmitError}}" class="submit-error">{{submitError}}</view>
      <button class="save-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="saveEvent">保存事件</button>
    </block>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
