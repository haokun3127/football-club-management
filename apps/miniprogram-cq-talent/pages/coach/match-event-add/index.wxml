<view class="match-event-page">
  <app-header title="添加比赛事件" show-back />
  <view class="match-event-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载名单' : state === 'empty' ? '暂无球员' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <!-- 事件类型 chips（Figma C6.1: 选中=品牌红 r8） -->
      <view class="section-title">事件类型</view>
      <view class="type-grid">
        <view
          wx:for="{{eventTypes}}"
          wx:key="value"
          class="type-chip {{activeType === item.value ? 'type-chip--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectType"
        >{{item.label}}</view>
      </view>

      <!-- 球员选择 -->
      <view class="section-title">球员</view>
      <picker mode="selector" range="{{playerNames}}" value="{{playerIndex}}" bindchange="onPlayerChange">
        <view class="picker-row">
          <text>{{playerNames[playerIndex] || '请选择球员'}}</text>
          <text class="picker-row__chevron">›</text>
        </view>
      </picker>

      <!-- 分钟 -->
      <view class="section-title">发生时间</view>
      <input class="text-input" type="number" placeholder="分钟，例如 54" value="{{minute}}" bindinput="onMinuteInput" />

      <!-- 备注 -->
      <view class="section-title">备注（选填）</view>
      <input class="text-input" placeholder="例如：左脚推射远角" value="{{note}}" bindinput="onNoteInput" />

      <view class="save-button" bindtap="saveEvent">添加事件</view>
    </block>
  </view>
  <role-tabbar role="coach" active="schedule" />
</view>
