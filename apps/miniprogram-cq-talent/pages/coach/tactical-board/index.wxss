page { height:100%; overflow:hidden; background:#f7f7f5; }
.c7-page { height:100vh; box-sizing:border-box; display:flex; flex-direction:column; padding-bottom:env(safe-area-inset-bottom); color:#202124; }
.c7-header { height:48px; min-height:48px; display:flex; align-items:center; background:white; }
.c7-back { margin:0 10px; padding:8px; background:none; line-height:1; }
.c7-back::after,.c7-actions button::after,.c7-error::after { border:0; }
.c7-back image { width:24px; height:24px; }
.c7-title { font-size:18px; font-weight:700; }
.c7-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:8px 16px; font-size:12px; }
.c7-event { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.c7-status { flex-shrink:0;        background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.c7-status--error {        background:transparent;border-radius:0;padding:0;height:auto;min-height:0;color:var(--color-text-secondary);}
.c7-pitch { position:relative; flex:1; min-height:160px; margin:0 12px; overflow:visible; border-radius:8px; background:repeating-linear-gradient(0deg,#176044 0,#176044 12.5%,#1b694b 12.5%,#1b694b 25%); }
.c7-boundary { position:absolute; inset:12px; border:1px solid #a0c4ad; }
.c7-halfway { position:absolute; left:12px; right:12px; top:50%; border-top:1px solid #a0c4ad; }
.c7-center { position:absolute; width:80px; height:80px; left:50%; top:50%; transform:translate(-50%,-50%); border:1px solid #a0c4ad; border-radius:50%; }
.c7-box { position:absolute; width:42%; height:16%; left:29%; border:1px solid #a0c4ad; }
.c7-box--top { top:12px; border-top:0; }.c7-box--bottom { bottom:12px; border-bottom:0; }
.c7-hint { position:absolute; top:38%; width:100%; text-align:center; color:#e3eee7; font-size:13px; }
.c7-player,.c7-ghost { position:absolute; display:flex; flex-direction:column; align-items:center; width:64px; transform:translate(-50%,-50%); z-index:2; }
.c7-player image,.c7-ghost image { width:34px; height:34px; border:2px solid white; border-radius:50%; background:#a80f1b; box-shadow:none; }
.c7-player text,.c7-ghost text { max-width:90px; white-space:nowrap; background:#152e24; color:white; padding:2px 5px; border-radius:3px; font-size:12px; font-weight:600; }
.c7-player--dragging { opacity:.3; }
.c7-roster { margin:8px 12px 0; border:2px solid transparent; border-radius:8px; background:white; }
.c7-roster--target { border-color:#a80f1b; background:#fff4f4; }
.c7-roster-heading { display:flex; justify-content:space-between; align-items:center; gap:6px; padding:8px; font-size:12px; font-weight:600; }
.c7-muted { color:#747a80; font-size:11px; font-weight:400; }
.c7-roster-scroll { height:116px; }
.c7-roster-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px 4px; padding:4px 4px 10px; }
.c7-roster-player { display:flex; flex-direction:column; align-items:center; gap:4px; font-size:12px; }
.c7-roster-player image { width:34px; height:34px; padding:4px; box-sizing:border-box; background:#f0f1f2; border-radius:50%; }
.c7-roster-player text { max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.c7-actions { display:flex; flex-shrink:0; gap:12px; padding:8px 14px; }
.c7-actions button { flex:1; margin:0; font-size:13px; line-height:36px; border-radius:6px; background:#ede7e7; color:#a80f1b; }
.c7-actions button[disabled] { color:#9da0a3; background:#eeefef; }
.c7-error { margin:0 12px 6px; padding:4px; font-size:12px; line-height:20px; color:#a80f1b; background:#fff0f1; }
.c7-ghost { position:fixed; z-index:1000; pointer-events:none; transform:translate(-50%,-85%); }
.c7-ghost image { width:42px; height:42px; }
.c7-feedback { padding:60px 24px; display:flex; flex-direction:column; gap:16px; text-align:center; }
@media (max-height:640px) { .c7-roster-scroll { height:78px; } .c7-toolbar { padding:5px 16px; } }
