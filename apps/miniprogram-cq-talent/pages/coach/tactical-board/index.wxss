.c7-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); background: #ffffff; }

.c7-header-shell { position: sticky; top: 0; z-index: 100; box-sizing: border-box; background: #ffffff; }
.c7-header { position: relative; display: flex; height: 88rpx; box-sizing: border-box; align-items: center; margin: 0; border-radius: 0; background: #ffffff; }
.c7-header__back { position: absolute; z-index: 1; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; }
.c7-header__back image { display: block; width: 40rpx; height: 40rpx; }
.c7-header__title { position: absolute; left: 112rpx; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; white-space: nowrap; }

.c7-content { padding: 0; background: #ffffff; }

.c7-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 44rpx;
  color: #667085;
  text-align: center;
}

.c7-feedback__title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
}

.c7-feedback__message {
  font-size: 26rpx;
  line-height: 40rpx;
}

.c7-feedback__retry {
  min-width: 160rpx;
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.c7-context-label { margin: 20rpx 32rpx 0; color: #a80f1b; font-size: 20rpx; font-weight: 700; line-height: 28rpx; letter-spacing: 1rpx; }
.c7-status { flex: 0 0 auto; padding: 8rpx 16rpx; border-radius: 99rpx; font-size: 20rpx; line-height: 28rpx; }
.c7-status--loaded, .c7-status--saved { background: #f0fff4; color: #237804; }
.c7-status--dirty { background: #fff7e6; color: #ad6800; }
.c7-formation-row { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 32rpx 0; }
.c7-formation-title { color: #202124; font-size: 34rpx; font-weight: 700; line-height: 44rpx; }
.c7-formation-picker { display: flex; box-sizing: border-box; width: 144rpx; height: 72rpx; align-items: center; justify-content: center; gap: 8rpx; padding: 0 16rpx; border: 1rpx solid #e7eaf0; border-radius: 36rpx; background: #ffffff; }
.c7-formation-label { overflow: hidden; color: #202124; font-size: 24rpx; font-weight: 700; line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.c7-formation-chevron { display: block; flex: 0 0 24rpx; width: 24rpx; height: 24rpx; }
.c7-board-container { box-sizing: border-box; padding-top: 28rpx; }
.c7-workspace { position: relative; box-sizing: border-box; width: 100%; height: 1040rpx; }
.c7-pitch { position: absolute; top: 0; left: 32rpx; box-sizing: border-box; width: calc(100vw - 64rpx); height: 568rpx; overflow: hidden; border-radius: 32rpx; background: #278a53; }
.c7-pitch__hint { position: absolute; z-index: 1; top: 24rpx; left: 28rpx; color: #ffffff; font-size: 20rpx; line-height: 28rpx; }
.c7-pitch__halfway { position: absolute; top: 282rpx; right: 24rpx; left: 24rpx; height: 2rpx; background: rgba(255,255,255,.75); }
.c7-pitch__boundary { position: absolute; inset: 24rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.75); border-radius: 0; }

.c7-player { width: 80rpx; height: 80rpx; text-align: center; }
.c7-player--readonly { position: absolute; }

.c7-player__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: #a80f1b;
  color: #ffffff;
}

.c7-player__number { color: #ffffff; font-size: 22rpx; font-weight: 700; line-height: 28rpx; }
.c7-player--selected .c7-player__badge { box-shadow: 0 0 0 4rpx #ffd666; }
.c7-roster { position: absolute; z-index: 0; top: 580rpx; right: 32rpx; left: 32rpx; box-sizing: border-box; height: 444rpx; padding: 24rpx 0 0; background: transparent; }
.c7-roster__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.c7-roster__title { color: #202124; font-size: 30rpx; font-weight: 700; line-height: 36rpx; }
.c7-roster__hint { flex: 1; color: #667085; font-size: 20rpx; line-height: 28rpx; text-align: right; }
.c7-roster__grid { position: absolute; top: 580rpx; right: 32rpx; left: 32rpx; height: 444rpx; pointer-events: none; }
.c7-roster__player { position: absolute; width: 96rpx; height: 160rpx; text-align: center; }
.c7-roster__player--listed { z-index: 1; }
.c7-roster__player--movable { z-index: 2; }
.c7-roster__avatar { display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid #d0d5dd; border-radius: 50%; color: #344054; font-size: 22rpx; font-weight: 700; line-height: 28rpx; }
.c7-roster__avatar--candidate { border-color: #a80f1b; background: #fdecef; color: #a80f1b; }
.c7-roster__avatar--on-field { background: #e7eaf0; color: #344054; }
.c7-roster__name { overflow: hidden; margin-top: 8rpx; color: #667085; font-size: 20rpx; line-height: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.c7-roster__status { overflow: hidden; margin-top: 4rpx; color: #667085; font-size: 20rpx; line-height: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.c7-actions { display: flex; gap: 28rpx; height: 96rpx; margin: 84rpx 32rpx 0; }
.c7-action { display: flex; box-sizing: border-box; align-items: center; justify-content: center; border-radius: 24rpx; font-size: 26rpx; font-weight: 700; line-height: 36rpx; }
.c7-action--secondary { width: 320rpx; border: 1rpx solid #e7eaf0; background: #ffffff; color: #202124; }
.c7-action--primary { flex: 1; background: #a80f1b; color: #ffffff; }
.c7-action--disabled { opacity: .55; }
.c7-save-error { margin: 12rpx 32rpx 0; padding: 16rpx 20rpx; border-radius: 16rpx; background: #fff1f0; color: #a80f1b; font-size: 24rpx; line-height: 34rpx; }
