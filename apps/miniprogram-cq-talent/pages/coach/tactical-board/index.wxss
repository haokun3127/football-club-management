.c7-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 300rpx; background: #f6f7f9; }

.c7-header { display: flex; height: 88rpx; box-sizing: content-box; align-items: center; justify-content: space-between; padding-left: 32rpx; background: #ffffff; }
.c7-header__left { display: flex; align-items: center; gap: 0; min-width: 0; height: 100%; }
.c7-header__back, .c7-header__share { display: flex; align-items: center; justify-content: center; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; }
.c7-header__back image, .c7-header__share image { display: block; width: 48rpx; height: 48rpx; }
.c7-header__title { color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; white-space: nowrap; }

.c7-content { padding: 0; }

.c7-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 44rpx;
  color: #667085;
  text-align: center;
}

.c7-feedback__title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
}

.c7-feedback__message {
  font-size: 26rpx;
  line-height: 40rpx;
}

.c7-feedback__retry {
  min-width: 160rpx;
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.c7-board-container { display: flex; box-sizing: border-box; height: 840rpx; align-items: center; justify-content: center; padding: 32rpx; }
.c7-pitch { position: relative; box-sizing: border-box; width: 686rpx; height: 760rpx; overflow: hidden; border-radius: 32rpx; background: #1a1a2e; }
.c7-pitch__circle { position: absolute; left: 273rpx; box-sizing: border-box; width: 140rpx; height: 140rpx; border: 1rpx solid rgba(255,255,255,.28); border-radius: 50%; background: rgba(255,255,255,.2); }
.c7-pitch__circle--top { top: 0; }.c7-pitch__circle--middle { top: 300rpx; }.c7-pitch__circle--bottom { top: 620rpx; }

.c7-pitch__halfway { position: absolute; top: 380rpx; right: 0; left: 0; height: 4rpx; background: rgba(255,255,255,.2); }
.c7-pitch__boundary { position: absolute; inset: 0; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.1); border-radius: 32rpx; }

.c7-player { width: 48rpx; height: 48rpx; text-align: center; }
.c7-player--readonly { position: absolute; }

.c7-player__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.c7-player--selected .c7-player__badge { box-shadow: 0 0 0 4rpx #ffd666; }
.c7-formation-label { display: flex; align-items: center; justify-content: center; height: 48rpx; color: #667085; font-size: 28rpx; line-height: 36rpx; text-align: center; }
.c7-save-error { margin: 12rpx 32rpx 0; padding: 16rpx 20rpx; border-radius: 16rpx; background: #fff1f0; color: #a80f1b; font-size: 24rpx; line-height: 34rpx; }

.c7-record image { display: block; width: 40rpx; height: 40rpx; }
.c7-record--disabled { opacity: .92; }
