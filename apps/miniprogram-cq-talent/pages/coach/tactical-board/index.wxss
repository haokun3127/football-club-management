.c7-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f6f7f9;
}

.c7-header {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  width: calc(100% - 48rpx);
  height: 124rpx;
  margin: 32rpx 24rpx 0;
  padding: 0 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.c7-header__back,
.c7-header__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
}

.c7-header__back {
  color: #202124;
  font-size: 52rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.c7-header__titles {
  flex: 1;
  text-align: center;
}

.c7-header__title {
  color: #202124;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.c7-header__subtitle {
  margin-top: 4rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 28rpx;
}

.c7-content {
  padding: 32rpx 24rpx 64rpx;
}

.c7-feedback {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 44rpx;
  color: #667085;
  text-align: center;
}

.c7-feedback__title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
}

.c7-feedback__message {
  font-size: 26rpx;
  line-height: 40rpx;
}

.c7-feedback__retry {
  min-width: 160rpx;
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.c7-context {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 8rpx 24rpx;
}

.c7-context__eyebrow {
  color: #a80f1b;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  letter-spacing: 2rpx;
}

.c7-context__title {
  margin-top: 6rpx;
  color: #202124;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.c7-status {
  flex: none;
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 99rpx;
  font-size: 20rpx;
  line-height: 28rpx;
}

.c7-status--loaded { background: #f2f4f7; color: #667085; }
.c7-status--dirty { background: #fff7e6; color: #ad6800; }
.c7-status--saved { background: #f0fff4; color: #237804; }

.c7-readonly,
.c7-save-error {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 24rpx;
  line-height: 34rpx;
}

.c7-save-error { margin-top: 20rpx; margin-bottom: 0; background: #fff1f0; color: #a80f1b; }

.c7-formation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 96rpx;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 24rpx;
  background: #ffffff;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}

.c7-formation--static { color: #667085; }
.c7-formation__arrow { font-size: 28rpx; font-weight: 400; }

.c7-pitch {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 860rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #278a53;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.16);
}

.c7-pitch__boundary {
  position: absolute;
  inset: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
}

.c7-pitch__halfway {
  position: absolute;
  top: 50%;
  right: 24rpx;
  left: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.75);
}

.c7-pitch__circle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.c7-pitch__box {
  position: absolute;
  left: 50%;
  width: 220rpx;
  height: 90rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  transform: translateX(-50%);
}

.c7-pitch__box--top { top: 24rpx; border-top: 0; }
.c7-pitch__box--bottom { bottom: 24rpx; border-bottom: 0; }

.c7-player {
  width: 112rpx;
  height: 132rpx;
  text-align: center;
}

.c7-player--readonly { position: absolute; }

.c7-player__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: #a80f1b;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.c7-player--selected .c7-player__badge { border-color: #ffd666; transform: scale(1.08); }

.c7-player__name,
.c7-player__position {
  overflow: hidden;
  color: #ffffff;
  text-overflow: ellipsis;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.65);
  white-space: nowrap;
}

.c7-player__name { margin-top: 4rpx; font-size: 18rpx; font-weight: 700; }
.c7-player__position { margin-top: 2rpx; font-size: 16rpx; }

.c7-bench {
  box-sizing: border-box;
  min-height: 172rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 28rpx;
  background: #ffffff;
}

.c7-bench__head { display: flex; align-items: center; gap: 20rpx; }
.c7-bench__title { color: #202124; font-size: 30rpx; font-weight: 700; }
.c7-bench__hint { flex: 1; color: #667085; font-size: 20rpx; text-align: right; }
.c7-bench__scroll { width: 100%; margin-top: 16rpx; white-space: nowrap; }
.c7-bench__row { display: inline-flex; align-items: flex-start; gap: 24rpx; }
.c7-bench__empty { color: #667085; font-size: 24rpx; line-height: 68rpx; }

.c7-bench-player { width: 68rpx; color: #202124; font-size: 18rpx; text-align: center; }
.c7-bench-player__avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: #f2f4f7; font-weight: 700; }
.c7-bench-player__name { overflow: hidden; margin-top: 6rpx; text-overflow: ellipsis; white-space: nowrap; }

.c7-actions { display: flex; gap: 24rpx; margin-top: 28rpx; }
.c7-actions__reset,
.c7-actions__save { display: flex; flex: 1; align-items: center; justify-content: center; height: 96rpx; border-radius: 24rpx; font-size: 26rpx; font-weight: 700; }
.c7-actions__reset { border: 1rpx solid #e7eaf0; background: #ffffff; color: #202124; }
.c7-actions__save { background: #a80f1b; color: #ffffff; }
.c7-actions__save--disabled { opacity: 0.45; }
