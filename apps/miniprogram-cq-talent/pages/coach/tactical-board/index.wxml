<view class="c7-page">
  <view class="c7-header" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c7-header__left">
      <view class="c7-header__back" bindtap="goBack" aria-label="返回">
        <image src="/assets/icons/chevron-left.svg" mode="aspectFit" />
      </view>
      <view class="c7-header__title">战术板</view>
    </view>
  </view>

  <view class="c7-content">
    <view wx:if="{{state === 'loading'}}" class="c7-feedback">
      <view class="c7-feedback__title">{{stateTitle}}</view>
      <view class="c7-feedback__message">{{message}}</view>
    </view>

    <view wx:elif="{{state === 'empty' || state === 'error'}}" class="c7-feedback">
      <view class="c7-feedback__title">{{stateTitle}}</view>
      <view class="c7-feedback__message">{{message}}</view>
      <view wx:if="{{state === 'error'}}" class="c7-feedback__retry" bindtap="retry">重试</view>
    </view>

    <block wx:elif="{{state === 'ready'}}">
      <view class="c7-board-container">
        <movable-area id="c7-pitch" class="c7-pitch">
          <view class="c7-pitch__circle c7-pitch__circle--top"></view>
          <view class="c7-pitch__circle c7-pitch__circle--middle"></view>
          <view class="c7-pitch__circle c7-pitch__circle--bottom"></view>
          <view class="c7-pitch__halfway"></view>
          <view class="c7-pitch__boundary"></view>

          <block wx:if="{{!readOnly}}">
            <movable-view wx:for="{{starters}}" wx:key="studentId" class="{{item.className}}" direction="all" x="{{item.px}}" y="{{item.py}}" inertia="{{false}}" out-of-bounds="{{false}}" data-id="{{item.studentId}}" bindchange="onPlayerMove" bindtap="selectStarter">
              <view class="c7-player__badge">{{item.initials}}</view>
            </movable-view>
          </block>
          <block wx:else>
            <view wx:for="{{starters}}" wx:key="studentId" class="{{item.className}} c7-player--readonly" style="left: {{item.px}}px; top: {{item.py}}px;">
              <view class="c7-player__badge">{{item.initials}}</view>
            </view>
          </block>
        </movable-area>
      </view>

      <block wx:if="{{!readOnly && hasFormation}}">
        <picker mode="selector" range="{{formations}}" range-key="label" value="{{formationIndex}}" bindchange="onFormationChange">
          <view class="c7-formation-label">{{formationLabel}}</view>
        </picker>
      </block>
      <view wx:else class="c7-formation-label">{{formationLabel}}</view>
      <view wx:if="{{saveError}}" class="c7-save-error">{{saveError}}</view>
    </block>
  </view>

  <view wx:if="{{state === 'ready'}}" class="c7-record {{dirty ? '' : 'c7-record--disabled'}}" bindtap="saveBoard" aria-label="保存战术板">
    <image src="/assets/icons/c7-video.svg" mode="aspectFit" />
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
