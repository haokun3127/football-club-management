<view class="c7-page">
  <view class="c7-navigation"><app-header title="比赛战术板" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" /></view>
  <view wx:if="{{state !== 'ready'}}" class="c7-feedback">
    <text>{{stateTitle}}</text><text class="c7-muted">{{message}}</text>
    <t-button wx:if="{{state === 'error'}}" bindtap="retry" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">重新加载</t-button>
  </view>
  <block wx:else>
    <view class="c7-toolbar"><text class="c7-event">{{eventTitle}}</text><text class="c7-status {{saveError ? 'c7-status--error' : ''}}">{{saveLabel}}</text></view>
    <view class="c7-context">自由摆放仅记录战术布置，不代表实际出场或训练计次。</view>
    <view id="c7-pitch" class="c7-pitch">
      <view class="c7-boundary"></view><view class="c7-halfway"></view><view class="c7-center"></view>
      <view class="c7-box c7-box--top"></view><view class="c7-box c7-box--bottom"></view>
      <text wx:if="{{!starters.length}}" class="c7-hint">{{readOnly ? '暂无场上布置' : '长按下方球员，拖入球场'}}</text>
      <view wx:for="{{starters}}" wx:key="studentId" class="c7-player {{dragId === item.studentId ? 'c7-player--dragging' : ''}}" style="left:{{item.left}}%;top:{{item.top}}%" data-id="{{item.studentId}}" bindtouchstart="startPlayerDrag" catchtouchmove="movePlayer" bindtouchend="finishDrag" bindtouchcancel="cancelDrag">
        <image src="{{item.avatarUrl || '/assets/icons/user-white.svg'}}" mode="aspectFill" /><text>{{item.displayName}}</text>
      </view>
    </view>
    <view id="c7-roster" class="c7-roster {{rosterTarget ? 'c7-roster--target' : ''}}">
      <view class="c7-roster-heading"><text>可用球员 · {{rosterPlayers.length}}</text><text class="c7-muted">{{readOnly ? '当前布置仅供查看' : '长按拖入 · 拖回名单'}}</text></view>
      <scroll-view class="c7-roster-scroll" scroll-y="{{!dragId}}">
        <view class="c7-roster-grid">
          <view wx:for="{{rosterPlayers}}" wx:key="studentId" class="c7-roster-player {{dragId === item.studentId ? 'c7-player--dragging' : ''}}" data-id="{{item.studentId}}" bindlongpress="startRosterDrag" bindtouchmove="movePlayer" bindtouchend="finishDrag" bindtouchcancel="cancelDrag">
            <image src="{{item.avatarUrl || '/assets/icons/user.svg'}}" mode="aspectFill" /><text>{{item.displayName}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="c7-actions">
      <t-button disabled="{{readOnly || !canUndo}}" bindtap="undoMove" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">撤销上一步</t-button>
      <t-button disabled="{{readOnly || !starters.length}}" bindtap="clearBoard" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">清空球场</t-button>
    </view>
    <t-button wx:if="{{saveError}}" class="c7-error" bindtap="saveBoard" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="c7-error" theme="primary" variant="text">{{saveError}}</t-button>
    <view wx:if="{{dragId}}" class="c7-ghost" style="left:{{dragX}}px;top:{{dragY}}px"><image src="{{dragAvatar || '/assets/icons/user-white.svg'}}" mode="aspectFill" /><text>{{dragName}}</text></view>
  </block>
</view>
