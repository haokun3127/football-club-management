<view class="tasks-page">
  <view class="tasks-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="tasks-nav__left">
      <view class="tasks-nav__back" bindtap="goBack" aria-label="返回"><image src="/assets/icons/c11-arrow-left.svg" mode="aspectFit" /></view>
      <view class="tasks-nav__title">测评任务</view>
    </view>
    <view class="tasks-nav__create" bindtap="openCreate" aria-label="新增测评任务">新增</view>
  </view>

  <view class="tasks-page__body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{statusTitle}}" message="{{message}}" action-text="{{statusActionText}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view class="filter-row">
        <view wx:for="{{filters}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="selectFilter">{{item.label}}</view>
      </view>

      <view wx:if="{{hasVisibleTasks}}" class="task-list">
        <view wx:for="{{visibleTasks}}" wx:key="id" class="task-card" data-id="{{item.id}}" bindtap="openTask">
          <view class="task-card__head">
            <view class="task-card__title">{{item.title}}</view>
            <view class="{{item.statusClass}}">{{item.statusLabel}}</view>
          </view>
          <view class="task-card__context">{{item.teamContextLabel}}</view>
          <view class="task-card__dates">{{item.dateRange}}</view>
          <view class="task-card__foot">
            <view class="task-card__progress">
              <view class="task-card__progress-label">{{item.progressLabel}}</view>
              <view class="task-card__track"><view class="task-card__bar {{item.progressClass}}" style="{{item.progressStyle}}"></view></view>
            </view>
            <image class="task-card__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view wx:else class="filter-empty">当前筛选暂无测评任务。</view>
    </block>
  </view>

  <view class="tasks-fab" bindtap="openCreate" aria-label="新增测评任务"><image src="/assets/icons/plus.svg" mode="aspectFit" /></view>
  <role-tabbar role="coach" active="training" />
</view>
