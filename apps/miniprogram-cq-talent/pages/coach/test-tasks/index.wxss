.tasks-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.tasks-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  justify-content: space-between;
  background: #fceeef;
}

.tasks-nav__left {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  gap: 0;
}

.tasks-nav__back {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.tasks-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tasks-nav__back image {
  width: 48rpx;
  height: 48rpx;
}

.tasks-nav__title {
  color: #202124;
  font-size: var(--font-size-display);
  font-weight: 700;
  line-height: 1.5;
}

.tasks-nav__create {
  flex: 0 0 auto;
  color: #a80f1b;
  font-size: var(--font-size-body);
  font-weight: 600;
  line-height: 1.5;
}

.tasks-page__body {
  /* Figma's 331px content frame keeps 16px inner gutters and a 16px filter inset.
     底部预留：底栏 140rpx + FAB 底 172rpx + 高 112rpx 内的悬浮区域，避免末卡被 FAB 压住。 */
  padding: 64rpx 76rpx 316rpx;
}

.filter-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.filter-chip {
  padding: 16rpx 32rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 32rpx;
  background: #ffffff;
  color: #667085;
  font-size: var(--font-size-aux);
  font-weight: 500;
  line-height: 1.5;
}

.filter-chip--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 600;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.task-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.05);
}

.task-card__head,
.task-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.task-card__title {
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-card__context {
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.task-card__status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: var(--font-size-aux);
  font-weight: 600;
  line-height: 1.5;
}

.task-card__status--in_progress {
  background: #e8f5e9;
  color: #2e7d32;
}

.task-card__status--not_started {
  background: #f3f4f6;
  color: #94a3b8;
}

.task-card__status--completed {
  background: #e0e7ff;
  color: #4f46e5;
}

.task-card__dates,
.task-card__progress-label {
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.task-card__progress {
  flex: 1;
}

.task-card__progress-label {
  margin-bottom: 8rpx;
  font-size: var(--font-size-aux);
}

.task-card__track {
  width: 240rpx;
  max-width: 100%;
  height: 8rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: #f0f0f0;
}

.task-card__bar {
  height: 100%;
  border-radius: 4rpx;
  background: #a80f1b;
}

.task-card__bar--muted {
  background: #94a3b8;
}

.task-card__chevron {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.tasks-fab {
  /* 底栏高 140rpx（role-tabbar，z-index 9999）：FAB 抬到 140rpx + 32rpx 间距之上，保证完整可见可点。 */
  position: fixed;
  right: 56rpx;
  bottom: 172rpx;
  z-index: 9998;
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 56rpx;
  background: var(--color-brand);
  box-shadow: 0 8rpx 12rpx rgba(var(--color-brand-rgb), 0.25);
}

.tasks-fab image {
  width: 48rpx;
  height: 48rpx;
}

.filter-empty {
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #667085;
  font-size: var(--font-size-aux);
  line-height: 1.5;
  text-align: center;
}

.tasks-first-hint {
  margin-top: 20rpx;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  background: #fff5f5;
  color: #a80f1b;
  font-size: var(--font-size-aux);
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
}
