.tasks-page { min-height:100vh; background:var(--color-page); }
.tasks-page__body { padding:24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.filter-row { display:flex; gap:16rpx; margin-bottom:24rpx; }
.filter-chip { display:flex; flex:1; align-items:center; justify-content:center; box-sizing:border-box; min-height:44px; padding:12rpx 16rpx; border:1rpx solid var(--color-line); border-radius:var(--radius-button); background:var(--color-card); color:var(--color-text-secondary); font-size:var(--font-size-body); }
.filter-chip--active { border-color:var(--color-brand); color:var(--color-brand); background:var(--color-brand-soft); font-weight:600; }
.task-list { display:flex; flex-direction:column; gap:20rpx; }
.task-card { display:flex; flex-direction:column; gap:16rpx; padding:28rpx; border:1rpx solid var(--color-line); border-radius:var(--radius-card); background:var(--color-card); }
.task-card__head,.task-card__foot { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.task-card__title { min-width:0; color:var(--color-text); font-size:var(--font-size-section); font-weight:600; line-height:1.5; }
.task-card__context,.task-card__dates,.task-card__progress-label { color:var(--color-text-secondary); font-size:var(--font-size-aux); line-height:1.5; }
.task-card__status { flex-shrink:0; color:var(--color-text-secondary); font-size:var(--font-size-aux); }
.task-card__status--in_progress { color:var(--color-brand); }
.task-card__progress { flex:1; }
.task-card__progress-label { margin-bottom:8rpx; }
.task-card__track { width:100%; height:8rpx; overflow:hidden; border-radius:4rpx; background:var(--color-line); }
.task-card__bar { height:100%; background:var(--color-brand); }
.task-card__bar--muted { background:var(--color-text-secondary); }
.task-card__chevron { width:32rpx; height:32rpx; flex:0 0 32rpx; }
.filter-empty,.tasks-first-hint { padding:24rpx 0; color:var(--color-text-secondary); font-size:var(--font-size-aux); line-height:1.6; text-align:center; }
