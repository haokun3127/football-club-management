.c161-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.c161-nav {
  height: 88rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-right: 44rpx;
  padding-left: 32rpx;
  background: #fceeef;
}

.c161-nav__back {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

.c161-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
}

.c161-nav__back-icon {
  width: 48rpx;
  height: 48rpx;
}

.c161-nav__title {
  color: #1f2937;
  font-size: 44rpx;
  font-weight: 700;
}

.c161-page__body {
  padding: 32rpx 44rpx 180rpx;
}

.c161-content {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.c161-explain {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.c161-explain__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  background: #dbeafe;
  border-radius: 50%;
}

.c161-explain__icon {
  width: 32rpx;
  height: 32rpx;
}

.c161-explain__text {
  color: #677487;
  font-size: 26rpx;
  line-height: 40rpx;
}

.c161-permission-list {
  overflow: hidden;
  background: #ffffff;
  border-radius: 24rpx;
}

.c161-permission-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.c161-permission-row:last-child {
  border-bottom: none;
}

.c161-permission-row__label {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 600;
}

.c161-switch {
  width: 80rpx;
  height: 48rpx;
}

.c161-admin-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  color: #ffffff;
  background: #a80f1b;
  border-radius: 52rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.c161-empty {
  padding: 96rpx 32rpx;
  text-align: center;
}

.c161-empty__toggle {
  width: 80rpx;
  height: 48rpx;
}

.c161-empty__title {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
}

.c161-empty__message {
  margin-top: 16rpx;
  color: #768396;
  font-size: 26rpx;
  line-height: 40rpx;
}

.c161-empty .c161-admin-cta {
  margin-top: 32rpx;
}
