<view class="radar-page">
  <view class="radar-nav" style="padding-top:{{navInset}}px">
    <view class="radar-nav__back" bindtap="goBack">
      <image class="radar-nav__back-icon" src="/assets/icons/c13-arrow-left.svg" mode="aspectFit" />
    </view>
    <view class="radar-nav__title">学员雷达</view>
    <view class="radar-nav__placeholder"></view>
  </view>
  <view class="radar-page__body">
    <view wx:if="{{students.length}}" class="radar-context">{{radarContext}}</view>

    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载能力雷达' : state === 'empty' ? '暂无雷达数据' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{hasRadar}}">
      <view class="radar-hero {{radarHeroClass}}">
        <view class="radar-hero__head">
          <view class="radar-hero__title">六维能力模型</view>
          <view class="radar-hero__period">综合 {{overall}}</view>
        </view>
        <view class="radar-hero__plot">
          <radar-canvas class="radar-hero__canvas" metrics="{{radar}}" width="528rpx" height="528rpx"></radar-canvas>
        </view>
      </view>
    </block>

    <view wx:if="{{students.length}}" class="radar-roster">
      <view class="radar-roster__head">
        <view class="radar-roster__title">全部学员</view>
        <view class="radar-roster__hint">点击头像切换查看</view>
      </view>
      <view class="radar-roster__grid">
        <view wx:for="{{students}}" wx:key="id" class="radar-player {{activeStudentId === item.id ? 'radar-player--active' : ''}}" data-id="{{item.id}}" bindtap="selectStudent">
          <view class="radar-player__avatar">{{item.initial}}</view>
          <view class="radar-player__name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
