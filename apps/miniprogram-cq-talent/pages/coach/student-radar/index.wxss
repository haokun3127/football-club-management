.radar-page {
  min-height: 100vh;
  background: var(--color-page);
}

.radar-page__body {
  padding: 24rpx var(--space-page) 180rpx;
}

.student-strip {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.student-strip__inner {
  display: flex;
  gap: 16rpx;
}

.student-chip {
  padding: 16rpx 32rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-line);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.student-chip--active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #ffffff;
  font-weight: 600;
}

/* 雷达 Hero（Figma C13: #07111f r16） */
.radar-hero {
  background: #07111f;
  border-radius: 32rpx;
  padding: 32rpx;
}

.radar-hero__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.radar-hero__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.radar-hero__overall {
  margin-top: 16rpx;
  text-align: center;
  font-size: 80rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}
