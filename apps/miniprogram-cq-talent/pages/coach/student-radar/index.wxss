.radar-page { min-height: 100vh; background: var(--color-page); padding-bottom: 48rpx; }
.radar-nav { position: sticky; top: 0; z-index: 100; display: flex; height: 88rpx; box-sizing: content-box; align-items: center; padding: 0 32rpx; background: #ffffff; }
.radar-nav__back, .radar-nav__placeholder { width: 48rpx; height: 64rpx; flex: 0 0 48rpx; }
.radar-nav__back { display: flex; align-items: center; justify-content: center; }
.radar-nav__back-icon { width: 36rpx; height: 36rpx; }
.radar-nav__title { flex: 1; min-width: 0; margin-left: 16rpx; overflow: hidden; text-align: left; text-overflow: ellipsis; white-space: nowrap; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; }
.radar-page__body { padding: 16rpx var(--space-page) 180rpx; }
.radar-context { margin-bottom: 16rpx; color: #667085; font-size: 26rpx; line-height: 36rpx; }
.radar-hero { position: relative; height: 688rpx; box-sizing: border-box; overflow: hidden; padding: 32rpx; border-radius: 28rpx; background: #ffffff; }
.radar-hero__head { display: flex; align-items: center; justify-content: space-between; }
.radar-hero__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 42rpx; }
.radar-hero__period { color: #a80f1b; font-size: 28rpx; font-weight: 700; line-height: 36rpx; }
.radar-hero__plot { display: flex; justify-content: center; margin-top: 20rpx; }
.radar-hero__canvas { display: block; width: 528rpx; height: 528rpx; }
.radar-roster { margin-top: 32rpx; }
.radar-roster__head { display: flex; align-items: center; justify-content: space-between; }
.radar-roster__title { color: #202124; font-size: 32rpx; font-weight: 700; line-height: 42rpx; }
.radar-roster__hint { color: #667085; font-size: 24rpx; line-height: 34rpx; }
.radar-roster__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 16rpx; row-gap: 24rpx; margin-top: 24rpx; }
.radar-player { display: flex; min-width: 0; flex-direction: column; align-items: center; }
.radar-player__avatar { display: flex; width: 84rpx; height: 84rpx; box-sizing: border-box; align-items: center; justify-content: center; border-radius: 50%; background: #3971ba; color: #ffffff; font-size: 30rpx; font-weight: 700; line-height: 1; }
.radar-player--active .radar-player__avatar { background: #a80f1b; }
.radar-player__name { width: 100%; margin-top: 8rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; color: #202124; font-size: 24rpx; line-height: 32rpx; }
.radar-player--active .radar-player__name { color: #a80f1b; font-weight: 600; }
.profile-identity { display: flex; align-items: center; gap: 24rpx; margin: 12rpx 0 28rpx; }
.profile-avatar { display: flex; flex: 0 0 112rpx; height: 112rpx; align-items: center; justify-content: center; border-radius: 30rpx; background: #a80f1b; color: #fff; font-size: 48rpx; font-weight: 700; }
.profile-name { margin-bottom: 8rpx; font-size: 40rpx; font-weight: 700; color: #202124; word-break: break-all; }
.profile-card { padding: 28rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: #fff; }
.profile-heading { font-size: 32rpx; font-weight: 700; color: #202124; }
.profile-subheading { font-size: 28rpx; font-weight: 600; margin: 28rpx 0 12rpx; }
.profile-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28rpx 20rpx; margin: 28rpx 0; }
.profile-label,.profile-hint { font-size: 24rpx; color: #667085; line-height: 1.6; }
.profile-hint { margin-top: 8rpx; }
.profile-value { margin-top: 8rpx; color: #202124; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.profile-record { padding: 20rpx 0; border-top: 1rpx solid #f0f1f3; margin-top: 12rpx; font-size: 28rpx; }
.profile-record__title { font-weight: 600; }
.profile-link { margin: 12rpx 0 0; padding: 0; width: auto; min-width: 0; background: transparent; color: #a80f1b; font-size: 24rpx; text-align: left; }
.profile-link::after { border: 0; }
.profile-history { padding: 20rpx; background: #f8f6f4; border-radius: 12rpx; font-size: 24rpx; }
.radar-player__name { white-space: normal; overflow: visible; }
.radar-hero__head { gap: 16rpx; align-items: flex-start; }
.radar-hero__period { font-size: 24rpx; }

/* C11 approved light club identity and summary cards; detail views reuse the same route. */
.radar-page { background:var(--club-page);color:var(--club-text); }
.radar-nav { background:var(--club-nav); }
.radar-nav__title { margin-left:8rpx;font-size:32rpx;font-weight:500;color:var(--club-text); }
.radar-nav__placeholder { display:none; }
.radar-page__body { padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.profile-identity { display:flex;flex-direction:column;align-items:stretch;gap:24rpx;margin:0 0 32rpx;padding:40rpx;background:var(--color-brand);border-radius:32rpx;color:#fff; }
.profile-identity__caption { font-size:24rpx;line-height:36rpx; }
.profile-name { margin:0;color:#fff;font-size:48rpx;line-height:68rpx; }
.profile-card { padding:32rpx;margin:0 0 32rpx;border:1rpx solid var(--club-line);border-radius:28rpx;box-shadow:var(--club-shadow); }
.profile-heading { color:var(--club-text);font-weight:500;line-height:48rpx; }
.profile-summary { display:flex;flex-direction:column;gap:12rpx; }
.profile-summary__text { font-size:30rpx;line-height:48rpx;color:var(--color-text-secondary); }
.profile-summary__link { color:var(--color-brand);font-size:26rpx;line-height:40rpx; }
.profile-course { min-height:320rpx;box-sizing:border-box;display:flex;flex-direction:column;gap:16rpx; }
.profile-link { min-height:48rpx;line-height:40rpx;text-align:left;justify-content:flex-start;font-size:26rpx; }
.profile-course .profile-link { margin:0;align-self:flex-start; }
.profile-hint + .profile-course { margin-top:32rpx; }
.radar-player__avatar { background:var(--color-brand-soft);color:var(--color-brand); }
.radar-player--active .radar-player__avatar { background:var(--color-brand);color:#fff; }

.profile-card .profile-link { display:block;width:100%;text-align:left;padding:0;white-space:normal; }
