.lesson-history-page {
  min-height: 100vh;
  background: var(--color-page);
}

.lesson-history-page__body {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  min-height: calc(100vh - 176rpx);
  padding: 44rpx 44rpx 0;
  padding-bottom: calc(324rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.history-card__header,
.history-row {
  display: flex;
  align-items: center;
}

.history-hero {
  padding: 40rpx;
  border-radius: 32rpx;
  background:var(--color-card);
  color:var(--color-text);
}

.history-hero__title {
  font-size: var(--font-size-section);
  font-weight: 700;
  line-height: 1.5;
}

.history-hero__meta {
  margin-top: 8rpx;
  color:var(--color-text-secondary);
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

.history-hero__meta--muted {
  margin-top: 24rpx;
  color:var(--color-text-secondary);
}

.history-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-card);
}

.history-card__header {
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.history-card__title {
  color: var(--color-text);
  font-size: var(--font-size-section);
  font-weight: 700;
}

.history-card__summary {
  color: var(--color-text-secondary);
  font-size: var(--font-size-aux);
}

.history-row {
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.history-row:last-child {
  border-bottom: 0;
}

.history-row__avatar {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: var(--color-text);
  font-size: var(--font-size-aux);
  font-weight: 700;
}

.history-row__main {
  min-width: 0;
  flex: 1;
}

.history-row__title {
  overflow: hidden;
  color: var(--color-text);
  font-size: var(--font-size-section);
  font-weight: 400;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-row__status {
  flex: 0 0 auto;




  font-size: var(--font-size-aux);
  font-weight: 600;
