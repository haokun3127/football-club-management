.history-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 8rpx;
}

.history-actions__primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  border-radius: 24rpx;
  background: var(--color-brand);
  color: #ffffff;
  font-size: var(--font-size-body);
  font-weight: 600;
}

.history-actions__filter {
  color: var(--color-brand);
  font-size: var(--font-size-body);
  line-height: 1.5;
  text-align: center;
  text-decoration: underline;
}

.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: var(--color-card);
  text-align: center;
}

.history-empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ecfdf3;
  color: #188754;
  font-size: 44rpx;
  font-weight: 700;
}

.history-empty__title {
  margin-top: 24rpx;
  color: var(--color-text);
  font-size: var(--font-size-section);
  font-weight: 700;
}

.history-empty__message {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-size-aux);
  line-height: 1.5;
}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.history-actions__primary,
.history-row { min-height:44px; min-width:44px; box-sizing:border-box; }
