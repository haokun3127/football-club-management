.training-assessment-page { min-height: 100vh; background: #f6f7f9; }
.assessment-nav { position: sticky; top: 0; z-index: 100; height:44px; box-sizing: content-box; display: flex; align-items: center; justify-content: space-between; padding-left: 32rpx; background: #ffffff; }
.assessment-nav__left { display: flex; align-items: center; min-width: 0; color: #202124; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.assessment-nav__left image { width: 48rpx; height: 48rpx; margin-right: 2rpx; }
.assessment-nav__save { color: #a80f1b; font-size: var(--font-size-body); font-weight: 600; line-height: 1.5; }
.assessment-body { padding: 32rpx 32rpx 64rpx; }
.assessment-hero { display: flex; flex-direction: column; gap: 8rpx; padding: 32rpx; border-radius: 24rpx; background:var(--color-card); }
.assessment-hero__top { display: flex; justify-content: space-between; gap: 16rpx; color:var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; }
.assessment-hero__top text:last-child { flex: 0 0 auto; }
.assessment-hero__time { color:var(--color-text); font-size:32px; font-weight: 700; line-height: 80rpx; letter-spacing: -2rpx; }
.assessment-hero__title { color:var(--color-text); font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.assessment-hero__meta { color:var(--color-text-secondary); font-size: var(--font-size-aux); line-height: 1.5; }
.assessment-hero__count { align-self: flex-start; margin-top: 2rpx; padding: 6rpx 16rpx; border: 1rpx solid rgba(255,255,255,0.16); border-radius: 22rpx; background:transparent; color:var(--color-text); font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; }
.assessment-projects { display: flex; gap: 16rpx; overflow-x: scroll; padding: 28rpx 0; white-space: nowrap; }
.assessment-project { flex: 0 0 auto; padding: 16rpx 24rpx; border: 1rpx solid #d9dee8; border-radius: 32rpx; background: #ffffff; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.assessment-project--active { border-color: #a80f1b; background: #a80f1b; color: #ffffff; font-weight: 600; }
.assessment-panel { overflow: hidden; border-radius: 24rpx; background: #ffffff; box-shadow:none; }
.assessment-panel__head { display: flex; justify-content: space-between; padding: 28rpx 24rpx; background: #fff4f5; color: #6b1b23; font-size: var(--font-size-aux); font-weight: 600; line-height: 1.5; }
.assessment-row { display: grid; grid-template-areas: "student score" "note note"; grid-template-columns: minmax(0, 1fr) 126rpx; column-gap: 16rpx; row-gap: 14rpx; align-items: center; padding: 24rpx; border-top: 1rpx solid #eef0f3; }
.assessment-row__student { grid-area: student; display: flex; min-width: 0; align-items: center; gap: 14rpx; color: #202124; font-size: var(--font-size-body); font-weight: 600; line-height: 1.5; }
.assessment-row__avatar { width: 52rpx; height: 52rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f1f2f4; color: #667085; font-size: var(--font-size-aux); }
.assessment-row__score, .assessment-row__note { min-width: 0; height: 64rpx; box-sizing: border-box; padding: 0 16rpx; border: 1rpx solid #dde2ea; border-radius: 12rpx; background: #ffffff; color: #202124; font-size: var(--font-size-aux); line-height: 1.5; }
.assessment-row__score { grid-area: score; background: #fff4f5; border-color: #ffe0e3; color: #a80f1b; font-weight: 700; text-align: center; }
.assessment-row__note { grid-area: note; }
.assessment-save { margin-top: 32rpx; border-radius: 16rpx; padding: 28rpx; background: #a80f1b; color: #ffffff; text-align: center; font-size: var(--font-size-body); font-weight: 700; line-height: 1.5; }
.assessment-save--disabled { background: #c9a4a8; }

/* 移动端触控下限，业务内容与原事件保持一致。 */
.assessment-nav__left,
.assessment-nav__save,
.assessment-save { min-height:44px; min-width:44px; box-sizing:border-box; }
