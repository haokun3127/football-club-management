.copy-page { min-height:100vh; background:var(--club-page); color:var(--club-muted); }
.copy-nav { position:sticky; top:0; z-index:10; display:flex; align-items:center; height:88rpx; background:var(--club-nav); color:var(--club-text); font-size:32rpx; gap:8rpx; padding-left:20rpx; }
.copy-page .back { padding:0; margin:0; min-width:56rpx; width:56rpx; height:72rpx; line-height:68rpx; color:var(--club-text); background:transparent; font-size:48rpx; }
.copy-body { padding:32rpx 32rpx calc(190rpx + env(safe-area-inset-bottom)); display:flex; flex-direction:column; gap:16rpx; }
.copy-card { padding:22rpx; display:flex; flex-direction:column; gap:10rpx; border:1rpx solid var(--club-line); border-radius:28rpx; background:#fff; box-shadow:var(--club-shadow); font-size:22rpx; line-height:1.5; overflow-wrap:anywhere; }
.card-title { font-size:28rpx; font-weight:700; color:var(--club-muted); }
.brand { color:var(--color-brand); }
.success { color:#188754; }
.mode-title { font-size:24rpx; font-weight:700; }
.mode-switch { display:flex; gap:8rpx; padding:8rpx; border:1rpx solid var(--club-line); border-radius:20rpx; background:#fff; }
.copy-page .mode-switch button { flex:1; margin:0; padding:14rpx; min-width:0; width:auto; border-radius:14rpx; background:#fff; color:var(--club-muted); font-size:22rpx; line-height:1.5; text-align:left; }
.copy-page .mode-switch .selected { background:var(--color-brand); color:#fff; }
.copy-page .target-picker { display:flex; justify-content:space-between; gap:20rpx; margin:0; width:100%; min-width:0; padding:20rpx; border:1rpx solid var(--club-line); border-radius:20rpx; background:#fff; color:var(--club-muted); font-size:24rpx; line-height:1.5; }
.target-summary + .target-summary { margin-top:8rpx; padding-top:10rpx; border-top:1rpx solid var(--club-line); }
.copy-page .target-row { display:flex; align-items:flex-start; gap:24rpx; width:100%; min-width:0; margin:0; padding:24rpx; border:1rpx solid var(--club-line); border-radius:24rpx; background:#fff; color:var(--club-muted); font-size:22rpx; font-weight:400; line-height:1.6; text-align:left; }
.target-row__body { flex:1; min-width:0; overflow-wrap:anywhere; }
.copy-page .target-row--selected { border-color:#b9dec4; background:#eef8f1; }
.notice { font-size:24rpx; line-height:1.6; }
.notice--error { color:var(--color-brand); }
.copy-footer { position:fixed; bottom:0; left:0; right:0; z-index:10; padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background:var(--club-nav); }
.copy-page .primary { width:100%; min-width:0; margin:0; height:96rpx; line-height:96rpx; padding:0 20rpx; border-radius:16rpx; background:var(--color-brand); color:#fff; font-size:32rpx; font-weight:500; }
.copy-page .primary[disabled] { background:#e9ddd9; color:#80736d; }
.copy-page button::after { border:0; }

.selection-title { color:var(--club-text); font-size:34rpx; font-weight:700; }
.selection-hint { font-size:22rpx; line-height:1.5; }
.selection-summary { padding:16rpx 24rpx; border-radius:20rpx; background:#eef5ff; font-size:20rpx; line-height:1.6; }
.selection-summary .brand { font-size:24rpx; margin-bottom:8rpx; }
.target-check { flex-shrink:0; width:42rpx; height:42rpx; margin-top:2rpx; border:1rpx solid var(--club-line); border-radius:50%; background:#fff; text-align:center; line-height:42rpx; color:#fff; }
.target-check--selected { background:var(--color-brand); border-color:var(--color-brand); }
.target-title { font-size:26rpx; font-weight:700; color:var(--club-text); }
.target-date { margin-top:12rpx; color:#4f4947; }
.target-metrics { margin-top:12rpx; font-size:20rpx; }
.target-status { margin-top:12rpx; text-align:right; font-size:20rpx; }
.selection-warning { padding:20rpx 24rpx; border:1rpx solid var(--club-warning-line); border-radius:20rpx; background:var(--club-warning-soft); font-size:22rpx; line-height:1.6; color:#4f4947; }
.selection-warning .brand { margin-top:8rpx; font-size:20rpx; }
.selection-actions { display:flex; gap:16rpx; }
.copy-page .selection-actions .primary { flex:1; min-width:0; width:auto; font-size:28rpx; }
.copy-page .secondary { width:208rpx; min-width:0; margin:0; padding:0; height:96rpx; line-height:96rpx; border:1rpx solid var(--club-line); border-radius:20rpx; background:#fff; color:#4f4947; font-size:28rpx; font-weight:500; }
.selection-empty { margin-top:144rpx; padding:44rpx 24rpx; border:1rpx solid var(--club-line); border-radius:32rpx; background:#fff; display:flex; flex-direction:column; align-items:center; gap:12rpx; font-size:20rpx; text-align:center; }
.selection-empty .selection-title { font-size:32rpx; }
.empty-mark { width:104rpx; height:104rpx; margin-bottom:8rpx; line-height:104rpx; border:1rpx solid var(--club-warning-line); border-radius:50%; background:var(--club-warning-soft); color:var(--color-brand); font-size:40rpx; }
