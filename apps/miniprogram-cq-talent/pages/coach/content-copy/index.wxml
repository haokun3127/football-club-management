<view class="copy-page">
  <view class="copy-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px"><button class="back" bindtap="goBack" disabled="{{saving}}">‹</button><text>{{view === 'targets' ? '选择目标课程' : '复制课程内容'}}</text></view>
  <view class="copy-body">
    <view wx:if="{{loading}}" class="notice">正在读取课程内容…</view>
    <view wx:if="{{loadError}}" class="notice notice--error">{{loadError}}</view>
    <block wx:if="{{source && view === 'summary'}}">
      <view class="copy-card"><view class="card-title">来源课程</view><view>{{source.title}}</view><view>可复制：{{source.count}} 项 · {{source.configuredMinutes}} 分钟</view><view wx:for="{{source.excluded}}" wx:key="index">已排除：{{item}}</view></view>
      <view class="copy-card"><view class="card-title">目标课程{{selectedCount ? ' · ' + selectedCount + ' 堂' : ''}}</view><view wx:if="{{!selectedCount}}">请选择需要复制的未来课程</view><view wx:for="{{selectedTargets}}" wx:key="eventId" class="target-summary"><view>{{item.dateLabel}} · {{item.title}}</view><view>已有：{{item.existing.length}} 项 · {{item.existingMinutes}} 分钟</view><view class="brand">{{item.existing.length ? '目标内容非空' : '目标尚无内容'}}</view></view></view>
      <view class="mode-title">处理已有内容</view>
      <view class="mode-switch"><button class="{{mode === 'merge' ? 'selected' : ''}}" data-mode="merge" bindtap="selectMode" disabled="{{saving || needsRefresh}}">合并并去重</button><button class="{{mode === 'replace' ? 'selected' : ''}}" data-mode="replace" bindtap="selectMode" disabled="{{saving || needsRefresh}}">替换训练内容</button></view>
      <view class="copy-card"><view class="card-title">复制后预览</view><view wx:if="{{!selectedCount}}">选择目标课程后显示结果</view><view wx:for="{{previewRows}}" wx:key="eventId" class="target-summary"><view>{{item.title}}</view><view>{{mode === 'merge' ? '合并' : '替换'}}：{{item.count}} 项 · {{item.minutes}} 分钟</view><view>{{item.names}}</view></view><view>{{mode === 'merge' ? '相同内容保留目标课的时长和备注' : '目标课训练内容将被来源内容替换'}}</view><view>已有测评结果不被覆盖</view></view>
      <button class="target-picker" bindtap="openTargets" disabled="{{saving || needsRefresh}}"><text>目标课程</text><text class="brand">{{selectedCount ? '已选 ' + selectedCount + ' 堂 · 更改 ›' : '请选择 ›'}}</text></button>
    </block>
    <block wx:if="{{view === 'targets'}}">
      <block wx:if="{{targets.length}}">
        <view class="selection-title">选择已有未来课程</view><view class="selection-hint">支持多选，最多20堂；取消将恢复原选择</view>
        <view class="selection-summary"><view class="brand">已选 {{pendingCount}} / 20堂</view><view>仅应用本次选择</view></view>
        <button wx:for="{{targets}}" wx:key="eventId" class="target-row {{item.selected ? 'target-row--selected' : ''}}" data-id="{{item.eventId}}" bindtap="toggleTarget"><view class="target-check {{item.selected ? 'target-check--selected' : ''}}">{{item.selected ? '✓' : ''}}</view><view class="target-row__body"><view class="target-title">{{item.title}}</view><view class="target-date">日期：{{item.dateLabel}}</view><view class="target-metrics">已有项目：{{item.existing.length}}项 · 配置时长：{{item.existingMinutes}}分钟</view><view class="target-status {{item.selected ? 'brand' : ''}}">{{item.selected ? '已选择' : '可选择'}}</view></view></button>
        <view class="selection-warning"><view>仅展示已有未来课程</view><view class="brand">达到20堂后不可继续选择</view></view>
      </block>
      <view wx:else class="selection-empty"><view class="empty-mark">—</view><view class="selection-title">暂无可用未来课程</view><view class="selection-hint">请先在排课中安排未来课程</view><view class="brand">最多可选择20堂</view></view>
    </block>
    <view wx:if="{{message}}" class="notice">{{message}}</view><view wx:for="{{results}}" wx:key="eventId" class="copy-card"><view class="card-title">{{item.title}}</view><view class="{{item.applied ? 'success' : 'brand'}}">{{item.label}}</view></view>
  </view>
  <view class="copy-footer">
    <block wx:if="{{view === 'targets'}}"><view wx:if="{{targets.length}}" class="selection-actions"><button class="secondary" bindtap="goBack">取消</button><button class="primary" bindtap="applyTargets">应用选择（{{pendingCount}}）</button></view><button wx:else class="primary" bindtap="goBack">返回复制设置</button></block>
    <button wx:elif="{{needsRefresh}}" class="primary" bindtap="load" disabled="{{saving}}">重新预览并核对</button><button wx:else class="primary" bindtap="submit" disabled="{{!canSubmit || saving}}" loading="{{saving}}">{{saving ? '正在复制…' : '核对后复制'}}</button>
  </view>
</view>
