<view class="c15-page">
  <view class="c15-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c15-nav__left" bindtap="goBack">
      <image class="c15-nav__back" src="/assets/icons/c12-arrow-left.svg" mode="aspectFit" />
      <text class="c15-nav__title">能力评估录入</text>
    </view>
    <text class="c15-nav__action" bindtap="saveDraft">保存草稿</text>
  </view>

  <view class="c15-body">
    <status-view
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
      action-text="{{statusActionText}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <scroll-view scroll-x class="c15-groups" enhanced show-scrollbar="{{false}}">
        <view class="c15-groups__row">
          <view wx:for="{{groups}}" wx:key="id" class="{{item.className}}" data-id="{{item.id}}" bindtap="selectGroup">{{item.label}}</view>
        </view>
      </scroll-view>

        <view wx:for="{{students}}" wx:for-item="student" wx:key="id" class="c15-student-card">
          <view class="c15-student-card__head">
            <view class="c15-student-card__avatar">{{student.initial}}</view>
            <view class="c15-student-card__identity">
              <text class="c15-student-card__name">{{student.name}}</text>
              <text wx:if="{{student.teamLabel}}" class="c15-student-card__team">{{student.teamLabel}}</text>
            </view>
            <text class="c15-student-card__average">{{student.averageLabel}}</text>
          </view>
          <view class="c15-rows">
            <view wx:for="{{student.rows}}" wx:for-item="row" wx:key="fieldId" class="c15-row">
              <text class="c15-row__label">{{row.label}}</text>
              <view class="c15-row__track">
                <view class="c15-row__track-line"><view class="c15-row__progress" style="width: {{row.progressPercent}}%;"></view></view>
                <slider
                  class="c15-row__slider-input"
                  min="{{row.sliderMin}}"
                  max="{{row.sliderMax}}"
                  step="{{row.sliderStep}}"
                  value="{{row.sliderValue}}"
                  activeColor="#a80f1b"
                  backgroundColor="#e7eaf0"
                  block-size="12"
                  data-student-id="{{student.id}}"
                  data-field-id="{{row.fieldId}}"
                  bindchange="onSliderChange"
                />
              </view>
              <text class="c15-row__value">{{row.valueLabel}}</text>
          </view>
        </view>
      </view>

      <text wx:if="{{lastSavedLabel}}" class="c15-draft-label">{{lastSavedLabel}}</text>
      <view class="c15-submit-wrap">
        <view class="{{submitting ? 'c15-submit c15-submit--disabled' : 'c15-submit'}}" bindtap="submit">{{submitting ? '正在保存' : '保存所有'}}</view>
      </view>
    </block>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
