<view class="entry-page">
  <app-header title="能力评估录入" action-text="保存草稿" bindaction="saveDraft" show-back />
  <view class="entry-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载测评表单' : state === 'empty' ? '无法录入' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <!-- 维度 tabs（Figma C15: 技术/体能/战术，选中=品牌红 r20） -->
      <scroll-view scroll-x class="group-strip" enhanced show-scrollbar="{{false}}">
        <view class="group-strip__inner">
          <view
            wx:for="{{groups}}"
            wx:key="*this"
            class="group-chip {{activeGroup === item ? 'group-chip--active' : ''}}"
            data-name="{{item}}"
            bindtap="selectGroup"
          >{{item}}</view>
        </view>
      </scroll-view>

      <!-- 学员卡片：头像 + 均分 + 滑杆组 -->
      <view wx:for="{{students}}" wx:key="id" class="student-card">
        <view class="student-card__head">
          <view class="student-card__avatar">{{item.initial}}</view>
          <view class="student-card__name">{{item.name}}</view>
          <view class="student-card__average">{{item.average}}</view>
        </view>
        <view class="slider-list">
          <block wx:for="{{fields}}" wx:for-item="field" wx:key="id">
            <view wx:if="{{(field.groupLabel || '评估项') === activeGroup}}" class="slider-row">
              <view class="slider-row__label">{{field.label}}</view>
              <slider
                class="slider-row__slider"
                min="{{field.sliderMin}}"
                max="{{field.sliderMax}}"
                step="{{field.sliderStep}}"
                value="{{item.values[field.id] || field.sliderMin}}"
                activeColor="#a80f1b"
                backgroundColor="#e7eaf0"
                block-size="20"
                data-student-id="{{item.id}}"
                data-field-id="{{field.id}}"
                bindchange="onSliderChange"
              />
              <view class="slider-row__value">{{item.values[field.id] !== undefined ? item.values[field.id] : '-'}}</view>
            </view>
          </block>
        </view>
      </view>

      <view class="submit-button {{submitting ? 'submit-button--disabled' : ''}}" bindtap="submit">{{submitting ? '提交中…' : '提交评估'}}</view>
    </block>
  </view>
  <role-tabbar role="coach" active="me" />
</view>
