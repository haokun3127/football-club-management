<view class="c15-page">
  <view class="c15-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c15-nav__left" bindtap="goBack">
      <image class="c15-nav__back" src="/assets/icons/chevron-left.svg" mode="aspectFit" />
      <text class="c15-nav__title">能力评估录入</text>
    </view>
    <text class="c15-nav__action" bindtap="saveDraft">保存草稿</text>
  </view>

  <view class="c15-body">
    <status-view
      state="{{state}}"
      title="{{statusTitle}}"
      message="{{message}}"
      action-text="{{statusActionText}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="c15-context">
        <view class="c15-context__label">当前训练球队</view>
        <view class="c15-context__main">
          <text class="c15-context__team">{{teamName || '训练球队待同步'}}</text>
          <text class="c15-context__hint">由训练管理选择</text>
        </view>
      </view>

      <view class="c15-metric-panel">
        <view class="c15-metric-panel__head">
          <text class="c15-metric-panel__title">当前球员指标</text>
          <text class="c15-metric-panel__hint">最新评测</text>
        </view>
        <view class="c15-metric-panel__student">
          <text class="c15-metric-panel__name">{{activeStudentName}}</text>
          <text class="c15-metric-panel__hint">录入本次原始值与标准分</text>
          <text class="c15-metric-panel__score-header">标准分</text>
        </view>

        <view wx:for="{{cards}}" wx:for-item="card" wx:key="fieldId" class="c15-metric-card">
          <text class="c15-metric-card__label">{{card.label}}</text>
          <view class="c15-metric-card__raw">
            <input
              class="c15-metric-card__input"
              type="digit"
              value="{{card.rawInputValue}}"
              min="{{card.inputMin}}"
              max="{{card.inputMax}}"
              placeholder="{{card.placeholder}}"
              data-field-id="{{card.fieldId}}"
              bindinput="onRawInput"
            />
            <text class="c15-metric-card__unit">{{card.unitLabel}}</text>
          </view>
          <text class="c15-metric-card__score">{{card.scoreLabel}}</text>
        </view>
      </view>

      <view class="c15-roster">
        <view class="c15-roster__head">
          <text class="c15-roster__title">全部球员</text>
          <text class="c15-roster__hint">{{students.length}} 名 · 点击头像切换评估</text>
        </view>
        <view class="c15-roster__grid">
          <view
            wx:for="{{students}}"
            wx:key="id"
            class="c15-player {{item.isActive ? 'c15-player--active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectStudent"
          >
            <view class="c15-player__avatar">{{item.initial}}</view>
            <text class="c15-player__name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <text wx:if="{{lastSavedLabel}}" class="c15-draft-label">{{lastSavedLabel}}</text>
      <view class="c15-submit-wrap">
        <view class="{{submitting ? 'c15-submit c15-submit--disabled' : 'c15-submit'}}" bindtap="submit">{{submitting ? '正在保存' : '保存所有'}}</view>
      </view>
    </block>
  </view>

  <role-tabbar role="coach" active="training" />
</view>
