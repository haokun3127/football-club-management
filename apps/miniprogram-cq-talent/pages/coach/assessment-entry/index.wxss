.c15-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #f6f7f9;
  color: #202124;
}

.c15-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  box-sizing: content-box;
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: #fceeef;
}

.c15-nav__left {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 0;
}

.c15-nav__back {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
}

.c15-nav__title {
  min-width: 0;
  overflow: hidden;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-nav__action {
  flex: 0 0 auto;
  color: #667085;
  font-size: 28rpx;
}

.c15-body {
  box-sizing: border-box;
  padding: 32rpx 32rpx 180rpx;
}

.c15-context {
  box-sizing: border-box;
  min-height: 108rpx;
  padding: 18rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.c15-context__label,
.c15-context__hint,
.c15-metric-panel__hint,
.c15-roster__hint {
  color: #667085;
  font-size: 22rpx;
  line-height: 30rpx;
}

.c15-context__main,
.c15-metric-panel__head,
.c15-metric-panel__student,
.c15-roster__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c15-context__main {
  margin-top: 2rpx;
}

.c15-context__team {
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-context__hint {
  margin-left: 16rpx;
  flex: 0 0 auto;
  color: #a80f1b;
}

.c15-metric-panel {
  box-sizing: border-box;
  margin-top: 32rpx;
  min-height: 620rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #07111f;
}

.c15-metric-panel__title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.c15-metric-panel__student {
  margin-top: 12rpx;
  justify-content: flex-start;
}

.c15-metric-panel__name {
  flex: 0 0 auto;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.c15-metric-panel__student .c15-metric-panel__hint {
  margin-left: auto;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.68);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-metric-panel__score-header {
  width: 64rpx;
  margin-left: 12rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
  white-space: nowrap;
}

.c15-metric-card {
  display: flex;
  min-height: 116rpx;
  box-sizing: border-box;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.c15-metric-card__label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #202124;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-metric-card__raw {
  display: flex;
  width: 104rpx;
  flex: 0 0 104rpx;
  align-items: center;
}

.c15-metric-card__input {
  width: 70rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: right;
}

.c15-metric-card__unit {
  margin-left: 8rpx;
  color: #202124;
  font-size: 26rpx;
  font-weight: 700;
}

.c15-metric-card__score {
  width: 76rpx;
  margin-left: 8rpx;
  flex: 0 0 76rpx;
  overflow: hidden;
  color: #202124;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-roster {
  margin-top: 32rpx;
}

.c15-roster__title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.c15-roster__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 16rpx;
  row-gap: 20rpx;
  margin-top: 24rpx;
}

.c15-player {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.c15-player__avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e7eaf0;
  border-radius: 50%;
  background: #ffffff;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.c15-player__name {
  width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  color: #667085;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-player--active .c15-player__avatar {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
}

.c15-player--active .c15-player__name {
  color: #a80f1b;
  font-weight: 700;
}

.c15-draft-label {
  display: block;
  margin-top: 16rpx;
  color: #667085;
  font-size: 22rpx;
  text-align: center;
}

.c15-submit-wrap {
  position: static;
  margin-top: 32rpx;
}

.c15-submit {
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.c15-submit--disabled {
  opacity: 0.56;
}
