.c15-page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #202124;
}

.c15-nav {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 44rpx;
  background: #fceeef;
}

.c15-nav__left {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 0;
}

.c15-nav__back {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
}

.c15-nav__title {
  overflow: hidden;
  font-size: 44rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-nav__action {
  flex: 0 0 auto;
  color: #667085;
  font-size: 28rpx;
}

.c15-body {
  box-sizing: border-box;
  padding: 32rpx 44rpx 48rpx;
}

.c15-groups {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.c15-groups__row {
  display: flex;
  gap: 16rpx;
}

.c15-group {
  box-sizing: border-box;
  padding: 16rpx 28rpx;
  border: 2rpx solid #e7eaf0;
  border-radius: 40rpx;
  background: #ffffff;
  color: #667085;
  font-size: 26rpx;
}

.c15-group--active {
  border-color: #a80f1b;
  background: #a80f1b;
  color: #ffffff;
  font-weight: 600;
}

.c15-student-card {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.c15-student-card__head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.c15-student-card__avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #a80f1b;
  border-radius: 50%;
  background: #fceeef;
  color: #a80f1b;
  font-size: 28rpx;
  font-weight: 700;
}

.c15-student-card__name {
  min-width: 0;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-student-card__identity {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.c15-student-card__team {
  overflow: hidden;
  color: #667085;
  font-size: 24rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-student-card__average {
  color: #a80f1b;
  font-size: 32rpx;
  font-weight: 700;
}

.c15-rows {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.c15-row {
  position: relative;
  display: flex;
  min-height: 30rpx;
  align-items: center;
  justify-content: space-between;
}

.c15-row__label {
  width: 80rpx;
  overflow: hidden;
  color: #667085;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c15-row__track {
  position: relative;
  flex: 0 0 320rpx;
  width: 320rpx;
  height: 12rpx;
}

.c15-row__track-line {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7eaf0;
}

.c15-row__progress {
  height: 100%;
  border-radius: inherit;
  background: #a80f1b;
}

.c15-row__slider-input {
  position: absolute;
  top: -24rpx;
  left: -12rpx;
  width: 344rpx;
  height: 60rpx;
  margin: 0;
  opacity: 0;
}

.c15-row__value {
  width: 64rpx;
  color: #a80f1b;
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.c15-draft-label {
  display: block;
  margin-top: 16rpx;
  color: #667085;
  font-size: 22rpx;
  text-align: center;
}

.c15-submit-wrap {
  position: static;
  margin-top: 32rpx;
}

.c15-submit {
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.c15-submit--disabled {
  opacity: 0.56;
}
