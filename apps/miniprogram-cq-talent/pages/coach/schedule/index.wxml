<view class="c1">
  <view class="c1-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c1-nav__title">{{clubName}}</view>
    <view wx:if="{{hasCoachInitial}}" class="c1-nav__avatar" bindtap="openMe">{{coachInitial}}</view>
  </view>
  <view class="c1-top-spacer" style="height:{{topBarHeight}}px"></view>

  <!-- V-03 C01 214:2144：授权队伍卡（更改展开选队，保留授权范围与选队状态） -->
  <view wx:if="{{hasTeamOptions}}" class="c1-team-card">
    <view class="c1-team-card__info">
      <view class="c1-team-card__title">日程范围 · {{selectedTeamIds.length}}队</view>
      <view class="c1-team-card__sub">仅显示所选球队的活动和待办</view>
    </view>
    <view class="c1-team-card__toggle" role="button" aria-label="更改授权队伍" catchtap="toggleTeamPicker">更改 ›</view>
  </view>
  <scroll-view wx:if="{{hasTeamOptions && showTeamPicker}}" scroll-x class="c1-team-strip">
    <view class="c1-team-row"><t-button class="c1-team {{allTeamsSelected ? 'c1-team--selected' : ''}}" data-id="all" bindtap="selectTeam" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="c1-team {{allTeamsSelected ? 'c1-team--selected' : ''}}" theme="primary" variant="text">全部</t-button>
    <t-button wx:for="{{teamOptions}}" wx:key="id" class="c1-team {{item.selected ? 'c1-team--selected' : ''}}" data-id="{{item.id}}" bindtap="selectTeam" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="c1-team {{item.selected ? 'c1-team--selected' : ''}}" theme="primary" variant="text"><image src="/assets/icons/content-users.svg" mode="aspectFit" />{{item.name}}</t-button></view>
  </scroll-view>

  <view class="schedule-calendar-wrap"><schedule-calendar class="schedule-calendar-widget" date="{{date}}" events="{{eventViews}}" expanded="{{viewMode === 'month'}}" top-inset="{{topBarHeight}}" bindchange="onCalendarChange" bindviewchange="onCalendarViewChange" /></view>

  <view class="c1-body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载日程' : state === 'empty' ? '暂无日程或任务' : '日程读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view class="agenda-heading">{{heroDateLabel}}</view>
      <view class="agenda-summary"><text wx:for="{{heroPills}}" wx:key="label">{{item.label}} {{item.value}}　</text></view>
      <view wx:if="{{hasVisibleEvents}}" class="c1-list">
        <view wx:for="{{visibleEvents}}" wx:key="id" class="acard acard--{{item.cardTone}}" data-id="{{item.id}}" bindtap="openEvent">
          <view class="acard__accent" style="background:{{item.typeColor}}"></view>
          <view class="acard__time"><view class="acard__start">{{item.startTime}}</view><view wx:if="{{item.durationText}}" class="acard__dur">{{item.durationText}}</view></view>
          <view class="acard__content">
            <view class="acard__head"><view class="acard__type acard__type--{{item.typeTone}}">{{item.typeLabel}}</view><view class="acard__title">{{item.title}}</view></view>
            <view wx:if="{{item.hasLocationDetail}}" class="acard__meta">{{item.locationLabel}}</view>
            <view wx:if="{{item.hasNextAction}}" class="acard__action" data-id="{{item.id}}" data-action="{{item.nextAction}}" catchtap="openTask">{{item.nextActionLabel}}</view>
          </view>
          <view class="acard__right"><view class="acard__pill pill--{{item.statusTone}}">{{item.statusLabel}}</view><image class="acard__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
        </view>
      </view>
      <view wx:if="{{!hasVisibleEvents}}" class="c1-empty">当前筛选下没有日程</view>
    </block>
  </view>

  <!-- 任务卡 -->
  <view id="coach-tasks" class="c1-tasks" wx:if="{{state !== 'loading' && state !== 'error'}}">
    <view class="c1-tasks__head"><view class="c1-tasks__heading">待完成任务</view><t-button class="c1-tasks__more" bindtap="showTasks" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="c1-tasks__more" theme="primary" variant="text">未完成任务 · {{taskCount}}</t-button></view>
    <view wx:if="{{!taskCards.length}}" class="c1-empty">暂无未完成任务</view>
    <view wx:for="{{taskCards}}" wx:key="eventId" class="c1-task" data-id="{{item.taskId}}" bindtap="openAssessmentTask">
      <view class="c1-task__title">{{item.title || item.label}}</view><view class="c1-task__meta">{{item.teamName}} · {{item.periodLabel}}</view>
      <view wx:if="{{item.totalStudents !== undefined}}" class="c1-task__meta">采集完成 {{item.completedStudents}} / {{item.totalStudents}} 人 · 待同步 {{item.readyStudents || 0}} 人</view>
      <view class="c1-task__action">{{item.label}} <image src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
    </view>
  </view>

  <!-- 所选队伍入口 -->
  <t-button class="c1-team-entry" wx:if="{{state !== 'loading' && state !== 'error'}}" bindtap="openSelectedTeam" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="c1-team-entry" theme="primary" variant="text">查看所选队伍</t-button>
  <role-tabbar role="coach" active="schedule" />
</view>
