<view class="c1">
  <view class="c1-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c1-nav__title">日程</view>
    <view wx:if="{{hasCoachInitial}}" class="c1-nav__avatar" bindtap="openMe">{{coachInitial}}</view>
  </view>
  <view class="c1-top-spacer" style="height:{{topBarHeight}}px"></view>

  <block wx:if="{{viewMode === 'month'}}">
    <view class="c1-month-calendar">
      <view class="c1-month-calendar__header">
        <view class="c1-month-calendar__title">{{monthLabel}}</view>
        <view class="c1-month-calendar__actions">
          <view class="c1-month-calendar__arrow" data-offset="-1" bindtap="changeMonth" aria-label="上个月"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
          <view class="c1-month-calendar__arrow" data-offset="1" bindtap="changeMonth" aria-label="下个月"><image src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
          <view class="c1-month-calendar__collapse" bindtap="collapseMonthPicker" aria-label="收起月历"><image class="c1-month-calendar__collapse-icon" src="/assets/icons/chevron-down-brand.svg" mode="aspectFit" /></view>
        </view>
      </view>
      <view class="c1-month-calendar__weekdays">
        <view wx:for="{{monthWeekdays}}" wx:key="*this" class="c1-month-calendar__weekday">{{item}}</view>
      </view>
      <view class="c1-month-calendar__grid">
        <view wx:for="{{monthDays}}" wx:key="key" class="c1-month-day {{item.isCurrentMonth ? '' : 'c1-month-day--outside'}} {{item.isToday ? 'c1-month-day--today' : ''}} {{item.isSelected ? 'c1-month-day--selected' : ''}}" data-date="{{item.key}}" bindtap="selectDay">
          <view class="c1-month-day__number">{{item.dayNumber}}</view>
          <view class="c1-month-day__markers">
            <view wx:if="{{item.hasTraining}}" class="c1-month-day__marker c1-month-day__marker--training"></view>
            <view wx:if="{{item.hasMatch}}" class="c1-month-day__marker c1-month-day__marker--match"></view>
            <view wx:if="{{item.hasMultiple}}" class="c1-month-day__marker c1-month-day__marker--multiple"></view>
          </view>
        </view>
      </view>
      <view class="c1-month-calendar__legend">
        <view class="c1-month-calendar__legend-item"><view class="c1-month-calendar__legend-dot c1-month-calendar__legend-dot--training"></view><text>绿色=训练</text></view>
        <view class="c1-month-calendar__legend-item"><view class="c1-month-calendar__legend-dot c1-month-calendar__legend-dot--match"></view><text>蓝色=比赛</text></view>
      </view>
    </view>
  </block>
  <view wx:else class="c1-dates">
    <view class="c1-dates__arrow c1-dates__arrow--previous" data-offset="-7" bindtap="changeWeek"><image src="/assets/icons/chevron-left.svg" mode="aspectFit" /></view>
      <view class="c1-week-nav" bindtap="expandMonthPicker">
        <view wx:for="{{collapsedDayStrip}}" wx:key="date" class="c1-day {{selectedDate === item.date ? 'c1-day--selected' : ''}}" data-date="{{item.date}}" catchtap="selectDay">
          <view class="c1-day__week">{{item.weekLabel}}</view>
          <view class="c1-day__num">{{item.dayNum}}</view>
        </view>
    </view>
    <view class="c1-dates__arrow c1-dates__arrow--next" data-offset="7" bindtap="changeWeek"><image src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
  </view>

  <view wx:if="{{state !== 'loading' && state !== 'error'}}" class="c1-all-teams-context">
    <text class="c1-all-teams-context__label">全部球队课程</text>
    <text class="c1-all-teams-context__copy">按时间排列 · 每节课标明所属球队</text>
  </view>

  <view class="c1-body">
    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载日程' : state === 'empty' ? '暂无日程或任务' : '日程读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view wx:if="{{hasHeroEvent}}" class="c1-hero" data-id="{{heroEvent.id}}" bindtap="openEvent">
        <view class="c1-hero__top"><view>{{heroDateLabel}}</view><view>重庆天才</view></view>
        <view class="c1-hero__main"><view class="c1-hero__time">{{heroEvent.startTime}}</view><view class="c1-hero__title">{{heroEvent.title}}</view></view>
        <view class="c1-hero__meta">{{heroEvent.locationLabel}}</view>
        <view class="c1-hero__pills">
          <block wx:if="{{heroPills.length}}">
            <view wx:for="{{heroPills}}" wx:key="label" class="c1-hero__pill c1-hero__pill--{{item.tone}}">
              <text class="c1-hero__pill-value">{{item.value}}</text>
              <text class="c1-hero__pill-label">{{item.label}}</text>
            </view>
          </block>
          <block wx:else>
            <view class="c1-hero__pill">{{heroEvent.statusLabel}}</view>
            <view wx:if="{{heroEvent.hasDuration}}" class="c1-hero__pill">{{heroEvent.durationText}}</view>
          </block>
        </view>
      </view>

      <view wx:if="{{hasVisibleEvents}}" class="c1-list">
        <view wx:for="{{visibleEvents}}" wx:key="id" class="acard acard--{{item.cardTone}}" data-id="{{item.id}}" bindtap="openEvent">
          <view class="acard__accent" style="background:{{item.typeColor}}"></view>
          <view class="acard__time"><view class="acard__start">{{item.startTime}}</view><view wx:if="{{item.durationText}}" class="acard__dur">{{item.durationText}}</view></view>
          <view class="acard__content">
            <view class="acard__head"><view class="acard__type acard__type--{{item.typeTone}}">{{item.typeLabel}}</view><view class="acard__title">{{item.title}}</view><view wx:if="{{item.hasCoachName}}" class="acard__coach">{{item.coachName}}</view></view>
            <view wx:if="{{item.hasLocationDetail}}" class="acard__meta">{{item.locationLabel}}</view>
            <view wx:if="{{item.hasNextAction}}" class="acard__action" data-id="{{item.id}}" data-action="{{item.nextAction}}" catchtap="openTask">{{item.nextActionLabel}}</view>
          </view>
          <view class="acard__right"><view class="acard__pill pill--{{item.statusTone}}">{{item.statusLabel}}</view><image class="acard__chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" /></view>
        </view>
      </view>
      <view wx:if="{{!hasVisibleEvents}}" class="c1-empty">当前筛选下没有日程</view>
    </block>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
