<view class="c1">
  <view class="c1-nav" style="padding-top:{{navInset}}px">
    <view class="c1-nav__title">日程</view>
    <view wx:if="{{hasCoachInitial}}" class="c1-nav__avatar" bindtap="openMe">{{coachInitial}}</view>
  </view>

  <view class="c1-dates">
    <view wx:for="{{dayStrip}}" wx:key="date" class="c1-day {{selectedDate === item.date ? 'c1-day--selected' : ''}}" data-date="{{item.date}}" bindtap="selectDay">
      <view class="c1-day__week">{{item.weekLabel}}</view>
      <view class="c1-day__num">{{item.dayNum}}</view>
    </view>
  </view>

  <view wx:if="{{state === 'ready'}}" class="c1-summary">
    <view wx:for="{{summaryItems}}" wx:key="key" class="c1-summary__item c1-summary__item--{{item.tone}}">
      <text class="c1-summary__label">{{item.label}}</text>
      <text class="c1-summary__value">{{item.value}}</text>
    </view>
  </view>

  <view wx:if="{{state === 'ready' && hasTeams}}" class="c1-teams">
    <view wx:for="{{teamChips}}" wx:key="name" class="c1-team-chip">{{item.name}}</view>
  </view>

  <view class="c1-body">
    <view class="c1-list-heading">
      <view class="c1-list-heading__title">{{viewMode === 'week' ? '本周日程' : '当日安排'}}</view>
      <view class="c1-list-heading__tools">
        <view class="view-switch">
          <view class="switch-item {{viewMode === 'day' ? 'active' : ''}}" data-mode="day" bindtap="switchView">日</view>
          <view class="switch-item {{viewMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="switchView">周</view>
        </view>
        <picker mode="date" value="{{date}}" bindchange="onDateChange"><view class="c1-tools__picker">{{rangeLabel}}</view></picker>
      </view>
    </view>

    <status-view wx:if="{{state !== 'ready'}}" state="{{state}}" title="{{state === 'loading' ? '加载日程' : state === 'empty' ? '暂无日程或任务' : '日程读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view wx:if="{{hasTaskCards}}" class="c1-task-section">
        <view class="c1-section-title">待处理任务</view>
        <view wx:for="{{taskCards}}" wx:key="eventId" class="c1-task-card" data-id="{{item.eventId}}" data-action="{{item.action}}" catchtap="openTask">
          <view class="c1-task-card__content"><view class="c1-task-card__label">{{item.label}}</view><view wx:if="{{item.hasDueAt}}" class="c1-task-card__due">{{item.dueLabel}}</view></view>
          <view class="c1-task-card__chevron">›</view>
        </view>
      </view>

      <view wx:if="{{hasVisibleEvents}}" class="c1-list">
        <view wx:for="{{visibleEvents}}" wx:key="id" class="acard" data-id="{{item.id}}" bindtap="openEvent">
          <view class="acard__accent" style="background:{{item.typeColor}}"></view>
          <view class="acard__time"><view class="acard__start">{{item.startTime}}</view><view wx:if="{{item.durationText}}" class="acard__dur">{{item.durationText}}</view></view>
          <view class="acard__content">
            <view class="acard__head"><view class="acard__title">{{item.title}}</view><view wx:if="{{item.hasCoachName}}" class="acard__coach">{{item.coachName}}</view></view>
            <view wx:if="{{item.hasLocationDetail}}" class="acard__meta">{{item.locationLabel}}</view>
            <view wx:if="{{item.hasNextAction}}" class="acard__action" data-id="{{item.id}}" data-action="{{item.nextAction}}" catchtap="openTask">{{item.nextActionLabel}}</view>
          </view>
          <view class="acard__right"><view class="acard__pill pill--{{item.statusTone}}">{{item.statusLabel}}</view><view class="acard__chevron">›</view></view>
        </view>
      </view>
      <view wx:if="{{!hasVisibleEvents}}" class="c1-empty">当前筛选下没有日程</view>
    </block>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
