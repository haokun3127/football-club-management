.c1 { min-height: 100vh; background: #f5f6f8; }

/* C1 Top Nav */
.c1-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 176rpx;
  padding: 28rpx 44rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e7eaf0;
}
.c1-nav__title { color: #202124; font-size: 44rpx; font-weight: 700; }
.c1-nav__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* C1 Date Strip */
.c1-dates {
  display: flex;
  gap: 8rpx;
  margin: 24rpx 32rpx 0;
  padding: 24rpx 16rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 24rpx;
  background: #ffffff;
}
.c1-day { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 12rpx 0; border-radius: 16rpx; }
.c1-day--selected { background: #a80f1b; border-radius: 32rpx; }
.c1-day__week { color: #667085; font-size: 20rpx; }
.c1-day__num { color: #202124; font-size: 28rpx; font-weight: 600; }
.c1-day--selected .c1-day__week, .c1-day--selected .c1-day__num { color: #ffffff; }

/* C1 Stats Row */
.c1-stats { display: flex; gap: 16rpx; padding: 24rpx 32rpx 0; }
.c1-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}
.c1-pill--brand { background: #a80f1b; }
.c1-pill--green { background: #10b981; }
.c1-pill--amber { background: #f59e0b; }

.c1-body { padding: 24rpx 32rpx calc(148rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 24rpx; }

.c1-tools { display: flex; align-items: center; justify-content: space-between; }
.c1-tools__picker { padding: 10rpx 18rpx; border-radius: 999rpx; background: #ffffff; border: 1rpx solid #e7eaf0; color: #60646f; font-size: 22rpx; }
.c1-scope { color: #8a8f99; font-size: 22rpx; }

/* C1 Activity Cards */
.c1-list { display: flex; flex-direction: column; gap: 24rpx; }
.acard {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}
.acard__accent { width: 8rpx; border-radius: 4rpx; flex-shrink: 0; }
.acard__time { display: flex; flex-direction: column; gap: 4rpx; width: 112rpx; flex-shrink: 0; justify-content: center; }
.acard__start { color: #a80f1b; font-size: 30rpx; font-weight: 800; }
.acard__dur { color: #667085; font-size: 22rpx; }
.acard__content { flex: 1; display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.acard__head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.acard__title { color: #202124; font-size: 32rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.acard__pill { padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 600; flex-shrink: 0; }
.pill--info { background: #d1fae5; color: #065f46; }
.pill--success { background: #ecfdf5; color: #059669; }
.pill--brand { background: #dbeafe; color: #1a3a6b; }
.pill--warning, .pill--pending { background: #fef3c7; color: #92400e; }
.pill--error { background: #fee2e2; color: #b91c1c; }
.acard__meta { color: #667085; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.acard__action { align-self: flex-start; padding: 8rpx 20rpx; border-radius: 999rpx; background: #fceeef; color: #a80f1b; font-size: 24rpx; font-weight: 600; }

/* 保留共享类 */
.view-switch { display: flex; padding: 6rpx; border-radius: 999rpx; background: #f2f3f5; }
.switch-item { padding: 10rpx 28rpx; border-radius: 999rpx; color: #60646f; font-size: 24rpx; font-weight: 600; }
.switch-item.active { background: #ffffff; color: #a80f1b; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06); }
.filter-row { display: flex; gap: 12rpx; }
.filter-item { padding: 10rpx 24rpx; border-radius: 999rpx; background: #ffffff; border: 1rpx solid #e7eaf0; color: #60646f; font-size: 24rpx; }
.filter-item.active { border-color: #a80f1b; background: #fceeef; color: #a80f1b; font-weight: 700; }
.card.empty { padding: 64rpx 32rpx; border-radius: 24rpx; background: #ffffff; color: #8a8f99; font-size: 26rpx; text-align: center; }
/* custom navigation: keep Figma 88px total height inclusive of safe area */
.c1-nav { box-sizing: border-box; }
