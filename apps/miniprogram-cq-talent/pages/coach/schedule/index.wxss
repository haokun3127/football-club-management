.c1 { min-height: 100vh; background: #f5f6f8; }

.c1-nav {
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e7eaf0;
}
.c1-nav__title { color: #202124; font-size: 36rpx; font-weight: 700; line-height: 44rpx; }
.c1-nav__avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #a80f1b; color: #ffffff; font-size: 28rpx; font-weight: 700; }

.c1-dates { position: relative; display: flex; align-items: center; height: 128rpx; box-sizing: border-box; padding: 24rpx 0; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }
.c1-dates__arrow { display: flex; flex: 0 0 44rpx; align-self: stretch; align-items: center; justify-content: center; }
.c1-dates__arrow image { display: block; width: 28rpx; height: 28rpx; }
.c1-dates__days { display: flex; flex: 1; min-width: 0; }
.c1-day { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-width: 0; border-radius: 16rpx; }
.c1-day--selected { border-radius: 32rpx; background: #a80f1b; }
.c1-day__week { color: #667085; font-size: 20rpx; line-height: 24rpx; }.c1-day__num { color: #202124; font-size: 28rpx; font-weight: 600; line-height: 34rpx; }
.c1-day--selected .c1-day__week, .c1-day--selected .c1-day__num { color: #ffffff; }

.c1-team-selector { position: relative; display: flex; flex-direction: column; justify-content: center; height: 152rpx; padding: 22rpx 84rpx 22rpx 42rpx; box-sizing: border-box; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #ffffff; }
.c1-team-selector__label { color: #667085; font-size: 24rpx; font-weight: 700; line-height: 28rpx; }
.c1-team-selector__line { display: flex; align-items: baseline; gap: 16rpx; min-width: 0; margin-top: 8rpx; }
.c1-team-selector__name { overflow: hidden; color: #202124; font-size: 34rpx; font-weight: 600; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.c1-team-selector__meta { flex: 0 0 auto; color: #667085; font-size: 22rpx; line-height: 28rpx; white-space: nowrap; }
.c1-team-selector__chevron { position: absolute; top: 50%; right: 32rpx; width: 40rpx; height: 40rpx; transform: translateY(-50%); }

.c1-body { padding: 0 44rpx calc(148rpx + env(safe-area-inset-bottom)); }
.c1-hero { display: flex; flex-direction: column; gap: 24rpx; min-height: 360rpx; margin: 0 -12rpx; padding: 32rpx; box-sizing: border-box; border-radius: 32rpx; background: #07111f; color: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.08); }
.c1-hero__top { display: flex; justify-content: space-between; color: rgba(255,255,255,.7); font-size: 22rpx; }.c1-hero__main { display: flex; flex-direction: row; align-items: baseline; gap: 16rpx; min-width: 0; }.c1-hero__time { flex: 0 0 auto; color: #ffffff; font-size: 108rpx; font-weight: 800; line-height: 108rpx; }.c1-hero__title { flex: 1; min-width: 0; overflow: hidden; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.c1-hero__meta { overflow: hidden; color: rgba(255,255,255,.8); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }.c1-hero__pills { display: flex; gap: 16rpx; margin-top: auto; }.c1-hero__pill { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 20rpx; border: 1rpx solid rgba(255,255,255,.15); border-radius: 999rpx; background: rgba(255,255,255,.06); color: #ffffff; white-space: nowrap; }.c1-hero__pill--primary { border-color: rgba(168,15,27,.2); background: rgba(168,15,27,.1); }.c1-hero__pill-value { color: #ffffff; font-size: 24rpx; font-weight: 800; line-height: 28rpx; }.c1-hero__pill-label { color: rgba(255,255,255,.7); font-size: 22rpx; font-weight: 600; line-height: 26rpx; }.c1-hero__pill--primary .c1-hero__pill-value { color: #a80f1b; }.c1-hero__pill--primary .c1-hero__pill-label { color: rgba(255,255,255,.8); }
.c1-list-heading { display: flex; align-items: center; justify-content: space-between; height: 84rpx; }.c1-list-heading__title, .c1-section-title { color: #202124; font-size: 28rpx; font-weight: 600; }
.c1-list-heading__tools { display: flex; align-items: center; gap: 12rpx; }.view-switch { display: flex; padding: 4rpx; border-radius: 20rpx; background: #ebeef2; }
.switch-item { min-width: 40rpx; padding: 6rpx 10rpx; border-radius: 16rpx; box-sizing: border-box; color: #667085; font-size: 20rpx; line-height: 24rpx; text-align: center; }.switch-item.active { background: #ffffff; color: #a80f1b; font-weight: 700; }
.c1-tools__picker { max-width: 180rpx; overflow: hidden; color: #667085; font-size: 20rpx; line-height: 32rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }

.c1-task-section { margin-bottom: 24rpx; }.c1-section-title { margin-bottom: 16rpx; }.c1-task-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx; border-radius: 24rpx; background: #ffffff; border: 1rpx solid #e7eaf0; }.c1-task-card__content { min-width: 0; }.c1-task-card__label { overflow: hidden; color: #202124; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.c1-task-card__due { margin-top: 8rpx; color: #667085; font-size: 22rpx; }.c1-task-card__chevron { color: #667085; font-size: 40rpx; font-weight: 300; line-height: 40rpx; }.acard__chevron { display: block; width: 40rpx; height: 40rpx; flex: 0 0 40rpx; }

.c1-list { display: flex; flex-direction: column; gap: 24rpx; margin-top: 24rpx; }.acard { display: flex; align-items: center; gap: 24rpx; min-height: 192rpx; padding: 24rpx; box-sizing: border-box; border-radius: 32rpx; background: #ffffff; box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08); }.acard__accent { width: 8rpx; align-self: stretch; flex: 0 0 8rpx; border-radius: 4rpx; }.acard__time { width: 112rpx; flex: 0 0 112rpx; }.acard__start { color: #a80f1b; font-size: 30rpx; font-weight: 800; line-height: 36rpx; }.acard__dur { color: #667085; font-size: 22rpx; line-height: 26rpx; }.acard__content { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; gap: 12rpx; }.acard__head { display: flex; align-items: center; gap: 8rpx; min-width: 0; }.acard__title { min-width: 0; overflow: hidden; color: #202124; font-size: 30rpx; font-weight: 600; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }.acard__coach { flex: 0 0 auto; padding: 4rpx 10rpx; border-radius: 8rpx; background: #f3f4f6; color: #667085; font-size: 20rpx; line-height: 26rpx; }.acard__meta { overflow: hidden; color: #667085; font-size: 22rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }.acard__action { align-self: flex-start; padding: 6rpx 12rpx; border-radius: 8rpx; background: #fdf0f1; color: #a80f1b; font-size: 22rpx; line-height: 28rpx; }.acard__right { display: flex; flex: 0 0 auto; align-items: center; gap: 10rpx; }.acard__pill { height: 42rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 20rpx; line-height: 42rpx; }.pill--info, .pill--success { background: #10b981; color: #ffffff; }.pill--brand { background: #1976d2; color: #ffffff; }.pill--warning, .pill--pending { background: #f59e0b; color: #ffffff; }.pill--error { background: #d14343; color: #ffffff; }
.c1-empty { padding: 64rpx 32rpx; border-radius: 24rpx; background: #ffffff; color: #8a8f99; font-size: 26rpx; text-align: center; }

.c1-dates__expand { position: absolute; right: 12rpx; bottom: -14rpx; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 28rpx; border-radius: 16rpx; background: #fff1f2; }
.c1-dates__expand image { display: block; width: 20rpx; height: 20rpx; transform: rotate(90deg); }

.c1-month-calendar { box-sizing: border-box; width: 100%; min-height: 588rpx; padding: 28rpx 24rpx 24rpx; background: #ffffff; border-bottom: 1rpx solid #e7eaf0; }
.c1-month-calendar__header { display: flex; align-items: center; justify-content: space-between; min-height: 48rpx; }
.c1-month-calendar__title { color: #202124; font-size: 34rpx; font-weight: 700; line-height: 42rpx; }
.c1-month-calendar__actions { display: flex; align-items: center; gap: 8rpx; }
.c1-month-calendar__arrow { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.c1-month-calendar__arrow image { display: block; width: 28rpx; height: 28rpx; }
.c1-month-calendar__collapse { display: flex; align-items: center; justify-content: center; gap: 6rpx; box-sizing: border-box; width: 104rpx; height: 48rpx; border-radius: 12rpx; background: #fff1f2; color: #a80f1b; font-size: 22rpx; font-weight: 600; line-height: 28rpx; }
.c1-month-calendar__collapse-icon { display: block; width: 20rpx; height: 20rpx; transform: rotate(-90deg); }
.c1-month-calendar__weekdays { display: grid; grid-template-columns: repeat(7, 1fr); margin-top: 24rpx; }
.c1-month-calendar__weekday { color: #667085; font-size: 22rpx; line-height: 28rpx; text-align: center; }
.c1-month-calendar__grid { display: grid; grid-template-columns: repeat(7, 1fr); grid-auto-rows: 64rpx; margin-top: 12rpx; }
.c1-month-day { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 6rpx; color: #202124; }
.c1-month-day--outside { color: #9ca3af; }
.c1-month-day__number { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; font-size: 26rpx; line-height: 32rpx; }
.c1-month-day--today .c1-month-day__number { color: #a80f1b; font-weight: 700; }
.c1-month-day--selected .c1-month-day__number { background: #a80f1b; color: #ffffff; font-weight: 700; }
.c1-month-day__markers { position: absolute; bottom: 0; display: flex; align-items: center; justify-content: center; gap: 4rpx; height: 10rpx; }
.c1-month-day__marker { width: 8rpx; height: 8rpx; border-radius: 50%; }
.c1-month-day__marker--training { background: #10b981; }
.c1-month-day__marker--match { background: #f59e0b; }
.c1-month-day__marker--multiple { width: 6rpx; height: 6rpx; background: #667085; }
