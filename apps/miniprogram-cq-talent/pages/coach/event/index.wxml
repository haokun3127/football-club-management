<view class="c2">
  <view class="c2-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c2-nav__left" bindtap="goBack">
      <image class="c2-nav__back" src="/assets/icons/chevron-left.svg" mode="aspectFit" />
      <view class="c2-nav__title">{{eventTypeLabel}}工作台</view>
    </view>
    <view wx:if="{{inProgress}}" class="c2-nav__finish {{finishing ? 'c2-nav__finish--disabled' : ''}}" bindtap="finishEvent">结束训练</view>
  </view>
  <view class="c2-route-tabs">
    <view class="c2-route-tab c2-route-tab--active" data-path="/pages/coach/schedule/index" bindtap="openCoachRoot">
      <image class="c2-route-tab__icon" src="/assets/icons/tab-calendar-active.png" mode="aspectFit" />
      <view class="c2-route-tab__label">日程</view>
      <view class="c2-route-tab__dot"></view>
    </view>
    <view class="c2-route-tab" data-path="/pages/coach/training/index" bindtap="openCoachRoot">
      <image class="c2-route-tab__icon" src="/assets/icons/tab-training-inactive.png" mode="aspectFit" />
      <view class="c2-route-tab__label">训练管理</view>
    </view>
    <view class="c2-route-tab" data-path="/pages/coach/me/index" bindtap="openCoachRoot">
      <image class="c2-route-tab__icon" src="/assets/icons/tab-user-inactive.png" mode="aspectFit" />
      <view class="c2-route-tab__label">我的</view>
    </view>
  </view>

  <view class="c2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载活动' : state === 'empty' ? '暂无工作台数据' : '活动读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view wx:if="{{eventView}}" class="shero">
       <view class="shero__heading">
         <view class="shero__content">
           <view class="shero__title">{{eventView.title}}</view>
           <view wx:if="{{eventView.sessionMeta}}" class="shero__session-meta"><text class="shero__session-team">{{eventView.sessionTeam}}</text><text wx:if="{{eventView.hasTime}}" class="shero__session-time"> · {{eventView.timeLabel}}</text></view>
         </view>
         <view wx:if="{{!inProgress}}" class="shero__status"><status-chip label="{{eventView.statusLabel}}" tone="{{eventView.statusTone}}" compact="{{true}}" /></view>
       </view>
       <view wx:if="{{countdownText}}" class="shero__countdown"><image class="shero__countdown-icon" src="/assets/icons/clock-white.svg" mode="aspectFit" />{{countdownText}}</view>
      <view class="shero__chips">
        <view wx:if="{{eventView.hasVenue}}" class="shero__chip shero__chip--muted">{{eventView.venue}}</view>
        <view wx:if="{{attendanceTotal > 0}}" class="shero__chip shero__chip--muted">出席 {{attendancePresent}}/{{attendanceTotal}} 人</view>
        <view wx:if="{{inProgress}}" class="shero__chip shero__chip--live">● 进行中</view>
      </view>
    </view>

    <view wx:if="{{hasRoster}}" class="workbench-card">
      <view class="row">
        <view class="section-title">出勤情况 {{attendancePresent}}/{{attendanceTotal}}</view>
        <view class="roster-detail" bindtap="openAttendance">查看详情</view>
      </view>
      <view class="roster-dots">
        <view wx:for="{{rosterRows}}" wx:key="studentId" class="roster-dot {{item.present ? 'roster-dot--present' : ''}}">{{item.initial}}</view>
      </view>
      <view wx:if="{{joinedNames}}" class="subtitle">已加入：{{joinedNames}}</view>
    </view>

    <view wx:if="{{hasWorkflow}}" class="workbench-card">
      <view class="section-title">流程状态</view>
      <view wx:for="{{workflowRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <status-chip label="{{item.value}}" tone="{{item.status === 'ready' ? 'success' : 'pending'}}" compact="{{true}}" />
      </view>
    </view>

    <view wx:if="{{hasActionCards}}" class="action-grid">
      <view wx:for="{{actionCards}}" wx:key="id" class="action-tile" data-action="{{item.id}}" bindtap="openAction">
        <image class="action-tile__icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="action-tile__label">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{hasTraining}}" class="workbench-card">
      <view class="section-title">训练内容</view>
      <view wx:for="{{trainingRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <view class="field-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{hasMatch}}" class="workbench-card">
      <view class="section-title">比赛记录</view>
      <view wx:for="{{matchRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <view class="field-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{hasPendingRows}}" wx:for="{{pendingRows}}" wx:key="title" class="workbench-card workbench-card--pending">
      <view class="section-title">{{item.title}}</view>
      <view class="subtitle">{{item.message}}</view>
    </view>
    </block>
  </view>
</view>
