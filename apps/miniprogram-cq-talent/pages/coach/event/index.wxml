<view class="c2">
  <view class="c2-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c2-nav__left" bindtap="goBack">
      <image class="c2-nav__back" src="/assets/icons/chevron-left.svg" mode="aspectFit" />
      <view class="c2-nav__title">{{eventTypeLabel}}工作台</view>
    </view>
  </view>
  <view class="c2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载活动' : state === 'empty' ? '暂无工作台数据' : '活动读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view wx:if="{{eventView}}" class="shero">
        <view class="shero__top"><view>{{eventView.heroDateLabel}}</view><view>重庆天才</view></view>
        <view class="shero__main">
          <view class="shero__big">{{eventView.startTime}}</view>
          <view class="shero__title">{{eventView.title}}</view>
        </view>
        <view wx:if="{{eventView.heroMeta}}" class="shero__meta">{{eventView.heroMeta}}</view>
        <view class="shero__pills">
          <view wx:if="{{attendanceTotal > 0}}" class="shero__pill">出席 {{attendancePresent}}/{{attendanceTotal}} 人</view>
        </view>
      </view>

    <view wx:if="{{hasRoster}}" class="workbench-card">
      <view class="row">
        <view class="section-title">出勤情况 {{attendancePresent}}/{{attendanceTotal}}</view>
        <view class="subtitle">点击头像切换</view>
      </view>
      <view class="roster-grid">
        <view wx:for="{{rosterRows}}" wx:key="studentId" class="roster-person" data-index="{{index}}" bindtap="toggleAttendance">
          <view class="roster-avatar {{item.present ? 'roster-avatar--present' : 'roster-avatar--absent'}}">
            <image wx:if="{{item.present}}" class="roster-avatar__check" src="/assets/icons/c4-1-check.svg" mode="aspectFit" />
            <view wx:else class="roster-avatar__initial">{{item.initial}}</view>
          </view>
          <view class="roster-name">{{item.displayName}}</view>
        </view>
      </view>
      <view wx:if="{{attendanceSaving}}" class="subtitle">正在保存出勤...</view>
      <view wx:if="{{attendanceError}}" class="attendance-error">{{attendanceError}}</view>
    </view>

    <view wx:if="{{hasTraining}}" class="workbench-card" data-action="training" bindtap="openAction">
      <view class="row">
        <view class="section-title">训练内容</view>
        <view class="training-card__edit">编辑 ›</view>
      </view>
      <view class="training-card__summary">{{trainingContentSummary}}</view>
    </view>

    <view wx:if="{{hasActionCards}}" class="action-grid">
      <view wx:for="{{actionCards}}" wx:key="id" class="action-tile" data-action="{{item.id}}" bindtap="openAction">
        <image class="action-tile__icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="action-tile__label">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{hasMatch}}" class="workbench-card">
      <view class="section-title">比赛记录</view>
      <view wx:for="{{matchRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <view class="field-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{hasPendingRows}}" wx:for="{{pendingRows}}" wx:key="title" class="workbench-card workbench-card--pending">
      <view class="section-title">{{item.title}}</view>
      <view class="subtitle">{{item.message}}</view>
    </view>
    </block>
  </view>
  <role-tabbar role="coach" active="schedule" />
</view>
