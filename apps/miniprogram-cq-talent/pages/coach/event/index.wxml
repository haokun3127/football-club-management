<view class="c2">
  <view class="c2-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c2-nav__left" bindtap="goBack">
      <view class="c2-nav__back">‹</view>
      <view class="c2-nav__title">{{eventTypeLabel}}工作台</view>
    </view>
  </view>

  <view class="c2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载活动' : state === 'empty' ? '暂无工作台数据' : '活动读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
    <view wx:if="{{eventView}}" class="shero">
      <view class="shero__heading">
        <view>
          <view class="shero__eyebrow">{{eventView.typeLabel}}</view>
          <view class="shero__title">{{eventView.title}}</view>
        </view>
        <status-chip label="{{eventView.statusLabel}}" tone="{{eventView.statusTone}}" compact="{{true}}" />
      </view>
      <view wx:if="{{eventView.hasTime}}" class="shero__meta">{{eventView.timeLabel}}</view>
      <view class="shero__chips">
        <view wx:if="{{eventView.hasTeamName}}" class="shero__chip">{{eventView.teamName}}</view>
        <view wx:if="{{eventView.hasVenue}}" class="shero__chip shero__chip--muted">{{eventView.venue}}</view>
      </view>
    </view>

    <view wx:if="{{hasWorkflow}}" class="workbench-card">
      <view class="section-title">流程状态</view>
      <view wx:for="{{workflowRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <status-chip label="{{item.value}}" tone="{{item.status === 'ready' ? 'success' : 'pending'}}" compact="{{true}}" />
      </view>
    </view>

    <view wx:if="{{hasActionCards}}" class="workbench-card">
      <view class="section-title">可用操作</view>
      <view class="action-grid">
        <view wx:for="{{actionCards}}" wx:key="id" class="action-tile {{item.toneClass}}" data-action="{{item.id}}" bindtap="openAction">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{hasRoster}}" class="workbench-card">
      <view class="row">
        <view class="section-title">参与成员</view>
        <view class="roster-count">{{rosterCount}} 人</view>
      </view>
      <view class="subtitle">状态来自活动名单确认，不作为出勤统计。</view>
      <view wx:for="{{rosterRows}}" wx:key="studentId" class="field-row">
        <view class="label">{{item.name}}</view>
        <view class="field-value">{{item.statusLabel}}</view>
      </view>
    </view>

    <view wx:if="{{hasTraining}}" class="workbench-card">
      <view class="section-title">训练内容</view>
      <view wx:for="{{trainingRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <view class="field-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{hasMatch}}" class="workbench-card">
      <view class="section-title">比赛记录</view>
      <view wx:for="{{matchRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <view class="field-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{hasPendingRows}}" wx:for="{{pendingRows}}" wx:key="title" class="workbench-card workbench-card--pending">
      <view class="section-title">{{item.title}}</view>
      <view class="subtitle">{{item.message}}</view>
    </view>
    </block>
  </view>
</view>
