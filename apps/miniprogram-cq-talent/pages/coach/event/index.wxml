<view class="c2 {{isTraining ? 'club-workbench' : ''}}">
  <app-header title="{{eventTypeLabel}}工作台" title-align="left" show-back="{{true}}" />
  <view class="c2-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载活动' : state === 'empty' ? '暂无工作台数据' : '活动读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />

    <block wx:if="{{state === 'ready'}}">
      <view wx:if="{{eventView}}" class="course-info workbench-card">
        <view class="section-title">{{eventView.title}}</view>
        <view class="subtitle">{{eventView.timeLabel}} · {{eventView.venue}}</view>
        <view wx:if="{{!canWrite}}" class="subtitle">课程已取消，不计训练记录</view>
        <view class="row"><view class="subtitle">{{eventView.teamName}}</view><t-button wx:if="{{canEditTraining}}" variant="text" theme="default" t-class="course-change" custom-style="min-height:44px;height:auto;font-size:var(--font-size-aux);line-height:1.5;" data-action="change" bindtap="openAction">变更课程</t-button></view>
      </view>

    <view wx:if="{{hasTraining}}" class="workbench-card">
      <view class="row">
        <view class="section-title">本次训练内容 · {{contentCount}} 项</view>
        <view wx:if="{{canEditTraining}}" class="training-card__edit" data-action="training" bindtap="openAction">编辑 ›</view>
      </view>
      <view wx:if="{{!hasConfiguredContent}}" class="training-card__summary">本堂课尚未添加训练内容</view>
      <view wx:for="{{contentGroups}}" wx:key="id" class="training-content-group"><view class="training-content-group__title">{{item.label}}</view><view wx:for="{{item.items}}" wx:for-item="content" wx:key="id" class="training-content-item"><text>{{content.name}}</text><text class="training-content-item__minutes">{{content.minutesLabel}}</text></view></view>


      <view wx:if="{{contentMinutesLabel}}" class="training-content-total">{{contentMinutesLabel}}</view>
      <t-button wx:if="{{hiddenContentCount}}" size="small" class="training-content-expand" bindtap="toggleContent" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="training-content-expand" theme="primary" variant="text">{{contentExpanded ? '收起' : '展开全部'}}{{contentExpanded ? '' : ' · 另有 ' + hiddenContentCount + ' 项'}}</t-button>
    </view>

    <view id="course-assessments" wx:if="{{isTraining}}" class="workbench-card course-assessment">
      <view class="section-title">本课测评</view><view wx:if="{{courseTaskMessage}}" class="subtitle">{{courseTaskMessage}}</view>
      <t-button wx:if="{{courseTasksState === 'error'}}" theme="primary" variant="text" bindtap="retryCourseTasks">重试本课测评</t-button>
      <view wx:for="{{courseTasks}}" wx:key="id" class="course-task" data-id="{{item.id}}" bindtap="openCourseTask"><view>{{item.title}} · {{item.summary}}</view><view class="subtitle">{{item.contextLabel}}</view><view class="training-card__edit">{{item.actionLabel}}</view><view wx:if="{{item.reason}}" class="subtitle">{{item.reason}}</view></view>
      <view wx:if="{{canWrite}}" class="training-card__edit" bindtap="createAssessmentTask">＋发起随堂测评</view>
    </view>
    <view wx:if="{{isTraining}}" class="workbench-card">
      <view class="section-title">训练内友谊赛</view>
      <view class="subtitle">归属本次训练课，比分与个人事件分别记录。</view>
      <view wx:if="{{gamesLoading}}" class="subtitle">正在读取记录…</view><view wx:if="{{gamesMessage}}" class="subtitle">{{gamesMessage}}</view>
      <view wx:for="{{friendlyGames}}" wx:key="id" class="friendly-game" data-id="{{item.id}}" bindtap="openTrainingGame" role="button"><view>{{item.title}} · {{item.score}} ›</view><view class="subtitle">{{item.summary}}</view></view>
      <t-button wx:for="{{gameSources}}" wx:key="contentBlockId" theme="default" variant="text" data-source="{{item.contentBlockId}}" bindtap="openTrainingGame">新增一场 · {{item.contentSnapshot.name}}</t-button>
    </view>
    <view wx:if="{{isTraining}}" class="workbench-card">
      <view class="row"><view class="section-title">名单与课次</view><t-button variant="text" theme="primary" bindtap="openAttendance">查看全部 {{rosterCount}} 人</t-button></view>
      <view wx:if="{{trainingFactsAvailable}}" class="subtitle">已计 {{attendancePresent}} 人 · 待生成 {{pendingRecordCount}} 人 · 例外 {{exceptionRows.length}} 人</view>
      <view wx:if="{{!trainingFactsAvailable}}" class="subtitle">训练记录暂不可用，请进入名单后重试。</view>
      <view class="subtitle">课程结束后自动记录，请假不计课次。无需整班提交；记录与财务分别处理。</view>
      <view wx:for="{{exceptionRows}}" wx:key="studentId" class="exception-row" data-id="{{item.studentId}}" bindtap="openRecord" role="button"><text>{{item.displayName}}</text><text class="subtitle">{{item.statusLabel}} ›</text></view>
      <t-button wx:if="{{canManageRoster}}" variant="text" theme="primary" bindtap="openTemporaryPlayers">添加临时球员</t-button>
    </view>
    <view wx:if="{{hasRoster && !isTraining}}" class="workbench-card">
      <view class="row">
        <view class="section-title">本课出勤 · {{attendancePresent}}/{{attendanceTotal}}</view>
        <view wx:if="{{canManageRoster}}" class="training-card__edit" bindtap="openTemporaryPlayers">＋临时球员</view>
      </view>
      <view class="roster-grid">
        <view wx:for="{{rosterRows}}" wx:key="studentId" class="roster-person" data-index="{{index}}" bindtap="toggleAttendance">
          <view class="roster-avatar {{item.present ? 'roster-avatar--present' : 'roster-avatar--absent'}}">
            <text wx:if="{{item.present}}" class="roster-avatar__check">✓</text>
            <view wx:else class="roster-avatar__initial">{{item.initial}}</view>
          </view>
          <view class="roster-name">{{item.displayName}}</view>
        </view>
      </view>
      <view wx:if="{{isTraining}}" class="subtitle">课结束自动记录 · 请假例外 · 无需点名提交
出勤记录与财务扣费分别处理</view>
      <view class="attendance-links"><text bindtap="openAttendance">完整名单</text><text data-action="records" bindtap="openAction">修改历史</text></view>
      <view wx:if="{{attendanceSaving}}" class="subtitle">正在保存出勤...</view>
      <view wx:if="{{attendanceError}}" class="attendance-error">{{attendanceError}}</view><t-button wx:if="{{attendanceNeedsRefresh}}" size="small" bindtap="retry" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">刷新核对</t-button>
    </view>

    <view wx:if="{{isTraining}}" class="workbench-card">
      <view class="row"><view class="section-title">按需记录与备课</view><t-button wx:if="{{canEditTraining}}" theme="primary" variant="text" bindtap="togglePreparation">{{preparationExpanded ? '收起备课工具' : '展开备课工具'}}</t-button></view>
      <t-button wx:if="{{canWrite}}" data-action="training-assessment" bindtap="openAction" theme="primary" variant="text">记录课堂表现（选填）</t-button>
      <block wx:if="{{preparationExpanded}}">
      <view wx:if="{{canEditTraining}}" class="training-tools"><t-button data-mode="templates" bindtap="openTransfer" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">套用模板</t-button><t-button data-mode="copy" bindtap="openTransfer" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">复制到其他课</t-button><t-button data-mode="save" bindtap="openTransfer" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">保存为模板</t-button></view>
      </block>
    </view>
    <view wx:if="{{hasActionCards && !isTraining}}" class="action-grid">
      <view wx:if="{{canWrite && hasTraining}}" class="action-tile" bindtap="createAssessmentTask"><view class="action-tile__label">创建测评任务</view></view>
      <view wx:for="{{actionCards}}" wx:key="id" class="action-tile" data-action="{{item.id}}" bindtap="openAction">
        <view wx:if="{{item.glyph}}" class="action-tile__glyph">{{item.glyph}}</view>
        <image wx:else class="action-tile__icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="action-tile__label">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{hasMatch}}" class="workbench-card">
      <view class="section-title">比赛记录</view>
      <view wx:for="{{matchRows}}" wx:key="label" class="field-row">
        <view class="label">{{item.label}}</view>
        <view class="field-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{hasPendingRows}}" wx:for="{{pendingRows}}" wx:key="title" class="workbench-card workbench-card--pending">
      <view class="section-title">{{item.title}}</view>
      <view class="subtitle">{{item.message}}</view>
    </view>
    </block>
  </view>
  <submit-bar wx:if="{{state === 'ready' && isTraining && !transferVisible}}" primary-text="{{primaryLabel}}" bindsubmit="primaryAction" />
  <role-tabbar wx:if="{{!isTraining && !transferVisible}}" role="coach" active="schedule" />
  <view wx:if="{{transferVisible}}" class="transfer-mask"><view class="transfer-sheet"><view class="transfer-head"><text>{{transferMode === 'save' ? '保存个人模板' : transferMode === 'templates' ? '套用模板' : '复制课程内容'}}</text><t-button disabled="{{transferBusy}}" bindtap="closeTransfer" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" theme="primary" variant="text">关闭</t-button></view>
    <scroll-view scroll-y class="transfer-scroll">
      <view class="transfer-hint">模板和复制均排除友谊赛内容及其记录。</view>
      <view wx:if="{{transferMode === 'save'}}"><t-input class="transfer-input" value="{{templateTitle}}" bindchange="onTemplateTitle" placeholder="模板名称" maxlength="80"  borderless t-class="transfer-input" /><t-button class="transfer-primary" disabled="{{transferBusy}}" bindtap="saveTemplate" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="transfer-primary" theme="primary" variant="base">保存个人模板</t-button></view>
      <block wx:if="{{transferMode === 'templates' && !transferPreview}}"><view wx:for="{{templates}}" wx:key="id" class="transfer-item" data-id="{{item.id}}" bindtap="selectTemplate"><view>{{item.title}} · {{item.visibility === 'club' ? '俱乐部' : '个人'}}</view><view class="transfer-hint">{{item.summary}}</view></view><view wx:if="{{!hasTemplates}}" class="transfer-hint">暂无可用模板</view></block>
      <view wx:if="{{transferPreview}}"><view class="transfer-title">{{transferPreview.title}}</view><view class="transfer-hint">{{transferPreview.count}}项 · {{transferPreview.configuredMinutes}}分钟</view><view wx:for="{{transferPreview.items}}" wx:key="id" class="transfer-item">{{item.name}} · {{item.configuredMinutes}}分钟</view><view wx:for="{{transferPreview.excluded}}" wx:key="*this" class="transfer-hint">已排除：{{item}}</view>
        <view wx:for="{{transferTargets}}" wx:key="eventId" class="transfer-target"><view class="transfer-title">{{item.title}}</view><view class="transfer-hint">{{item.dateLabel}}</view><view class="transfer-hint">已有内容：{{item.existingLabel}}</view><t-button disabled="{{transferBusy}}" class="{{item.action === 'replace' ? 'transfer-selected' : ''}}" data-id="{{item.eventId}}" bindtap="toggleTransferTarget" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="{{item.action === 'replace' ? 'transfer-selected' : ''}}" theme="primary" variant="text">{{item.action === 'replace' ? '已选：替换此课内容' : '跳过此课 · 点击选择替换'}}</t-button></view>
      </view>
      <view class="transfer-message">{{transferMessage}}</view><view wx:for="{{transferResults}}" wx:key="eventId" class="transfer-item">{{item.title}} · {{item.label}}</view>
      <t-button wx:if="{{transferPreview && hasTransferTargets}}" class="transfer-primary" disabled="{{transferBusy}}" bindtap="confirmTransfer" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="transfer-primary" theme="primary" variant="base">{{transferBusy ? '处理中…' : '确认保存所选课程'}}</t-button>
    </scroll-view></view></view>
</view>
