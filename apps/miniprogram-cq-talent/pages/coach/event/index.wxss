.c2 { min-height: 100vh; background: #f6f7f9; }

/* C2 Top Nav */
.c2-nav { display: flex; align-items: center; justify-content: space-between; height: 176rpx; padding: 28rpx 44rpx; background: #ffffff; }
.c2-nav__left { display: flex; align-items: center; gap: 24rpx; }
.c2-nav__back { color: #202124; font-size: 56rpx; font-weight: 300; line-height: 1; }
.c2-nav__title { color: #202124; font-size: 44rpx; font-weight: 700; }
.c2-nav__action { color: #a80f1b; font-size: 30rpx; font-weight: 600; }

.c2-body { padding: 32rpx 44rpx 64rpx; display: flex; flex-direction: column; gap: 32rpx; }

/* C2 Session Header */
.shero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.25);
}
.shero__title { color: #ffffff; font-size: 32rpx; font-weight: 600; }
.shero__meta { color: rgba(255, 255, 255, 0.7); font-size: 26rpx; }
.shero__timer-row { display: flex; align-items: center; gap: 16rpx; }
.shero__clock { font-size: 40rpx; }
.shero__timer { color: #ffffff; font-size: 104rpx; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
.shero__chips { display: flex; gap: 24rpx; flex-wrap: wrap; }
.shero__chip { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; }
.shero__chip--green { background: rgba(16, 185, 129, 0.1); color: #10b981; }
.shero__chip--gray { background: #e0e2e6; color: #667085; }

/* C2 Attendance Card */
.acard2 {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}
.acard2__head { display: flex; align-items: center; justify-content: space-between; }
.acard2__title { color: #202124; font-size: 28rpx; font-weight: 600; }
.acard2__link { color: #a80f1b; font-size: 28rpx; font-weight: 700; }
.acard2__dots { display: flex; flex-wrap: wrap; gap: 8rpx; }
.acard2__dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #a80f1b;
  border: 4rpx solid #ffffff;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.acard2__dot--off { background: #e0e2e6; color: #667085; }
.acard2__summary { color: #667085; font-size: 24rpx; }

/* 共享类沿用 app.wxss；以下为页内补充 */
.workbench-card { padding: 32rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05); display: flex; flex-direction: column; gap: 16rpx; }
.workbench-card--pending { border: 1rpx solid #fde68a; background: #fffbeb; }
.completion-card__score { color: #a80f1b; font-size: 40rpx; font-weight: 800; }
.roster-count { padding: 8rpx 14rpx; border-radius: 999rpx; background: #f2f4f7; color: #667085; font-size: 21rpx; }
