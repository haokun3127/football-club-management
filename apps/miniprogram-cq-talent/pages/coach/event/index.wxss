.event-workbench { min-height: 100vh; background: #f6f7f9; }
.event-workbench__body { padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }
.workbench-hero { margin-bottom: 20rpx; padding: 30rpx 26rpx; border-radius: 28rpx; background: linear-gradient(145deg,#17191f,#30333b); color: #fff; box-shadow: 0 16rpx 36rpx rgba(16,24,40,.16); }
.event-workbench--match .workbench-hero { background: linear-gradient(145deg,#0f4aa8,#2873e8); }
.workbench-hero__eyebrow { margin-bottom: 10rpx; color: rgba(255,255,255,.62); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.workbench-hero__row { align-items: flex-start; }
.workbench-hero__title { flex: 1; font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.workbench-hero__meta { margin-top: 10rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }
.workbench-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(16,24,40,.04); }
.workbench-card--pending { border-color: #fecdca; background: #fff8f7; }
.completion-card__score { color: #a80f1b; font-size: 34rpx; font-weight: 750; }
.completion-card .section-title,.workbench-card .row .section-title { margin-bottom: 4rpx; }
.action-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; }
.action-tile { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-width: 0; min-height: 82rpx; margin: 0; padding: 0 18rpx; border: 1rpx solid #e7eaf0; border-radius: 18rpx; background: #fff; color: #202124; font-size: 25rpx; font-weight: 650; line-height: 1; }
.action-tile--primary { border-color: #f7cdd1; background: #fceeef; color: #a80f1b; }
.action-tile--match { border-color: #b2ddff; background: #eff8ff; color: #175cd3; }
.action-tile__icon { display: inline-flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 12rpx; border-radius: 12rpx; background: currentColor; color: #fff; font-size: 21rpx; }
.roster-count { color: #a80f1b; font-size: 24rpx; font-weight: 700; }
