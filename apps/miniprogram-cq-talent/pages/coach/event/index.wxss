.c2 { min-height: 100vh; background: #f6f7f9; }

.c2-body { display: flex; flex-direction: column; gap: 24rpx; padding: 16rpx 44rpx calc(180rpx + env(safe-area-inset-bottom)); }
.workbench-card { display: flex; flex-direction: column; gap: 24rpx; padding: 32rpx; border: 0; border-radius: 24rpx; background: #ffffff; box-shadow:none; }
.workbench-card--pending { border-color: #fde68a; background: #fffbeb; }
.section-title { color: #202124; font-size: var(--font-size-section); font-weight: 700; line-height: 1.5; }
.subtitle { color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }
.row, .field-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-width: 0; }
.field-row { min-height: 56rpx; padding-top: 12rpx; border-top: 1rpx solid #f0f1f3; }
.label { min-width: 0; overflow: hidden; color: #344054; font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.field-value { flex: 0 1 auto; max-width: 56%; overflow: hidden; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.roster-count { flex: 0 0 auto; padding: 6rpx 12rpx; border-radius: 8rpx; background: #f2f4f7; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; }

.action-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24rpx; }
.action-tile { display: flex; box-sizing: border-box; width: 100%; min-width: 0; min-height: 200rpx; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; margin: 0; padding: 16rpx 8rpx; border: 0; border-radius: 24rpx; background: #ffffff; box-shadow:none; color: #202124; }
.action-tile__icon { width: 56rpx; height: 56rpx; }
.action-tile__glyph { color: #a80f1b; font-size: 48rpx; font-weight: 700; line-height: 56rpx; text-align: center; }
.action-tile__label { max-width: 100%; overflow: hidden; font-size: var(--font-size-aux); font-weight: 500; line-height: 1.5; text-align: center; text-overflow: ellipsis; white-space: nowrap; }

.roster-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24rpx 16rpx; margin-top: 8rpx; }
.roster-person { display: flex; min-width: 0; flex-direction: column; align-items: center; }
.roster-avatar { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; font-size: var(--font-size-body); font-weight: 700; }
.roster-avatar--present { background: #10b981; color: #ffffff; }
.roster-avatar--absent { background: #e5e7eb; color: #667085; }
.roster-avatar__check { display: block; width: 44rpx; height: 44rpx; }
.roster-avatar__initial { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.roster-name { width: 100%; min-width: 96rpx; margin-top: 10rpx; overflow: hidden; color: #202124; font-size: var(--font-size-aux); line-height: 1.5; text-align: center; text-overflow: ellipsis; white-space: normal; }
.attendance-error { padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff1f2; color: #b42318; font-size: var(--font-size-aux); line-height: 1.5; }
.training-card__summary { overflow: hidden; color: #667085; font-size: var(--font-size-aux); line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.training-card__edit { flex: 0 0 auto; color: #a80f1b; font-size: var(--font-size-aux); font-weight: 700; line-height: 1.5; }

.training-content-group { margin-top:24rpx; }
.training-content-group__title { color:#697386;font-size: var(--font-size-section);font-weight:600;margin-bottom:10rpx; }
.training-content-item { display:flex;justify-content:space-between;gap:20rpx;padding:10rpx 0;font-size: var(--font-size-body);line-height: 1.5; }
.training-content-item__minutes { flex-shrink:0;color:#697386;font-size: var(--font-size-aux); }
.training-content-total { margin-top:18rpx;color:#697386;font-size: var(--font-size-aux); }
.training-content-expand { margin-top:18rpx;color:#a80f1b;background:#fff1f2; }

.training-tools { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }
.training-tools button { font-size: var(--font-size-aux); color:#a80f1b; background:#fff5f5; margin:0; padding:12rpx 18rpx; min-width:0; width:auto; }
.transfer-mask { position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:200; display:flex; align-items:flex-end; }
.transfer-sheet { width:100%; padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:28rpx 28rpx 0 0; background:#fff; }
.transfer-head { display:flex; align-items:center; justify-content:space-between; font-size: var(--font-size-body); font-weight:700; margin-bottom:20rpx; }
.transfer-head button { width:auto; margin:0; min-width:0; font-size: var(--font-size-aux); }
.transfer-scroll { max-height:70vh; height:70vh; }
.transfer-item,.transfer-target { padding:20rpx 0; border-bottom:1rpx solid #eee; font-size: var(--font-size-body); }
.transfer-hint { font-size: var(--font-size-aux); color:#667085; line-height:1.6; margin-top:8rpx; }
.transfer-title { font-size: var(--font-size-section); font-weight:600; margin-top:12rpx; }
.transfer-input { margin:24rpx 0; padding:20rpx; background:#f6f7f9; border-radius:12rpx; }
.transfer-message { color:#667085; font-size: var(--font-size-aux); margin:24rpx 0; line-height:1.6; }
.transfer-primary,.transfer-selected { background:#a80f1b; color:#fff; }
.transfer-target button { margin-top:16rpx; font-size: var(--font-size-aux); }

/* Approved Figma C03 · bright club V2. Match workbench keeps its existing flow. */
.club-workbench { background:var(--club-page); }
.club-workbench .c2-body { gap:20rpx;padding:32rpx 32rpx calc(166rpx + env(safe-area-inset-bottom)); }
.club-workbench .workbench-card { gap:10rpx;padding:24rpx;border:1rpx solid var(--club-line);border-radius:28rpx;box-shadow:none; }
.club-workbench .section-title { color:var(--club-muted);font-size: var(--font-size-section);line-height: 1.5; }
.attendance-links { display:flex;gap:32rpx;font-size: var(--font-size-aux);color:var(--color-brand);line-height: 1.5; }
.club-workbench .training-content-group { margin-top:8rpx; }
.club-workbench .training-content-item { font-size: var(--font-size-aux);line-height: 1.5;padding:4rpx 0; }
.club-workbench .training-tools { margin-top:8rpx; }
.club-workbench .training-tools button { font-size: var(--font-size-aux);padding:4rpx 10rpx;line-height: 1.5; }
.club-workbench .course-assessment { background:var(--color-warning-soft);box-shadow:none; }
.course-task { font-size: var(--font-size-aux);color:var(--color-text-secondary);line-height: 1.5;padding:4rpx 0; }
/* 移动端触控下限。 */
.roster-person, .action-tile, .course-task { min-height:44px; min-width:44px; box-sizing:border-box; }

/* Classroom execution: content first; roster exceptions are read-only links. */
.club-workbench .course-info .section-title { color:var(--color-text); font-size:var(--font-size-display); font-weight:600; }
.club-workbench .section-title { color:var(--color-text); }
.club-workbench .course-assessment { background:var(--color-card); }
.exception-row { display:flex; justify-content:space-between; align-items:center; gap:12px; min-height:44px; border-top:1px solid var(--color-line); font-size:var(--font-size-body); }
.club-workbench .training-card__edit { min-height:44px; display:flex; align-items:center; }
