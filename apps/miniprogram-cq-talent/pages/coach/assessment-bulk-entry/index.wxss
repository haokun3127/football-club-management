.bulk-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 232rpx; background: #f6f7f9; color: #202124; }
.bulk-nav { position: sticky; top: 0; z-index: 100; display: flex; box-sizing: content-box; height: 88rpx; align-items: center; padding: 0 32rpx; background: #ffffff; }
.bulk-nav__back { display: flex; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; }
.bulk-nav__back image { width: 48rpx; height: 48rpx; }
.bulk-nav__title { min-width: 0; flex: 1; margin-left: 20rpx; overflow: hidden; font-size: 36rpx; font-weight: 700; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.bulk-body { padding: 16rpx 32rpx 48rpx; }
.bulk-context-line { margin: 2rpx 0 20rpx; color: #667085; font-size: 24rpx; line-height: 34rpx; }
.bulk-summary { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; padding: 24rpx 32rpx; border-radius: 28rpx; background: #ffffff; }
.bulk-summary__count { color: #202124; font-size: 30rpx; font-weight: 700; line-height: 40rpx; }
.bulk-summary__rule { flex: 0 0 auto; margin-left: 16rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: #edf4ff; color: #3971ba; font-size: 22rpx; line-height: 30rpx; }
.bulk-row { display: flex; min-height: 112rpx; align-items: center; margin-top: 16rpx; padding: 20rpx 24rpx; border-radius: 28rpx; background: #ffffff; }
.bulk-row__identity { display: flex; min-width: 0; align-items: center; }
.bulk-row__avatar { display: flex; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 50%; background: #fce7e7; color: #a80f1b; font-size: 26rpx; font-weight: 700; }
.bulk-row__name { margin-left: 16rpx; overflow: hidden; font-size: 30rpx; font-weight: 700; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.bulk-row__metrics { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: stretch; margin-left: 20rpx; }
.bulk-metric { display: flex; min-height: 64rpx; align-items: center; border-bottom: 2rpx solid #dbe1eb; }
.bulk-metric--readonly { border-bottom: 0; }
.bulk-metric:last-child { border-bottom: 0; }
.bulk-metric__input { min-width: 0; flex: 1; color: #202124; font-size: 28rpx; font-weight: 700; line-height: 36rpx; text-align: right; }
.bulk-metric__readonly { min-width: 0; flex: 1; color: #202124; font-size: 28rpx; font-weight: 700; line-height: 36rpx; }
.bulk-metric__unit { flex: 0 0 auto; margin-left: 8rpx; color: #667085; font-size: 23rpx; }
.bulk-metric__score { flex: 0 0 76rpx; margin-left: 16rpx; overflow: hidden; color: #667085; font-size: 22rpx; line-height: 34rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.bulk-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 110; box-sizing: border-box; padding: 12rpx 32rpx 24rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 -8rpx 24rpx rgba(32, 33, 36, .08); }
.bulk-actions__hint { color: #667085; font-size: 22rpx; line-height: 30rpx; text-align: center; }
.bulk-actions__buttons { display: flex; gap: 16rpx; margin-top: 12rpx; }
.bulk-actions__primary, .bulk-actions__secondary { display: flex; height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 44rpx; font-size: 28rpx; font-weight: 700; }
.bulk-actions__primary { flex: 1; background: #a80f1b; color: #ffffff; }
.bulk-actions__primary--disabled { opacity: .58; }
.bulk-actions__secondary { flex: 1; background: #fff0f1; color: #a80f1b; }
.bulk-actions__secondary--disabled { background: #e6ebf2; color: #4f5e73; }
