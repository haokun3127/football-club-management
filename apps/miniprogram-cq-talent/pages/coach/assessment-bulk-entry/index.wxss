.bulk-page { min-height:100vh; box-sizing:border-box; background:var(--color-page); color:var(--color-text); }
.bulk-body { padding:16px var(--spacing-page) calc(156px + env(safe-area-inset-bottom)); }
.bulk-title { font-size:var(--font-size-display); font-weight:600; line-height:1.5; }
.bulk-context-line { margin:8px 0 16px; color:var(--color-text-secondary); font-size:var(--font-size-aux); line-height:1.5; }
.bulk-summary { padding:16px; background:var(--color-card); border-radius:var(--radius-card); }
.bulk-summary__count { font-size:var(--font-size-body); font-weight:600; line-height:1.5; }
.bulk-summary__rule,.bulk-course-hint { margin-top:8px; color:var(--color-text-secondary); font-size:var(--font-size-aux); line-height:1.5; }
.bulk-workflow { margin:16px 0; font-size:var(--font-size-body); }
.bulk-course-bar { margin:16px 0; padding:12px; border:1px solid var(--color-line); background:var(--color-card); border-radius:var(--radius-button); }
.bulk-course-choice { display:flex; align-items:center; min-height:44px; font-size:var(--font-size-body); color:var(--color-brand); }
.bulk-row { margin-top:16px; padding:12px; border:1px solid var(--color-line); border-radius:var(--radius-card); background:var(--color-card); }
.bulk-row__identity { display:flex; align-items:center; gap:8px; min-height:44px; border-bottom:1px solid var(--color-line); }
.bulk-row__name { min-width:0; flex:1; font-size:var(--font-size-body); font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.bulk-row__status { color:var(--color-text-secondary); font-size:var(--font-size-aux); line-height:1.5; }
.bulk-metric { padding-top:12px; }
.bulk-metric__label { margin-bottom:8px; font-size:var(--font-size-aux); line-height:1.5; color:var(--color-text-secondary); }
.bulk-metric__readonly { padding:12px; background:var(--color-page); border-radius:var(--radius-button); font-size:var(--font-size-body); line-height:1.5; }
.bulk-metric__course { display:flex; align-items:center; min-height:44px; margin-top:4px; color:var(--color-brand); font-size:var(--font-size-aux); line-height:1.5; overflow-wrap:anywhere; }
.bulk-workflow__error,.bulk-metric__error { color:var(--color-error); font-size:var(--font-size-aux); line-height:1.5; padding:8px 0; }
.bulk-history-mask { position:fixed; inset:0; z-index:200; background:rgba(0,0,0,.4); display:flex; align-items:center; padding:16px; }
.bulk-history-panel { width:100%; background:var(--color-card); border-radius:var(--radius-card); padding:16px; }
.bulk-history-head { display:flex; align-items:center; justify-content:space-between; font-size:var(--font-size-body); }
.bulk-history-scroll { height:60vh; }
.bulk-history-item { white-space:pre-wrap; font-size:var(--font-size-aux); line-height:1.7; padding:12px 0; border-bottom:1px solid var(--color-line); overflow-wrap:anywhere; }

.bulk-row--active { border-color: var(--color-brand); }
.bulk-focus { padding: 12px 0 0; font-size: var(--font-size-body); line-height: 1.5; color: var(--color-brand); overflow-wrap: anywhere; }
.bulk-row__status { flex-shrink: 0; }
