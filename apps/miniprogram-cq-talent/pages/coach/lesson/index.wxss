.lesson-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.lesson-hero { margin-bottom: 20rpx; padding: 28rpx 24rpx; border-radius: 28rpx; background: linear-gradient(145deg,#8f0d18,#c41725); color: #fff; }
.lesson-hero .title { color: #fff; }
.lesson-hero__eyebrow { margin-bottom: 8rpx; color: rgba(255,255,255,.66); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.lesson-hero__hint { margin-top: 10rpx; color: rgba(255,255,255,.76); font-size: 23rpx; }
.lesson-list-card { padding-top: 18rpx; }
.lesson-note-card { margin-bottom: 30rpx; }

.lesson-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.lesson-row:last-child {
  border-bottom: 0;
}

.lesson-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.strong {
  color: #1f2329;
  font-weight: 700;
}

.consume-toggle {
  min-width: 118rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
}

.consume-toggle.on {
  background: #fceeef;
  color: var(--color-brand);
}

.consume-toggle.off {
  background: #fff7e6;
  color: #ad6800;
}

.reason-input,
.lesson-note {
  width: 100%;
  min-height: 68rpx;
  margin-top: 14rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  font-size: 24rpx;
}

.lesson-note {
  min-height: 120rpx;
}

.correction-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.correction-actions button {
  margin-top: 0;
}

.lesson-correction-link {
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-brand);
}
