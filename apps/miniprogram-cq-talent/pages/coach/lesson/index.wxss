.c5 {
  min-height: 100vh;
  background: #f6f7f9;
}

.c5-body {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding: 44rpx 44rpx calc(400rpx + env(safe-area-inset-bottom));
}

.c5-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
}

.c5-hero__title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.c5-hero__meta {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  line-height: 32rpx;
}

.c5-hero__meta-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.c5-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
}

.c5-list__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #e7eaf0;
}

.c5-list__title,
.section-title {
  color: #202124;
  font-size: 28rpx;
  font-weight: 600;
}

.c5-list__count {
  color: #667085;
  font-size: 24rpx;
}

.c5-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-bottom: 1rpx solid #e7eaf0;
}

.c5-row:last-child {
  border-bottom: 0;
}

.c5-row__avatar {
  display: flex;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #f3f4f6;
  color: #202124;
  font-size: 22rpx;
  font-weight: 600;
}

.c5-row__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #202124;
  font-size: 28rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c5-chip {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #dcfce7;
  color: #188754;
  font-size: 24rpx;
  font-weight: 600;
}

.submit-error {
  padding: 20rpx 24rpx;
  border: 1rpx solid #fecaca;
  border-radius: 16rpx;
  background: #fff1f2;
  color: #b42318;
  font-size: 24rpx;
  line-height: 34rpx;
}

.c5-confirm-bar {
  position: fixed;
  right: 0;
  bottom: 140rpx;
  left: 0;
  z-index: 50;
  box-sizing: border-box;
  padding: 44rpx;
  background: rgba(246, 247, 249, 0.98);
}

.c5-confirm-bar__button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  border-radius: 24rpx;
  background: #a80f1b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.c5-confirm-bar__button--disabled {
  opacity: 0.72;
}

.c5-confirm-bar__correction {
  margin-top: 24rpx;
  color: #a80f1b;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 34rpx;
  text-align: center;
  text-decoration: underline;
}
