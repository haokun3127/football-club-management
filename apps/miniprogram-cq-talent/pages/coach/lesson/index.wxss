 .history-page { min-height:100vh; background:var(--color-page); color:var(--color-text); }
.history-page__body { padding:16px var(--spacing-page) calc(112px + env(safe-area-inset-bottom)); }
.record-summary { margin-bottom:16px; font-size:var(--font-size-aux); color:var(--color-text-secondary); line-height:1.5; }
.record-filters { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; margin:12px 0; }
.record { display:grid; grid-template-columns:minmax(0,1fr) 112px; align-items:center; gap:8px; padding:12px; background:var(--color-card); border-bottom:1px solid var(--color-line); }
.record:first-of-type { border-radius:var(--radius-card) var(--radius-card) 0 0; }
.record-main { min-width:0; }
.record-title { font-size:var(--font-size-body); font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.record-state { margin-top:4px; color:var(--color-text-secondary); font-size:var(--font-size-aux); line-height:1.5; }
.record-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:center; }
.record-action { min-width:0; }
.record-filter { min-width:0; }
.record-history { grid-column:1 / -1; width:100%; margin-top:8px; font-size:var(--font-size-aux); color:var(--color-text-secondary); line-height:1.6; overflow-wrap:anywhere; }
.record-history > view { padding:8px 0; }
.record-field { margin-bottom:20px; font-size:var(--font-size-body); color:var(--color-text-secondary); }
.record-input { box-sizing:border-box; margin-top:8px; padding:12px; min-height:48px; border:1px solid var(--color-line); border-radius:var(--radius-button); background:var(--color-card); color:var(--color-text); font-size:var(--font-size-body); line-height:1.5; }
.record-toggle { display:flex; justify-content:space-between; align-items:center; }
.record-reason { width:100%; }
.record-info { padding:12px; background:var(--color-info-soft); color:var(--color-info); font-size:var(--font-size-aux); line-height:1.5; border-radius:var(--radius-button); }
.editor-error { color:var(--color-error); font-size:var(--font-size-body); line-height:1.5; margin:12px 0; }
