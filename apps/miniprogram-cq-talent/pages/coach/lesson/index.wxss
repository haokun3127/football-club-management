.history-page { min-height:100vh;background:var(--club-page);color:var(--club-text); }
.page-nav { position:sticky;top:0;z-index:100;height:88rpx;box-sizing:content-box;display:flex;align-items:center;padding-left:32rpx;background:var(--club-nav); }
.page-nav__back { width:40rpx;font-size:40rpx; }
.page-nav__title { font-size:32rpx;font-weight:500; }
.history-page__body { padding:32rpx 32rpx calc(166rpx + env(safe-area-inset-bottom)); }
.record-summary { color:var(--color-text-secondary);font-size:26rpx;line-height:40rpx;margin-bottom:24rpx; }
.record { box-sizing:border-box;min-height:320rpx;margin-bottom:32rpx;padding:32rpx;border:1rpx solid var(--club-line);border-radius:28rpx;background:#fff;box-shadow:var(--club-shadow); }
.record-title { font-size:32rpx;font-weight:500;line-height:48rpx; }
.record-state { margin-top:16rpx;color:var(--color-text-secondary);font-size:30rpx;line-height:48rpx; }
.record-actions,.record-filters { display:flex;gap:24rpx; }
.record-actions button,.record-filters button { width:auto;min-width:0;margin:0;padding:12rpx 0;background:transparent;color:var(--color-brand);font-size:26rpx;line-height:40rpx; }
.record-filters { margin-bottom:24rpx; }
.record-filters button { color:var(--club-muted); }
.record-filters button.selected { color:var(--color-brand);border-bottom:2rpx solid var(--color-brand); }
.record-history { margin-top:24rpx;font-size:24rpx;color:var(--color-text-secondary);line-height:40rpx;overflow-wrap:anywhere; }
.record-field { margin-bottom:64rpx;font-size:26rpx;color:var(--club-muted); }
.record-input { box-sizing:border-box;margin-top:16rpx;padding:24rpx;min-height:96rpx;border:1rpx solid var(--color-line);border-radius:16rpx;background:#fff;font-size:30rpx;line-height:48rpx; }
.record-toggle { display:flex;justify-content:space-between;align-items:center; }
.record-reason { width:100%;height:112rpx; }
.record-info { padding:24rpx;background:var(--color-info-soft);color:var(--color-info);font-size:24rpx;line-height:36rpx;border-radius:16rpx; }
.editor-error { color:var(--color-error);font-size:26rpx;line-height:40rpx;margin:24rpx 0; }
.record-footer { position:fixed;bottom:0;left:0;right:0;padding:16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));background:var(--club-nav); }
.record-footer .record-primary { width:100%;height:96rpx;padding:0;background:var(--color-brand);color:#fff;border-radius:16rpx;font-size:32rpx;line-height:96rpx; }
