<view class="c5">
  <app-header theme="soft" title="销课处理" title-align="left" show-back />

  <view class="c5-body">
    <status-view wx:if="{{state !== 'ready' && state !== 'idle'}}" state="{{state}}" title="销课处理" message="{{message}}" action-text="{{retryLabel}}" bindaction="retry" />

    <block wx:if="{{state === 'ready' && hasRoster}}">
      <view class="c5-hero">
        <view class="c5-hero__title">待处理销课</view>
        <view class="c5-hero__meta-group">
          <view class="c5-hero__meta" wx:if="{{hasEventTeam}}">{{eventTeam}} · {{eventDate}}</view>
          <view class="c5-hero__meta" wx:else>{{eventDate}}</view>
          <view class="c5-hero__meta" wx:if="{{hasVenue}}">{{eventTime}} · {{eventVenue}}</view>
          <view class="c5-hero__meta" wx:else>{{eventTime}}</view>
        </view>
      </view>

      <view class="c5-list">
        <view class="c5-list__head">
          <view class="c5-list__title">待确认学员</view>
          <view class="c5-list__count">{{rosterCount}} 人待处理</view>
        </view>
        <view wx:for="{{roster}}" wx:key="studentId" class="c5-row">
          <view class="c5-row__avatar">{{item.avatarLetter}}</view>
          <view class="c5-row__name">{{item.name}}</view>
          <view class="c5-chip">{{item.lessonAmountText}}</view>
        </view>
      </view>

      <view wx:if="{{hasSubmitError}}" class="submit-error">{{submitError}}</view>
      <view class="c5-history-link" bindtap="openHistory">查看历史销课</view>
    </block>
  </view>

  <view wx:if="{{state === 'ready' && hasRoster}}" class="c5-confirm-bar">
    <view wx:if="{{saving}}" class="c5-confirm-bar__button c5-confirm-bar__button--disabled">确认中...</view>
    <view wx:else class="c5-confirm-bar__button" bindtap="confirmLesson">确认全部</view>
    <view class="c5-confirm-bar__correction" bindtap="openCorrection">发起更正</view>
  </view>

  <role-tabbar role="coach" active="schedule" />
</view>
