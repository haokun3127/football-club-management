<view class="page">
  <status-view state="{{state}}" title="销课确认" message="{{message}}" />
  <view wx:if="{{workbench}}" class="card hero-card">
    <view class="title">销课确认</view>
    <view class="subtitle">默认全员销课，教练只处理不销课或需纠正学员</view>
  </view>
  <view wx:if="{{workbench}}" class="card">
    <view class="section-title">学员销课状态</view>
    <view wx:for="{{workbench.roster}}" wx:key="studentId" class="lesson-row">
      <view class="lesson-main">
        <view>
          <view class="label strong">{{item.name}}</view>
          <view class="subtitle">余额：{{item.remainingLessons === undefined ? '待同步' : item.remainingLessons}}</view>
        </view>
        <view class="consume-toggle {{item.shouldConsume === false ? 'off' : 'on'}}" data-student-id="{{item.studentId}}" bindtap="toggleConsume">
          {{item.shouldConsume === false ? '不销课' : '销课'}}
        </view>
      </view>
      <input
        wx:if="{{item.shouldConsume === false}}"
        class="reason-input"
        placeholder="填写不销课原因，如请假、免扣、未到场"
        value="{{item.exceptionReason}}"
        data-student-id="{{item.studentId}}"
        bindinput="onReasonInput"
      />
      <view class="correction-actions">
        <button
          class="ghost-button mini-button"
          loading="{{correctingStudentId === item.studentId}}"
          disabled="{{!!correctingStudentId}}"
          data-student-id="{{item.studentId}}"
          data-delta="{{1}}"
          bindtap="correctLesson"
        >返还</button>
        <button
          class="ghost-button mini-button"
          loading="{{correctingStudentId === item.studentId}}"
          disabled="{{!!correctingStudentId}}"
          data-student-id="{{item.studentId}}"
          data-delta="{{-1}}"
          bindtap="correctLesson"
        >补扣</button>
      </view>
    </view>
  </view>
  <view wx:if="{{workbench}}" class="card">
    <view class="section-title">确认与纠正</view>
    <view class="subtitle">默认按本次出勤确认课时；余额暂未更新时仍可提交。如需返还或补扣，请在保存后发起课时调整。</view>
    <textarea class="lesson-note" placeholder="本次销课备注，可选" value="{{lessonNote}}" bindinput="onLessonNoteInput" />
    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="confirmLesson">确认销课</button>
  </view>
</view>
