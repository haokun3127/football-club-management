.field-value {
  max-width: 430rpx;
}
.coach-profile { display: flex; align-items: center; gap: 22rpx; margin-bottom: 20rpx; padding: 30rpx 26rpx; border-radius: 28rpx; background: linear-gradient(145deg,#8f0d18,#c41725); color: #fff; }
.coach-profile .title { color: #fff; }
.coach-profile__avatar { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border: 2rpx solid rgba(255,255,255,.35); border-radius: 50%; background: rgba(255,255,255,.14); font-size: 40rpx; font-weight: 700; }
.coach-profile__eyebrow { color: rgba(255,255,255,.6); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.coach-profile__meta { margin-top: 6rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }
.scope-card { position: relative; }
.scope-card .tag { position: absolute; top: 22rpx; right: 22rpx; }
.scope-card__teams { margin-top: 8rpx; line-height: 1.8; }
.permission-card { border-top: 6rpx solid var(--color-brand); }
.service-card { background: #fff8f7; }
