.field-value {
  max-width: 430rpx;
}
.coach-profile { display: flex; align-items: center; gap: 22rpx; margin-bottom: 20rpx; padding: 30rpx 26rpx; border-radius: 28rpx; background: linear-gradient(145deg,#8f0d18,#c41725); color: #fff; }
.coach-profile .title { color: #fff; }
.coach-profile__avatar { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border: 2rpx solid rgba(255,255,255,.35); border-radius: 50%; background: rgba(255,255,255,.14); font-size: 40rpx; font-weight: 700; }
.coach-profile__eyebrow { color: rgba(255,255,255,.6); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.coach-profile__meta { margin-top: 6rpx; color: rgba(255,255,255,.72); font-size: 23rpx; }
.scope-card { position: relative; }
.scope-card .tag { position: absolute; top: 22rpx; right: 22rpx; }
.scope-card__teams { margin-top: 8rpx; line-height: 1.8; }
.permission-card { border-top: 6rpx solid var(--color-brand); }
.service-card { background: #fff8f7; }

/* C16 TopBar + profile-hero */
.c16 { min-height: 100vh; background: #f6f7f9; }
.c16-bar { display: flex; align-items: center; justify-content: space-between; height: 176rpx; padding: 28rpx 44rpx; background: #fceeef; }
.c16-bar__title { color: #202124; font-size: 44rpx; font-weight: 700; }
.c16-bar__settings { color: #202124; font-size: 40rpx; }
.c16-body { padding-top: 32rpx; }
.c16-hero { display: flex; gap: 24rpx; padding: 40rpx; border-radius: 24rpx; background: #07111f; margin-bottom: 32rpx; }
.c16-hero__avatar { width: 120rpx; height: 120rpx; border-radius: 60rpx; background: #a80f1b; color: #ffffff; font-size: 40rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.c16-hero__info { display: flex; flex-direction: column; gap: 8rpx; }
.c16-hero__name { color: #ffffff; font-size: 40rpx; font-weight: 700; }
.c16-hero__meta { color: rgba(255, 255, 255, 0.6); font-size: 26rpx; }
.c16-hero__teams { margin-top: 8rpx; align-self: flex-start; padding: 6rpx 16rpx; border-radius: 8rpx; background: rgba(255, 255, 255, 0.1); color: #ffffff; font-size: 22rpx; }
/* custom navigation: keep Figma 88px total height inclusive of safe area */
.c16-bar { box-sizing: border-box; }
