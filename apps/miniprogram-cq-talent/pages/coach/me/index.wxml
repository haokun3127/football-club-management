<view class="page">
  <view class="card hero-card">
    <view class="title">{{displayName}}</view>
    <view class="subtitle">身份、负责球队、权限范围和账号绑定</view>
  </view>

  <status-view
    state="{{state}}"
    title="{{state === 'loading' ? '加载教练身份' : '教练身份读取失败'}}"
    message="{{message}}"
    action-text="{{state === 'error' ? '重试' : ''}}"
    bindaction="retry"
  />

  <view wx:if="{{home}}" class="card">
    <view class="section-title">负责球队</view>
    <view class="subtitle">{{teamsText}}</view>
  </view>

  <view class="card">
    <view class="section-title">权限范围</view>
    <view class="field-row"><view class="label">可读</view><view class="field-value">负责活动、球队、学员训练交付数据</view></view>
    <view class="field-row"><view class="label">可写</view><view class="field-value">点名、销课、比赛、训练内容、评测，需 BFF 授权</view></view>
    <view class="field-row"><view class="label">不可见</view><view class="field-value">收费、保险审核、后台运营和 WPS 配置</view></view>
  </view>

  <view class="card">
    <view class="section-title">私教意向提醒</view>
    <view class="subtitle">提醒接口待接入；只展示家长意向，不做订单、支付或派单。</view>
  </view>

  <view class="card">
    <view class="section-title">账号绑定</view>
    <view class="subtitle">微信绑定、手机号匹配、最近登录依赖登录 BFF；当前为可联调结构。</view>
  </view>

  <role-tabbar role="coach" active="me" />
</view>
