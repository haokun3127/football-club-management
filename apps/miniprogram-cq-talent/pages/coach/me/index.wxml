<view class="c16">
  <view class="c16-bar" style="padding-top:{{navInset}}px"><view class="c16-bar__title">我的</view><view class="c16-bar__settings" bindtap="openAccount">设置</view></view>
  <view class="c16-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载教练身份' : '教练身份读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="retry" />
    <view wx:if="{{home}}" class="c16-content">
      <!-- Figma C16 profile hero -->
      <view class="c16-profile"><view class="c16-profile__top"><view class="c16-profile__avatar">{{avatarLetter}}</view><view><view class="c16-profile__name">{{displayName}}</view><view class="c16-profile__badge">主教练</view><view class="c16-profile__team">{{teamsText}}</view></view></view><view class="c16-profile__stats"><view><view>本赛季执教</view><view class="c16-profile__number">{{home.events.length}}</view></view><view><view>在队学员</view><view class="c16-profile__number">{{home.teams.length}}</view></view><view><view>平均出勤</view><view class="c16-profile__number">数据待同步</view></view></view></view>
      <!-- Figma C16 menu -->
      <view class="c16-menu"><view class="c16-menu__item" bindtap="openPermissions"><view class="c16-menu__icon">权</view><view>权限范围</view><view class="c16-menu__arrow">›</view></view><view class="c16-menu__item" bindtap="openPrivateInterest"><view class="c16-menu__icon">私</view><view>私教兴趣</view><view class="c16-menu__arrow">›</view></view><view class="c16-menu__item" bindtap="openAccount"><view class="c16-menu__icon">账</view><view>账号设置</view><view class="c16-menu__arrow">›</view></view><view class="c16-menu__item" bindtap="openHelp"><view class="c16-menu__icon">帮</view><view>帮助中心</view><view class="c16-menu__arrow">›</view></view></view>
    </view>
  </view>
  <role-tabbar role="coach" active="me" />
</view>
