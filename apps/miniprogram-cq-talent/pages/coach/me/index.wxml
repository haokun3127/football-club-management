<view class="c16">
  <view class="c16-bar" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="c16-bar__title">我的</view>
    <view class="c16-bar__settings" bindtap="openAccount">
      <image class="c16-bar__settings-icon" src="/assets/icons/c16-settings.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="c16-body">
    <status-view
      wx:if="{{state !== 'ready'}}"
      state="{{state}}"
      title="{{state === 'loading' ? '加载教练身份' : '教练身份读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <view wx:if="{{state === 'ready'}}" class="c16-content">
      <view class="c16-profile">
        <view class="c16-profile__top">
          <view class="c16-profile__avatar">{{avatarLetter}}</view>
          <view class="c16-profile__identity">
            <view class="c16-profile__name">{{displayName}}</view>
            <view class="c16-profile__role">教练</view>
            <view class="c16-profile__team">{{teamsText}}</view>
          </view>
        </view>
        <view class="c16-profile__stats">
          <view wx:for="{{profileStats}}" wx:key="label" class="c16-profile__stat">
            <view class="c16-profile__stat-label">{{item.label}}</view>
            <view class="c16-profile__stat-value">{{item.value}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{canSwitchToParent}}" class="c16-role-switch" bindtap="switchToParent">
        <view class="c16-role-switch__identity"><view class="c16-role-switch__label">当前身份</view><view class="c16-role-switch__role">教练端</view></view>
        <view class="c16-role-switch__action">切换 ›</view>
      </view>

      <view class="c16-menu">
        <view class="c16-menu__item" bindtap="openPermissions">
          <image class="c16-menu__icon" src="/assets/icons/c16-shield.svg" mode="aspectFit" />
          <view class="c16-menu__label">权限范围</view>
          <image class="c16-menu__arrow" src="/assets/icons/c16-chevron-right.svg" mode="aspectFit" />
        </view>
        <view class="c16-menu__item" bindtap="openPrivateInterest">
          <image class="c16-menu__icon" src="/assets/icons/c16-heart.svg" mode="aspectFit" />
          <view class="c16-menu__label">私教兴趣</view>
          <image class="c16-menu__arrow" src="/assets/icons/c16-chevron-right.svg" mode="aspectFit" />
        </view>
        <view class="c16-menu__item" bindtap="openAccount">
          <image class="c16-menu__icon" src="/assets/icons/c16-user.svg" mode="aspectFit" />
          <view class="c16-menu__label">账号设置</view>
          <image class="c16-menu__arrow" src="/assets/icons/c16-chevron-right.svg" mode="aspectFit" />
        </view>
        <view class="c16-menu__item" bindtap="openHelp">
          <image class="c16-menu__icon" src="/assets/icons/c16-help-circle.svg" mode="aspectFit" />
          <view class="c16-menu__label">帮助中心</view>
          <image class="c16-menu__arrow" src="/assets/icons/c16-chevron-right.svg" mode="aspectFit" />
        </view>
      </view>

      <button class="c16-logout" bindtap="logout">退出登录</button>
    </view>
  </view>

  <role-tabbar role="coach" active="me" />
</view>
