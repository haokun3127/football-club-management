<view class="attendance-page">
  <app-header title="{{correctionMode ? '出勤修改' : '活动点名'}}" show-back="{{true}}" />
  <view class="attendance-page__body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '正在读取名单' : state === 'empty' ? '暂无学员' : '名单读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重新加载' : ''}}" bindaction="retry" />

    <!-- C4.2 家长异议警示卡 -->
    <view wx:if="{{correctionMode && workbench}}" class="correction-alert">
      <view class="correction-alert__icon">⚠</view>
      <view class="correction-alert__texts">
        <view class="correction-alert__title">出勤记录需要修改</view>
        <view class="correction-alert__text">家长对出勤记录提出异议，请核实后重新提交（共 {{disputedCount}} 条异常）</view>
      </view>
    </view>

    <view wx:if="{{workbench}}" class="event-head">
      <view class="event-head__eyebrow">本次活动</view>
      <view class="event-head__title">{{workbench.event.title}}</view>
      <view class="event-head__meta">{{workbench.event.startsAt}} · {{workbench.event.venue}}</view>
    </view>

    <view wx:if="{{workbench && workbench.roster.length}}" class="summary-grid">
      <view class="summary-item"><view class="summary-item__value">{{summary.total}}</view><view class="summary-item__label">应到</view></view>
      <view class="summary-item summary-item--success"><view class="summary-item__value">{{summary.present}}</view><view class="summary-item__label">到课</view></view>
      <view class="summary-item summary-item--warning"><view class="summary-item__value">{{summary.attention}}</view><view class="summary-item__label">待确认</view></view>
    </view>

    <view wx:if="{{workbench && workbench.roster.length}}" class="roster-card">
      <view class="roster-head">
        <view><view class="section-title">学员名单</view><view class="subtitle">逐一确认状态，必要时补充说明</view></view>
        <button class="batch-button" bindtap="markAllPresent">全部到课</button>
      </view>
      <view wx:for="{{workbench.roster}}" wx:key="studentId" class="attendance-row">
        <view class="attendance-main">
          <view class="student-info"><view class="student-avatar">{{item.avatarLetter}}</view><view><view class="student-name">{{item.name}}</view><view class="lesson-state">{{item.lessonAction || '课时状态待确认'}}</view></view></view>
          <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{item.statusIndex}}" data-index="{{index}}" bindchange="onStatusChange">
            <status-chip label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
          </picker>
        </view>
        <input class="note-input" placeholder="补充迟到、请假等说明（选填）" value="{{item.note}}" data-index="{{index}}" bindinput="onNoteInput" />
      </view>
    </view>
  </view>
  <submit-bar wx:if="{{workbench && workbench.roster.length}}" primary-text="保存点名" hint="保存失败时，本页填写内容会保留" loading="{{saving}}" bindsubmit="saveAttendance" />
</view>
