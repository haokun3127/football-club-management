<view class="page">
  <status-view state="{{state}}" title="点名" message="{{message}}" />
  <view wx:if="{{workbench}}" class="card hero-card">
    <view class="title">活动点名</view>
    <view class="subtitle">{{workbench.event.title}}</view>
  </view>
  <view wx:if="{{workbench}}" class="card">
    <view class="row">
      <view>
        <view class="section-title">学员名单</view>
        <view class="subtitle">支持单人状态、备注和批量到课</view>
      </view>
      <button class="ghost-button mini-button inline-button" bindtap="markAllPresent">批量到课</button>
    </view>
    <view wx:for="{{workbench.roster}}" wx:key="studentId" class="attendance-row">
      <view class="attendance-main">
        <view>
          <view class="label strong">{{item.name}}</view>
          <view class="subtitle">{{item.lessonAction || '课时状态待同步'}}</view>
        </view>
        <picker mode="selector" range="{{statusOptions}}" range-key="label" data-index="{{index}}" bindchange="onStatusChange">
          <view class="status-pill">{{item.status}}</view>
        </picker>
      </view>
      <input
        class="note-input"
        placeholder="备注，如迟到原因、请假说明"
        value="{{item.note}}"
        data-index="{{index}}"
        bindinput="onNoteInput"
      />
    </view>
  </view>
  <view wx:if="{{workbench}}" class="card">
    <view class="section-title">写入状态</view>
    <view class="subtitle">保存将调用 app-client 点名 BFF，并携带 requestId 与 Idempotency-Key。</view>
    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAttendance">保存点名</button>
  </view>
</view>
