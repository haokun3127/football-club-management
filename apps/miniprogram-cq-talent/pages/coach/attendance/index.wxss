.c4 { min-height: 100vh; background: #f6f7f9; }

/* C4 Top Nav（粉底） */
.c4-nav { display: flex; align-items: center; justify-content: space-between; height: 176rpx; padding: 28rpx 44rpx; background: #fceeef; }
.c4-nav__left { display: flex; align-items: center; gap: 24rpx; }
.c4-nav__back { color: #202124; font-size: 56rpx; font-weight: 300; line-height: 1; }
.c4-nav__title { color: #202124; font-size: 44rpx; font-weight: 700; }
.c4-nav__submit { color: #a80f1b; font-size: 32rpx; font-weight: 600; }

.c4-body { padding: 44rpx 44rpx calc(148rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; }

/* C4 Session Header */
.c4-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}
.c4-hero__title { color: #ffffff; font-size: 36rpx; font-weight: 700; }
.c4-hero__meta { color: rgba(255, 255, 255, 0.6); font-size: 26rpx; }
.c4-hero__counts { display: flex; gap: 24rpx; }
.c4-hero__count { display: flex; align-items: center; gap: 8rpx; color: #ffffff; font-size: 28rpx; font-weight: 600; }
.c4-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.c4-dot--green { background: #188754; }
.c4-dot--red { background: #a80f1b; }
.c4-dot--gray { background: #667085; }

/* C4 Quick Actions */
.c4-actions { display: flex; gap: 24rpx; }
.c4-action {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.c4-action--green { background: #e8f5e9; color: #188754; }
.c4-action--outline { border: 2rpx solid #a80f1b; color: #a80f1b; }

/* C4 异议警示卡 */
.correction-alert { display: flex; gap: 20rpx; padding: 28rpx; border: 1rpx solid #fde68a; border-radius: 24rpx; background: #fffbeb; }
.correction-alert__icon { color: #d97706; font-size: 36rpx; }
.correction-alert__title { color: #92400e; font-size: 28rpx; font-weight: 700; }
.correction-alert__text { color: #92400e; font-size: 24rpx; margin-top: 6rpx; }

/* C4 名单 */
.roster-card { display: flex; flex-direction: column; gap: 20rpx; }
.attendance-row { padding: 24rpx; border-radius: 16rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); }
.attendance-main { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.student-info { display: flex; align-items: center; gap: 20rpx; }
.student-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #3b82f6; color: #ffffff; font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.student-name { color: #202124; font-size: 28rpx; font-weight: 700; }
.lesson-state { color: #667085; font-size: 22rpx; margin-top: 4rpx; }
.note-input { margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 12rpx; background: #f8f9fb; color: #202124; font-size: 24rpx; }

/* 恢复自重写前样式（pre-b14） */
.correction-alert__texts { flex: 1; }
/* custom navigation: keep Figma 88px total height inclusive of safe area */
.c4-nav { box-sizing: border-box; }
