.attendance-page { min-height: 100vh; background: #f6f7f9; }
.attendance-page__body { padding: 20rpx 24rpx 230rpx; }
.event-head { padding: 24rpx 8rpx 28rpx; }
.event-head__eyebrow { color: var(--color-brand); font-size: 22rpx; font-weight: 700; }
.event-head__title { margin-top: 10rpx; color: #202124; font-size: 36rpx; font-weight: 750; line-height: 1.35; }
.event-head__meta { margin-top: 10rpx; color: #667085; font-size: 23rpx; line-height: 1.5; }
.summary-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-bottom: 20rpx; }
.summary-item { padding: 22rpx 12rpx; border: 1rpx solid #e7eaf0; border-radius: 20rpx; background: #ffffff; text-align: center; }
.summary-item__value { color: #202124; font-size: 36rpx; font-weight: 750; }
.summary-item__label { margin-top: 4rpx; color: #667085; font-size: 21rpx; }
.summary-item--success .summary-item__value { color: var(--color-success); }
.summary-item--warning .summary-item__value { color: #ad6800; }
.roster-card { overflow: hidden; border: 1rpx solid #e7eaf0; border-radius: 24rpx; background: #ffffff; }
.roster-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 26rpx 24rpx; border-bottom: 1rpx solid #e7eaf0; }
.roster-head .section-title { margin-bottom: 5rpx; }
.batch-button { flex-shrink: 0; min-height: 64rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid var(--color-brand); border-radius: 14rpx; background: #ffffff; color: var(--color-brand); font-size: 24rpx; font-weight: 600; line-height: 62rpx; }
.attendance-row { padding: 24rpx; border-bottom: 1rpx solid #f2f4f7; }
.attendance-row:last-child { border-bottom: 0; }
.attendance-main,.student-info { display: flex; align-items: center; }
.attendance-main { justify-content: space-between; gap: 20rpx; }
.student-info { min-width: 0; gap: 18rpx; }
.student-avatar { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: #fceeef; color: var(--color-brand); font-size: 26rpx; font-weight: 700; }
.student-name { color: #202124; font-size: 27rpx; font-weight: 700; }
.lesson-state { margin-top: 5rpx; color: #667085; font-size: 21rpx; }
.note-input { width: 100%; min-height: 68rpx; margin-top: 16rpx; box-sizing: border-box; padding: 12rpx 18rpx; border-radius: 14rpx; background: #f6f7f9; color: #202124; font-size: 23rpx; }

/* C4.2 家长异议警示卡 */
.correction-alert {
  display: flex;
  gap: 20rpx;
  background: #fff3e0;
  border: 1rpx solid #ff9800;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.correction-alert__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ff9800;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.correction-alert__texts {
  flex: 1;
}

.correction-alert__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff9800;
}

.correction-alert__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
