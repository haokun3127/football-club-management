.c4 { min-height: 100vh; background: #f6f7f9; }

.c4-body { padding: 44rpx 44rpx calc(180rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 32rpx; }

/* C4 Session Header */
.c4-hero {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 238rpx;
  gap: 24rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #07111f;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}
.c4-hero__title { overflow: hidden; color: #ffffff; font-size: 36rpx; font-weight: 700; line-height: 44rpx; text-overflow: ellipsis; white-space: nowrap; }
.c4-hero__meta { color: rgba(255, 255, 255, 0.6); font-size: 26rpx; }
.c4-hero__counts { display: flex; gap: 24rpx; }
.c4-hero__count { display: flex; align-items: center; gap: 8rpx; color: #ffffff; font-size: 28rpx; font-weight: 600; }
.c4-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.c4-dot--green { background: #188754; }
.c4-dot--red { background: #a80f1b; }
.c4-dot--gray { background: #667085; }

/* C4 Quick Actions */
.c4-actions { display: flex; gap: 24rpx; }
.c4-action {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.c4-action--green { background: #e8f5e9; color: #188754; }
.c4-action--outline { border: 2rpx solid #a80f1b; color: #a80f1b; }

/* C4 名单 */
.roster-card { display: flex; flex-direction: column; gap: 24rpx; }
.attendance-row { box-sizing: border-box; min-height: 120rpx; padding: 24rpx; border-radius: 16rpx; background: #ffffff; box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05); }
.attendance-main { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.student-info { display: flex; flex: 1; min-width: 0; align-items: center; gap: 24rpx; }
.student-info__copy { min-width: 0; }
.student-avatar { width: 72rpx; height: 72rpx; border-radius: 36rpx; background: #3b82f6; color: #ffffff; font-size: 26rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.student-name { overflow: hidden; color: #202124; font-size: 28rpx; font-weight: 700; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.attendance-confirmation { display: block; box-sizing: border-box; width: 40rpx; height: 40rpx; }
.attendance-confirmation--present { padding: 8rpx; border-radius: 50%; background: #188754; }
.attendance-confirmation--absent { border: 4rpx solid #d0d5dd; border-radius: 50%; background: #f2f4f7; }
.note-input { box-sizing: border-box; width: 100%; margin-top: 16rpx; padding: 14rpx 20rpx; border-radius: 12rpx; background: #f8f9fb; color: #202124; font-size: 24rpx; }
.roster-footer { padding: 0 16rpx; color: #667085; font-size: 24rpx; line-height: 30rpx; text-align: right; }

.save-error { padding: 20rpx 24rpx; border: 1rpx solid #fecaca; border-radius: 16rpx; background: #fff1f2; color: #b42318; font-size: 24rpx; line-height: 34rpx; }
