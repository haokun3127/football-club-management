.coverage-page {
  min-height: 100vh;
  background: #f6f7f9;
}

.coverage-nav {
  box-sizing: border-box;
  display: flex;
  height: 176rpx;
  padding: 64rpx 44rpx 20rpx;
  align-items: center;
  gap: 24rpx;
  background: #fceeef;
}

.coverage-nav__back {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.coverage-nav__back image {
  width: 48rpx;
  height: 48rpx;
}

.coverage-nav__title {
  color: #202124;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.coverage-page__body {
  padding: 32rpx 44rpx calc(176rpx + env(safe-area-inset-bottom));
}

.coverage-title {
  margin-bottom: 24rpx;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}

.student-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.student-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.student-card__name {
  min-width: 0;
  color: #202124;
  font-size: 28rpx;
  font-weight: 700;
}

.student-card__coverage {
  flex: 0 0 auto;
  color: #667085;
  font-size: 24rpx;
}

.dimension-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
}

.dimension-row__label {
  flex: 0 0 96rpx;
  overflow: hidden;
  color: #667085;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dimension-row__track {
  min-width: 0;
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #f1f5f9;
}

.dimension-row__bar {
  height: 100%;
  border-radius: 6rpx;
}

.dimension-row__bar--covered {
  background: #a80f1b;
}

.dimension-row__bar--uncovered {
  background: #e5e7eb;
}

.dimension-row__bar--pending {
  background: transparent;
}

.dimension-row__pending {
  flex: 0 0 auto;
  color: #98a2b3;
  font-size: 20rpx;
}
