.task-create-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.task-create-page__body {
  padding: 32rpx 32rpx 64rpx;
}

.page-nav { position: sticky; top: 0; z-index: 100; height: 88rpx; box-sizing: content-box; display: flex; align-items: center; padding: 0 200rpx 0 32rpx; background: var(--color-card); }
.page-nav__back { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; }
.page-nav__back image { width: 48rpx; height: 48rpx; }
.page-nav__title { flex: 1; margin-left: 8rpx; color: #202124; font-size: 36rpx; font-weight: 700; }
.page-nav__spacer { width: 48rpx; height: 48rpx; }

.form-card { padding: 32rpx; border-radius: 24rpx; background: #ffffff; }
.form-field { padding: 24rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.form-field:last-child { border-bottom: none; }
.form-field__label { margin-bottom: 16rpx; color: #667085; font-size: 24rpx; }
.form-field__input { box-sizing: border-box; width: 100%; height: 72rpx; padding: 0 24rpx; border-radius: 12rpx; background: #f6f7f9; font-size: 28rpx; color: #202124; }
.form-field__picker-box { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; height: 72rpx; padding: 0 24rpx; border-radius: 12rpx; background: #f6f7f9; font-size: 28rpx; color: #202124; }
.form-field__picker-arrow { color: #98a2b3; font-size: 32rpx; }

.submit-button { display: flex; align-items: center; justify-content: center; margin-top: 48rpx; height: 96rpx; border-radius: 48rpx; background: #a80f1b; color: #ffffff; font-size: 32rpx; font-weight: 700; }
.submit-button--disabled { opacity: 0.45; }
