<view class="task-create-page">
  <view class="page-nav" style="padding-top:{{navInset}}px;padding-right:{{menuInset}}px">
    <view class="page-nav__back" bindtap="goBack" role="button" aria-label="返回">‹</view>
    <view class="page-nav__title">{{pageTitle}}</view>
  </view>
  <view class="task-create-page__body">
    <view wx:if="{{loading}}" class="notice">正在读取课程与任务…</view>
    <view wx:if="{{loadError}}" class="notice notice--warning"><text>{{loadError}}</text><button class="text-action" bindtap="retryLoad">重新读取</button></view>
    <block wx:if="{{view === 'summary'}}">
      <view class="club-card">
        <view class="section-title">随堂测评 · {{sourceEventId ? '课程已预选' : '请选择课程'}}</view>
        <view class="caption">{{sourceDate}} {{sourceTitle}}<text wx:if="{{sourceTime}}"> · {{sourceTime}}</text></view>
        <view class="caption" wx:if="{{!sourceEventId}}">请选择本次测评对应的真实课程</view>
        <button class="text-action" bindtap="openCourses" disabled="{{loading || submitting}}">{{sourceEventId ? '更换真实课程' : '选择真实课程'}} →</button>
        <view class="settings-summary {{settingsReady ? '' : 'settings-summary--incomplete'}}" bindtap="openSettings" role="button" aria-label="编辑任务设置">
          <view class="inline-heading"><text>任务设置</text><text class="brand-link">编辑 →</text></view>
          <view class="caption">{{title || '任务名称待填写'}}</view>
          <view class="caption caption--small">{{templateNames[templateIndex] || '模板未选'}} · {{termLabel || '学期待填写'}} · {{startsOn}}—{{dueOn}}</view>
        </view>
      </view>
      <view class="summary-row" bindtap="openScope" role="button" aria-label="选择测评项目"><text>项目</text><text class="summary-row__value">{{projectSummary}}</text></view>
      <view class="summary-row" bindtap="openScope" role="button" aria-label="选择测评学员"><text>对象</text><text class="summary-row__value">{{selectedStudentCount}}名学员 · 可选择部分名单</text></view>
      <view wx:if="{{attendanceNotes.length}}" class="notice notice--warning">
        <view class="section-title">出勤提示</view>
        <view wx:for="{{attendanceNotes}}" wx:key="*this" class="caption">{{item}}</view>
        <view class="caption">仍可选为任务对象，不自动排除</view>
        <button class="text-action" bindtap="openScope">查看名单 →</button>
      </view>
      <block wx:if="{{matchingTasks.length}}">
        <view class="club-card">
          <view class="section-title">已匹配授权任务</view>
          <picker range="{{matchingTasks}}" range-key="title" value="{{existingTaskIndex}}" bindchange="chooseExistingTask" disabled="{{submitting}}"><view class="caption">{{matchingTasks[existingTaskIndex].title}} · 同课程 / 同项目<text wx:if="{{matchingTasks.length > 1}}"> ›</text></view></picker>
          <view class="caption">选择一种处理方式</view>
        </view>
        <view class="segmented">
          <button class="segmented__item {{taskMode === 'continue' ? 'segmented__item--active' : ''}}" data-mode="continue" bindtap="selectTaskMode">继续已有任务</button>
          <button class="segmented__item {{taskMode === 'create' ? 'segmented__item--active' : ''}}" data-mode="create" bindtap="selectTaskMode">另建独立复测</button>
        </view>
        <view class="notice notice--info"><view class="caption">继续已有任务：直接进入，不创建新任务</view><view class="caption">另建独立复测：完成任务设置后新建</view></view>
      </block>
    </block>
    <block wx:elif="{{view === 'courses'}}">
      <view class="section-title">可选训练课</view>
      <view wx:for="{{courseOptions}}" wx:key="id" class="selection-row" data-id="{{item.id}}" bindtap="selectCourse" role="button" aria-label="{{item.label}}">
        <text class="selection-mark {{pendingCourseId === item.id ? 'selection-mark--selected' : ''}}">{{pendingCourseId === item.id ? '✓' : '○'}}</text>
        <view class="selection-row__body"><view>{{item.label}}</view><view class="caption caption--small" wx:if="{{item.timeLabel}}">{{item.timeLabel}}</view></view>
      </view>
      <view wx:if="{{!courseOptions.length && !loading}}" class="notice">暂无有权限的训练课，请联系俱乐部安排。</view>
      <view wx:if="{{!sourceEventId}}" class="club-card"><view class="section-title">请选择课程</view><view class="caption">根据实际安排选择，不默认当天课程。</view></view>
    </block>
    <block wx:elif="{{view === 'scope'}}">
      <view class="club-card">
        <view class="inline-heading"><text class="section-title">项目库</text><button wx:if="{{publicationEnabled}}" class="text-action" bindtap="toggleAllProjects">全选 / 取消</button></view>
        <view wx:if="{{!publicationEnabled}}" class="caption">当前使用完整模板</view>
        <view wx:for="{{projects}}" wx:key="id" class="project-choice" data-id="{{item.id}}" bindtap="toggleProject" role="checkbox" aria-checked="{{item.selected}}"><text class="selection-mark {{item.selected ? 'selection-mark--selected' : ''}}">{{item.selected ? '✓' : '○'}}</text><text>{{item.name}}</text></view>
        <view class="brand-link">{{selectedProjectCount}}项已选</view>
      </view>
      <view class="summary-row"><input class="student-search" placeholder="搜索学员姓名" value="{{studentSearch}}" bindinput="onStudentSearch" /><button class="text-action" bindtap="toggleAllStudents">全选 / 取消</button></view>
      <view wx:for="{{visibleStudents}}" wx:key="id" class="selection-row {{item.attendanceWarning ? 'selection-row--warning' : ''}}" data-id="{{item.id}}" bindtap="toggleStudent" role="checkbox" aria-checked="{{item.selected}}">
        <text class="selection-mark {{item.selected ? 'selection-mark--selected' : ''}}">{{item.selected ? '✓' : '○'}}</text>
        <view class="selection-row__body"><view>{{item.name}}</view><view class="caption caption--small">{{item.attendanceLabel}}{{item.attendanceWarning ? ' · 仍可选择' : ''}}{{!item.selected ? ' · 未选择' : ''}}</view></view>
      </view>
      <view wx:if="{{!visibleStudents.length}}" class="notice">{{studentSearch ? '没有匹配的学员' : '本课暂无可选学员'}}</view>
    </block>
    <block wx:elif="{{view === 'settings'}}">
      <view class="settings-card">
        <view class="settings-title">任务设置</view><view class="caption">课程已知字段已自动带入，可修改</view>
        <view class="notice notice--info"><view class="brand-link">{{sourceEventId ? '已自动带入' : '尚未选择课程'}}</view><view class="caption caption--small">{{sourceEventId ? '任务名称与课程日期来自已选课程' : '请先返回选择真实课程'}}</view></view>
        <view class="form-field"><view class="form-field__label">任务名称</view><input class="form-field__input" value="{{title}}" placeholder="填写任务名称" maxlength="60" bindinput="onTitleInput" /></view>
        <view class="form-field"><view class="form-field__label">模板</view><picker range="{{templateNames}}" value="{{templateIndex}}" bindchange="onTemplateChange"><view class="form-field__picker-box">{{templateNames[templateIndex] || '暂无可用模板'}}<text>›</text></view></picker></view>
        <view class="form-field"><view class="form-field__label">所属学期</view><input class="form-field__input" value="{{termLabel}}" placeholder="填写真实学期" maxlength="30" bindinput="onTermLabelInput" /><view class="brand-link caption--small">填写本次测评所属学期</view></view>
        <view class="date-fields">
          <view class="form-field"><view class="form-field__label">开始日期</view><picker mode="date" value="{{startsOn}}" bindchange="onStartDateChange"><view class="form-field__picker-box">{{startsOn}}</view></picker></view>
          <view class="form-field"><view class="form-field__label">截止日期</view><picker mode="date" value="{{dueOn}}" bindchange="onDueDateChange"><view class="form-field__picker-box">{{dueOn}}</view></picker></view>
        </view>
        <view class="caption caption--small">周期须包含所选课程日期</view>
      </view>
      <view wx:if="{{!settingsReady}}" class="notice notice--warning"><view class="section-title">当前未配置完整</view><view class="caption">请补齐名称、模板和学期，并确认周期包含所选课程。</view></view>
    </block>
  </view>
  <view class="fixed-actions">
    <block wx:if="{{view === 'summary'}}"><button class="primary-button" disabled="{{loading || submitting || loadError || (matchingTasks.length && taskMode === 'continue' ? false : !canSubmit)}}" loading="{{submitting}}" bindtap="primaryAction">{{submitting ? '创建中' : (matchingTasks.length && taskMode === 'continue' ? '继续已有任务' : '创建并录入')}}</button></block>
    <button wx:elif="{{view === 'courses'}}" class="primary-button" disabled="{{!pendingCourseId || loading}}" bindtap="applyCourse">使用所选课程</button>
    <button wx:elif="{{view === 'scope'}}" class="primary-button" disabled="{{!selectedStudentCount || !selectedProjectCount}}" bindtap="applyScope">应用{{selectedStudentCount}}人</button>
    <block wx:else><button class="secondary-button" bindtap="goBack">取消</button><button class="primary-button" disabled="{{!settingsReady}}" bindtap="applySettings">保存设置并返回</button></block>
  </view>
</view>
