.change-page {
  min-height: 100vh;
  background: var(--color-page);
}

.change-page__body {
  padding: 44rpx 44rpx 200rpx;
}

/* 活动信息卡（Figma C3） */
.info-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.info-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.info-card__chip {
  padding: 8rpx 16rpx;
  background: #e8f5e9;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #188754;
}

.info-card__meta {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.form-card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.form-card__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.reason-chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.reason-chip--active {
  background: var(--color-brand);
  border-color: var(--color-brand);
  color: #ffffff;
  font-weight: 600;
}

.picker-box {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.picker-box--combined {
  position: relative;
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
}

.picker-box--combined > text {
  overflow: hidden;
  flex: 1;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.picker-box--combined > picker {
  position: absolute;
  top: 0;
  bottom: 0;
}

.picker-box--combined > picker:first-of-type {
  left: 0;
  width: 65%;
}

.picker-box--combined > picker:last-of-type {
  right: 0;
  width: 35%;
}

.picker-box__hitarea {
  width: 100%;
  height: 100%;
}

.picker-box__icon {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
}

.picker-box__icon--time {
  width: 28rpx;
  height: 28rpx;
}

.picker-box--placeholder {
  color: var(--color-text-secondary);
}

.input-box {
  display: block;
  box-sizing: border-box;
  width: 100%;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.textarea-box {
  width: 100%;
  box-sizing: border-box;
  background: #f6f7f9;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 160rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.hint {
  margin-top: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.form-error {
  padding: 20rpx 24rpx;
  border: 1rpx solid #fecaca;
  border-radius: 16rpx;
  background: #fff1f2;
  color: #b42318;
  font-size: 24rpx;
  line-height: 34rpx;
}

.picker-box--row { display: flex; align-items: center; justify-content: space-between; }
.picker-box__arrow { color: #98a2b3; font-size: 32rpx; }
.notify-row { display: flex; align-items: center; justify-content: space-between; }
.notify-row__hint { margin-top: 8rpx; color: #98a2b3; font-size: 24rpx; }
