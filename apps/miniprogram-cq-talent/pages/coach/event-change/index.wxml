<view class="change-page">
  <app-header theme="soft" title="变更活动" title-align="left" action-text="{{state === 'ready' && !submitting ? '保存' : ''}}" bindaction="submit" show-back />
  <view class="change-page__body">
    <status-view
      state="{{state}}"
      title="{{state === 'loading' ? '加载活动' : state === 'empty' ? '无法提交变更' : '读取失败'}}"
      message="{{message}}"
      action-text="{{state === 'error' ? '重试' : ''}}"
      bindaction="retry"
    />

    <block wx:if="{{state === 'ready'}}">
      <view class="info-card">
        <view class="info-card__head">
          <view class="info-card__title">{{eventTitle}}</view>
          <view class="info-card__chip">{{eventStatus}}</view>
        </view>
        <view wx:if="{{hasEventMeta}}" class="info-card__meta">{{eventMeta}}</view>
      </view>

      <view class="form-card">
        <view class="form-card__title">变更原因</view>
        <view class="reason-row">
          <view
            wx:for="{{reasons}}"
            wx:key="value"
            class="reason-chip {{reasonIndex === index ? 'reason-chip--active' : ''}}"
            data-index="{{index}}"
            bindtap="selectReason"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="form-card">
        <view class="form-card__title">新时间</view>
        <view class="picker-row">
          <picker mode="date" value="{{newDate}}" disabled="{{submitting}}" bindchange="selectDate">
            <view class="picker-box">
              <text class="{{hasNewDate ? '' : 'picker-box--placeholder'}}">{{dateDisplay}}</text>
              <text>日期</text>
            </view>
          </picker>
          <picker mode="time" value="{{newTime}}" disabled="{{submitting}}" bindchange="selectTime">
            <view class="picker-box">
              <text class="{{hasNewTime ? '' : 'picker-box--placeholder'}}">{{timeDisplay}}</text>
              <text>时间</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-card">
        <view class="form-card__title">新场地</view>
        <picker wx:if="{{venueNames.length > 0}}" mode="selector" range="{{venueNames}}" value="{{venueIndex}}" disabled="{{submitting}}" bindchange="selectVenue">
          <view class="picker-box picker-box--row">
            <text class="{{venueIndex >= 0 ? '' : 'picker-box--placeholder'}}">{{venueIndex >= 0 ? newVenue : '选择新场地'}}</text>
            <text class="picker-box__arrow">›</text>
          </view>
        </picker>
        <input wx:else class="input-box" placeholder="填写不同于原场地的新场地" value="{{newVenue}}" disabled="{{submitting}}" bindinput="inputVenue" />
      </view>

      <view class="form-card">
        <view class="form-card__title">说明</view>
        <textarea class="textarea-box" placeholder="请说明变更原因（选填）" maxlength="500" value="{{note}}" disabled="{{submitting}}" bindinput="inputNote" />
      </view>

      <view class="form-card notify-row">
        <view class="notify-row__text">
          <view class="form-card__title">通知学员家长</view>
          <view class="notify-row__hint">本次变更将通知 {{affectedCount}} 位家长</view>
        </view>
        <switch checked="{{notifyParents}}" disabled="{{submitting}}" color="#a80f1b" bindchange="toggleNotify" />
      </view>

      <view wx:if="{{hasSubmitError}}" class="form-error">{{submitError}}</view>
    </block>
  </view>
  <role-tabbar role="coach" active="schedule" />
</view>
