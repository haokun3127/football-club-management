page{background:var(--club-page);color:var(--club-text)}.evaluation-page{min-height:100vh;background:var(--club-page)}.evaluation-nav{display:flex;align-items:center;min-height:44px;padding-left:32rpx;background:var(--club-nav);font-size: var(--font-size-body);box-sizing:content-box}.evaluation-back{width:48rpx;height:72rpx;display:flex;align-items:center}.evaluation-back image{width:32rpx;height:32rpx}.evaluation-body{padding:32rpx 32rpx calc(184rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:32rpx}.evaluation-heading{font-size: var(--font-size-section);line-height: 1.5;font-weight:600}.evaluation-team{font-size: var(--font-size-aux);color:var(--club-muted);margin-top:-20rpx}.evaluation-card{background:#fff;border:2rpx solid var(--club-line);border-radius:28rpx;padding:32rpx;box-shadow:none;display:flex;flex-direction:column;gap:24rpx}.evaluation-option{display:flex;gap:16rpx;align-items:center;font-size: var(--font-size-body);font-weight:500;line-height:48rpx}.evaluation-check{font-size: var(--font-size-body);color:var(--color-text-secondary);width:48rpx;flex-shrink:0}.evaluation-check--selected{color:var(--color-brand)}.evaluation-caption{font-size: var(--font-size-aux);line-height: 1.5;color:var(--color-text-secondary)}.evaluation-note{width:100%;min-height:48rpx;font-size: var(--font-size-aux);line-height: 1.5;color:var(--club-text)}.evaluation-text{font-size: var(--font-size-body);line-height: 1.5;color:var(--color-text-secondary);white-space:pre-wrap;overflow-wrap:break-word}.evaluation-author,.evaluation-current{font-size: var(--font-size-body);line-height:48rpx}.evaluation-current{margin-bottom:16rpx}.evaluation-date{align-self:flex-start;padding:8rpx 16rpx;background:#eef4ff;border-radius:16rpx;color:#2268d8;font-size: var(--font-size-aux);line-height:36rpx}.evaluation-link{padding:0;margin:0;background:transparent;color:var(--color-brand);text-align:left;font-size: var(--font-size-body);line-height:48rpx}.evaluation-link::after,.evaluation-save::after{border:0}.evaluation-footer{position:fixed;bottom:0;left:0;right:0;background:var(--club-nav);padding:16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom))}.evaluation-save{background:var(--color-brand);color:#fff;border-radius:16rpx;font-size: var(--font-size-body);height:96rpx;line-height:96rpx}.evaluation-save[disabled]{background:#dac7c8;color:var(--club-muted)}.evaluation-error{padding:24rpx;background:#fff0ef;color:var(--color-brand);font-size: var(--font-size-aux);line-height:40rpx}

.evaluation-footer .evaluation-save{width:100%;max-width:none;display:block}.evaluation-body>.evaluation-link{width:100%;max-width:none;text-align:left}

/* 移动端触控下限，业务内容与原事件保持一致。 */
.evaluation-back,
.evaluation-card { min-height:44px; min-width:44px; box-sizing:border-box; }
