<view class="evaluation-page">
  <app-header title="{{pageTitle}}" title-align="left" show-back="{{true}}" custom-back="{{true}}" bindback="goBack" />
  <view class="evaluation-body">
    <status-view state="{{state}}" title="{{state === 'loading' ? '加载评价' : state === 'empty' ? '暂无评价' : '读取失败'}}" message="{{message}}" action-text="{{state === 'error' ? '重试' : ''}}" bindaction="reload" />
    <block wx:if="{{state === 'ready'}}">
      <view class="evaluation-heading">{{studentName}} · {{mode === 'history' ? '评价历史' : '当前评价'}}</view>
      <picker wx:if="{{teams.length > 1 && mode !== 'edit'}}" range="{{teams}}" range-key="name" bindchange="changeTeam"><view class="evaluation-team">{{teamName}} ▾</view></picker>
      <view wx:else class="evaluation-team">{{teamName}}</view>
      <block wx:if="{{mode === 'edit'}}">
        <view wx:for="{{phrases}}" wx:key="id" class="evaluation-card" data-id="{{item.id}}" bindtap="togglePhrase"><view class="evaluation-option"><text class="evaluation-check {{item.selected ? 'evaluation-check--selected' : ''}}">{{item.selected ? '☑' : '○'}}</text><text>{{item.text}}</text></view><view class="evaluation-caption">{{item.selected ? '已选' : '未选'}}</view></view>
        <view class="evaluation-card"><view class="evaluation-option"><text class="evaluation-check">○</text><text>补充评价</text></view><t-textarea class="evaluation-note" value="{{note}}" maxlength="500" placeholder="可选，记录对学员的具体建议" disabled="{{submitting || mustReload}}" bindchange="inputNote" auto-height  t-class="evaluation-note" /><view class="evaluation-caption">{{note.length}} / 500</view></view>
        <view class="evaluation-caption">按需更新，不要求每课评价</view>
      </block>
      <block wx:elif="{{mode === 'current'}}">
        <view class="evaluation-card"><view wx:if="{{current}}"><view wx:for="{{current.phrases}}" wx:key="id" class="evaluation-current">{{item.text}}</view><view wx:if="{{current.note}}" class="evaluation-text">{{current.note}}</view><view wx:if="{{!current.phrases.length && !current.note}}" class="evaluation-text">当前评价已清空，历史仍保留。</view><view class="evaluation-caption">{{current.actorDisplayName}} · {{history[0].date}}</view></view><view wx:else class="evaluation-text">教练尚未维护本队评价</view></view>
        <t-button class="evaluation-link" bindtap="showHistory" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="evaluation-link" theme="primary" variant="text">查看评价变化 ›</t-button><t-button wx:if="{{canEdit}}" class="evaluation-link" bindtap="edit" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="evaluation-link" theme="primary" variant="text">更新本队评价 ›</t-button>
      </block>
      <block wx:else>
        <view wx:for="{{history}}" wx:key="revision" class="evaluation-card"><view class="evaluation-date">{{item.date}}</view><view class="evaluation-author">{{item.author}}</view><view wx:for="{{item.changes}}" wx:for-item="change" wx:key="*this" class="evaluation-text">{{change}}</view></view>
        <view wx:if="{{!history.length}}" class="evaluation-text">暂无评价变化</view>
      </block>
      <view class="evaluation-caption" wx:if="{{mode !== 'edit'}}">评价不自动计入能力分</view>
      <view wx:if="{{mustReload}}" class="evaluation-error">{{message}}<t-button class="evaluation-link" bindtap="reload" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="evaluation-link" theme="primary" variant="text">重新读取</t-button></view>
    </block>
  </view>
  <view wx:if="{{state === 'ready' && mode === 'edit'}}" class="evaluation-footer"><t-button class="evaluation-save" disabled="{{!canEdit || submitting || mustReload}}" loading="{{submitting}}" bindtap="save" custom-style="min-height:var(--control-height);height:auto;font-size:var(--font-size-body);line-height:1.5;padding:var(--control-padding);" t-class="evaluation-save" theme="primary" variant="base">保存评价</t-button></view>
</view>
