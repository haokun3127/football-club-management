<view class="login-page">
  <app-header title="账号验证" />
  <view class="login-page__body">
    <view class="login-hero">
      <view class="login-hero__eyebrow">重庆天才足球</view>
      <view class="title">欢迎回来</view>
      <view class="subtitle">验证微信手机号后，将自动匹配您在俱乐部登记的身份。</view>
    </view>

    <status-view state="{{state}}" title="{{state === 'loading' ? '正在验证' : state === 'pending' ? '需要俱乐部确认' : state === 'error' ? '暂时无法登录' : ''}}" message="{{message}}" action-text="{{state === 'error' ? '重新连接' : ''}}" bindaction="retry" />

    <view wx:if="{{state === 'ready'}}" class="card verify-card">
      <view class="section-title">手机号验证</view>
      <view class="subtitle">手机号只用于匹配当前俱乐部档案，不会创建新的身份。</view>
      <button class="primary-button verify-button" open-type="getPhoneNumber" loading="{{submitting}}" disabled="{{submitting}}" bindgetphonenumber="onGetPhoneNumber">授权手机号并进入</button>
      <view class="privacy-note">继续即表示同意使用微信授权手机号完成身份核验。</view>
    </view>

    <view class="help-row"><view class="help-row__title">遇到问题？</view><view class="help-row__text">未登记、手机号不一致、多身份或账号停用，请联系俱乐部工作人员处理。</view></view>
  </view>
</view>
