.login-page { min-height: 100vh; background: #f6f7f9; }
.login-page__body { padding: 44rpx 24rpx 48rpx; }
.login-hero { padding: 28rpx 12rpx 34rpx; }
.login-hero__eyebrow { margin-bottom: 14rpx; color: var(--color-brand); font-size: 24rpx; font-weight: 700; }
.login-hero .title { font-size: 44rpx; }
.login-hero .subtitle { max-width: 600rpx; margin-top: 16rpx; }
.verify-card { padding: 32rpx; }
.verify-button { margin-top: 28rpx; }
.privacy-note { margin-top: 18rpx; color: #98a2b3; font-size: 21rpx; line-height: 1.5; text-align: center; }
.help-row { margin-top: 36rpx; padding: 0 12rpx; }
.help-row__title { color: #202124; font-size: 25rpx; font-weight: 650; }
.help-row__text { margin-top: 8rpx; color: #667085; font-size: 23rpx; line-height: 1.55; }
