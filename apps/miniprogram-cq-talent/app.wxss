@import "styles/tokens.wxss";

page {
  background: var(--color-page);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 30rpx;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-with-header { padding-top: 20rpx; }

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
}

.hero-card {
  border-color: #f7cdd1;
  background: var(--color-brand-soft);
  box-shadow: none;
}

.title { font-size: 36rpx; font-weight: 700; line-height: 1.3; }
.subtitle { color: var(--color-text-secondary); font-size: 26rpx; line-height: 1.55; }
.section-title { margin-bottom: 16rpx; font-size: 32rpx; font-weight: 700; }
.label { color: var(--color-text-secondary); font-size: 26rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.stack { display: flex; flex-direction: column; gap: 16rpx; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  font-size: 24rpx;
}
.tag.muted { background: #f2f4f7; color: var(--color-text-secondary); }
.tag.warning { background: var(--color-warning-soft); color: var(--color-warning); }
.tag.success { background: var(--color-success-soft); color: var(--color-success); }

.primary-button,
.ghost-button {
  min-height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  transition: background-color 180ms ease, transform 180ms ease;
}
.primary-button { background: var(--color-brand); color: #ffffff; }
.primary-button.button-hover { background: var(--color-brand-pressed); transform: scale(0.99); }
.primary-button[disabled] { background: #d0d5dd; color: #ffffff; }
.ghost-button { border: 1rpx solid var(--color-brand); background: #ffffff; color: var(--color-brand); }

.empty { padding: 40rpx 24rpx; color: var(--color-text-secondary); text-align: center; }
.field-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f2f4f7; }
.field-row:last-child { border-bottom: 0; }
.field-value { flex: 1; color: var(--color-text); text-align: right; }
.actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.mini-button { flex: 1; min-height: 80rpx; font-size: 28rpx; line-height: 80rpx; }
.safe-bottom { height: env(safe-area-inset-bottom); }
