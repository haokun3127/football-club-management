page {
  background: #f7f8fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 148rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #eceef2;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.hero-card {
  background: #fff1f0;
  border-color: #ffd6d2;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  color: #60646f;
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.label {
  color: #60646f;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #fff1f0;
  color: #e60012;
  font-size: 22rpx;
}

.tag.muted {
  background: #f2f3f5;
  color: #60646f;
}

.tag.warning {
  background: #fff7e6;
  color: #ad6800;
}

.tag.success {
  background: #f0fff4;
  color: #237804;
}

.primary-button {
  background: #e60012;
  color: #ffffff;
  border-radius: 10rpx;
}

.primary-button.button-hover {
  background: #c4000f;
}

.ghost-button {
  color: #e60012;
  border: 1rpx solid #e60012;
  background: #ffffff;
  border-radius: 10rpx;
}

.empty {
  padding: 40rpx 24rpx;
  color: #60646f;
  text-align: center;
}

.field-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.field-row:last-child {
  border-bottom: 0;
}

.field-value {
  flex: 1;
  text-align: right;
  color: #1f2329;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.mini-button {
  flex: 1;
  font-size: 26rpx;
  line-height: 2.4;
}

.safe-bottom {
  height: 1rpx;
}
