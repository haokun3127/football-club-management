{
  "name": "football-club-management",
  "version": "0.1.0",
  "private": true,
  "description": "Youth football club management platform.",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test",
    "check:miniprogram-policy": "node scripts/miniprogram-policy/check.mjs",
    "clean": "pnpm -r run clean",
    "dev:api": "pnpm --filter @football-club/api dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @football-club/domain build && pnpm -r typecheck",
    "check:delivery": "node scripts/verify-delivery-config.mjs && pnpm check && pnpm build && node --test scripts/delivery/*.test.mjs scripts/devtools/automation-session.test.cjs deploy/environment-isolation/bootstrap-client.test.mjs deploy/environment-isolation/bootstrap-identity.test.mjs && node scripts/verify-environment-startup.mjs",
    "check:environments": "node scripts/verify-environment-readiness.mjs",
    "dev:backoffice": "pnpm --filter @football-club/backoffice dev"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
