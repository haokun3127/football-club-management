{
  "name": "football-club-management",
  "version": "0.1.0",
  "private": true,
  "description": "Youth football club management platform.",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test",
    "clean": "pnpm -r run clean",
    "dev:api": "pnpm --filter @football-club/api dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @football-club/domain build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
